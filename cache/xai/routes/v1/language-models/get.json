{
  "operationId": "handle_language_models_list_request",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "models": [
              {
                "aliases": [
                  "grok-4.3-latest"
                ],
                "cached_prompt_text_token_price": 2000,
                "cached_prompt_text_token_price_long_context": 0,
                "completion_text_token_price": 25000,
                "completion_text_token_price_long_context": 0,
                "created": 1776556800,
                "fingerprint": "fp_777a9f8466",
                "id": "latest",
                "input_modalities": [
                  "text",
                  "image"
                ],
                "long_context_threshold": 0,
                "object": "model",
                "output_modalities": [
                  "text"
                ],
                "owned_by": "xai",
                "prompt_image_token_price": 12500,
                "prompt_text_token_price": 12500,
                "prompt_text_token_price_long_context": 0,
                "search_price": 0,
                "version": "1.0"
              },
              {
                "aliases": [],
                "cached_prompt_text_token_price": 2000,
                "cached_prompt_text_token_price_long_context": 0,
                "completion_text_token_price": 80000,
                "completion_text_token_price_long_context": 160000,
                "created": 1768003200,
                "fingerprint": "fp_5319828d69",
                "id": "grok-420-reasoning",
                "input_modalities": [
                  "text"
                ],
                "long_context_threshold": 128000,
                "object": "model",
                "output_modalities": [
                  "text"
                ],
                "owned_by": "xai",
                "prompt_image_token_price": 0,
                "prompt_text_token_price": 20000,
                "prompt_text_token_price_long_context": 40000,
                "search_price": 0,
                "version": "1.0"
              }
            ]
          },
          "schema": {
            "$ref": "#/components/schemas/ListLanguageModelsResponse"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "description": "Bad request. The request is invalid or an invalid API key is provided."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "List all chat and image understanding models available to the authenticating API key with full information. Additional information compared to /v1/models includes modalities, fingerprint and alias(es).",
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "ListLanguageModelsResponse": {
        "properties": {
          "models": {
            "description": "Array of available language models.",
            "items": {
              "$ref": "#/components/schemas/LanguageModel"
            },
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "type": "object"
      },
      "LanguageModel": {
        "description": "Details of a language model",
        "properties": {
          "aliases": {
            "description": "Alias ID(s) of the model that user can use in a request's model field.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cached_prompt_text_token_price": {
            "description": "Price of a prompt text token (in USD cents per 100 million tokens) that was cached previously.",
            "format": "int64",
            "type": "integer"
          },
          "cached_prompt_text_token_price_long_context": {
            "description": "Price of the cached prompt text token for long context requests (USD cents per 100 million tokens).\nWhen 0, falls back to cached_prompt_text_token_price.",
            "format": "int64",
            "type": "integer"
          },
          "completion_text_token_price": {
            "description": "Price of the completion text token in USD cents per 100 million token.",
            "format": "int64",
            "type": "integer"
          },
          "completion_text_token_price_long_context": {
            "description": "Price of the completion text token for long context requests (USD cents per 100 million tokens).\nWhen 0, the standard completion_text_token_price applies.",
            "format": "int64",
            "type": "integer"
          },
          "created": {
            "description": "Creation time of the model in Unix timestamp.",
            "format": "int64",
            "type": "integer"
          },
          "fingerprint": {
            "description": "Fingerprint of the xAI system configuration hosting the model.",
            "type": "string"
          },
          "id": {
            "description": "Model ID. Obtainable from <https://console.x.ai/team/default/models> or <https://docs.x.ai/docs/models>.",
            "type": "string"
          },
          "input_modalities": {
            "description": "The input modalities supported by the model, e.g. `\"text\"`, `\"image\"`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "long_context_threshold": {
            "description": "Token count at or above which the long context prices apply.\nWhen 0, the model has no long context pricing tier.",
            "format": "int64",
            "type": "integer"
          },
          "object": {
            "description": "The object type, which is always `\"model\"`.",
            "type": "string"
          },
          "output_modalities": {
            "description": "The output modalities supported by the model, e.g. `\"text\"`, `\"image\"`.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "owned_by": {
            "description": "Owner of the model.",
            "type": "string"
          },
          "prompt_image_token_price": {
            "description": "Price of the prompt image token in USD cents per 100 million token.",
            "format": "int64",
            "type": "integer"
          },
          "prompt_text_token_price": {
            "description": "Price of the prompt text token in USD cents per 100 million token.",
            "format": "int64",
            "type": "integer"
          },
          "prompt_text_token_price_long_context": {
            "description": "Price of the prompt text token for long context requests (USD cents per 100 million tokens).\nWhen 0, the standard prompt_text_token_price applies at all context lengths.",
            "format": "int64",
            "type": "integer"
          },
          "search_price": {
            "description": "Price of the search in USD cents per 100 million searches.",
            "format": "int64",
            "type": "integer"
          },
          "version": {
            "description": "Version of the model.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fingerprint",
          "created",
          "object",
          "owned_by",
          "version",
          "input_modalities",
          "output_modalities",
          "prompt_text_token_price",
          "cached_prompt_text_token_price",
          "prompt_image_token_price",
          "completion_text_token_price",
          "search_price",
          "prompt_text_token_price_long_context",
          "cached_prompt_text_token_price_long_context",
          "completion_text_token_price_long_context",
          "long_context_threshold",
          "aliases"
        ],
        "type": "object"
      }
    }
  }
}
