{
  "operationId": "handle_get_me_request",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "api_key": {
              "api_key_id": "ae1e1841-4326-4b36-a8a9-8a1a7237db11",
              "blocked": false,
              "disabled": false,
              "redacted_api_key": "xai-...b14o"
            },
            "team_blocked": false,
            "team_id": "5ea6f6bd-7815-4b8a-9135-28b2d7ba6722",
            "user_id": "59fbe5f2-040b-46d5-8325-868bb8f23eb2",
            "zdr_status": "no_zdr"
          },
          "schema": {
            "$ref": "#/components/schemas/GetMeResponse"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "description": "Bad request."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Get information about the currently authenticated caller.\nWorks with both API keys and OAuth tokens. Returns identity, team, and ZDR status.",
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "GetMeResponse": {
        "description": "Information about the currently authenticated caller.\nWorks with both API keys and OAuth tokens.",
        "properties": {
          "api_key": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MeApiKeyInfo",
                "description": "Present when authenticated with an API key."
              }
            ]
          },
          "oauth": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MeOAuthInfo",
                "description": "Present when authenticated with an OAuth token."
              }
            ]
          },
          "team_blocked": {
            "description": "Whether the team is blocked from making API requests.",
            "type": "boolean"
          },
          "team_id": {
            "description": "Team ID associated with the credentials.",
            "type": "string"
          },
          "user_id": {
            "description": "User ID associated with the credentials.",
            "type": "string"
          },
          "zdr_status": {
            "$ref": "#/components/schemas/ZdrStatus",
            "description": "Zero Data Retention status: `\"no_zdr\"` or `\"zdr\"`.\nHistorical `\"pii_scrubbing\"` is accepted on read but no longer emitted."
          }
        },
        "required": [
          "user_id",
          "team_id",
          "zdr_status",
          "team_blocked"
        ],
        "type": "object"
      },
      "MeApiKeyInfo": {
        "description": "API key details nested in the `/v1/me` response.",
        "properties": {
          "api_key_id": {
            "description": "The API key ID.",
            "type": "string"
          },
          "blocked": {
            "description": "Whether the API key is blocked.",
            "type": "boolean"
          },
          "disabled": {
            "description": "Whether the API key is disabled.",
            "type": "boolean"
          },
          "redacted_api_key": {
            "description": "The redacted API key.",
            "type": "string"
          }
        },
        "required": [
          "redacted_api_key",
          "api_key_id",
          "blocked",
          "disabled"
        ],
        "type": "object"
      },
      "MeOAuthInfo": {
        "description": "OAuth token details nested in the `/v1/me` response.",
        "properties": {
          "client_id": {
            "description": "The OAuth client_id of the application.",
            "type": "string"
          }
        },
        "required": [
          "client_id"
        ],
        "type": "object"
      },
      "ZdrStatus": {
        "description": "Zero Data Retention status for a team.",
        "enum": [
          "no_zdr",
          "zdr",
          "pii_scrubbing"
        ],
        "type": "string"
      }
    }
  }
}
