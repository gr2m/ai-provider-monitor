{
  "operationId": "handle_download_file_content_request",
  "parameters": [
    {
      "description": "The file's `id` to download.",
      "in": "path",
      "name": "file_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Format of the downloaded content.",
      "in": "query",
      "name": "format",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ContentFormat"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/octet-stream": {
          "schema": {
            "type": "string"
          }
        }
      },
      "description": "Success -- raw file bytes streamed in chunks."
    },
    "404": {
      "description": "File not found, deleted, or expired."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Download the contents of a file as a stream of raw bytes. The response\n`Content-Type` is `application/octet-stream`. Use this for the binary\npayload; use `GET /v1/files/{file_id}` for metadata only.",
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "ContentFormat": {
        "description": "Format of the downloaded file content.",
        "enum": [
          "original",
          "text"
        ],
        "type": "string"
      }
    }
  }
}
