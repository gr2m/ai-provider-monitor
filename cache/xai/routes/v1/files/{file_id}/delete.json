{
  "operationId": "handle_delete_file_request",
  "parameters": [
    {
      "description": "The file's `id` to delete.",
      "in": "path",
      "name": "file_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "deleted": true,
            "id": "file_a128090d-f0c9-4873-bd84-e499777e7417"
          },
          "schema": {
            "$ref": "#/components/schemas/DeleteFileResponse"
          }
        }
      },
      "description": "Success"
    },
    "404": {
      "description": "File not found or already deleted."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Delete a file by ID. After this returns, the file no longer appears in\n`GET /v1/files`, content download returns 404, and the ID can no longer\nbe referenced in chat attachments.",
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "DeleteFileResponse": {
        "properties": {
          "deleted": {
            "description": "Whether the file was deleted.",
            "type": "boolean"
          },
          "id": {
            "description": "The ID of the file.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always \"file\". Only included for compatibility.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "deleted",
          "object"
        ],
        "type": "object"
      }
    }
  }
}
