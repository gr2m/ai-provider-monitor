{
  "operationId": "handle_list_skills_request",
  "parameters": [
    {
      "description": "The maximum number of objects to be returned in a single response.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "format": "int32",
        "type": "integer"
      }
    },
    {
      "description": "Identifier for the last item from the previous pagination request.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Sort order. Use `asc` for ascending and `desc` for descending order.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SkillList"
          }
        }
      },
      "description": "Success"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "SkillList": {
        "description": "A list of hosted skills.",
        "properties": {
          "data": {
            "description": "A list of skills.",
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array"
          },
          "first_id": {
            "description": "The ID of the first item in the list.",
            "type": "string"
          },
          "has_more": {
            "description": "Whether there are more items available.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The ID of the last item in the list.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `\"list\"`.",
            "type": "string"
          }
        },
        "required": [
          "data",
          "first_id",
          "has_more",
          "last_id",
          "object"
        ],
        "type": "object"
      },
      "Skill": {
        "description": "A hosted skill.",
        "properties": {
          "created_at": {
            "description": "Unix timestamp (seconds) for when the skill was created.",
            "format": "int64",
            "type": "integer"
          },
          "default_version": {
            "description": "Default version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "description": {
            "description": "Description extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill.",
            "type": "string"
          },
          "latest_version": {
            "description": "Latest version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "name": {
            "description": "Skill name extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `\"skill\"`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "default_version",
          "description",
          "latest_version",
          "name",
          "object"
        ],
        "type": "object"
      }
    }
  }
}
