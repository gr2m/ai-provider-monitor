{
  "operationId": "handle_upload_skill_request",
  "requestBody": {
    "content": {
      "multipart/form-data": {
        "schema": {
          "$ref": "#/components/schemas/UploadSkillMultipartRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Skill"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "description": "Invalid skill upload."
    },
    "413": {
      "description": "Payload too large."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "UploadSkillMultipartRequest": {
        "description": "Multipart form fields accepted by `POST /v1/skills`.",
        "properties": {
          "files": {
            "description": "Skill zip file or one file from a directory upload. Clients may send\nthis field once with a zip file, or repeatedly with directory files.",
            "items": {
              "format": "binary",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "type": "object"
      },
      "Skill": {
        "description": "A hosted skill.",
        "properties": {
          "created_at": {
            "description": "Unix timestamp (seconds) for when the skill was created.",
            "format": "int64",
            "type": "integer"
          },
          "default_version": {
            "description": "Default version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "description": {
            "description": "Description extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill.",
            "type": "string"
          },
          "latest_version": {
            "description": "Latest version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "name": {
            "description": "Skill name extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `\"skill\"`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "default_version",
          "description",
          "latest_version",
          "name",
          "object"
        ],
        "type": "object"
      }
    }
  }
}
