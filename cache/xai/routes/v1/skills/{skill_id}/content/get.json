{
  "operationId": "handle_download_skill_content_request",
  "parameters": [
    {
      "description": "The skill ID.",
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/zip": {
          "schema": {
            "type": "string"
          }
        }
      },
      "description": "Success -- raw skill zip bytes streamed in chunks."
    },
    "404": {
      "description": "Skill not found."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    "v1"
  ]
}
