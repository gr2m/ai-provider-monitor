{
  "operationId": "handle_retrieve_skill_request",
  "parameters": [
    {
      "description": "The skill ID.",
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Skill"
          }
        }
      },
      "description": "Success"
    },
    "404": {
      "description": "Skill not found."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "Skill": {
        "description": "A hosted skill.",
        "properties": {
          "created_at": {
            "description": "Unix timestamp (seconds) for when the skill was created.",
            "format": "int64",
            "type": "integer"
          },
          "default_version": {
            "description": "Default version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "description": {
            "description": "Description extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill.",
            "type": "string"
          },
          "latest_version": {
            "description": "Latest version for the skill. Currently always `\"1\"`.",
            "type": "string"
          },
          "name": {
            "description": "Skill name extracted from `SKILL.md` frontmatter.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `\"skill\"`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "default_version",
          "description",
          "latest_version",
          "name",
          "object"
        ],
        "type": "object"
      }
    }
  }
}
