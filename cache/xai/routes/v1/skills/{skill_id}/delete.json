{
  "operationId": "handle_delete_skill_request",
  "parameters": [
    {
      "description": "The skill ID.",
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeletedSkill"
          }
        }
      },
      "description": "Success"
    },
    "404": {
      "description": "Skill not found."
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    "v1"
  ],
  "components": {
    "schemas": {
      "DeletedSkill": {
        "description": "Response for deleting a hosted skill.",
        "properties": {
          "deleted": {
            "description": "Whether the skill was deleted.",
            "type": "boolean"
          },
          "id": {
            "description": "The ID of the skill.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `\"skill.deleted\"`.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "deleted",
          "object"
        ],
        "type": "object"
      }
    }
  }
}
