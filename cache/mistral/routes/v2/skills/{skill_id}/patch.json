{
  "description": "UpdateSkill",
  "operationId": "skills_update",
  "parameters": [
    {
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "title": "skill_id",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "additionalProperties": false,
          "properties": {
            "sharingScope": {
              "$ref": "#/components/schemas/RegistrySharingScope",
              "description": "Registry sharing scope.",
              "nullable": true,
              "title": "sharing_scope"
            },
            "workspaceRelation": {
              "$ref": "#/components/schemas/ShareRelation",
              "description": "Access every workspace member gets when sharing_scope is `workspace`. Defaults to `writer`, which is what a workspace publish granted before this field existed, so omitting it preserves today's behaviour exactly. Rejected unless sharing_scope is `workspace`.",
              "nullable": true,
              "title": "workspace_relation"
            }
          },
          "title": "UpdateSkillRequest",
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Skill"
          }
        }
      },
      "description": "Success"
    }
  },
  "summary": "UpdateSkill",
  "tags": [
    "beta.skills"
  ],
  "components": {
    "schemas": {
      "RegistrySharingScope": {
        "enum": [
          "sharing_scope_unspecified",
          "private",
          "workspace"
        ],
        "title": "RegistrySharingScope",
        "type": "string"
      },
      "ShareRelation": {
        "description": "Relation a subject holds on a shared registry object.",
        "enum": [
          "share_relation_unspecified",
          "reader",
          "writer"
        ],
        "title": "ShareRelation",
        "type": "string"
      },
      "Skill": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "description": "Aliases pointing to this version.",
            "items": {
              "type": "string"
            },
            "title": "aliases",
            "type": "array"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Creation time.",
            "title": "created_at"
          },
          "definition": {
            "$ref": "#/components/schemas/SkillDefinition",
            "title": "definition"
          },
          "id": {
            "title": "id",
            "type": "string"
          },
          "latestVersion": {
            "description": "Latest version number.",
            "example": 1,
            "format": "int32",
            "title": "latest_version",
            "type": "integer"
          },
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          },
          "notes": {
            "description": "Notes for this version.",
            "title": "notes",
            "type": "string"
          },
          "sharingScope": {
            "$ref": "#/components/schemas/RegistrySharingScope",
            "description": "Registry sharing scope.",
            "title": "sharing_scope"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Last update time.",
            "title": "updated_at"
          },
          "version": {
            "example": 1,
            "format": "int32",
            "title": "version",
            "type": "integer"
          }
        },
        "title": "Skill",
        "type": "object"
      },
      "Timestamp": {
        "description": "RFC 3339 timestamp.",
        "examples": [
          "1s",
          "1.000340012s"
        ],
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "SkillDefinition": {
        "additionalProperties": false,
        "description": "Versioned skill content.",
        "properties": {
          "assets": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SkillAssetContent",
              "title": "value"
            },
            "description": "Additional files available to the skill.",
            "title": "assets",
            "type": "object"
          },
          "body": {
            "description": "Skill body content.",
            "title": "body",
            "type": "string"
          },
          "description": {
            "description": "Model-facing trigger and usage description.",
            "title": "description",
            "type": "string"
          }
        },
        "title": "SkillDefinition",
        "type": "object"
      },
      "SkillAssetContent": {
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "rawContent": {
                "format": "byte",
                "title": "raw_content",
                "type": "string"
              }
            },
            "required": [
              "rawContent"
            ],
            "title": "raw_content"
          },
          {
            "properties": {
              "textContent": {
                "title": "text_content",
                "type": "string"
              }
            },
            "required": [
              "textContent"
            ],
            "title": "text_content"
          }
        ],
        "properties": {
          "isExecutable": {
            "title": "is_executable",
            "type": "boolean"
          }
        },
        "title": "SkillAssetContent",
        "type": "object"
      }
    }
  }
}
