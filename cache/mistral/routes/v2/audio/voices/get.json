{
  "description": "List voices, cursor-paginated",
  "operationId": "audio_v2_voices_list",
  "parameters": [
    {
      "description": "Maximum number of voices to return",
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 10,
        "description": "Maximum number of voices to return",
        "maximum": 100,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Cursor returned as next_page_token by the previous page",
      "in": "query",
      "name": "page_token",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Cursor returned as next_page_token by the previous page",
        "title": "Page Token"
      }
    },
    {
      "description": "Filter the voices between customs and presets",
      "in": "query",
      "name": "type",
      "required": false,
      "schema": {
        "default": "all",
        "description": "Filter the voices between customs and presets",
        "enum": [
          "all",
          "custom",
          "preset"
        ],
        "title": "Type",
        "type": "string"
      }
    },
    {
      "description": "Keep voices matching any of these genders",
      "in": "query",
      "name": "gender",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/components/schemas/VoiceGender"
            },
            "maxItems": 3,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Keep voices matching any of these genders",
        "title": "Gender"
      }
    },
    {
      "description": "Keep voices supporting any of these languages",
      "in": "query",
      "name": "language",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "maxLength": 12,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Keep voices supporting any of these languages",
        "title": "Language"
      }
    },
    {
      "description": "Case-insensitive match on voice name",
      "in": "query",
      "name": "query",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Case-insensitive match on voice name",
        "title": "Query"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VoiceListPage"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "List voices, cursor-paginated",
  "tags": [
    "audio.voices"
  ],
  "components": {
    "schemas": {
      "VoiceGender": {
        "enum": [
          "female",
          "male",
          "neutral"
        ],
        "title": "VoiceGender",
        "type": "string"
      },
      "VoiceListPage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/VoiceResponse"
            },
            "title": "Data",
            "type": "array"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor for the next page, null on the last page",
            "title": "Next Page Token"
          }
        },
        "required": [
          "data"
        ],
        "title": "VoiceListPage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "VoiceResponse": {
        "description": "Schema for voice response",
        "properties": {
          "age": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "color": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "gender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gender"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/VoiceKind",
            "default": "ivc",
            "description": "Cloning technology behind the voice: ivc for instant cloning, pvc for professional cloning."
          },
          "languages": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Languages",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "retention_notice": {
            "default": 30,
            "title": "Retention Notice",
            "type": "integer"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          },
          "trimmed_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trimmed Seconds"
          },
          "type": {
            "enum": [
              "preset",
              "custom"
            ],
            "readOnly": true,
            "title": "Type",
            "type": "string"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "required": [
          "name",
          "id",
          "created_at",
          "user_id",
          "type"
        ],
        "title": "VoiceResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceKind": {
        "enum": [
          "ivc",
          "pvc"
        ],
        "title": "VoiceKind",
        "type": "string"
      }
    }
  }
}
