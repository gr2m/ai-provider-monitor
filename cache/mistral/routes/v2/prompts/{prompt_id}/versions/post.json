            "title": "version",
            "type": "integer"
          }
        },
        "title": "CreatePromptVersionResponse",
        "type": "object"
      },
      "PromptVariable": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          }
        },
        "title": "PromptVariable",
        "type": "object"
      }
    }
