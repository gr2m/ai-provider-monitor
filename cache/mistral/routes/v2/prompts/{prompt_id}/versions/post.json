            },
            "definition": {
              "$ref": "#/components/schemas/PromptDefinition",
              "title": "definition"
            },
            "notes": {
              "description": "Notes for this version.",
              "nullable": true,
              "title": "notes",
              "type": "string"
            }
          },
          "required": [
            "definition"
          ],
          "title": "CreatePromptVersionRequest",
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
