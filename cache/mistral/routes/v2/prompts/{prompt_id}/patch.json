{
  "description": "UpdatePrompt",
  "operationId": "prompts_update",
  "parameters": [
    {
      "in": "path",
      "name": "prompt_id",
      "required": true,
      "schema": {
        "title": "prompt_id",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "description": "Display description.",
              "nullable": true,
              "title": "description",
              "type": "string"
            },
            "sharingScope": {
              "$ref": "#/components/schemas/RegistrySharingScope",
              "description": "Registry sharing scope.",
              "nullable": true,
              "title": "sharing_scope"
            },
            "title": {
              "description": "Display title.",
              "nullable": true,
              "title": "title",
              "type": "string"
            },
            "workspaceRelation": {
              "$ref": "#/components/schemas/ShareRelation",
              "description": "Access every workspace member gets when sharing_scope is `workspace`. Defaults to `writer`, which is what a workspace publish granted before this field existed, so omitting it preserves today's behaviour exactly. Rejected unless sharing_scope is `workspace`.",
              "nullable": true,
              "title": "workspace_relation"
            }
          },
          "title": "UpdatePromptRequest",
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Prompt"
          }
        }
      },
      "description": "Success"
    }
  },
  "summary": "UpdatePrompt",
  "tags": [
    "beta.prompts"
  ],
  "components": {
    "schemas": {
      "RegistrySharingScope": {
        "enum": [
          "sharing_scope_unspecified",
          "private",
          "workspace"
        ],
        "title": "RegistrySharingScope",
        "type": "string"
      },
      "ShareRelation": {
        "description": "Relation a subject holds on a shared registry object.",
        "enum": [
          "share_relation_unspecified",
          "reader",
          "writer"
        ],
        "title": "ShareRelation",
        "type": "string"
      },
      "Prompt": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "description": "Aliases pointing to this version.",
            "items": {
              "type": "string"
            },
            "title": "aliases",
            "type": "array"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Creation time.",
            "title": "created_at"
          },
          "createdBy": {
            "title": "created_by",
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/PromptDefinition",
            "title": "definition"
          },
          "description": {
            "description": "Display description.",
            "title": "description",
            "type": "string"
          },
          "id": {
            "title": "id",
            "type": "string"
          },
          "latestVersion": {
            "description": "Latest version number.",
            "example": 1,
            "format": "int32",
            "title": "latest_version",
            "type": "integer"
          },
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          },
          "notes": {
            "description": "Notes for this version.",
            "title": "notes",
            "type": "string"
          },
          "sharingScope": {
            "$ref": "#/components/schemas/RegistrySharingScope",
            "description": "Registry sharing scope.",
            "title": "sharing_scope"
          },
          "title": {
            "description": "Display title.",
            "title": "title",
            "type": "string"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Last update time.",
            "title": "updated_at"
          },
          "version": {
            "example": 1,
            "format": "int32",
            "title": "version",
            "type": "integer"
          },
          "versionCreatedAt": {
            "$ref": "#/components/schemas/Timestamp",
            "title": "version_created_at"
          }
        },
        "title": "Prompt",
        "type": "object"
      },
      "Timestamp": {
        "description": "RFC 3339 timestamp.",
        "examples": [
          "1s",
          "1.000340012s"
        ],
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "PromptDefinition": {
        "additionalProperties": false,
        "description": "Versioned prompt content.",
        "properties": {
          "content": {
            "description": "Prompt template content.",
            "title": "content",
            "type": "string"
          },
          "variables": {
            "description": "Variables used by the prompt.",
            "items": {
              "$ref": "#/components/schemas/PromptVariable"
            },
            "title": "variables",
            "type": "array"
          }
        },
        "required": [
          "content"
        ],
        "title": "PromptDefinition",
        "type": "object"
      },
      "PromptVariable": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          }
        },
        "title": "PromptVariable",
        "type": "object"
      }
    }
  }
}
