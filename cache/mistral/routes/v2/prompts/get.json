{
  "description": "ListPrompts",
  "operationId": "prompts_list",
  "parameters": [
    {
      "in": "query",
      "name": "pageSize",
      "schema": {
        "format": "int32",
        "title": "page_size",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "pageToken",
      "schema": {
        "title": "page_token",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "alias",
      "schema": {
        "title": "alias",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "fields",
      "schema": {
        "items": {
          "type": "string"
        },
        "title": "fields",
        "type": "array"
      }
    },
    {
      "description": "Defaults to created_at when omitted.",
      "in": "query",
      "name": "sort.field",
      "schema": {
        "$ref": "#/components/schemas/ListSortField",
        "description": "Defaults to created_at when omitted.",
        "title": "field"
      }
    },
    {
      "description": "Defaults to descending for timestamp fields and ascending for text fields.",
      "in": "query",
      "name": "sort.direction",
      "schema": {
        "$ref": "#/components/schemas/ListSortDirection",
        "description": "Defaults to descending for timestamp fields and ascending for text fields.",
        "title": "direction"
      }
    },
    {
      "description": "REST-friendly alias for sort.field. Supported values: created_at, last_modified_at, name, title.",
      "in": "query",
      "name": "sort_by",
      "schema": {
        "description": "REST-friendly alias for sort.field. Supported values: created_at, last_modified_at, name, title.",
        "title": "sort_by",
        "type": "string"
      }
    },
    {
      "description": "REST-friendly alias for sort.direction. Supported values: asc, desc.",
      "in": "query",
      "name": "sort_direction",
      "schema": {
        "description": "REST-friendly alias for sort.direction. Supported values: asc, desc.",
        "title": "sort_direction",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListPromptsResponse"
          }
        }
      },
      "description": "Success"
    }
  },
  "summary": "ListPrompts",
  "tags": [
    "beta.prompts"
  ],
  "components": {
    "schemas": {
      "ListSortField": {
        "enum": [
          "list_sort_field_unspecified",
          "list_sort_field_created_at",
          "list_sort_field_last_modified_at",
          "list_sort_field_name",
          "list_sort_field_title"
        ],
        "title": "ListSortField",
        "type": "string"
      },
      "ListSortDirection": {
        "enum": [
          "list_sort_direction_unspecified",
          "list_sort_direction_asc",
          "list_sort_direction_desc"
        ],
        "title": "ListSortDirection",
        "type": "string"
      },
      "ListPromptsResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Prompt"
            },
            "title": "data",
            "type": "array"
          },
          "nextPageToken": {
            "title": "next_page_token",
            "type": "string"
          }
        },
        "title": "ListPromptsResponse",
        "type": "object"
      },
      "Prompt": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "description": "Aliases pointing to this version.",
            "items": {
              "type": "string"
            },
            "title": "aliases",
            "type": "array"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Creation time.",
            "title": "created_at"
          },
          "createdBy": {
            "title": "created_by",
            "type": "string"
          },
          "definition": {
            "$ref": "#/components/schemas/PromptDefinition",
            "title": "definition"
          },
          "description": {
            "description": "Display description.",
            "title": "description",
            "type": "string"
          },
          "id": {
            "title": "id",
            "type": "string"
          },
          "latestVersion": {
            "description": "Latest version number.",
            "example": 1,
            "format": "int32",
            "title": "latest_version",
            "type": "integer"
          },
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          },
          "notes": {
            "description": "Notes for this version.",
            "title": "notes",
            "type": "string"
          },
          "sharingScope": {
            "$ref": "#/components/schemas/RegistrySharingScope",
            "description": "Registry sharing scope.",
            "title": "sharing_scope"
          },
          "title": {
            "description": "Display title.",
            "title": "title",
            "type": "string"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp",
            "description": "Last update time.",
            "title": "updated_at"
          },
          "version": {
            "example": 1,
            "format": "int32",
            "title": "version",
            "type": "integer"
          },
          "versionCreatedAt": {
            "$ref": "#/components/schemas/Timestamp",
            "title": "version_created_at"
          }
        },
        "title": "Prompt",
        "type": "object"
      },
      "Timestamp": {
        "description": "RFC 3339 timestamp.",
        "examples": [
          "1s",
          "1.000340012s"
        ],
        "format": "date-time",
        "title": "Timestamp",
        "type": "string"
      },
      "PromptDefinition": {
        "additionalProperties": false,
        "description": "Versioned prompt content.",
        "properties": {
          "content": {
            "description": "Prompt template content.",
            "title": "content",
            "type": "string"
          },
          "variables": {
            "description": "Variables used by the prompt.",
            "items": {
              "$ref": "#/components/schemas/PromptVariable"
            },
            "title": "variables",
            "type": "array"
          }
        },
        "required": [
          "content"
        ],
        "title": "PromptDefinition",
        "type": "object"
      },
      "RegistrySharingScope": {
        "enum": [
          "sharing_scope_unspecified",
          "private",
          "workspace"
        ],
        "title": "RegistrySharingScope",
        "type": "string"
      },
      "PromptVariable": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Stable object name.",
            "title": "name",
            "type": "string"
          }
        },
        "title": "PromptVariable",
        "type": "object"
      }
    }
  }
}
