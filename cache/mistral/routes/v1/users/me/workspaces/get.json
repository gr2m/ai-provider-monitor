{
  "description": "List every workspace the authenticated user is a member of, across all\ntheir organizations, each tagged with the organization it belongs to.",
  "operationId": "users_api_list_workspaces",
  "parameters": [
    {
      "description": "Return only workspaces belonging to this organization.",
      "examples": {},
      "in": "query",
      "name": "organization_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Return only workspaces belonging to this organization.",
        "examples": [
          "1a2b3c4d-5e6f-4a8b-9c0d-1e2f3a4b5c6d"
        ],
        "title": "Organization Id"
      }
    },
    {
      "description": "Number of workspaces to skip before returning results.",
      "examples": {},
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
        "default": 0,
        "description": "Number of workspaces to skip before returning results.",
        "examples": [
          0
        ],
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of workspaces to return.",
      "examples": {},
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 100,
        "description": "Maximum number of workspaces to return.",
        "examples": [
          100
        ],
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListWorkspacesResponse"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "DashboardUserContextAuth": []
    },
    {
      "BearerUserContextAuth": []
    }
  ],
  "summary": "List Workspaces",
  "tags": [
    "beta.users"
  ],
  "components": {
    "schemas": {
      "ListWorkspacesResponse": {
        "properties": {
          "workspaces": {
            "description": "The workspaces the authenticated user is a member of, each tagged with the organization it belongs to.",
            "items": {
              "$ref": "#/components/schemas/UserWorkspace"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "workspaces"
        ],
        "title": "ListWorkspacesResponse",
        "type": "object"
      },
      "UserWorkspace": {
        "properties": {
          "id": {
            "description": "The workspace's unique identifier.",
            "examples": [
              "7f8e9d0c-1b2a-4c3d-8e9f-0a1b2c3d4e5f"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "The workspace's display name.",
            "examples": [
              "production"
            ],
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "description": "The identifier of the organization this workspace belongs to.",
            "examples": [
              "1a2b3c4d-5e6f-4a8b-9c0d-1e2f3a4b5c6d"
            ],
            "title": "Organization Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "organization_id"
        ],
        "title": "UserWorkspace",
        "type": "object"
      }
    }
  }
}
