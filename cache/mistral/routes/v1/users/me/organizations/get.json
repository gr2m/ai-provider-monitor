{
  "description": "List every organization the authenticated user is a member of.\n\nIdentity-only: the caller need not have selected an organization, so this\nreads only the user and never scopes by the active org.",
  "operationId": "users_api_list_organizations",
  "parameters": [
    {
      "description": "Number of organizations to skip before returning results.",
      "examples": {},
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
        "default": 0,
        "description": "Number of organizations to skip before returning results.",
        "examples": [
          0
        ],
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of organizations to return.",
      "examples": {},
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 100,
        "description": "Maximum number of organizations to return.",
        "examples": [
          100
        ],
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListOrganizationsResponse"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "DashboardUserContextAuth": []
    },
    {
      "BearerUserContextAuth": []
    }
  ],
  "summary": "List Organizations",
  "tags": [
    "beta.users"
  ],
  "components": {
    "schemas": {
      "ListOrganizationsResponse": {
        "properties": {
          "organizations": {
            "description": "The organizations the authenticated user is a member of.",
            "items": {
              "$ref": "#/components/schemas/UserOrganization"
            },
            "title": "Organizations",
            "type": "array"
          }
        },
        "required": [
          "organizations"
        ],
        "title": "ListOrganizationsResponse",
        "type": "object"
      },
      "UserOrganization": {
        "properties": {
          "id": {
            "description": "The organization's unique identifier.",
            "examples": [
              "1a2b3c4d-5e6f-4a8b-9c0d-1e2f3a4b5c6d"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "The organization's display name.",
            "examples": [
              "Acme Corp"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "UserOrganization",
        "type": "object"
      }
    }
  }
}
