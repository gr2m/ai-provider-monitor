      "ScalarStatisticValue": {
        "description": "A single scalar computed run-level statistic: its canonical id and numeric value.\n\n``value`` is ``None`` when the statistic is not evaluable (e.g. a ``sum`` or percentile over an\nempty numeric sample). A declared ``count`` is always evaluable and is ``0`` on an empty sample.\n\nThe ``type`` discriminator lets future result shapes (e.g. a categorical ``categories`` or a\n``distribution``) join a union without overloading this model; consumers dispatch on ``type``.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "type": {
            "const": "scalar",
            "default": "scalar",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
