            "title": "Value"
          }
        },
        "required": [
          "id"
        ],
        "title": "ScalarStatisticValue",
        "type": "object"
      },
      "ConfusionMatrix": {
        "description": "A confusion matrix over ``(expected, predicted)`` label pairs.\n\n``matrix[i][j]`` is the number of samples whose expected label is ``labels[i]`` and predicted\nlabel is ``labels[j]``. It is the complete, aggregatable representation: precision/recall/f1 for\nany class derive from it, and matrices from several runs merge by element-wise sum.",
        "properties": {
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "matrix": {
            "items": {
