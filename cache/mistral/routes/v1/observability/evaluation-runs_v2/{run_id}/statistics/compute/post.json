      "ScalarStatisticValue": {
        "description": "A single scalar computed run-level statistic: its canonical id and numeric value.\n\n``value`` is ``None`` when the statistic is not evaluable (e.g. a ``sum`` or percentile over an\nempty numeric sample). A declared ``count`` is always evaluable and is ``0`` on an empty sample.\n\nThe ``type`` discriminator lets future result shapes (e.g. a categorical ``categories`` or a\n``distribution``) join a union without overloading this model; consumers dispatch on ``type``.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "type": {
            "const": "scalar",
            "default": "scalar",
            "title": "Type",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "id"
        ],
        "title": "ScalarStatisticValue",
        "type": "object"
      },
      "ConfusionMatrix": {
        "description": "A confusion matrix over ``(expected, predicted)`` label pairs.\n\n``matrix[i][j]`` is the number of samples whose expected label is ``labels[i]`` and predicted\nlabel is ``labels[j]``. It is the complete, aggregatable representation: precision/recall/f1 for\nany class derive from it, and matrices from several runs merge by element-wise sum.",
        "properties": {
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "matrix": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "title": "Matrix",
            "type": "array"
          }
        },
        "required": [
          "labels",
          "matrix"
        ],
        "title": "ConfusionMatrix",
        "type": "object"
