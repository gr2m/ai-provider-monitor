{
  "description": "Search pipeline results",
  "operationId": "search_pipeline_results_v1_observability_pipeline_results_search_post",
  "parameters": [
    {
      "in": "query",
      "name": "from",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "From"
      }
    },
    {
      "in": "query",
      "name": "to",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "To"
      }
    },
    {
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 50,
        "maximum": 100,
        "minimum": 0,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Cursor"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/PipelineResultsRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/GetPipelineResults"
          }
        }
      },
      "description": "Successful Response"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Bad Request - Invalid request parameters or data"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Not Found - Resource does not exist"
    },
    "408": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Request Timeout - Operation timed out"
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Conflict - Resource conflict"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Unprocessable Entity - Validation error"
    }
  },
  "summary": "Search pipeline results",
  "tags": [
    "beta.observability.spans"
  ],
  "components": {
    "schemas": {
      "PipelineResultsRequest": {
        "properties": {
          "pipeline_config_slugs": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Pipeline Config Slugs",
            "type": "array"
          },
          "search_expression": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Expression"
          }
        },
        "required": [
          "pipeline_config_slugs"
        ],
        "title": "PipelineResultsRequest",
        "type": "object"
      },
      "GetPipelineResults": {
        "properties": {
          "pipeline_results": {
            "$ref": "#/components/schemas/FeedResultGetPipelineResult"
          }
        },
        "required": [
          "pipeline_results"
        ],
        "title": "GetPipelineResults",
        "type": "object"
      },
      "ObservabilityError": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ObservabilityErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ObservabilityError",
        "type": "object"
      },
      "FeedResultGetPipelineResult": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cursor"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/PipelineResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "title": "FeedResultGetPipelineResult",
        "type": "object"
      },
      "ObservabilityErrorDetail": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ObservabilityErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message",
          "error_code"
        ],
        "title": "ObservabilityErrorDetail",
        "type": "object"
      },
      "PipelineResult": {
        "properties": {
          "duration_ns": {
            "title": "Duration Ns",
            "type": "integer"
          },
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "judge_explanations": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Judge Explanations",
            "type": "object"
          },
          "judge_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Judge Labels",
            "type": "object"
          },
          "judge_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Judge Scores",
            "type": "object"
          },
          "span_id": {
            "pattern": "^[0-9a-f]{16}$",
            "title": "Span Id",
            "type": "string"
          },
          "span_name": {
            "title": "Span Name",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "span_id",
          "span_name",
          "duration_ns",
          "evaluated_at",
          "judge_scores",
          "judge_labels",
          "judge_explanations"
        ],
        "title": "PipelineResult",
        "type": "object"
      },
      "ObservabilityErrorCode": {
        "enum": [
          "UNKNOWN_ERROR",
          "VALIDATION_ERROR",
          "AUTH_FORBIDDEN",
          "AUTH_FORBIDDEN_NOT_WORKSPACE_ADMIN",
          "AUTH_FORBIDDEN_WORKSPACE_NOT_FOUND",
          "AUTH_FORBIDDEN_ROLE_NOT_FOUND",
          "AUTH_UNAUTHORIZED",
          "FEATURE_NOT_SUPPORTED",
          "FIELDS_BAD_REQUEST",
          "SEARCH_BAD_REQUEST",
          "DATABASE_ERROR",
          "DATABASE_TIMEOUT",
          "DATABASE_UNAVAILABLE",
          "DATABASE_QUERY_ERROR",
          "SEARCH_FILTER_TO_SQL_CONVERSION_ERROR",
          "JUDGE_CONVERSATION_FORMAT_ERROR",
          "JUDGE_MISTRAL_API_ERROR",
          "JUDGE_MISTRAL_API_TIMEOUT",
          "JUDGE_NAME_ALREADY_EXISTS",
          "JUDGE_NOT_FOUND",
          "JUDGE_DID_NOT_CHANGE",
          "DATASET_NOT_FOUND",
          "DATASET_TASK_NOT_FOUND",
          "DATASET_RECORD_NOT_FOUND",
          "DATASET_RECORD_FORMAT_ERROR",
          "AGENT_NOT_FOUND",
          "AGENT_MISTRAL_API_ERROR",
          "EVALUATION_NOT_FOUND",
          "EVALUATION_CURRENTLY_RUNNING",
          "EVALUATION_RECORD_NOT_FOUND",
          "EVALUATION_RUN_NOT_FOUND",
          "EVALUATION_RUN_TRANSITION_IS_INVALID",
          "EVALUATION_RUN_TRANSITION_IS_RUNNING_ALREADY",
          "EVALUATION_RUN_TRANSITION_ERROR",
          "EVALUATION_RUN_OUTPUT_RECORD_CONFLICT",
          "TEMPLATE_ERROR",
          "TEMPLATE_SYNTAX_ERROR",
          "PROJECT_NOT_FOUND",
          "PROJECT_NAME_ALREADY_EXISTS",
          "PIPELINE_CONFIG_NOT_FOUND",
          "PIPELINE_CONFIG_ALREADY_EXISTS",
          "PIPELINE_NOT_FOUND",
          "PIPELINE_ALREADY_EXISTS",
          "SCORER_NOT_FOUND",
          "SCORER_ALREADY_EXISTS",
          "SCORER_CONFIG_KIND_MISMATCH",
          "EVALUATION_NAME_ALREADY_EXISTS",
          "OPTIMIZATION_NOT_FOUND",
          "OPTIMIZATION_TRIAL_KEY_ALREADY_EXISTS",
          "OPTIMIZATION_TRIAL_OBSERVATION_ALREADY_EXISTS",
          "TRACES_FILTER_QUERY_PARSE_ERROR",
          "TRACE_NOT_FOUND",
          "SPAN_NOT_FOUND"
        ],
        "title": "ObservabilityErrorCode",
        "type": "string"
      }
    }
  }
}
