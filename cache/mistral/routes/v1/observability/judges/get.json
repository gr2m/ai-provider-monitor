{
  "description": "Get judges with optional filtering and search",
  "operationId": "get_judges_v1_observability_judges_get",
  "parameters": [
    {
      "description": "Filter by judge output types",
      "in": "query",
      "name": "type_filter",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/components/schemas/JudgeOutputType"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by judge output types",
        "title": "Type Filter"
      }
    },
    {
      "description": "Filter by model names",
      "in": "query",
      "name": "model_filter",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by model names",
        "title": "Model Filter"
      }
    },
    {
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 50,
        "maximum": 100,
        "minimum": 0,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "default": 1,
        "minimum": 1,
        "title": "Page",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "q",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Q"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListJudgesResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Bad Request - Invalid request parameters or data"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Not Found - Resource does not exist"
    },
    "408": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Request Timeout - Operation timed out"
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Conflict - Resource conflict"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ObservabilityError"
          }
        }
      },
      "description": "Unprocessable Entity - Validation error"
    }
  },
  "summary": "Get judges with optional filtering and search",
  "tags": [
    "beta.observability.judges"
  ],
  "components": {
    "schemas": {
      "JudgeOutputType": {
        "enum": [
          "REGRESSION",
          "CLASSIFICATION"
        ],
        "title": "JudgeOutputType",
        "type": "string"
      },
      "ListJudgesResponse": {
        "properties": {
          "judges": {
            "$ref": "#/components/schemas/PaginatedResultJudgePreview"
          }
        },
        "required": [
          "judges"
        ],
        "title": "ListJudgesResponse",
        "type": "object"
      },
      "ObservabilityError": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ObservabilityErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ObservabilityError",
        "type": "object"
      },
      "PaginatedResultJudgePreview": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          },
          "previous": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Judge"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "count"
        ],
        "title": "PaginatedResultJudgePreview",
        "type": "object"
      },
      "ObservabilityErrorDetail": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ObservabilityErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message",
          "error_code"
        ],
        "title": "ObservabilityErrorDetail",
        "type": "object"
      },
      "Judge": {
        "properties": {
          "base_revision": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Revision"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deleted At"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "down_revision": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Down Revision"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output": {
            "discriminator": {
              "mapping": {
                "CLASSIFICATION": "#/components/schemas/JudgeClassificationOutput",
                "REGRESSION": "#/components/schemas/JudgeRegressionOutput"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/JudgeClassificationOutput"
              },
              {
                "$ref": "#/components/schemas/JudgeRegressionOutput"
              }
            ],
            "title": "Output"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          },
          "up_revision": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Up Revision"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at",
          "deleted_at",
          "owner_id",
          "workspace_id",
          "name",
          "description",
          "model_name",
          "output",
          "instructions",
          "tools"
        ],
        "title": "Judge",
        "type": "object"
      },
      "ObservabilityErrorCode": {
        "enum": [
          "UNKNOWN_ERROR",
          "VALIDATION_ERROR",
          "AUTH_FORBIDDEN",
          "AUTH_FORBIDDEN_NOT_WORKSPACE_ADMIN",
          "AUTH_FORBIDDEN_WORKSPACE_NOT_FOUND",
          "AUTH_FORBIDDEN_ROLE_NOT_FOUND",
          "AUTH_UNAUTHORIZED",
          "FEATURE_NOT_SUPPORTED",
          "FIELDS_BAD_REQUEST",
          "SEARCH_BAD_REQUEST",
          "DATABASE_ERROR",
          "DATABASE_TIMEOUT",
          "DATABASE_UNAVAILABLE",
          "DATABASE_QUERY_ERROR",
          "SEARCH_FILTER_TO_SQL_CONVERSION_ERROR",
          "JUDGE_CONVERSATION_FORMAT_ERROR",
          "JUDGE_MISTRAL_API_ERROR",
          "JUDGE_MISTRAL_API_TIMEOUT",
          "JUDGE_NAME_ALREADY_EXISTS",
          "JUDGE_NOT_FOUND",
          "JUDGE_DID_NOT_CHANGE",
          "DATASET_NOT_FOUND",
          "DATASET_TASK_NOT_FOUND",
          "DATASET_RECORD_NOT_FOUND",
          "DATASET_RECORD_FORMAT_ERROR",
          "AGENT_NOT_FOUND",
          "AGENT_MISTRAL_API_ERROR",
          "EVALUATION_NOT_FOUND",
          "EVALUATION_CURRENTLY_RUNNING",
          "EVALUATION_RECORD_NOT_FOUND",
          "EVALUATION_RUN_NOT_FOUND",
          "EVALUATION_RUN_TRANSITION_IS_INVALID",
          "EVALUATION_RUN_TRANSITION_IS_RUNNING_ALREADY",
          "EVALUATION_RUN_TRANSITION_ERROR",
          "EVALUATION_RUN_OUTPUT_RECORD_CONFLICT",
          "TEMPLATE_ERROR",
          "TEMPLATE_SYNTAX_ERROR",
          "PROJECT_NOT_FOUND",
          "PROJECT_NAME_ALREADY_EXISTS",
          "PIPELINE_CONFIG_NOT_FOUND",
          "PIPELINE_CONFIG_ALREADY_EXISTS",
          "PIPELINE_NOT_FOUND",
          "PIPELINE_ALREADY_EXISTS",
          "SCORER_NOT_FOUND",
          "SCORER_ALREADY_EXISTS",
          "SCORER_CONFIG_KIND_MISMATCH",
          "EVALUATION_NAME_ALREADY_EXISTS",
          "OPTIMIZATION_NOT_FOUND",
          "OPTIMIZATION_TRIAL_KEY_ALREADY_EXISTS",
          "TRACES_FILTER_QUERY_PARSE_ERROR",
          "TRACE_NOT_FOUND",
          "SPAN_NOT_FOUND"
        ],
        "title": "ObservabilityErrorCode",
        "type": "string"
      },
      "JudgeClassificationOutput": {
        "properties": {
          "options": {
            "items": {
              "$ref": "#/components/schemas/JudgeClassificationOutputOption"
            },
            "title": "Options",
            "type": "array"
          },
          "type": {
            "const": "CLASSIFICATION",
            "default": "CLASSIFICATION",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "options"
        ],
        "title": "JudgeClassificationOutput",
        "type": "object"
      },
      "JudgeRegressionOutput": {
        "properties": {
          "max": {
            "default": 1,
            "exclusiveMaximum": 1000000000,
            "title": "Max",
            "type": "number"
          },
          "max_description": {
            "title": "Max Description",
            "type": "string"
          },
          "min": {
            "default": 0,
            "minimum": 0,
            "title": "Min",
            "type": "number"
          },
          "min_description": {
            "title": "Min Description",
            "type": "string"
          },
          "type": {
            "const": "REGRESSION",
            "default": "REGRESSION",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "min_description",
          "max_description"
        ],
        "title": "JudgeRegressionOutput",
        "type": "object"
      },
      "JudgeClassificationOutputOption": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value",
          "description"
        ],
        "title": "JudgeClassificationOutputOption",
        "type": "object"
      }
    }
  }
}
