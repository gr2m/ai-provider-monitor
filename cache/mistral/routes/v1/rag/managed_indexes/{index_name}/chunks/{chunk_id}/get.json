      "in": "path",
      "name": "index_name",
      "required": true,
      "schema": {
        "title": "Index Name",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "chunk_id",
      "required": true,
      "schema": {
        "title": "Chunk Id",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
