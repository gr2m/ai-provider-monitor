          "schema": {
            "$ref": "#/components/schemas/NavigationResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "404": {
      "description": "Index not found, or source/chunk does not exist in the index"
    },
    "409": {
      "description": "Index is not ready for search"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    },
    "500": {
      "description": "Navigation query failed during execution"
    }
  },
