                  "max_candidates_too_small": "#/components/schemas/MaxCandidatesTooSmallResponse",
                  "missing_embedding": "#/components/schemas/MissingEmbeddingResponse",
                  "missing_field": "#/components/schemas/MissingFieldResponse",
                  "top_k_too_large": "#/components/schemas/TopKTooLargeResponse"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/MissingFieldResponse"
                },
                {
                  "$ref": "#/components/schemas/MissingEmbeddingResponse"
                },
                {
                  "$ref": "#/components/schemas/IncorrectFieldTypeResponse"
                },
                {
                  "$ref": "#/components/schemas/EmbeddingMismatchResponse"
                },
                {
                  "$ref": "#/components/schemas/MaxCandidatesTooSmallResponse"
                },
                {
                  "$ref": "#/components/schemas/TopKTooLargeResponse"
                }
              ]
            },
            "title": "Response 400 Search Index V1 Rag Managed Indexes  Index Name  Search Post",
            "type": "array"
          }
        }
      },
      "description": "Invalid search query"
    },
    "404": {
      "description": "Index not found"
    },
    "409": {
      "description": "Index is not ready for search"
    },
    "422": {
      "content": {
        "application/json": {
