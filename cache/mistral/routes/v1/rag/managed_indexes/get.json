{
  "description": "Lists all managed search indexes for the current workspace.",
  "operationId": "list_indexes_v1_rag_managed_indexes_get",
  "parameters": [
    {
      "description": "Maximum number of indexes to return",
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 20,
        "description": "Maximum number of indexes to return",
        "maximum": 100,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Cursor returned as next_page_token by the previous page",
      "in": "query",
      "name": "page_token",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Cursor returned as next_page_token by the previous page",
        "title": "Page Token"
      }
    },
    {
      "description": "Case-insensitive substring to match against index names",
      "in": "query",
      "name": "name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Case-insensitive substring to match against index names",
        "title": "Name"
      }
    },
    {
      "description": "Status to match",
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ManagedIndexStatus"
          },
          {
            "type": "null"
          }
        ],
        "description": "Status to match",
        "title": "Status"
      }
    },
    {
      "description": "Creator ID to match",
      "in": "query",
      "name": "creator_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Creator ID to match",
        "title": "Creator Id"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListManagedIndexesResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
