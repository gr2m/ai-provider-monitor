{
  "description": "List all credentials configured at the workspace level for a given connector.",
  "operationId": "connector_list_workspace_credentials_v1",
  "parameters": [
    {
      "in": "query",
      "name": "auth_type",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/OutboundAuthenticationType"
          },
          {
            "type": "null"
          }
        ],
        "title": "Auth Type"
      }
    },
    {
      "in": "query",
      "name": "fetch_default",
      "required": false,
      "schema": {
        "default": false,
        "title": "Fetch Default",
        "type": "boolean"
      }
    },
    {
      "in": "path",
      "name": "connector_id_or_name",
      "required": true,
      "schema": {
        "title": "Connector Id Or Name",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/CredentialsResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "List workspace credentials for a connector.",
  "tags": [
    "beta.connectors"
  ],
  "components": {
    "schemas": {
      "OutboundAuthenticationType": {
        "enum": [
          "oauth2",
          "bearer",
          "none"
        ],
        "title": "OutboundAuthenticationType",
        "type": "string"
      },
      "CredentialsResponse": {
        "properties": {
          "connector_preset_credentials_for_auth": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/OutboundAuthenticationType"
            },
            "title": "Connector Preset Credentials For Auth",
            "type": "array"
          },
          "credentials": {
            "items": {
              "$ref": "#/components/schemas/AuthenticationConfiguration"
            },
            "title": "Credentials",
            "type": "array"
          }
        },
        "required": [
          "credentials"
        ],
        "title": "CredentialsResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "AuthenticationConfiguration": {
        "properties": {
          "authentication_type": {
            "$ref": "#/components/schemas/OutboundAuthenticationType"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "authentication_type"
        ],
        "title": "AuthenticationConfiguration",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
