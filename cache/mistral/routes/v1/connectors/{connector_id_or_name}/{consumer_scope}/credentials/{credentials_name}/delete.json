{
  "description": "Delete connector credentials for a given consumer.",
  "operationId": "connector_delete_credentials",
  "parameters": [
    {
      "in": "path",
      "name": "credentials_name",
      "required": true,
      "schema": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$",
        "title": "Credentials Name",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "connector_id_or_name",
      "required": true,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "title": "Connector Id Or Name"
      }
    },
    {
      "in": "path",
      "name": "consumer_scope",
      "required": true,
      "schema": {
        "enum": [
          "user",
          "workspace",
          "organization"
        ],
        "title": "Consumer Scope",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MessageResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Delete credentials for a consumer.",
  "tags": [
    "beta.connectors"
  ],
  "components": {
    "schemas": {
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
