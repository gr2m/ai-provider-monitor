{
  "description": "Create consumer credentials for a given connector and consumer scope (organization, workspace, user)",
  "operationId": "connector_create_credentials_v1",
  "parameters": [
    {
      "in": "path",
      "name": "connector_id_or_name",
      "required": true,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "title": "Connector Id Or Name"
      }
    },
    {
      "in": "path",
      "name": "consumer_scope",
      "required": true,
      "schema": {
        "enum": [
          "user",
          "workspace",
          "organization"
        ],
        "title": "Consumer Scope",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CredentialsCreateOrUpdate"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MessageResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Create consumer credentials for a connector.",
  "tags": [
    "beta.connectors"
  ],
  "components": {
    "schemas": {
      "CredentialsCreateOrUpdate": {
        "description": "Request to create or update credentials for a connector.",
        "properties": {
          "credentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionCredentialsInput"
              },
              {
                "type": "null"
              }
            ],
            "description": "The credential data (headers, bearer_token, or OAuth2 client credentials)."
          },
          "is_default": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Controls whether this credential is the default for its auth method. On creation: if no credential exists yet for this auth method, the credential is automatically set as default when is_default is true or omitted; setting is_default to false is rejected because a default must exist. If other credentials already exist, setting is_default to true promotes this credential (demoting the previous default); false or omitted creates it as non-default. On update: true promotes this credential, false is rejected if it is currently the default (promote another credential first), omitted leaves the default status unchanged.",
            "title": "Is Default"
          },
          "name": {
            "description": "Name of the credentials. Use this name to access or modify your credentials.",
            "title": "Name",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-readable title for the credentials.",
            "title": "Title"
          }
        },
        "required": [
          "name"
        ],
        "title": "CredentialsCreateOrUpdate",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ConnectionCredentialsInput": {
        "additionalProperties": false,
        "properties": {
          "bearer_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bearer Token"
          },
          "headers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headers"
          },
          "oauth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OAuth2ClientCredentialsInput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ConnectionCredentialsInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "OAuth2ClientCredentialsInput": {
        "additionalProperties": false,
        "properties": {
          "client_certificate": {
            "anyOf": [
              {
                "maxLength": 16384,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "PEM X.509 certificate registered on the OAuth2 client, for private_key_jwt.",
            "title": "Client Certificate"
          },
          "client_id": {
            "maxLength": 8192,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "client_private_key": {
            "anyOf": [
              {
                "format": "password",
                "maxLength": 16384,
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "description": "Unencrypted PEM RSA private key matching client_certificate, for private_key_jwt.",
            "title": "Client Private Key"
          },
          "client_secret": {
            "anyOf": [
              {
                "format": "password",
                "maxLength": 8192,
                "minLength": 1,
                "type": "string",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Secret"
          },
          "grant_type": {
            "const": "client_credentials",
            "title": "Grant Type",
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "client_id"
        ],
        "title": "OAuth2ClientCredentialsInput",
        "type": "object"
      }
    }
  }
}
