{
  "description": "Get the OAuth2 authorization URL for a connector to initiate user authentication.",
  "operationId": "connector_get_auth_url_v1",
  "parameters": [
    {
      "in": "path",
      "name": "connector_id_or_name",
      "required": true,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "title": "Connector Id Or Name"
      }
    },
    {
      "in": "query",
      "name": "app_return_url",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "App Return Url"
      }
    },
    {
      "description": "Auth method type to use for the authorization URL. Required when the connector supports multiple interactive auth methods; otherwise the sole method is selected automatically. Use this to pick a specific method (e.g. 'oauth2' vs 'github_app').",
      "in": "query",
      "name": "method_type",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/AuthenticationType",
        "default": "oauth2",
        "description": "Auth method type to use for the authorization URL. Required when the connector supports multiple interactive auth methods; otherwise the sole method is selected automatically. Use this to pick a specific method (e.g. 'oauth2' vs 'github_app')."
      }
    },
    {
      "in": "query",
      "name": "credentials_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Credentials Name"
      }
    },
    {
      "in": "query",
      "name": "credentials_title",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "maxLength": 255,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Credentials Title"
      }
    },
    {
      "description": "Only valid with method_type=oauth2. When true, returns a GitHub App installation URL (https://github.com/apps/<slug>/installations/new) if the connector has the proper configuration The Github application needs to have 'Request user authorization (OAuth) during installation' enabled to perform the proper auth loop.",
      "in": "query",
      "name": "github_installation_link",
      "required": false,
      "schema": {
        "default": false,
        "description": "Only valid with method_type=oauth2. When true, returns a GitHub App installation URL (https://github.com/apps/<slug>/installations/new) if the connector has the proper configuration The Github application needs to have 'Request user authorization (OAuth) during installation' enabled to perform the proper auth loop.",
        "title": "Github Installation Link",
        "type": "boolean"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AuthUrlResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Get the auth URL for a connector.",
  "tags": [
    "beta.connectors"
  ],
  "components": {
    "schemas": {
      "AuthenticationType": {
        "enum": [
          "oauth2",
          "bearer",
          "none",
          "github_app",
          "slack_app"
        ],
        "title": "AuthenticationType",
        "type": "string"
      },
      "AuthUrlResponse": {
        "properties": {
          "auth_url": {
            "title": "Auth Url",
            "type": "string"
          },
          "ttl": {
            "title": "Ttl",
            "type": "integer"
          }
        },
        "required": [
          "auth_url",
          "ttl"
        ],
        "title": "AuthUrlResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
