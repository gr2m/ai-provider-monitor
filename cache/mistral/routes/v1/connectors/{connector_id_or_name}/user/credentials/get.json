{
  "description": "List all credentials configured at the user level for a given connector.",
  "operationId": "connector_list_user_credentials_v1",
  "parameters": [
    {
      "in": "path",
      "name": "connector_id_or_name",
      "required": true,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "title": "Connector Id Or Name"
      }
    },
    {
      "in": "query",
      "name": "auth_type",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AuthenticationType"
          },
          {
            "type": "null"
          }
        ],
        "title": "Auth Type"
      }
    },
    {
      "in": "query",
      "name": "fetch_default",
      "required": false,
      "schema": {
        "default": false,
        "title": "Fetch Default",
        "type": "boolean"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/CredentialsResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "List user credentials for a connector.",
  "tags": [
    "beta.connectors"
  ],
  "components": {
    "schemas": {
      "AuthenticationType": {
        "enum": [
          "oauth2",
          "bearer",
          "none",
          "github_app",
          "slack_app"
        ],
        "title": "AuthenticationType",
        "type": "string"
      },
      "CredentialsResponse": {
        "properties": {
          "connector_preset_credentials_for_auth": {
            "default": [],
            "deprecated": true,
            "items": {
              "$ref": "#/components/schemas/AuthenticationType"
            },
            "title": "Connector Preset Credentials For Auth",
            "type": "array"
          },
          "credentials": {
            "items": {
              "$ref": "#/components/schemas/AuthenticationConfiguration"
            },
            "title": "Credentials",
            "type": "array"
          }
        },
        "required": [
          "credentials"
        ],
        "title": "CredentialsResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "AuthenticationConfiguration": {
        "properties": {
          "authentication_type": {
            "$ref": "#/components/schemas/AuthenticationType"
          },
          "creator_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creator Id"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/ConsumerType"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CredentialsStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "name",
          "authentication_type",
          "scope"
        ],
        "title": "AuthenticationConfiguration",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ConsumerType": {
        "enum": [
          "user",
          "org",
          "workspace",
          "system"
        ],
        "title": "ConsumerType",
        "type": "string"
      },
      "CredentialsStatus": {
        "properties": {
          "error_http_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HTTPStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CredentialsStatusErrorReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Checked At"
          },
          "status_type": {
            "$ref": "#/components/schemas/AuthStatus"
          }
        },
        "required": [
          "status_type"
        ],
        "title": "CredentialsStatus",
        "type": "object"
      },
      "HTTPStatus": {
        "description": "HTTP status codes and reason phrases\n\nStatus codes from the following RFCs are all observed:\n\n    * RFC 7231: Hypertext Transfer Protocol (HTTP/1.1), obsoletes 2616\n    * RFC 6585: Additional HTTP Status Codes\n    * RFC 3229: Delta encoding in HTTP\n    * RFC 4918: HTTP Extensions for WebDAV, obsoletes 2518\n    * RFC 5842: Binding Extensions to WebDAV\n    * RFC 7238: Permanent Redirect\n    * RFC 2295: Transparent Content Negotiation in HTTP\n    * RFC 2774: An HTTP Extension Framework\n    * RFC 7725: An HTTP Status Code to Report Legal Obstacles\n    * RFC 7540: Hypertext Transfer Protocol Version 2 (HTTP/2)\n    * RFC 2324: Hyper Text Coffee Pot Control Protocol (HTCPCP/1.0)\n    * RFC 8297: An HTTP Status Code for Indicating Hints\n    * RFC 8470: Using Early Data in HTTP",
        "enum": [
          100,
          101,
          102,
          103,
          200,
          201,
          202,
          203,
          204,
          205,
          206,
          207,
          208,
          226,
          300,
          301,
          302,
          303,
          304,
          305,
          307,
          308,
          400,
          401,
          402,
          403,
          404,
          405,
          406,
          407,
          408,
          409,
          410,
          411,
          412,
          413,
          414,
          415,
          416,
          417,
          418,
          421,
          422,
          423,
          424,
          425,
          426,
          428,
          429,
          431,
          451,
          500,
          501,
          502,
          503,
          504,
          505,
          506,
          507,
          508,
          510,
          511
        ],
        "title": "HTTPStatus",
        "type": "integer"
      },
      "CredentialsStatusErrorReason": {
        "enum": [
          "oauth expired",
          "oauth near expiry",
          "empty credentials",
          "blank bearer token",
          "unparsable credentials",
          "you need to reconnect",
          "oauth refresh error",
          "MCP server unreachable",
          "MCP server timed out",
          "MCP server error",
          "unknown error"
        ],
        "title": "CredentialsStatusErrorReason",
        "type": "string"
      },
      "AuthStatus": {
        "enum": [
          "valid",
          "invalid",
          "error"
        ],
        "title": "AuthStatus",
        "type": "string"
      }
    }
  }
}
