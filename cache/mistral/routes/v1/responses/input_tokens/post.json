  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CountResponseInputTokensRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/CountResponseInputTokensResponse"
          }
        }
      },
      "description": "Successful Response"
    }
  },
  "summary": "Count Input Tokens",
  "tags": [
    "responses"
  ],
