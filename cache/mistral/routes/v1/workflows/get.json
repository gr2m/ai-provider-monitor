{
  "description": "Get Workflows",
  "operationId": "get_workflows_v1_workflows_get",
  "parameters": [
    {
      "description": "Filter by workflow status",
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/WorkflowExecutionStatus"
          },
          {
            "items": {
              "$ref": "#/components/schemas/WorkflowExecutionStatus"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by workflow status",
        "title": "Status"
      }
    },
    {
      "description": "Whether to include shared workflows",
      "in": "query",
      "name": "include_shared",
      "required": false,
      "schema": {
        "default": true,
        "description": "Whether to include shared workflows",
        "title": "Include Shared",
        "type": "boolean"
      }
    },
    {
      "description": "Whether to only return workflows available in chat assistant",
      "in": "query",
      "name": "available_in_chat_assistant",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "description": "Whether to only return workflows available in chat assistant",
        "title": "Available In Chat Assistant"
      }
    },
    {
      "description": "Filter by deployment name(s)",
      "in": "query",
      "name": "deployment_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by deployment name(s)",
        "title": "Deployment Name"
      }
    },
    {
      "description": "Filter by deployment activity. active=only active, inactive=only inactive, None=no filter",
      "in": "query",
      "name": "deployment_status",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by deployment activity. active=only active, inactive=only inactive, None=no filter",
        "title": "Deployment Status"
      }
    },
    {
      "description": "Filter by archived state. False=exclude archived, True=only archived, None=include all",
      "in": "query",
      "name": "archived",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by archived state. False=exclude archived, True=only archived, None=include all",
        "title": "Archived"
      }
    },
    {
      "description": "Filter to workflows tagged with all listed tags (AND).",
      "in": "query",
      "name": "tags",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter to workflows tagged with all listed tags (AND).",
        "title": "Tags"
      }
    },
    {
      "description": "Field to sort by",
      "in": "query",
      "name": "sort_by",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "const": "display_name",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Field to sort by",
        "title": "Sort By"
      }
    },
    {
      "description": "Sort direction",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "asc",
        "description": "Sort direction",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order",
        "type": "string"
      }
    },
    {
      "description": "The cursor for pagination",
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The cursor for pagination",
        "title": "Cursor"
      }
    },
    {
      "description": "The maximum number of workflows to return",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 50,
        "description": "The maximum number of workflows to return",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "deprecated": true,
      "description": "Deprecated: use deployment_status instead",
      "in": "query",
      "name": "active_only",
      "required": false,
      "schema": {
        "default": false,
        "deprecated": true,
        "description": "Deprecated: use deployment_status instead",
        "title": "Active Only",
        "type": "boolean"
      }
    },
    {
      "description": "Fuzzy search query for workflow name, display name, description, or ID",
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Fuzzy search query for workflow name, display name, description, or ID",
        "title": "Search"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkflowListResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Get Workflows",
  "tags": [
    "workflows"
  ],
  "components": {
    "schemas": {
      "WorkflowExecutionStatus": {
        "enum": [
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELED",
          "TERMINATED",
          "CONTINUED_AS_NEW",
          "TIMED_OUT",
          "RETRYING_AFTER_ERROR"
        ],
        "title": "WorkflowExecutionStatus",
        "type": "string"
      },
      "WorkflowListResponse": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "workflows": {
            "description": "A list of workflows",
            "items": {
              "$ref": "#/components/schemas/WorkflowBasicDefinition"
            },
            "title": "Workflows",
            "type": "array"
          }
        },
        "required": [
          "workflows",
          "next_cursor"
        ],
        "title": "WorkflowListResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "WorkflowBasicDefinition": {
        "properties": {
          "archived": {
            "description": "Whether the workflow is archived",
            "title": "Archived",
            "type": "boolean"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A description of the workflow",
            "title": "Description"
          },
          "display_name": {
            "description": "The display name of the workflow",
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/WorkflowMetadata",
            "description": "Workflow metadata"
          },
          "name": {
            "description": "The name of the workflow",
            "title": "Name",
            "type": "string"
          },
          "tags": {
            "description": "Workflow tags",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "display_name",
          "archived"
        ],
        "title": "WorkflowBasicDefinition",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowMetadata": {
        "properties": {
          "shared_namespace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Namespace for shared workflows, None if user-owned",
            "title": "Shared Namespace"
          }
        },
        "title": "WorkflowMetadata",
        "type": "object"
      }
    }
  }
}
