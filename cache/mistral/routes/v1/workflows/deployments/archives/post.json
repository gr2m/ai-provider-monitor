{
  "description": "Create an empty archive, with a signed URL to upload the tarball a managed deployment builds from.\n\nPUT the gzipped tar to `upload_url` with `upload_headers`, then pass `archive_id` in the spec on create or update.",
  "operationId": "create_deployment_archive_v1_workflows_deployments_archives_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateDeploymentArchiveRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "201": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeploymentArchiveUploadResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Create Deployment Archive",
  "tags": [
    "workflows.deployments"
  ],
  "components": {
    "schemas": {
      "CreateDeploymentArchiveRequest": {
        "description": "The size of the gzipped tar a managed deployment will build from.",
        "properties": {
          "size": {
            "description": "Size of the gzipped tar in bytes, at most 256 MiB. The upload URL accepts exactly this size.",
            "exclusiveMinimum": 0,
            "maximum": 268435456,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "size"
        ],
        "title": "CreateDeploymentArchiveRequest",
        "type": "object"
      },
      "DeploymentArchiveUploadResponse": {
        "description": "An empty archive, and where to upload the tarball a managed deployment then builds from.",
        "properties": {
          "archive_id": {
            "description": "Pass it as the spec's `archive_id` once the upload has finished.",
            "format": "uuid",
            "title": "Archive Id",
            "type": "string"
          },
          "upload_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Headers the PUT must send for the signed URL to accept it.",
            "title": "Upload Headers",
            "type": "object"
          },
          "upload_url": {
            "description": "A signed URL to PUT the tarball to. It grants write access, so keep it secret.",
            "title": "Upload Url",
            "type": "string"
          }
        },
        "required": [
          "archive_id",
          "upload_url",
          "upload_headers"
        ],
        "title": "DeploymentArchiveUploadResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
