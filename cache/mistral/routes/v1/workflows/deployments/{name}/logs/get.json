{
  "description": "Retrieve logs for a deployment (across all of its workers).\n\nUse `after`/`before`/`order` on the first request to set the time range and sort order; for\nthe next pages pass the `cursor` from the previous response (it remembers the range and order).\n\n`log_type=build` serves the managed build pipeline's output instead. It pages the same way,\nand a null `next_cursor` means the window is drained.",
  "operationId": "get_deployment_logs",
  "parameters": [
    {
      "in": "path",
      "name": "name",
      "required": true,
      "schema": {
        "title": "Name",
        "type": "string"
      }
    },
    {
      "description": "Which stream to read. 'runtime' is the workers' own logs; 'build' reads the image build output and requires a managed deployment.",
      "in": "query",
      "name": "log_type",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/DeploymentLogType",
        "default": "runtime",
        "description": "Which stream to read. 'runtime' is the workers' own logs; 'build' reads the image build output and requires a managed deployment."
      }
    },
    {
      "description": "Filter logs by worker name",
      "in": "query",
      "name": "worker_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by worker name",
        "title": "Worker Name"
      }
    },
    {
      "description": "Filter logs by workflow name",
      "in": "query",
      "name": "workflow_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by workflow name",
        "title": "Workflow Name"
      }
    },
    {
      "description": "Only return logs at or after this timestamp",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only return logs at or after this timestamp",
        "title": "After"
      }
    },
    {
      "description": "Only return logs before this timestamp",
      "in": "query",
      "name": "before",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only return logs before this timestamp",
        "title": "Before"
      }
    },
    {
      "description": "First-page sort order: 'asc' (oldest first) or 'desc'. Ignored when `cursor` is set.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "asc",
        "description": "First-page sort order: 'asc' (oldest first) or 'desc'. Ignored when `cursor` is set.",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order",
        "type": "string"
      }
    },
    {
      "description": "Pagination cursor from a previous response's `next_cursor`; carries the window and order",
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Pagination cursor from a previous response's `next_cursor`; carries the window and order",
        "title": "Cursor"
      }
    },
    {
      "description": "Maximum number of logs to return",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 50,
        "description": "Maximum number of logs to return",
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeploymentLogSearchResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Get Deployment Logs",
  "tags": [
    "workflows.deployments"
  ],
  "components": {
    "schemas": {
      "DeploymentLogType": {
        "description": "Which log stream a deployment's logs come from.\n\n`runtime` is what the workers themselves emit. `build` only exists for managed\ndeployments: it is the image build pipeline's output, which no worker reports.",
        "enum": [
          "build",
          "runtime"
        ],
        "title": "DeploymentLogType",
        "type": "string"
      },
      "DeploymentLogSearchResponse": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/DeploymentLogRecord"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "DeploymentLogSearchResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "DeploymentLogRecord": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "log_attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Log Attributes",
            "type": "object"
          },
          "severity_text": {
            "title": "Severity Text",
            "type": "string"
          },
          "span_id": {
            "title": "Span Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "trace_id",
          "span_id",
          "severity_text",
          "body",
          "log_attributes"
        ],
        "title": "DeploymentLogRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
