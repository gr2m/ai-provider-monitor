{
  "description": "Get Deployment",
  "operationId": "get_deployment_v1_workflows_deployments__name__get",
  "parameters": [
    {
      "in": "path",
      "name": "name",
      "required": true,
      "schema": {
        "title": "Name",
        "type": "string"
      }
    },
    {
      "description": "Scope serving status to this workflow",
      "in": "query",
      "name": "workflow_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Scope serving status to this workflow",
        "title": "Workflow Name"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeploymentDetailResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Get Deployment",
  "tags": [
    "workflows.deployments"
  ],
  "components": {
    "schemas": {
      "DeploymentDetailResponse": {
        "properties": {
          "active_worker_count": {
            "default": 0,
            "description": "Number of workers currently live within the liveness cutoff",
            "title": "Active Worker Count",
            "type": "integer"
          },
          "created_at": {
            "description": "When the deployment was first registered",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier of the deployment",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "description": "Whether at least one worker is currently live",
            "title": "Is Active",
            "type": "boolean"
          },
          "is_hardened": {
            "default": false,
            "description": "Whether the deployment only accepts registrations from authorized principals",
            "title": "Is Hardened",
            "type": "boolean"
          },
          "last_heartbeat": {
            "description": "When the deployment last saw a worker registration",
            "format": "date-time",
            "title": "Last Heartbeat",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentLocation"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Where the deployment is running"
          },
          "locations": {
            "description": "Distinct location types reported by the deployment's workers",
            "items": {
              "$ref": "#/components/schemas/LocationType"
            },
            "title": "Locations",
            "type": "array"
          },
          "managed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ManagedDeploymentResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "Live managed service state for managed deployments; null for self-hosted deployments or when managed services are unavailable"
          },
          "name": {
            "description": "Deployment name",
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User id that owns the deployment, or null when it is administrator-managed",
            "title": "Owner"
          },
          "updated_at": {
            "deprecated": true,
            "description": "Deprecated alias of last_heartbeat",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "worker_count": {
            "default": 0,
            "description": "Number of workers registered to the deployment",
            "title": "Worker Count",
            "type": "integer"
          },
          "workers": {
            "description": "Workers registered for the deployment",
            "items": {
              "$ref": "#/components/schemas/DeploymentWorkerResponse"
            },
            "title": "Workers",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "is_active",
          "created_at",
          "last_heartbeat",
          "updated_at",
          "workers"
        ],
        "title": "DeploymentDetailResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "DeploymentLocation": {
        "properties": {
          "k8s_cluster": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "K8s cluster name, if applicable",
            "title": "K8S Cluster"
          },
          "k8s_namespace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "K8s namespace, if applicable",
            "title": "K8S Namespace"
          },
          "location_type": {
            "$ref": "#/components/schemas/LocationType",
            "description": "Where the deployment runs: 'local', 'k8s', or 'managed'"
          }
        },
        "required": [
          "location_type"
        ],
        "title": "DeploymentLocation",
        "type": "object"
      },
      "LocationType": {
        "enum": [
          "local",
          "k8s",
          "managed"
        ],
        "title": "LocationType",
        "type": "string"
      },
      "ManagedDeploymentResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "deployed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployed At"
          },
          "deployed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployed By"
          },
          "is_hardened": {
            "default": false,
            "title": "Is Hardened",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "resources": {
            "$ref": "#/components/schemas/DeploymentResourceConfig"
          },
          "rollout_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rollout Status"
          },
          "runtime_credential_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime Credential Id"
          },
          "runtime_principal_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrincipalType"
              },
              {
                "type": "null"
              }
            ]
          },
          "service_id": {
            "title": "Service Id",
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/DeploymentWorkerSpecResponse"
          },
          "status": {
            "$ref": "#/components/schemas/DeploymentObservedState"
          },
          "stopped": {
            "default": false,
            "title": "Stopped",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated By"
          }
        },
        "required": [
          "service_id",
          "name",
          "spec",
          "resources",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ManagedDeploymentResponse",
        "type": "object"
      },
      "DeploymentWorkerResponse": {
        "properties": {
          "created_at": {
            "description": "When the worker first registered",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "is_active": {
            "description": "Whether this worker's liveness key is currently alive",
            "title": "Is Active",
            "type": "boolean"
          },
          "last_heartbeat": {
            "description": "When the worker last registered",
            "format": "date-time",
            "title": "Last Heartbeat",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentLocation"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the worker is running; null if the worker did not report a location"
          },
          "name": {
            "description": "Worker name",
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "deprecated": true,
            "description": "Deprecated alias of last_heartbeat",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "name",
          "created_at",
          "last_heartbeat",
          "updated_at",
          "is_active"
        ],
        "title": "DeploymentWorkerResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "DeploymentResourceConfig": {
        "properties": {
          "replicas": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replicas"
          }
        },
        "title": "DeploymentResourceConfig",
        "type": "object"
      },
      "PrincipalType": {
        "enum": [
          "api_key",
          "service_account",
          "user"
        ],
        "title": "PrincipalType",
        "type": "string"
      },
      "DeploymentWorkerSpecResponse": {
        "properties": {
          "archive_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Archive the worker builds from, if any.",
            "title": "Archive Id"
          },
          "backend_spec": {
            "description": "Backend-specific configuration. 'mistral_cloud' is Mistral Cloud; 'kubernetes' is a deployment that already runs on Kubernetes.",
            "discriminator": {
              "mapping": {
                "koyeb": "#/components/schemas/DeploymentMistralCloudBackendSpec",
                "kubernetes": "#/components/schemas/DeploymentK8sBackendSpec",
                "mistral_cloud": "#/components/schemas/DeploymentMistralCloudBackendSpec"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeploymentMistralCloudBackendSpec"
              },
              {
                "$ref": "#/components/schemas/DeploymentK8sBackendSpec"
              }
            ],
            "title": "Backend Spec"
          },
          "commit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GitCommitMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "github_url": {
            "description": "GitHub repository the worker builds from. Empty for a worker built from an archive.",
            "title": "Github Url",
            "type": "string"
          },
          "requested_roles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Roles"
          },
          "restarted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restarted At"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "type": {
            "default": "workflows_worker",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "github_url",
          "backend_spec"
        ],
        "title": "DeploymentWorkerSpecResponse",
        "type": "object"
      },
      "DeploymentObservedState": {
        "properties": {
          "available_replicas": {
            "default": 0,
            "title": "Available Replicas",
            "type": "integer"
          },
          "build_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentBuildState"
              },
              {
                "type": "null"
              }
            ]
          },
          "deployed_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployed Revision"
          },
          "endpoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpoint"
          },
          "generation": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation"
          },
          "last_seen": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "ready_replicas": {
            "default": 0,
            "title": "Ready Replicas",
            "type": "integer"
          }
        },
        "title": "DeploymentObservedState",
        "type": "object"
      },
      "DeploymentMistralCloudBackendSpec": {
        "additionalProperties": false,
        "description": "Worker configuration for the Mistral Cloud backend.",
        "properties": {
          "build_directory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Docker build context, as a path in the repo. Defaults to the repo root.",
            "title": "Build Directory"
          },
          "dockerfile_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path to the Dockerfile, relative to 'build_directory'. Defaults to 'Dockerfile'.",
            "title": "Dockerfile Path"
          },
          "secrets": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DeploymentSecretBinding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Secrets to bind to the worker, as 'secret:workspace:<NAME>' references. Each is available during build and run: as a Dockerfile build arg (declare a matching 'ARG') and as an env var. On update, the field carries the complete set: send the full list to rebind, an empty list to unbind all, omit it to leave the bindings unchanged.",
            "title": "Secrets"
          },
          "type": {
            "default": "mistral_cloud",
            "enum": [
              "mistral_cloud",
              "koyeb"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "DeploymentMistralCloudBackendSpec",
        "type": "object"
      },
      "DeploymentK8sBackendSpec": {
        "additionalProperties": false,
        "description": "Worker configuration for the Kubernetes backend.",
        "properties": {
          "entrypoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Either a 'module:function' reference (e.g. 'worker:main') or a '.py' script path relative to 'working_dir'.",
            "title": "Entrypoint"
          },
          "type": {
            "const": "kubernetes",
            "default": "kubernetes",
            "title": "Type",
            "type": "string"
          },
          "working_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path in the repo holding the worker's pyproject.toml, for monorepo layouts. Leave empty for single-package repos.",
            "title": "Working Dir"
          }
        },
        "title": "DeploymentK8sBackendSpec",
        "type": "object"
      },
      "GitCommitMetadata": {
        "properties": {
          "author": {
            "anyOf": [
