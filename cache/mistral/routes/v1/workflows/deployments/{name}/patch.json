          "service_id",
          "name",
          "spec",
          "resources",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ManagedDeploymentResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "DeploymentResourceConfigUpdate": {
        "properties": {
          "replicas": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replicas"
          }
        },
        "title": "DeploymentResourceConfigUpdate",
        "type": "object"
      },
      "WorkflowsWorkerSpecUpdate": {
        "properties": {
          "archive_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rebuild the worker from this archive, dropping 'github_url' and 'revision'. Sending 'github_url' instead moves it back to a repository.",
            "title": "Archive Id"
          },
          "backend_spec": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentMistralCloudBackendSpec"
              },
              {
                "type": "null"
              }
            ],
            "description": "Backend-specific configuration for the Mistral Cloud backend."
          },
          "github_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Github Url"
          },
          "requested_roles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The complete workspace-role set after the update, beyond `workflow_executor`. Replaces the current roles; omit it to leave them unchanged, send an empty list to drop all extras. Granted only if the deploying user holds them.",
            "title": "Requested Roles"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          }
        },
        "title": "WorkflowsWorkerSpecUpdate",
        "type": "object"
      },
      "DeploymentResourceConfig": {
        "properties": {
          "replicas": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replicas"
          }
        },
        "title": "DeploymentResourceConfig",
        "type": "object"
      },
      "PrincipalType": {
        "enum": [
          "api_key",
          "service_account",
          "user"
        ],
        "title": "PrincipalType",
        "type": "string"
      },
      "DeploymentWorkerSpecResponse": {
        "properties": {
          "archive_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Archive the worker builds from, if any.",
            "title": "Archive Id"
          },
          "backend_spec": {
            "description": "Backend-specific configuration. 'mistral_cloud' is Mistral Cloud; 'kubernetes' is a deployment that already runs on Kubernetes.",
            "discriminator": {
              "mapping": {
                "koyeb": "#/components/schemas/DeploymentMistralCloudBackendSpec",
                "kubernetes": "#/components/schemas/DeploymentK8sBackendSpec",
                "mistral_cloud": "#/components/schemas/DeploymentMistralCloudBackendSpec"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/DeploymentMistralCloudBackendSpec"
              },
              {
                "$ref": "#/components/schemas/DeploymentK8sBackendSpec"
              }
            ],
            "title": "Backend Spec"
          },
          "commit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GitCommitMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "github_url": {
            "description": "GitHub repository the worker builds from. Empty for a worker built from an archive.",
            "title": "Github Url",
            "type": "string"
          },
          "requested_roles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Roles"
          },
          "restarted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restarted At"
          },
          "revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "type": {
            "default": "workflows_worker",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "github_url",
          "backend_spec"
        ],
        "title": "DeploymentWorkerSpecResponse",
        "type": "object"
      },
      "DeploymentObservedState": {
        "properties": {
          "available_replicas": {
            "default": 0,
            "title": "Available Replicas",
            "type": "integer"
          },
          "build_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeploymentBuildState"
