                "type": "null"
              }
            ]
          },
          "spec": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowsWorkerSpecUpdate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "UpdateDeploymentRequest",
        "type": "object"
      },
      "ManagedDeploymentResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
