          },
          "runtime_principal_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrincipalType"
              },
              {
                "type": "null"
              }
            ]
          },
          "service_id": {
            "title": "Service Id",
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/DeploymentWorkerSpecResponse"
          },
          "status": {
            "$ref": "#/components/schemas/DeploymentObservedState"
          },
          "stopped": {
            "default": false,
            "title": "Stopped",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
