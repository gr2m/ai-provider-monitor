                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          }
        },
        "title": "DeploymentBuildState",
        "type": "object"
      },
      "DeploymentSecretBinding": {
        "description": "Binds one env var to one platform secret; the value is resolved at boot, never stored.",
        "properties": {
          "env_var_name": {
            "description": "Environment variable the worker process reads; the secret's name lives in 'reference'.",
            "title": "Env Var Name",
            "type": "string"
          },
          "reference": {
            "description": "Secret reference as 'secret:workspace:<NAME>'. Resolved at boot by the runtime-init container; the value never reaches the control plane.",
            "title": "Reference",
            "type": "string"
          }
        },
        "required": [
          "env_var_name",
          "reference"
        ],
        "title": "DeploymentSecretBinding",
        "type": "object"
      },
      "GitCommitAuthor": {
        "properties": {
          "html_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Html Url"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "title": "GitCommitAuthor",
        "type": "object"
      }
