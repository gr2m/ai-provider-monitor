            "title": "Last Seen"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "ready_replicas": {
            "default": 0,
            "title": "Ready Replicas",
            "type": "integer"
          }
        },
        "title": "DeploymentObservedState",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "DeploymentMistralCloudBackendSpec": {
        "additionalProperties": false,
        "description": "Worker configuration for the Mistral Cloud backend.",
        "properties": {
          "build_directory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Docker build context, as a path in the repo. Defaults to the repo root.",
            "title": "Build Directory"
          },
          "dockerfile_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path to the Dockerfile, relative to 'build_directory'. Defaults to 'Dockerfile'.",
            "title": "Dockerfile Path"
          },
          "secrets": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DeploymentSecretBinding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Secrets to bind to the worker, as 'secret:workspace:<NAME>' references. Each is available during build and run: as a Dockerfile build arg (declare a matching 'ARG') and as an env var. On update, the field carries the complete set: send the full list to rebind, an empty list to unbind all, omit it to leave the bindings unchanged.",
            "title": "Secrets"
          },
          "type": {
            "default": "mistral_cloud",
            "enum": [
              "mistral_cloud",
              "koyeb"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "DeploymentMistralCloudBackendSpec",
        "type": "object"
      },
      "DeploymentK8sBackendSpec": {
        "additionalProperties": false,
        "description": "Worker configuration for the Kubernetes backend.",
        "properties": {
          "entrypoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Either a 'module:function' reference (e.g. 'worker:main') or a '.py' script path relative to 'working_dir'.",
            "title": "Entrypoint"
          },
          "type": {
            "const": "kubernetes",
            "default": "kubernetes",
            "title": "Type",
            "type": "string"
          },
          "working_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path in the repo holding the worker's pyproject.toml, for monorepo layouts. Leave empty for single-package repos.",
            "title": "Working Dir"
          }
        },
        "title": "DeploymentK8sBackendSpec",
        "type": "object"
      },
      "GitCommitMetadata": {
        "properties": {
          "author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GitCommitAuthor"
