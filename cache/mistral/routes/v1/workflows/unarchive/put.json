          },
          "workspace_id": {
            "description": "Workspace ID of the workflow",
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "display_name",
          "type",
          "customer_id",
          "workspace_id"
