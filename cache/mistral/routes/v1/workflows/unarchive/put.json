          "available_in_chat_assistant": {
            "default": false,
            "description": "Whether the workflow is available in chat assistant",
            "title": "Available In Chat Assistant",
            "type": "boolean"
          },
          "customer_id": {
            "description": "Customer ID of the workflow",
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Description of the workflow",
            "title": "Description"
          },
          "display_name": {
            "description": "Display name of the workflow",
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier of the workflow",
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_technical": {
            "default": false,
            "description": "Whether the workflow is technical (e.g. SDK-managed)",
            "title": "Is Technical",
            "type": "boolean"
          },
          "name": {
            "description": "Name of the workflow",
            "title": "Name",
            "type": "string"
          },
          "shared_namespace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
