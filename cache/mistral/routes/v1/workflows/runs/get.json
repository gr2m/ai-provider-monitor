{
  "description": "List Runs",
  "operationId": "list_runs_v1_workflows_runs_get",
  "parameters": [
    {
      "description": "Filter by workflow name or id",
      "in": "query",
      "name": "workflow_identifier",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by workflow name or id",
        "title": "Workflow Identifier"
      }
    },
    {
      "description": "Filter by root execution id; returns the whole execution tree (the root and all its descendant sub-workflows).",
      "in": "query",
      "name": "root_execution_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by root execution id; returns the whole execution tree (the root and all its descendant sub-workflows).",
        "title": "Root Execution Id"
      }
    },
    {
      "description": "Search by workflow name, display name, or ID",
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Search by workflow name, display name, or ID",
        "title": "Search"
      }
    },
    {
      "description": "Filter by workflow status",
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/WorkflowExecutionStatus"
          },
          {
            "items": {
              "$ref": "#/components/schemas/WorkflowExecutionStatus"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by workflow status",
        "title": "Status"
      }
    },
    {
      "description": "Filter by deployment name",
      "in": "query",
      "name": "deployment_name",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by deployment name",
        "title": "Deployment Name"
      }
    },
    {
      "description": "Field to sort by",
      "in": "query",
      "name": "sort_by",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "enum": [
              "start_time",
              "end_time"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Field to sort by",
        "title": "Sort By"
      }
    },
    {
      "description": "Sort direction",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "desc",
        "description": "Sort direction",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order",
        "type": "string"
      }
    },
    {
      "description": "Include runs with start_time >= value",
      "in": "query",
      "name": "start_time_after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Include runs with start_time >= value",
        "title": "Start Time After"
      }
    },
    {
      "description": "Include runs with start_time <= value",
      "in": "query",
      "name": "start_time_before",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Include runs with start_time <= value",
        "title": "Start Time Before"
      }
    },
    {
      "description": "Include runs with end_time >= value. Running executions (no end_time) are excluded; use the status filter to include them.",
      "in": "query",
      "name": "end_time_after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Include runs with end_time >= value. Running executions (no end_time) are excluded; use the status filter to include them.",
        "title": "End Time After"
      }
    },
    {
      "description": "Include runs with end_time <= value. Running executions (no end_time) are excluded; use the status filter to include them.",
      "in": "query",
      "name": "end_time_before",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Include runs with end_time <= value. Running executions (no end_time) are excluded; use the status filter to include them.",
        "title": "End Time Before"
      }
    },
    {
      "description": "Filter by user id. Use 'current' to filter by the authenticated user",
      "in": "query",
      "name": "user_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by user id. Use 'current' to filter by the authenticated user",
        "title": "User Id"
      }
    },
    {
      "description": "Filter to runs of workflows tagged with all listed tags (AND).",
      "in": "query",
      "name": "workflow_tags",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter to runs of workflows tagged with all listed tags (AND).",
        "title": "Workflow Tags"
      }
    },
    {
      "description": "Include runs of internal/technical workflows (e.g. parallel-execution)",
      "in": "query",
      "name": "include_internal",
      "required": false,
      "schema": {
        "default": true,
        "description": "Include runs of internal/technical workflows (e.g. parallel-execution)",
        "title": "Include Internal",
        "type": "boolean"
      }
    },
    {
      "description": "Number of items per page",
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 50,
        "description": "Number of items per page",
        "maximum": 1000,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Token for the next page of results",
      "in": "query",
      "name": "next_page_token",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Token for the next page of results",
        "title": "Next Page Token"
      }
    },
    {
      "description": "Filter executions by search key as repeated entries (max 3, AND'd together). 'key:value' matches a similar value, 'key==:value' matches the exact value, a bare 'key' matches executions that have the key set at all, and 'key==' matches executions whose value for the key is null.",
      "in": "query",
      "name": "search_key",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "pattern": "^(?:[^:]+==:.+|[^:]+==|[^:]+:.+|[^:]+)$",
              "type": "string"
            },
            "maxItems": 3,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter executions by search key as repeated entries (max 3, AND'd together). 'key:value' matches a similar value, 'key==:value' matches the exact value, a bare 'key' matches executions that have the key set at all, and 'key==' matches executions whose value for the key is null.",
        "title": "Search Key"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkflowExecutionListResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "List Runs",
  "tags": [
    "workflows.runs"
  ],
  "components": {
    "schemas": {
      "WorkflowExecutionStatus": {
        "enum": [
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELED",
          "TERMINATED",
          "CONTINUED_AS_NEW",
          "TIMED_OUT",
          "RETRYING_AFTER_ERROR"
        ],
        "title": "WorkflowExecutionStatus",
        "type": "string"
      },
      "WorkflowExecutionListResponse": {
        "description": "Deprecated: use WorkflowRunListResponse instead. Will be removed in the next major version.",
        "properties": {
          "executions": {
            "description": "A list of workflow executions",
            "items": {
              "$ref": "#/components/schemas/WorkflowExecutionWithoutResultResponse"
            },
            "title": "Executions",
            "type": "array"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Token to use for fetching the next page of results. Null if this is the last page.",
            "title": "Next Page Token"
          }
        },
        "required": [
          "executions"
        ],
        "title": "WorkflowExecutionListResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "WorkflowExecutionWithoutResultResponse": {
        "properties": {
          "deployment_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the deployment that ran this execution",
            "title": "Deployment Name"
          },
          "end_time": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The end time of the workflow execution, if available",
            "title": "End Time"
          },
          "execution_id": {
            "description": "The ID of the workflow execution",
            "title": "Execution Id",
            "type": "string"
          },
          "parent_execution_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The parent execution ID of the workflow execution",
            "title": "Parent Execution Id"
          },
          "root_execution_id": {
            "description": "The root execution ID of the workflow execution",
            "title": "Root Execution Id",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The unique run identifier (database UUID)",
            "title": "Run Id"
          },
          "start_time": {
            "description": "The start time of the workflow execution",
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkflowExecutionStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "The status of the workflow execution"
          },
          "total_duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The total duration of the trace in milliseconds",
            "title": "Total Duration Ms"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ID of the user who triggered the execution",
            "title": "User Id"
          },
          "workflow_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ID of the workflow",
            "title": "Workflow Id"
          },
          "workflow_name": {
            "description": "The name of the workflow",
            "title": "Workflow Name",
            "type": "string"
          }
        },
        "required": [
          "workflow_name",
          "execution_id",
          "root_execution_id",
          "status",
          "start_time",
          "end_time"
        ],
        "title": "WorkflowExecutionWithoutResultResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
