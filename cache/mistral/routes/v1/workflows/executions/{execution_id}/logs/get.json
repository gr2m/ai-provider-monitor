{
  "description": "Retrieve logs for a workflow execution.\n\nUse `after`/`before`/`order` on the first request to set the time range and sort order; for\nthe next pages pass the `cursor` from the previous response (it remembers the range and order).",
  "operationId": "get_workflow_execution_logs",
  "parameters": [
    {
      "in": "path",
      "name": "execution_id",
      "required": true,
      "schema": {
        "title": "Execution Id",
        "type": "string"
      }
    },
    {
      "description": "Filter logs by workflow run ID",
      "in": "query",
      "name": "run_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by workflow run ID",
        "title": "Run Id"
      }
    },
    {
      "description": "Filter logs by activity ID",
      "in": "query",
      "name": "activity_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "pattern": "^\\d+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by activity ID",
        "title": "Activity Id"
      }
    },
    {
      "description": "Only return logs at or after this timestamp",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only return logs at or after this timestamp",
        "title": "After"
      }
    },
    {
      "description": "Only return logs before this timestamp",
      "in": "query",
      "name": "before",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only return logs before this timestamp",
        "title": "Before"
      }
    },
    {
      "description": "First-page sort order: 'asc' (oldest first) or 'desc'. Ignored when `cursor` is set.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "asc",
        "description": "First-page sort order: 'asc' (oldest first) or 'desc'. Ignored when `cursor` is set.",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order",
        "type": "string"
      }
    },
    {
      "description": "Pagination cursor from a previous response's `next_cursor`; carries the window and order",
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Pagination cursor from a previous response's `next_cursor`; carries the window and order",
        "title": "Cursor"
      }
    },
    {
      "description": "Maximum number of logs to return",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 50,
        "description": "Maximum number of logs to return",
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ExecutionLogSearchResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Get Workflow Execution Logs",
  "tags": [
    "workflows.executions"
  ],
  "components": {
    "schemas": {
      "ExecutionLogSearchResponse": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ExecutionLogRecord"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "ExecutionLogSearchResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ExecutionLogRecord": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "log_attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Log Attributes",
            "type": "object"
          },
          "severity_text": {
            "title": "Severity Text",
            "type": "string"
          },
          "span_id": {
            "title": "Span Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "trace_id",
          "span_id",
          "severity_text",
          "body",
          "log_attributes"
        ],
        "title": "ExecutionLogRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
