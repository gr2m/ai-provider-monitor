{
  "description": "Stream logs for a workflow execution via SSE.\n\nResume cursor comes from the `Last-Event-ID` header or `last_event_id` query param (header wins)\nand takes precedence over `after`; omit all to tail from the execution start.",
  "operationId": "stream_workflow_execution_logs",
  "parameters": [
    {
      "in": "path",
      "name": "execution_id",
      "required": true,
      "schema": {
        "title": "Execution Id",
        "type": "string"
      }
    },
    {
      "description": "Filter logs by workflow run ID",
      "in": "query",
      "name": "run_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by workflow run ID",
        "title": "Run Id"
      }
    },
    {
      "description": "Filter logs by activity ID",
      "in": "query",
      "name": "activity_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "pattern": "^\\d+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter logs by activity ID",
        "title": "Activity Id"
      }
    },
    {
      "description": "Start a fresh stream at this timestamp (ignored when resuming via last_event_id)",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Start a fresh stream at this timestamp (ignored when resuming via last_event_id)",
        "title": "After"
      }
    },
    {
      "description": "Resume from this cursor (a prior response's SSE id)",
      "in": "query",
      "name": "last_event_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Resume from this cursor (a prior response's SSE id)",
        "title": "Last Event Id"
      }
    },
    {
      "description": "Resume from this cursor (a prior response's SSE id). Takes precedence over the query parameter.",
      "in": "header",
      "name": "Last-Event-ID",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Resume from this cursor (a prior response's SSE id). Takes precedence over the query parameter.",
        "title": "Last-Event-Id"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "text/event-stream": {
          "schema": {
            "properties": {
              "data": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ExecutionLogRecord"
                  },
                  {
                    "$ref": "#/components/schemas/StreamError"
                  }
                ]
              },
              "event": {
                "enum": [
                  "log",
                  "error"
                ],
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "description": "Stream of Server-Sent Events (SSE): `log` events carry an ExecutionLogRecord; `error` events carry a StreamError payload."
    },
    "404": {
      "description": "Execution not found"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    },
    "503": {
      "description": "Logs backend unavailable"
    }
  },
  "summary": "Stream Workflow Execution Logs",
  "tags": [
    "workflows.executions"
  ],
  "components": {
    "schemas": {
      "ExecutionLogRecord": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "log_attributes": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Log Attributes",
            "type": "object"
          },
          "severity_text": {
            "title": "Severity Text",
            "type": "string"
          },
          "span_id": {
            "title": "Span Id",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "trace_id",
          "span_id",
          "severity_text",
          "body",
          "log_attributes"
        ],
        "title": "ExecutionLogRecord",
        "type": "object"
      },
      "StreamError": {
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "error",
          "reason"
        ],
        "title": "StreamError",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
