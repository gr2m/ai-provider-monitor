        "title": "OrganizationUsersCreateOUT",
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "A",
          "M",
          "B"
        ],
        "title": "UserRole",
        "type": "string"
      },
      "StaticOrganizationRoles": {
        "enum": [
          "0d48f530-095c-43fe-8aea-6673bcacabe6",
          "c955f4e1-9477-43f0-8349-6fbc629fccc9",
          "7bde5959-d676-47d2-b779-35b64323d278"
        ],
        "title": "StaticOrganizationRoles",
        "type": "string"
      },
      "PlanType": {
        "enum": [
          "API",
          "CHAT",
          "ON_PREMISE",
          "LICENSE",
          "MISTRAL_CODE"
        ],
        "title": "PlanType",
        "type": "string"
      }
    }
