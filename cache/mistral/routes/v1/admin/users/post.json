            "title": "Role Names"
          },
          "roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/UserRole"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/StaticOrganizationRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
