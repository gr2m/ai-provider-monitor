              "alice.martin@example.com"
            ],
            "title": "Email"
          },
          "is_sso_outsider": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the member is outside the SSO domain.",
            "title": "Is Sso Outsider"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
