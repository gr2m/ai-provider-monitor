{
  "description": "Update an Organization member's roles and product seats.",
  "operationId": "users_api_admin_users_update_user",
  "parameters": [
    {
      "description": "User ID.",
      "in": "path",
      "name": "user_id",
      "required": true,
      "schema": {
        "description": "User ID.",
        "format": "uuid",
        "title": "User Id",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/AdminOrganizationMemberUpdate"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminOrganizationMemberOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Update User",
  "tags": [
    "beta.admin.users"
  ],
  "components": {
    "schemas": {
      "AdminOrganizationMemberUpdate": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              },
              {
                "$ref": "#/components/schemas/StaticOrganizationRoles"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated legacy single role value, kept for backward compatibility. Mutually exclusive with 'role_name'."
          },
          "role_name": {
            "anyOf": [
              {
                "enum": [
                  "member",
                  "billing_manager",
                  "organization_admin"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated single role name, kept for backward compatibility. Mutually exclusive with 'role'.",
            "title": "Role Name"
          },
          "role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "member",
                    "billing_manager",
                    "organization_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to assign. Mutually exclusive with 'roles'.",
            "title": "Role Names"
          },
          "roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/UserRole"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/StaticOrganizationRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to assign. Mutually exclusive with 'role_names'.",
            "title": "Roles"
          },
          "subscription_types": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "CHAT",
                    "MISTRAL_CODE"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Product seats to assign to the member.",
            "title": "Subscription Types"
          }
        },
        "title": "AdminOrganizationMemberUpdate",
        "type": "object"
      },
      "AdminOrganizationMemberOUT": {
        "properties": {
          "created_at": {
            "description": "Date the member was added to the Organization.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Email address of the Organization member.",
            "examples": [
              "alice.martin@example.com"
            ],
            "title": "Email"
          },
          "is_sso_outsider": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the member is outside the SSO domain.",
            "title": "Is Sso Outsider"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last time the member signed in to the Organization, accurate to about 30 minutes. Null if they never signed in.",
            "examples": [
              "2026-11-04T09:12:00Z"
            ],
            "title": "Last Login At"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the Organization member.",
            "examples": [
              "Alice Martin"
            ],
            "title": "Name"
          },
          "oid_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Identity provider ID for the member.",
            "title": "Oid Id"
          },
          "raw_role": {
            "$ref": "#/components/schemas/StaticOrganizationRoles",
            "deprecated": true,
            "description": "Deprecated single organization role. Use 'raw_roles' instead."
          },
          "raw_roles": {
            "description": "Organization roles assigned to the member.",
            "items": {
              "$ref": "#/components/schemas/StaticOrganizationRoles"
            },
            "minItems": 1,
            "title": "Raw Roles",
            "type": "array"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MemberStatus"
              }
            ],
            "default": "active",
            "description": "Account status of the member. Deactivated and blocked members cannot access the Organization.",
            "examples": [
              "active"
            ]
          },
          "subscription_types": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "CHAT",
                    "MISTRAL_CODE"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Product seats assigned to the member.",
            "title": "Subscription Types"
          },
          "subscriptions": {
            "default": [],
            "description": "Subscriptions assigned to the member.",
            "items": {
              "$ref": "#/components/schemas/MemberSubscriptionOUT"
            },
            "title": "Subscriptions",
            "type": "array"
          },
          "uuid": {
            "description": "Organization member ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          },
          "workspaces": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/MemberWorkspaceInfo"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated: limited to the first 100 Workspaces the member belongs to, ordered by name. Use GET /users/{user_id}/workspaces instead.",
            "title": "Workspaces"
          },
          "workspaces_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Total number of Workspaces the member belongs to, including those not returned in 'workspaces'.",
            "examples": [
              3
            ],
            "title": "Workspaces Total"
          }
        },
        "required": [
          "uuid",
          "oid_id",
          "name",
          "email",
          "raw_roles",
          "raw_role",
          "created_at"
        ],
        "title": "AdminOrganizationMemberOUT",
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "A",
          "M",
          "B"
        ],
        "title": "UserRole",
        "type": "string"
      },
      "StaticOrganizationRoles": {
        "enum": [
          "0d48f530-095c-43fe-8aea-6673bcacabe6",
          "c955f4e1-9477-43f0-8349-6fbc629fccc9",
          "7bde5959-d676-47d2-b779-35b64323d278"
        ],
        "title": "StaticOrganizationRoles",
        "type": "string"
      },
      "MemberStatus": {
        "enum": [
          "active",
          "deactivated",
          "blocked"
        ],
        "title": "MemberStatus",
        "type": "string"
      },
      "MemberSubscriptionOUT": {
        "properties": {
          "member_has_access": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the member currently has access to the plan.",
            "title": "Member Has Access"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/APIPlan"
              },
              {
                "$ref": "#/components/schemas/ChatPlan"
              },
              {
                "$ref": "#/components/schemas/CodePlan"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plan assigned to the member.",
            "title": "Plan"
          },
          "self_service": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the subscription was created through self-service.",
            "title": "Self Service"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Current status of the member subscription."
          },
          "type": {
            "$ref": "#/components/schemas/PlanType",
            "description": "Type of subscription assigned to the member."
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "User ID associated with the subscription.",
            "title": "User"
          }
        },
        "required": [
          "type"
        ],
        "title": "MemberSubscriptionOUT",
        "type": "object"
      },
      "MemberWorkspaceInfo": {
        "properties": {
          "is_default": {
            "description": "Whether this is the default Workspace for the Organization.",
            "title": "Is Default",
            "type": "boolean"
          },
          "name": {
            "description": "Workspace name.",
            "examples": [
              "Product Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          },
          "raw_role": {
            "$ref": "#/components/schemas/StaticWorkspaceRoles",
            "deprecated": true,
            "description": "Deprecated single workspace role. Use 'raw_roles' instead."
          },
          "raw_roles": {
            "description": "Workspace roles assigned to the member.",
            "items": {
              "$ref": "#/components/schemas/StaticWorkspaceRoles"
            },
            "minItems": 1,
            "title": "Raw Roles",
            "type": "array"
          },
          "uuid": {
            "description": "Workspace ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "is_default",
          "raw_roles",
          "raw_role"
        ],
        "title": "MemberWorkspaceInfo",
        "type": "object"
      },
      "APIPlan": {
        "enum": [
          "FREE",
          "PAY_AS_YOU_GO"
        ],
        "title": "APIPlan",
        "type": "string"
      },
      "ChatPlan": {
        "enum": [
          "INDIVIDUAL",
          "EDU",
          "TEAM"
        ],
        "title": "ChatPlan",
        "type": "string"
      },
      "CodePlan": {
        "enum": [
          "ENTERPRISE"
        ],
        "title": "CodePlan",
        "type": "string"
      },
      "SubscriptionStatus": {
        "enum": [
          "NS",
          "S",
          "IC",
          "A",
          "CF",
          "CG",
          "C",
          "PC",
          "GP"
        ],
        "title": "SubscriptionStatus",
        "type": "string"
      },
      "PlanType": {
        "enum": [
          "API",
          "CHAT",
          "ON_PREMISE",
          "LICENSE",
          "MISTRAL_CODE"
        ],
        "title": "PlanType",
        "type": "string"
      },
      "StaticWorkspaceRoles": {
        "enum": [
          "48436751-ee56-44bd-8a2d-712233977821",
          "578584f1-4319-4c88-9948-38a5184483b6",
          "252a0825-40b9-4b98-be80-7658956f13e9",
          "17aa61c5-1c61-477e-a40a-e52c8ccd74b9",
          "b23cd6e0-91cd-4a8a-9869-b30366bf3966",
          "731eb2be-a74f-4070-b797-35bf7009e553"
        ],
        "title": "StaticWorkspaceRoles",
        "type": "string"
      }
    }
  }
}
