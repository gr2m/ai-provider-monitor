          "subscription_types": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "CHAT",
                    "MISTRAL_CODE"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Product seats assigned to the member.",
            "title": "Subscription Types"
          },
          "subscriptions": {
            "default": [],
