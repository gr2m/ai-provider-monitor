            "description": "Deprecated single organization role. Use 'raw_roles' instead.",
            "title": "Raw Role"
          },
          "raw_roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/UserRole"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/StaticOrganizationRoles"
                },
                "minItems": 1,
                "type": "array"
              }
            ],
            "description": "Organization roles assigned to the member.",
            "title": "Raw Roles"
