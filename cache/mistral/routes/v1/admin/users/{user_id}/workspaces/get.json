{
  "description": "List the Workspaces an Organization member belongs to, with their roles.",
  "operationId": "users_api_admin_users_get_user_workspaces",
  "parameters": [
    {
      "description": "User ID.",
      "in": "path",
      "name": "user_id",
      "required": true,
      "schema": {
        "description": "User ID.",
        "format": "uuid",
        "title": "User Id",
        "type": "string"
      }
    },
    {
      "description": "Page number to return.",
      "examples": {},
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "default": 1,
        "description": "Page number to return.",
        "examples": [
          1
        ],
        "exclusiveMinimum": 0,
        "title": "Page",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of results per page.",
      "examples": {},
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 25,
        "description": "Maximum number of results per page.",
        "examples": [
          25
        ],
        "exclusiveMinimum": 0,
        "maximum": 100,
        "title": "Page Size",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminUserWorkspacesOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Get User Workspaces",
  "tags": [
    "beta.admin.users"
  ],
  "components": {
    "schemas": {
      "AdminUserWorkspacesOUT": {
        "properties": {
