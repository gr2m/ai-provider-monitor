      "UsageType": {
        "description": "The UsageType maps a recorded usage to a billable metric in Lago.\n\nFor example `UsageType.COMPLETION` maps to `api_tokens` in Lago. A new UsageType is billed only once it is added to\n`USAGE_TYPE_TO_LAGO_EVENT_TYPE_MAP` in kazekit.usage, which the job reporting the usage relies on. Types left out of\nit, such as `WORKFLOW_EXECUTIONS`, are recorded but not reported to Lago.",
        "enum": [
          "usage",
          "codestral",
          "document_library",
          "document_library_api",
          "libraries_pages",
          "libraries_tokens",
          "libraries_audio",
          "chat",
          "rlhf",
          "ocr",
          "audio_seconds",
          "audio_characters",
          "audio_agents",
          "connectors",
          "workflow_executions",
          "vibe",
          "vibe_connectors",
          "vibe_ocr",
          "vibe_audio_seconds",
          "vibe_audio_characters"
        ],
        "title": "UsageType",
        "type": "string"
      },
