                "us",
                "eu"
              ]
            ],
            "title": "Api Zone"
          },
          "billing_display_name": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Customer-facing billing metric names to include.",
            "examples": [
              [
                "mistral-large-latest"
              ]
            ],
            "title": "Billing Display Name"
          },
          "billing_group": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Billing metric components to include.",
            "examples": [
              [
                "input",
                "output"
              ]
            ],
            "title": "Billing Group"
          },
          "billing_metric": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Billing metric identifiers to include.",
            "examples": [
              [
                "mistral-large"
              ]
            ],
            "title": "Billing Metric"
          },
          "end": {
            "description": "Exclusive end of the usage interval.",
            "examples": [
              "2026-09-01T00:00:00Z"
            ],
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "filters": {
            "anyOf": [
