{
  "description": "Query the organization's detailed usage for a required time range.\n\nOptional filters, caller-selected grouping and time buckets, pagination, aggregates, and distinct API-call counts\nare supported. The response contains usage quantities only; it does not include prices, currency, or calculated\ncosts. For a fixed monthly report with pricing, use `GET /v1/admin/usage`.",
  "operationId": "users_api_admin_usage_query_usage",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UsageQueryIN"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/UsageQueryOUT"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Detailed Usage Query",
  "tags": [
    "beta.admin.billing"
  ],
  "components": {
    "schemas": {
      "UsageQueryIN": {
        "properties": {
          "api_key_id": {
