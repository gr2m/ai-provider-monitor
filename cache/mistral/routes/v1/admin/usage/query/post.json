          "service_tier": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Service tiers to include.",
            "examples": [
              [
                "standard",
                "priority"
              ]
            ],
            "title": "Service Tier"
          },
          "start": {
            "description": "Inclusive start of the usage interval.",
            "examples": [
              "2026-08-01T00:00:00Z"
            ],
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "time_bucket": {
            "anyOf": [
              {
                "enum": [
                  "second",
                  "1min",
                  "5min",
                  "15min",
                  "30min",
                  "hour",
                  "4hours",
                  "day",
                  "week",
                  "month"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time interval used to bucket grouped rows.",
            "examples": [
              "day"
            ],
            "title": "Time Bucket"
          },
          "untracked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
