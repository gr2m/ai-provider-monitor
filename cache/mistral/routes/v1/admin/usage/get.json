{
  "description": "Return the organization's usage for a calendar month in a fixed, product-oriented format.\n\nThe response includes the applicable price catalog and currency. For custom time ranges, filters, grouping, and\npagination, use `POST /v1/admin/usage/query`.",
  "operationId": "users_api_admin_usage_get_usage",
  "parameters": [
    {
      "description": "Month to return usage for.",
      "in": "query",
      "name": "month",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Month to return usage for.",
        "title": "Month"
      }
    },
    {
      "description": "Year to return usage for.",
      "in": "query",
      "name": "year",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Year to return usage for.",
        "title": "Year"
      }
    },
    {
      "description": "Workspace ID to filter results.",
      "in": "query",
      "name": "workspace_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Workspace ID to filter results.",
        "title": "Workspace Id"
      }
    },
    {
      "description": "Regional inference zone to filter results.",
      "in": "query",
      "name": "api_zone",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ApiZone"
          },
          {
            "type": "null"
          }
        ],
        "description": "Regional inference zone to filter results."
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/UsageOUTJSON"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Monthly Usage and Pricing",
  "tags": [
    "beta.admin.billing"
  ],
  "components": {
    "schemas": {
      "ApiZone": {
        "enum": [
          "global",
          "us",
          "eu"
        ],
        "title": "ApiZone",
        "type": "string"
      },
      "UsageOUTJSON": {
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Audio usage data."
          },
          "audio_agents": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Audio Agent session duration usage data."
          },
          "audio_characters": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Text-to-speech (audio characters) usage data."
          },
          "chat": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Chat usage data."
          },
          "completion": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Completion usage data."
          },
          "connectors": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Connector usage data."
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Currency used for usage prices.",
            "title": "Currency"
          },
          "currency_symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Currency symbol used for usage prices.",
            "title": "Currency Symbol"
          },
          "date": {
            "description": "Reference date for the usage period.",
            "format": "date-time",
            "title": "Date",
            "type": "string"
          },
          "end_date": {
            "description": "End of the usage period.",
            "format": "date-time",
            "title": "End Date",
            "type": "string"
          },
          "fine_tuning": {
            "$ref": "#/components/schemas/FineTuningDataJSON",
            "description": "Fine-tuning usage data."
          },
          "libraries_api": {
            "$ref": "#/components/schemas/LibrariesAPIUsageDataJSON",
            "description": "Libraries API usage data."
          },
          "next_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Next month in the usage report.",
            "title": "Next Month"
          },
          "ocr": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "OCR usage data."
          },
          "previous_month": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Previous month in the usage report.",
            "title": "Previous Month"
          },
          "prices": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PriceData"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Prices used to calculate usage amounts.",
            "title": "Prices"
          },
          "start_date": {
            "description": "Start of the usage period.",
            "format": "date-time",
            "title": "Start Date",
            "type": "string"
          },
          "vibe_code": {
            "$ref": "#/components/schemas/VibeCodeUsageDataJSON",
            "description": "Vibe Code usage data, broken down by sub-usage type."
          },
          "vibe_usage": {
            "description": "Legacy Vibe usage field. Always 0; use the Vibe usage API instead.",
            "title": "Vibe Usage",
            "type": "number"
          }
        },
        "required": [
          "completion",
          "ocr",
          "connectors",
          "libraries_api",
          "fine_tuning",
          "audio",
          "audio_characters",
          "audio_agents",
          "vibe_usage",
          "vibe_code",
          "chat",
          "date",
          "previous_month",
          "next_month",
          "start_date",
          "end_date",
          "currency",
          "currency_symbol",
          "prices"
        ],
        "title": "UsageOUTJSON",
        "type": "object"
      },
      "BasicModelUsageDataJSON": {
        "properties": {
          "models": {
            "additionalProperties": {
              "additionalProperties": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            },
            "description": "Usage data grouped by model.",
            "title": "Models",
            "type": "object"
          }
        },
        "required": [
          "models"
        ],
        "title": "BasicModelUsageDataJSON",
        "type": "object"
      },
      "FineTuningDataJSON": {
        "properties": {
          "storage": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Fine-tuning storage usage.",
            "title": "Storage",
            "type": "object"
          },
          "training": {
            "additionalProperties": {
              "additionalProperties": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              "type": "object"
            },
            "description": "Fine-tuning training usage.",
            "title": "Training",
            "type": "object"
          }
        },
        "required": [
          "training",
          "storage"
        ],
        "title": "FineTuningDataJSON",
        "type": "object"
      },
      "LibrariesAPIUsageDataJSON": {
        "properties": {
          "audio_seconds": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Audio usage for Libraries API."
          },
          "pages": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Page usage for Libraries API."
          },
          "tokens": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Token usage for Libraries API."
          }
        },
        "required": [
          "pages",
          "tokens",
          "audio_seconds"
        ],
        "title": "LibrariesAPIUsageDataJSON",
        "type": "object"
      },
      "PriceData": {
        "properties": {
          "api_zone": {
            "$ref": "#/components/schemas/ApiZone",
            "description": "API zone this price applies to."
          },
          "billing_group": {
            "description": "Billing metric group this price applies to.",
            "title": "Billing Group",
            "type": "string"
          },
          "billing_metric": {
            "description": "Billing metric this price applies to.",
            "title": "Billing Metric",
            "type": "string"
          },
          "event_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LagoEventType"
              },
              {
                "type": "null"
              }
            ],
            "description": "Billing event type for the price."
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Unit price for the billing metric.",
            "title": "Price"
          },
          "service_tier": {
            "$ref": "#/components/schemas/ServiceTier",
            "description": "Service tier this price applies to."
          }
        },
        "required": [
          "event_type",
          "billing_metric",
          "billing_group",
          "api_zone",
          "service_tier",
          "price"
        ],
        "title": "PriceData",
        "type": "object"
      },
      "VibeCodeUsageDataJSON": {
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Vibe Code audio transcription usage data."
          },
          "audio_characters": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Vibe Code text-to-speech usage data."
          },
          "completion": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Vibe Code completion (token) usage data."
          },
          "connectors": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Vibe Code connectors usage data."
          },
          "ocr": {
            "$ref": "#/components/schemas/BasicModelUsageDataJSON",
            "description": "Vibe Code OCR usage data."
          }
        },
        "required": [
          "completion",
          "ocr",
          "connectors",
          "audio",
          "audio_characters"
        ],
        "title": "VibeCodeUsageDataJSON",
        "type": "object"
      },
      "LagoEventType": {
        "enum": [
          "api_tokens",
          "api_pages",
          "api_audio_seconds",
          "api_audio_characters",
          "api_connectors",
          "api_libraries_tokens",
          "api_libraries_pages",
          "api_libraries_audio",
          "deployment_tokens",
          "gpu_hour",
          "reserved_instance",
          "vibe_tokens",
          "vibe_connectors",
          "vibe_pages",
          "vibe_audio_seconds",
          "vibe_audio_characters"
        ],
        "title": "LagoEventType",
        "type": "string"
      },
      "ServiceTier": {
        "description": "The service tier a request is resolved to and routed on.",
        "enum": [
          "standard",
          "priority"
        ],
        "title": "ServiceTier",
        "type": "string"
      }
    }
  }
}
