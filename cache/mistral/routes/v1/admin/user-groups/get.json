{
  "description": "Get all user groups across the organization.",
  "operationId": "users_api_admin_user_groups_get_user_groups",
  "parameters": [
    {
      "description": "Page number to return.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "default": 1,
        "description": "Page number to return.",
        "exclusiveMinimum": 0,
        "title": "Page",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of results per page.",
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 25,
        "description": "Maximum number of results per page.",
        "exclusiveMinimum": 0,
        "maximum": 100,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Search term used to filter user groups by name.",
      "examples": {},
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Search term used to filter user groups by name.",
        "examples": [
          "Engineering"
        ],
        "title": "Search"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminUserGroupsOut"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Get User Groups",
  "tags": [
    "beta.admin.user-groups"
  ],
  "components": {
    "schemas": {
      "AdminUserGroupsOut": {
        "properties": {
          "items": {
            "description": "User groups on this page.",
            "items": {
              "$ref": "#/components/schemas/AdminUserGroupOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "Page number returned.",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "Maximum number of results per page.",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "Total number of user groups that match the request.",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "items",
          "page",
          "page_size"
        ],
        "title": "AdminUserGroupsOut",
        "type": "object"
      },
      "AdminUserGroupOut": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional description of the user group.",
            "examples": [
              "Members of the platform engineering team"
            ],
            "title": "Description"
          },
          "externally_managed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the group is managed by an external system.",
            "title": "Externally Managed"
          },
          "name": {
            "description": "Name of the user group.",
            "examples": [
              "Engineering Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          },
          "organization_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Organization role assigned to the group.",
            "title": "Organization Role"
          },
          "parent_group_ids": {
            "description": "UUIDs of the groups this group is directly nested inside.",
            "examples": [
              [
                "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
              ]
            ],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Parent Group Ids",
            "type": "array"
          },
          "uuid": {
            "description": "User group ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "description"
        ],
        "title": "AdminUserGroupOut",
        "type": "object"
      }
    }
  }
}
