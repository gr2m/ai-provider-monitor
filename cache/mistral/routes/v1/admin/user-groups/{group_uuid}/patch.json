            "title": "Parent Group Ids"
          }
        },
        "title": "AdminUpdateUserGroupIn",
        "type": "object"
      },
      "AdminUserGroupOut": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
