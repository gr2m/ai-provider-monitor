                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated name of the user group.",
            "examples": [
              "Engineering Team"
            ],
            "title": "Name"
          },
          "parent_group_ids": {
            "anyOf": [
              {
                "items": {
