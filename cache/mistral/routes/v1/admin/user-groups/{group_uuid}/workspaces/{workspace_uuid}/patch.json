{
  "description": "Update the workspace role assignment for a user group.\n\nEither set the group's roles with `role_names` or `roles`, which replaces all the roles it has on the\nWorkspace, or change them with `add_role_names`/`add_roles` and `remove_role_names`/`remove_roles`, which\nkeeps its other roles.",
  "operationId": "users_admin_user_groups_update_group_workspace_assignment",
  "parameters": [
    {
      "description": "User group ID.",
      "in": "path",
      "name": "group_uuid",
      "required": true,
      "schema": {
        "description": "User group ID.",
        "format": "uuid",
        "title": "Group Uuid",
        "type": "string"
      }
    },
    {
      "description": "Workspace ID.",
      "in": "path",
      "name": "workspace_uuid",
      "required": true,
      "schema": {
        "description": "Workspace ID.",
        "format": "uuid",
        "title": "Workspace Uuid",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/AdminUpdateGroupWorkspaceAssignmentIn"
        }
      }
    },
    "required": true
  },
  "responses": {
    "204": {
      "description": "No Content"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Update Group Workspace Assignment",
  "tags": [
    "beta.admin.user-groups"
  ],
  "components": {
    "schemas": {
      "AdminUpdateGroupWorkspaceAssignmentIn": {
        "description": "Either set the group's roles on the Workspace, or add and remove some of them.",
        "properties": {
          "add_role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to add to the existing roles. Mutually exclusive with 'add_roles'.",
            "examples": [
              [
                "user"
              ]
            ],
            "title": "Add Role Names"
          },
          "add_roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to add to the existing roles. Mutually exclusive with 'add_role_names'.",
            "examples": [
              [
                "48436751-ee56-44bd-8a2d-712233977821"
              ]
            ],
            "title": "Add Roles"
          },
          "remove_role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to remove from the existing roles. Mutually exclusive with 'remove_roles'.",
            "examples": [
              [
                "dev"
              ]
            ],
            "title": "Remove Role Names"
          },
          "remove_roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to remove from the existing roles. Mutually exclusive with 'remove_role_names'.",
            "examples": [
              [
                "578584f1-4319-4c88-9948-38a5184483b6"
              ]
            ],
            "title": "Remove Roles"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              },
              {
                "$ref": "#/components/schemas/StaticWorkspaceRoles"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated single role value. Use 'role_names' instead."
          },
          "role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to assign. Mutually exclusive with 'roles'.",
            "title": "Role Names"
          },
          "roles": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WorkspaceRole"
                    },
                    {
                      "$ref": "#/components/schemas/StaticWorkspaceRoles"
                    }
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to assign. Mutually exclusive with 'role_names'.",
            "title": "Roles"
          }
        },
        "title": "AdminUpdateGroupWorkspaceAssignmentIn",
        "type": "object"
      },
      "StaticWorkspaceRoles": {
        "enum": [
          "48436751-ee56-44bd-8a2d-712233977821",
          "578584f1-4319-4c88-9948-38a5184483b6",
          "252a0825-40b9-4b98-be80-7658956f13e9",
          "17aa61c5-1c61-477e-a40a-e52c8ccd74b9",
          "b23cd6e0-91cd-4a8a-9869-b30366bf3966",
          "731eb2be-a74f-4070-b797-35bf7009e553"
        ],
        "title": "StaticWorkspaceRoles",
        "type": "string"
      },
      "WorkspaceRole": {
        "enum": [
          "A",
          "M"
        ],
        "title": "WorkspaceRole",
        "type": "string"
      }
    }
  }
}
