{
  "description": "Update a Workspace.",
  "operationId": "users_api_admin_workspaces_update_workspaces",
  "parameters": [
    {
      "description": "Workspace ID.",
      "in": "path",
      "name": "workspace_uuid",
      "required": true,
      "schema": {
        "description": "Workspace ID.",
        "format": "uuid",
        "title": "Workspace Uuid",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UpdateWorkspaceIN"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkspaceOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Update Workspaces",
  "tags": [
    "beta.admin.workspaces"
  ],
  "components": {
    "schemas": {
      "UpdateWorkspaceIN": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated Workspace description.",
            "examples": [
              "Workspace for product and design teams"
            ],
            "title": "Description"
          },
          "icon": {
            "anyOf": [
              {
                "maxLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated Workspace icon.",
            "examples": [
              "★"
            ],
            "title": "Icon"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated Workspace name.",
            "examples": [
              "Product Team"
            ],
            "title": "Name"
          }
        },
        "title": "UpdateWorkspaceIN",
        "type": "object"
      },
      "WorkspaceOUT": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace description.",
            "examples": [
              "Workspace for product and design teams"
            ],
            "title": "Description"
          },
          "groups_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of groups assigned to the Workspace.",
            "examples": [
              3
            ],
            "title": "Groups Count"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace icon.",
            "examples": [
              "★"
            ],
            "title": "Icon"
          },
          "is_default": {
            "description": "Whether this is the default Workspace for the Organization.",
            "title": "Is Default",
            "type": "boolean"
          },
          "members_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of members in the Workspace.",
            "title": "Members Count"
          },
          "name": {
            "description": "Workspace name.",
            "examples": [
              "Product Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          },
          "spend_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceSpendLimitOUT"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace spending limit."
          },
          "uuid": {
            "description": "Workspace ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "description",
          "icon",
          "is_default"
        ],
        "title": "WorkspaceOUT",
        "type": "object"
      },
      "WorkspaceSpendLimitOUT": {
        "properties": {
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Currency used for the Workspace spending limit.",
            "examples": [
              "USD"
            ],
            "title": "Currency"
          },
          "no_monthly_limit": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the Workspace has no monthly spending limit.",
            "title": "No Monthly Limit"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Monthly spending limit for the Workspace.",
            "title": "Value"
          }
        },
        "required": [
          "value",
          "currency",
          "no_monthly_limit"
        ],
        "title": "WorkspaceSpendLimitOUT",
        "type": "object"
      }
    }
  }
}
