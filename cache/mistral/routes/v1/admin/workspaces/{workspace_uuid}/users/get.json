{
  "description": "List the members of a Workspace, direct or through a group, with their roles.",
  "operationId": "users_api_admin_workspaces_list_workspace_users",
  "parameters": [
    {
      "description": "Workspace ID.",
      "in": "path",
      "name": "workspace_uuid",
      "required": true,
      "schema": {
        "description": "Workspace ID.",
        "format": "uuid",
        "title": "Workspace Uuid",
        "type": "string"
      }
    },
    {
      "description": "Page number to return.",
      "examples": {},
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "default": 1,
        "description": "Page number to return.",
        "examples": [
          1
        ],
        "exclusiveMinimum": 0,
        "maximum": 1000000,
        "title": "Page",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of results per page.",
      "examples": {},
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 25,
        "description": "Maximum number of results per page.",
        "examples": [
          25
        ],
        "exclusiveMinimum": 0,
        "maximum": 100,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Whether to include deactivated and blocked members.",
      "examples": {},
      "in": "query",
      "name": "include_inactive",
      "required": false,
      "schema": {
        "default": false,
        "description": "Whether to include deactivated and blocked members.",
        "examples": [
          false
        ],
        "title": "Include Inactive",
        "type": "boolean"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminWorkspaceUsersOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "List Workspace Users",
  "tags": [
    "beta.admin.workspaces"
  ],
  "components": {
    "schemas": {
      "AdminWorkspaceUsersOUT": {
        "properties": {
          "items": {
            "description": "Members of the Workspace on this page, direct or through a group.",
            "items": {
              "$ref": "#/components/schemas/AdminWorkspaceMemberOUT"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "Page number returned.",
            "examples": [
              1
            ],
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "Maximum number of results per page.",
            "examples": [
              25
            ],
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "Total number of members of the Workspace.",
            "examples": [
              42
            ],
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "AdminWorkspaceUsersOUT",
        "type": "object"
      },
      "AdminWorkspaceMemberOUT": {
        "properties": {
          "direct_member": {
            "description": "Whether the user is a direct member of the Workspace. Members who only belong to it through a group are managed by changing the group.",
            "examples": [
              true
            ],
            "title": "Direct Member",
            "type": "boolean"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Email address of the Workspace member.",
            "examples": [
              "alice.martin@example.com"
            ],
            "title": "Email"
          },
          "externally_managed": {
            "description": "Whether the member is managed by an external identity provider, through SSO or SCIM.",
            "examples": [
              false
            ],
            "title": "Externally Managed",
            "type": "boolean"
          },
          "group_grants": {
            "description": "Groups assigned to the Workspace that grant the member roles, with the roles each one grants.",
            "items": {
              "$ref": "#/components/schemas/AdminWorkspaceGroupGrantOUT"
            },
            "title": "Group Grants",
            "type": "array"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the Workspace member.",
            "examples": [
              "Alice Martin"
            ],
            "title": "Name"
          },
          "roles": {
            "description": "Names of the Workspace roles assigned directly to the member.",
            "examples": [
              [
                "workspace_admin"
              ]
            ],
            "items": {
              "enum": [
                "user",
                "dev",
                "mistral_code_user",
                "cloud_user",
                "workspace_contributor",
                "workspace_admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus",
            "description": "Account status of the member."
          },
          "user_id": {
            "description": "User ID of the Workspace member.",
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "name",
          "email",
          "direct_member",
          "roles",
          "group_grants",
          "externally_managed",
          "status"
        ],
        "title": "AdminWorkspaceMemberOUT",
        "type": "object"
      },
      "AdminWorkspaceGroupGrantOUT": {
        "properties": {
          "group_id": {
            "description": "ID of the group assigned to the Workspace.",
            "format": "uuid",
            "title": "Group Id",
            "type": "string"
          },
          "group_name": {
            "description": "Name of the group assigned to the Workspace.",
            "examples": [
              "Engineering"
            ],
            "title": "Group Name",
            "type": "string"
          },
          "roles": {
            "description": "Names of the Workspace roles the group assignment grants.",
            "examples": [
              [
                "user"
              ]
            ],
            "items": {
              "enum": [
                "user",
                "dev",
                "mistral_code_user",
                "cloud_user",
                "workspace_contributor",
                "workspace_admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "group_id",
          "group_name",
          "roles"
        ],
        "title": "AdminWorkspaceGroupGrantOUT",
        "type": "object"
      },
      "MemberStatus": {
        "enum": [
          "active",
          "deactivated",
          "blocked"
        ],
        "title": "MemberStatus",
        "type": "string"
      }
    }
  }
}
