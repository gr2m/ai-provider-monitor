{
  "description": "Add or update Workspace members.\n\nFor each member, either set its roles with `roles` or `role_names`, which replaces all the roles it has in\nthe Workspace, or change them with `add_roles`/`add_role_names` and `remove_roles`/`remove_role_names`,\nwhich keeps its other roles. Users who are not yet members are added with the given roles.",
  "operationId": "users_api_admin_workspaces_add_or_update_users_workspaces",
  "parameters": [
    {
      "description": "Workspace ID.",
      "in": "path",
      "name": "workspace_uuid",
      "required": true,
      "schema": {
        "description": "Workspace ID.",
        "format": "uuid",
        "title": "Workspace Uuid",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/AdminWorkspaceMemberUpsertIN"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AddOrUpdateUsersToWorkspaceOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Add Or Update Users Workspaces",
  "tags": [
    "beta.admin.workspaces"
  ],
  "components": {
    "schemas": {
      "AdminWorkspaceMemberUpsertIN": {
        "properties": {
          "members": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AdminWorkspaceMemberUpsertSingleIN"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace members to add or update. 'roles' or 'role_names' replace the member's roles; 'add_*' and 'remove_*' change them without touching the others.",
            "title": "Members"
          }
        },
        "title": "AdminWorkspaceMemberUpsertIN",
        "type": "object"
      },
      "AddOrUpdateUsersToWorkspaceOUT": {
        "properties": {
          "added_members_count": {
            "description": "Number of users added to the Workspace.",
            "title": "Added Members Count",
            "type": "integer"
          },
          "updated_members_count": {
            "description": "Number of Workspace members updated.",
            "title": "Updated Members Count",
            "type": "integer"
          }
        },
        "required": [
          "added_members_count",
          "updated_members_count"
        ],
        "title": "AddOrUpdateUsersToWorkspaceOUT",
        "type": "object"
      },
      "AdminWorkspaceMemberUpsertSingleIN": {
        "description": "Workspace member to add or update, either by setting its roles or by adding and removing some.",
        "properties": {
          "add_role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to add to the existing roles. Mutually exclusive with 'add_roles'.",
            "examples": [
              [
                "user"
              ]
            ],
            "title": "Add Role Names"
          },
          "add_roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to add to the existing roles. Mutually exclusive with 'add_role_names'.",
            "examples": [
              [
                "48436751-ee56-44bd-8a2d-712233977821"
              ]
            ],
            "title": "Add Roles"
          },
          "remove_role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to remove from the existing roles. Mutually exclusive with 'remove_roles'.",
            "examples": [
              [
                "dev"
              ]
            ],
            "title": "Remove Role Names"
          },
          "remove_roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to remove from the existing roles. Mutually exclusive with 'remove_role_names'.",
            "examples": [
              [
                "578584f1-4319-4c88-9948-38a5184483b6"
              ]
            ],
            "title": "Remove Roles"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              },
              {
                "$ref": "#/components/schemas/StaticWorkspaceRoles"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated legacy single role value, kept for backward compatibility. Mutually exclusive with 'role_name'."
          },
          "role_name": {
            "anyOf": [
              {
                "enum": [
                  "user",
                  "dev",
                  "mistral_code_user",
                  "cloud_user",
                  "workspace_contributor",
                  "workspace_admin"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Deprecated single role name, kept for backward compatibility. Mutually exclusive with 'role'.",
            "title": "Role Name"
          },
          "role_names": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "user",
                    "dev",
                    "mistral_code_user",
                    "cloud_user",
                    "workspace_contributor",
                    "workspace_admin"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simplified role names to assign. Mutually exclusive with 'roles'.",
            "title": "Role Names"
          },
          "roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/WorkspaceRole"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Role values to assign. Mutually exclusive with 'role_names'.",
            "title": "Roles"
          },
          "user_uuid": {
            "description": "User ID of the Workspace member.",
            "format": "uuid",
            "title": "User Uuid",
            "type": "string"
          }
        },
        "required": [
          "user_uuid"
        ],
        "title": "AdminWorkspaceMemberUpsertSingleIN",
        "type": "object"
      },
      "StaticWorkspaceRoles": {
        "enum": [
          "48436751-ee56-44bd-8a2d-712233977821",
          "578584f1-4319-4c88-9948-38a5184483b6",
          "252a0825-40b9-4b98-be80-7658956f13e9",
          "17aa61c5-1c61-477e-a40a-e52c8ccd74b9",
          "b23cd6e0-91cd-4a8a-9869-b30366bf3966",
          "731eb2be-a74f-4070-b797-35bf7009e553"
        ],
        "title": "StaticWorkspaceRoles",
        "type": "string"
      },
      "WorkspaceRole": {
        "enum": [
          "A",
          "M"
        ],
        "title": "WorkspaceRole",
        "type": "string"
      }
    }
  }
}
