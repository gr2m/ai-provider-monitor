{
  "description": "Create a Workspace.",
  "operationId": "users_api_admin_workspaces_create_workspace",
  "parameters": [],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/AdminWorkspaceIn"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkspaceEnrichedOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Create Workspace",
  "tags": [
    "beta.admin.workspaces"
  ],
  "components": {
    "schemas": {
      "AdminWorkspaceIn": {
        "properties": {
          "add_all_org_members": {
            "default": false,
            "description": "Whether to add all Organization members to the Workspace.",
            "title": "Add All Org Members",
            "type": "boolean"
          },
          "admin_user_id": {
            "description": "User ID to grant the Workspace Admin role to.",
            "format": "uuid",
            "title": "Admin User Id",
            "type": "string"
          },
          "description": {
            "default": "",
            "description": "Workspace description.",
            "examples": [
              "Workspace for product and design teams"
            ],
            "maxLength": 255,
            "title": "Description",
            "type": "string"
          },
          "icon": {
            "default": "",
            "description": "Workspace icon.",
            "examples": [
              "★"
            ],
            "maxLength": 2,
            "title": "Icon",
            "type": "string"
          },
          "name": {
            "description": "Workspace name.",
            "examples": [
              "Product Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "admin_user_id"
        ],
        "title": "AdminWorkspaceIn",
        "type": "object"
      },
      "WorkspaceEnrichedOUT": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace description.",
            "examples": [
              "Workspace for product and design teams"
            ],
            "title": "Description"
          },
          "groups_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of groups assigned to the Workspace.",
            "examples": [
              3
            ],
            "title": "Groups Count"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace icon.",
            "examples": [
              "★"
            ],
            "title": "Icon"
          },
          "is_default": {
            "description": "Whether this is the default Workspace for the Organization.",
            "title": "Is Default",
            "type": "boolean"
          },
          "members_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of members in the Workspace.",
            "title": "Members Count"
          },
          "name": {
            "description": "Workspace name.",
            "examples": [
              "Product Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          },
          "raw_role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceRole"
              },
              {
                "$ref": "#/components/schemas/StaticWorkspaceRoles"
              },
              {
                "$ref": "#/components/schemas/StaticOrganizationRoles"
              }
            ],
            "deprecated": true,
            "description": "Deprecated single role for the Workspace. Use 'raw_roles' instead.",
            "title": "Raw Role"
          },
          "raw_roles": {
            "description": "Roles granted for the Workspace.",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/WorkspaceRole"
                },
                {
                  "$ref": "#/components/schemas/StaticWorkspaceRoles"
                },
                {
                  "$ref": "#/components/schemas/StaticOrganizationRoles"
                }
              ]
            },
            "minItems": 1,
            "title": "Raw Roles",
            "type": "array"
          },
          "spend_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceSpendLimitOUT"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace spending limit."
          },
          "uuid": {
            "description": "Workspace ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "description",
          "icon",
          "is_default",
          "raw_roles",
          "raw_role"
        ],
        "title": "WorkspaceEnrichedOUT",
        "type": "object"
