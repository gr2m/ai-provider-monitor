{
  "description": "List Workspaces in the Organization.",
  "operationId": "users_api_admin_workspaces_get_workspaces",
  "parameters": [
    {
      "description": "Whether to include archived Workspaces.",
      "in": "query",
      "name": "is_archived",
      "required": false,
      "schema": {
        "default": false,
        "description": "Whether to include archived Workspaces.",
        "title": "Is Archived",
        "type": "boolean"
      }
    },
    {
      "description": "Page number to return.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "default": 1,
        "description": "Page number to return.",
        "exclusiveMinimum": 0,
        "title": "Page",
        "type": "integer"
      }
    },
    {
      "description": "Maximum number of results per page.",
      "in": "query",
      "name": "page_size",
      "required": false,
      "schema": {
        "default": 25,
        "description": "Maximum number of results per page.",
        "exclusiveMinimum": 0,
        "maximum": 100,
        "title": "Page Size",
        "type": "integer"
      }
    },
    {
      "description": "Search term to filter Workspaces by name.",
      "examples": {},
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Search term to filter Workspaces by name.",
        "examples": [
          "Product"
        ],
        "title": "Search"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WorkspacesOut"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Get Workspaces",
  "tags": [
    "beta.admin.workspaces"
  ],
  "components": {
    "schemas": {
      "WorkspacesOut": {
        "properties": {
          "items": {
            "description": "Workspaces on this page.",
            "items": {
              "$ref": "#/components/schemas/WorkspaceOUT"
            },
            "title": "Items",
            "type": "array"
          },
          "object": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiObjectType"
              }
            ],
            "default": "list",
            "description": "Type of paginated API object."
          },
          "page": {
            "description": "Page number returned.",
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "description": "Maximum number of results per page.",
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "description": "Total number of Workspaces that match the request.",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "items",
          "page",
          "page_size"
        ],
        "title": "WorkspacesOut",
        "type": "object"
      },
      "WorkspaceOUT": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace description.",
            "examples": [
              "Workspace for product and design teams"
            ],
            "title": "Description"
          },
          "groups_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of groups assigned to the Workspace.",
            "examples": [
              3
            ],
            "title": "Groups Count"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace icon.",
            "examples": [
              "★"
            ],
            "title": "Icon"
          },
          "is_default": {
            "description": "Whether this is the default Workspace for the Organization.",
            "title": "Is Default",
            "type": "boolean"
          },
          "members_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of members in the Workspace.",
            "title": "Members Count"
          },
          "name": {
            "description": "Workspace name.",
            "examples": [
              "Product Team"
            ],
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          },
          "spend_limit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceSpendLimitOUT"
              },
              {
                "type": "null"
              }
            ],
            "description": "Workspace spending limit."
          },
          "uuid": {
            "description": "Workspace ID.",
            "format": "uuid",
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "description",
          "icon",
          "is_default"
        ],
        "title": "WorkspaceOUT",
        "type": "object"
      },
      "ApiObjectType": {
        "description": "Type of API object for pagination responses.",
        "enum": [
          "list"
        ],
        "title": "ApiObjectType",
        "type": "string"
      },
      "WorkspaceSpendLimitOUT": {
        "properties": {
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Currency used for the Workspace spending limit.",
            "examples": [
              "USD"
            ],
            "title": "Currency"
          },
          "no_monthly_limit": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the Workspace has no monthly spending limit.",
            "title": "No Monthly Limit"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Monthly spending limit for the Workspace.",
            "title": "Value"
          }
        },
        "required": [
          "value",
          "currency",
          "no_monthly_limit"
        ],
        "title": "WorkspaceSpendLimitOUT",
        "type": "object"
      }
    }
  }
}
