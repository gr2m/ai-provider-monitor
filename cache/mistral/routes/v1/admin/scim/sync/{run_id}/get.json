{
  "description": "Retrieve an on-demand SCIM synchronization run for the Organization.\n\nReturns the run's lifecycle status along with the preview or result summary\nonce the synchronization plan has been built.",
  "operationId": "users_api_admin_scim_sync_get_scim_sync_run",
  "parameters": [
    {
      "description": "Identifier of the SCIM synchronization run.",
      "examples": {},
      "in": "path",
      "name": "run_id",
      "required": true,
      "schema": {
        "description": "Identifier of the SCIM synchronization run.",
        "examples": [
          "6f9619ff-8b86-d011-b42d-00cf4fc964ff"
        ],
        "format": "uuid",
        "title": "Run Id",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminScimSyncRunOUT"
          }
        }
      },
      "description": "OK"
    }
  },
  "security": [
    {
      "AdminApiKey": []
    }
  ],
  "summary": "Get Scim Sync Run",
  "tags": [
    "beta.admin.scim"
  ],
  "components": {
    "schemas": {
      "AdminScimSyncRunOUT": {
        "properties": {
          "created_at": {
            "description": "Time at which the synchronization run was created.",
            "examples": [
              "2026-07-28T10:00:00Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dry_run": {
            "description": "Whether the run only previewed changes.",
            "examples": [
              true
            ],
            "title": "Dry Run",
            "type": "boolean"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure detail when the synchronization run could not complete.",
            "examples": [
              "Failed to fetch users from the SCIM provider."
            ],
            "title": "Error Message"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time at which processing finished, if it has finished.",
            "examples": [
              "2026-07-28T10:00:05Z"
            ],
            "title": "Finished At"
          },
          "run_id": {
            "description": "Unique identifier of the SCIM synchronization run.",
            "examples": [
              "6f9619ff-8b86-d011-b42d-00cf4fc964ff"
            ],
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time at which processing started, if it has started.",
            "examples": [
              "2026-07-28T10:00:01Z"
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/ScimSyncRunStatus",
            "description": "Current lifecycle status of the synchronization run.",
            "examples": [
              "SUCCESS"
            ]
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScimSyncSummaryOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preview or result summary, available after the synchronization plan is built.",
            "examples": [
              {
                "groups": {},
                "memberships": [],
                "users": {
                  "deprovision": [],
                  "provision": []
                }
              }
            ]
          },
          "sync_config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdminScimSyncConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "Categories selected for this synchronization run.",
            "examples": [
              {
                "delete_missing_groups": true,
                "deprovision_users": true,
                "sync_groups": true,
                "sync_memberships": true,
                "sync_users": true
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "dry_run",
          "sync_config",
          "created_at",
          "started_at",
          "finished_at",
          "summary",
          "error_message"
        ],
        "title": "AdminScimSyncRunOUT",
        "type": "object"
      },
      "ScimSyncRunStatus": {
        "enum": [
          "PENDING",
          "RUNNING",
          "SUCCESS",
          "SKIPPED",
          "FAILED"
        ],
        "title": "ScimSyncRunStatus",
        "type": "string"
      },
      "ScimSyncSummaryOut": {
        "properties": {
          "groups": {
            "$ref": "#/components/schemas/ScimSyncGroupsSummaryOut"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncMembershipActionOut"
            },
            "title": "Memberships",
            "type": "array"
          },
          "users": {
            "$ref": "#/components/schemas/ScimSyncUsersSummaryOut"
          }
        },
        "required": [
          "users",
          "groups",
          "memberships"
        ],
        "title": "ScimSyncSummaryOut",
        "type": "object"
      },
      "AdminScimSyncConfig": {
        "properties": {
          "delete_missing_groups": {
            "default": false,
            "description": "Delete Organization groups that are absent from the SCIM provider.",
            "examples": [
              false
            ],
            "title": "Delete Missing Groups",
            "type": "boolean"
          },
          "deprovision_users": {
            "default": false,
            "description": "Remove Organization users that are inactive or absent from the SCIM provider.",
            "examples": [
              false
            ],
            "title": "Deprovision Users",
            "type": "boolean"
          },
          "sync_groups": {
            "description": "Synchronize group metadata from the SCIM provider.",
            "examples": [
              true
            ],
            "title": "Sync Groups",
            "type": "boolean"
          },
          "sync_memberships": {
            "description": "Synchronize additions and removals of users in SCIM groups.",
            "examples": [
              true
            ],
            "title": "Sync Memberships",
            "type": "boolean"
          },
          "sync_users": {
            "description": "Add users found in the SCIM provider to the Organization.",
            "examples": [
              true
            ],
            "title": "Sync Users",
            "type": "boolean"
          }
        },
        "required": [
          "sync_users",
          "sync_groups",
          "sync_memberships"
        ],
        "title": "AdminScimSyncConfig",
        "type": "object"
      },
      "ScimSyncGroupsSummaryOut": {
        "properties": {
          "create": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncGroupActionOut"
            },
            "title": "Create",
            "type": "array"
          },
          "delete": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncGroupActionOut"
            },
            "title": "Delete",
            "type": "array"
          },
          "update": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncGroupUpdateActionOut"
            },
            "title": "Update",
            "type": "array"
          }
        },
        "required": [
          "create",
          "update",
          "delete"
        ],
        "title": "ScimSyncGroupsSummaryOut",
        "type": "object"
      },
      "ScimSyncMembershipActionOut": {
        "properties": {
          "group": {
            "$ref": "#/components/schemas/ScimSyncGroupRefOut"
          },
          "users_added": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncUserRefOut"
            },
            "title": "Users Added",
            "type": "array"
          },
          "users_removed": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncUserRefOut"
            },
            "title": "Users Removed",
            "type": "array"
          }
        },
        "required": [
          "group",
          "users_added",
          "users_removed"
        ],
        "title": "ScimSyncMembershipActionOut",
        "type": "object"
      },
      "ScimSyncUsersSummaryOut": {
        "properties": {
          "deprovision": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncUserActionOut"
            },
            "title": "Deprovision",
            "type": "array"
          },
          "provision": {
            "items": {
              "$ref": "#/components/schemas/ScimSyncUserActionOut"
            },
            "title": "Provision",
            "type": "array"
          }
        },
        "required": [
          "provision",
          "deprovision"
        ],
        "title": "ScimSyncUsersSummaryOut",
        "type": "object"
      },
      "ScimSyncGroupActionOut": {
        "properties": {
          "group": {
            "$ref": "#/components/schemas/ScimSyncGroupRefOut"
          }
        },
        "required": [
          "group"
        ],
        "title": "ScimSyncGroupActionOut",
        "type": "object"
      },
      "ScimSyncGroupUpdateActionOut": {
        "properties": {
          "group": {
            "$ref": "#/components/schemas/ScimSyncGroupRefOut"
          },
          "previous_groupName": {
            "title": "Previous Groupname",
            "type": "string"
          }
        },
        "required": [
          "group",
          "previous_groupName"
        ],
        "title": "ScimSyncGroupUpdateActionOut",
        "type": "object"
      },
      "ScimSyncGroupRefOut": {
        "properties": {
          "groupName": {
            "title": "Groupname",
            "type": "string"
          },
          "uuid": {
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "groupName"
        ],
        "title": "ScimSyncGroupRefOut",
        "type": "object"
      },
      "ScimSyncUserRefOut": {
        "properties": {
          "userName": {
            "title": "Username",
            "type": "string"
          },
          "uuid": {
            "title": "Uuid",
            "type": "string"
          }
        },
        "required": [
          "uuid"
        ],
        "title": "ScimSyncUserRefOut",
        "type": "object"
      },
      "ScimSyncUserActionOut": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/ScimSyncUserRefOut"
          }
        },
        "required": [
          "user"
        ],
        "title": "ScimSyncUserActionOut",
        "type": "object"
      }
    }
  }
}
