{
  "description": "Speech",
  "operationId": "speech_v1_audio_speech_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/SpeechRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "additionalProperties": false,
            "properties": {
              "audio_data": {
                "description": "Base64 encoded audio data",
                "title": "Audio Data",
                "type": "string"
              }
            },
            "required": [
              "audio_data"
            ],
            "title": "SpeechResponse",
            "type": "object"
          }
        },
        "text/event-stream": {
          "schema": {
            "$defs": {
              "CompletionTokensDetails": {
                "additionalProperties": false,
                "description": "Token usage details for the completion.",
                "properties": {
                  "reasoning_tokens": {
                    "default": 0,
                    "title": "Reasoning Tokens",
                    "type": "integer"
                  }
                },
                "title": "CompletionTokensDetails",
                "type": "object"
              },
              "MessageTokens": {
                "additionalProperties": false,
                "description": "Information on a single message included in a tokenized prompt as part of an InstructRequest.",
                "properties": {
                  "role": {
                    "$ref": "#/$defs/Roles"
                  },
                  "settings_tokens": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Settings Tokens"
                  },
                  "total_tokens": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Total Tokens"
                  },
                  "truncated": {
                    "default": false,
                    "title": "Truncated",
                    "type": "boolean"
                  },
                  "usage_count": {
                    "default": 1,
                    "title": "Usage Count",
                    "type": "integer"
                  }
                },
                "required": [
                  "role"
                ],
                "title": "MessageTokens",
                "type": "object"
              },
              "PromptTokensDetails": {
                "additionalProperties": false,
                "description": "Token usage details for the prompt.",
                "properties": {
                  "audio_tokens": {
                    "default": 0,
                    "title": "Audio Tokens",
                    "type": "integer"
                  },
                  "cached_tokens": {
                    "default": 0,
                    "title": "Cached Tokens",
                    "type": "integer"
                  },
                  "messages": {
                    "items": {
                      "$ref": "#/$defs/MessageTokens"
                    },
                    "title": "Messages",
                    "type": "array"
                  }
                },
                "title": "PromptTokensDetails",
                "type": "object"
              },
              "Roles": {
                "enum": [
                  "system",
                  "user",
                  "assistant",
                  "tool"
                ],
                "title": "Roles",
                "type": "string"
              },
              "SpeechStreamAudioDelta": {
                "additionalProperties": false,
                "properties": {
                  "audio_data": {
                    "title": "Audio Data",
                    "type": "string"
                  },
                  "type": {
                    "const": "speech.audio.delta",
                    "default": "speech.audio.delta",
                    "title": "Type",
                    "type": "string"
                  }
                },
                "required": [
                  "audio_data"
                ],
                "title": "SpeechStreamAudioDelta",
                "type": "object"
              },
              "SpeechStreamDone": {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "speech.audio.done",
                    "default": "speech.audio.done",
                    "title": "Type",
                    "type": "string"
                  },
                  "usage": {
                    "$ref": "#/$defs/UsageInfo"
                  }
                },
                "required": [
                  "usage"
                ],
                "title": "SpeechStreamDone",
                "type": "object"
              },
              "SpeechStreamEventTypes": {
                "enum": [
                  "speech.audio.delta",
                  "speech.audio.done"
                ],
                "title": "SpeechStreamEventTypes",
                "type": "string"
              },
              "UsageInfo": {
                "additionalProperties": false,
                "properties": {
                  "completion_tokens": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": 0,
                    "title": "Completion Tokens"
                  },
                  "completion_tokens_details": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/CompletionTokensDetails"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "num_cached_tokens": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Num Cached Tokens"
                  },
                  "prompt_audio_seconds": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Prompt Audio Seconds"
                  },
                  "prompt_token_details": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/PromptTokensDetails"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prompt_tokens": {
                    "default": 0,
                    "title": "Prompt Tokens",
                    "type": "integer"
                  },
                  "prompt_tokens_details": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/PromptTokensDetails"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "request_count": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Request Count"
                  },
                  "service_tier": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The service tier at which the request was processed: standard or priority.",
                    "title": "Service Tier"
                  },
                  "total_tokens": {
                    "default": 0,
                    "title": "Total Tokens",
                    "type": "integer"
                  }
                },
                "title": "UsageInfo",
                "type": "object"
              }
            },
            "additionalProperties": false,
            "properties": {
              "data": {
                "discriminator": {
                  "mapping": {
                    "speech.audio.delta": "#/$defs/SpeechStreamAudioDelta",
                    "speech.audio.done": "#/$defs/SpeechStreamDone"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/SpeechStreamAudioDelta"
                  },
                  {
                    "$ref": "#/$defs/SpeechStreamDone"
                  }
                ],
                "title": "Data"
              },
              "event": {
                "$ref": "#/$defs/SpeechStreamEventTypes"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "title": "SpeechStreamEvents",
            "type": "object"
          }
        }
      },
      "description": "Speech audio data."
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Speech",
  "tags": [
    "audio.speech"
  ],
  "components": {
    "schemas": {
      "SpeechRequest": {
        "additionalProperties": true,
        "properties": {
          "input": {
            "description": "Text to generate a speech from",
            "title": "Input",
            "type": "string"
          },
          "metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetadataDict"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "phoneme_hints": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "$ref": "#/components/schemas/IPAPhoneme"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional pronunciation hints mapping a (case-sensitive) word to its ordered list of IPA phones.",
            "title": "Phoneme Hints"
          },
          "prompt_cache_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Cache Key"
          },
          "ref_audio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "contentMediaType": "application/octet-stream",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The audio reference for generating the speech.",
            "title": "Ref Audio"
          },
          "response_format": {
            "$ref": "#/components/schemas/SpeechOutputFormat",
            "default": "mp3",
            "description": "Output audio format. Defaults to mp3."
          },
          "stream": {
            "default": false,
            "title": "Stream",
            "type": "boolean"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The preset or custom voice to use for generating the speech.",
            "title": "Voice Id"
          }
        },
        "required": [
          "input"
        ],
        "title": "SpeechRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MetadataDict": {
        "additionalProperties": true,
        "description": "Custom type for metadata with embedded validation.",
        "properties": {},
        "title": "MetadataDict",
        "type": "object"
      },
      "IPAPhoneme": {
        "description": "The IPA phone inventory usable in pronunciation hints.\n\n``StrEnum`` members' values are their (lowercase) names via ``auto()``, so each member IS\nthe IPA string it represents. Using an enum makes ``phoneme_hints`` values self-validating\nat the API boundary (pydantic rejects any phone outside this set). **Append-only**: never\nreorder or remove entries, only add new phones (e.g. for future languages) at the end.",
        "enum": [
          "a",
          "aɪ",
          "aʊ",
          "b",
          "d",
          "dʒ",
          "e",
          "eɪ",
          "f",
          "g",
          "h",
          "i",
          "j",
          "k",
          "l",
          "m",
          "n",
          "o",
          "oʊ",
          "p",
          "s",
          "t",
          "tʃ",
          "u",
          "v",
          "w",
          "z",
          "æ",
          "ð",
          "ŋ",
          "ɑ",
          "ɔ",
          "ɔɪ",
          "ɖ",
          "ə",
          "ɚ",
          "ɛ",
          "ɜ",
          "ɪ",
          "ɱ",
          "ɹ",
          "ɾ",
          "ʃ",
          "ʈ",
          "ʊ",
          "ʋ",
          "ʌ",
          "ʒ",
          "ʔ",
          "θ"
        ],
        "title": "IPAPhoneme",
        "type": "string"
      },
      "SpeechOutputFormat": {
        "enum": [
          "pcm",
          "wav",
          "mp3",
          "flac",
          "opus"
        ],
        "title": "SpeechOutputFormat",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
