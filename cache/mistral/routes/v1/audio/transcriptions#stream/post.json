{
  "description": "Create Streaming Transcription (SSE)",
  "operationId": "audio_api_v1_transcriptions_post_stream",
  "requestBody": {
    "content": {
      "multipart/form-data": {
        "schema": {
          "$ref": "#/components/schemas/AudioTranscriptionRequestStream"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "text/event-stream": {
          "schema": {
            "$ref": "#/components/schemas/TranscriptionStreamEvents"
          }
        }
      },
      "description": "Stream of transcription events"
    }
  },
  "summary": "Create Streaming Transcription (SSE)",
  "tags": [
    "audio.transcriptions"
  ],
  "components": {
    "schemas": {
      "AudioTranscriptionRequestStream": {
        "properties": {
          "context_bias": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Context Bias",
            "type": "array"
          },
          "diarize": {
            "default": false,
            "title": "Diarize",
            "type": "boolean"
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "File"
          },
          "file_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ID of a file uploaded to /v1/files",
            "title": "File Id"
          },
          "file_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Url of a file to be transcribed",
            "title": "File Url"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^\\w{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Language of the audio, e.g. 'en'. Providing the language can boost accuracy.",
            "title": "Language"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "speaker_references": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Dictionary of speaker names and reference audios for speakers who are known to appear in the audio. When enabled, diarize must be true. Predicted speakers will be matched against reference speakers from this dictionary.",
            "title": "Speaker References",
            "type": "object"
          },
          "stream": {
            "const": true,
            "default": true,
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temperature"
          },
          "timestamp_granularities": {
            "description": "Granularities of timestamps to include in the response.",
            "items": {
              "$ref": "#/components/schemas/TimestampGranularity"
            },
            "title": "Timestamp Granularities",
            "type": "array"
          }
        },
        "required": [
          "model"
        ],
        "title": "AudioTranscriptionRequestStream",
        "type": "object"
      },
      "TranscriptionStreamEvents": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "discriminator": {
              "mapping": {
                "transcription.done": "#/components/schemas/TranscriptionStreamDone",
                "transcription.language": "#/components/schemas/TranscriptionStreamLanguage",
                "transcription.segment": "#/components/schemas/TranscriptionStreamSegmentDelta",
                "transcription.text.delta": "#/components/schemas/TranscriptionStreamTextDelta",
                "turn.eager_end": "#/components/schemas/TurnDetectionEagerEndEvent",
                "turn.end": "#/components/schemas/TurnDetectionEndEvent",
                "turn.resume": "#/components/schemas/TurnDetectionResumeEvent",
                "turn.start": "#/components/schemas/TurnDetectionStartEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TranscriptionStreamTextDelta"
              },
              {
                "$ref": "#/components/schemas/TranscriptionStreamLanguage"
              },
              {
                "$ref": "#/components/schemas/TranscriptionStreamSegmentDelta"
              },
              {
                "$ref": "#/components/schemas/TranscriptionStreamDone"
              },
              {
                "$ref": "#/components/schemas/TurnDetectionStartEvent"
              },
              {
                "$ref": "#/components/schemas/TurnDetectionEagerEndEvent"
              },
              {
                "$ref": "#/components/schemas/TurnDetectionResumeEvent"
              },
              {
                "$ref": "#/components/schemas/TurnDetectionEndEvent"
              }
            ],
            "title": "Data"
          },
          "event": {
            "$ref": "#/components/schemas/TranscriptionStreamEventTypes",
            "title": "Event"
          }
        },
        "required": [
          "event",
          "data"
        ],
        "title": "TranscriptionStreamEvents",
        "type": "object"
      },
      "File": {
        "description": "The File object (not file name) to be uploaded.\n To upload a file and specify a custom file name you should format your request as such:\n ```bash\n file=@path/to/your/file.jsonl;filename=custom_name.jsonl\n ```\n Otherwise, you can just keep the original file name:\n ```bash\n file=@path/to/your/file.jsonl\n ```",
        "format": "binary",
        "title": "File",
        "type": "string"
      },
      "TimestampGranularity": {
        "enum": [
          "segment",
          "word"
        ],
        "title": "TimestampGranularity",
        "type": "string"
      },
      "TranscriptionStreamTextDelta": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "transcription.text.delta",
            "default": "transcription.text.delta",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TranscriptionStreamTextDelta",
        "type": "object"
      },
      "TranscriptionStreamLanguage": {
        "additionalProperties": false,
        "properties": {
          "audio_language": {
            "pattern": "^\\w{2}$",
            "title": "Audio Language",
            "type": "string"
          },
          "type": {
            "const": "transcription.language",
            "default": "transcription.language",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "audio_language"
        ],
        "title": "TranscriptionStreamLanguage",
        "type": "object"
      },
      "TranscriptionStreamSegmentDelta": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "speaker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Speaker Id"
          },
          "start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "transcription.segment",
            "default": "transcription.segment",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text",
          "start",
          "end"
        ],
        "title": "TranscriptionStreamSegmentDelta",
        "type": "object"
      },
      "TranscriptionStreamDone": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "anyOf": [
              {
                "pattern": "^\\w{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/TranscriptionSegmentChunk"
            },
            "title": "Segments",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "transcription.done",
            "default": "transcription.done",
            "title": "Type",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageInfo"
          }
        },
        "required": [
          "model",
          "text",
          "language",
          "usage"
        ],
        "title": "TranscriptionStreamDone",
        "type": "object"
      },
      "TurnDetectionStartEvent": {
        "additionalProperties": false,
        "properties": {
          "time_s": {
            "minimum": 0,
            "title": "Time S",
            "type": "number"
          },
          "type": {
            "const": "turn.start",
            "default": "turn.start",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "time_s"
        ],
        "title": "TurnDetectionStartEvent",
        "type": "object"
      },
      "TurnDetectionEagerEndEvent": {
        "additionalProperties": false,
        "properties": {
          "time_s": {
            "minimum": 0,
            "title": "Time S",
            "type": "number"
          },
          "type": {
            "const": "turn.eager_end",
            "default": "turn.eager_end",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "time_s"
        ],
        "title": "TurnDetectionEagerEndEvent",
        "type": "object"
      },
      "TurnDetectionResumeEvent": {
        "additionalProperties": false,
        "properties": {
          "time_s": {
            "minimum": 0,
            "title": "Time S",
            "type": "number"
          },
          "type": {
            "const": "turn.resume",
            "default": "turn.resume",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "time_s"
        ],
        "title": "TurnDetectionResumeEvent",
        "type": "object"
      },
      "TurnDetectionEndEvent": {
        "additionalProperties": false,
        "properties": {
          "end_reason": {
            "$ref": "#/components/schemas/TurnDetectionEndReason"
          },
          "time_s": {
            "minimum": 0,
            "title": "Time S",
            "type": "number"
          },
          "type": {
            "const": "turn.end",
            "default": "turn.end",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "time_s",
          "end_reason"
        ],
        "title": "TurnDetectionEndEvent",
        "type": "object"
      },
      "TranscriptionStreamEventTypes": {
        "enum": [
          "transcription.language",
          "transcription.segment",
          "transcription.text.delta",
          "transcription.done",
          "turn.start",
          "turn.eager_end",
          "turn.resume",
          "turn.end"
        ],
        "title": "TranscriptionStreamEventTypes",
        "type": "string"
      },
      "TranscriptionSegmentChunk": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "speaker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speaker Id"
          },
          "start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "type": {
            "const": "transcription_segment",
            "default": "transcription_segment",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "text",
          "start",
          "end"
        ],
        "title": "TranscriptionSegmentChunk",
        "type": "object"
      },
      "UsageInfo": {
        "additionalProperties": false,
        "properties": {
          "completion_tokens": {
            "default": 0,
            "title": "Completion Tokens",
            "type": "integer"
          },
          "prompt_audio_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Audio Seconds"
          },
          "prompt_tokens": {
            "default": 0,
            "title": "Prompt Tokens",
            "type": "integer"
          },
          "prompt_tokens_details": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PromptTokensDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "service_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The service tier at which the request was processed: standard or priority.",
            "title": "Service Tier"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "title": "UsageInfo",
        "type": "object"
      },
      "TurnDetectionEndReason": {
        "enum": [
          "threshold",
          "timeout"
        ],
        "title": "TurnDetectionEndReason",
        "type": "string"
      },
      "PromptTokensDetails": {
        "additionalProperties": false,
        "description": "Token usage details for the prompt.",
        "properties": {
          "audio_tokens": {
            "default": 0,
            "title": "Audio Tokens",
            "type": "integer"
          },
          "cached_tokens": {
            "default": 0,
            "title": "Cached Tokens",
            "type": "integer"
          }
        },
        "title": "PromptTokensDetails",
        "type": "object"
      }
    }
  }
}
