{
  "description": "Validates and persists documents. Returns 200 with each document reported as accepted or rejected in the response body, or 403 once the index holds its limit of chunks.",
  "operationId": "ingest_documents_v1_context_search_indexes__index_name__documents_post",
  "parameters": [
    {
      "in": "path",
      "name": "index_name",
      "required": true,
      "schema": {
        "title": "Index Name",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/IngestDocumentsRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/IngestDocumentsResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "403": {
      "description": "Index has reached its chunk limit"
    },
    "404": {
      "description": "Index not found"
    },
    "409": {
      "description": "Index is not ready for ingestion"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Ingest documents into a managed index",
  "tags": [
    "beta.context.search_indexes"
  ],
  "components": {
    "schemas": {
      "IngestDocumentsRequest": {
        "additionalProperties": false,
        "properties": {
          "documents": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "title": "IngestDocumentsRequest",
        "type": "object"
      },
      "IngestDocumentsResponse": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "rejected": {
            "title": "Rejected",
            "type": "integer"
          },
          "results": {
            "items": {
              "discriminator": {
                "mapping": {
                  "accepted": "#/components/schemas/AcceptedDocumentResponse",
                  "rejected": "#/components/schemas/RejectedDocumentResponse"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AcceptedDocumentResponse"
                },
                {
                  "$ref": "#/components/schemas/RejectedDocumentResponse"
                }
              ]
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "rejected",
          "results"
        ],
        "title": "IngestDocumentsResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "AcceptedDocumentResponse": {
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "position",
          "document_id",
          "chunk_count"
        ],
        "title": "AcceptedDocumentResponse",
        "type": "object"
      },
      "RejectedDocumentResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/DocumentFieldErrorResponse"
            },
            "title": "Errors",
            "type": "array"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "status": {
            "const": "rejected",
            "default": "rejected",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "position",
          "errors"
        ],
        "title": "RejectedDocumentResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "DocumentFieldErrorResponse": {
        "description": "A single field-level validation failure within a rejected document.",
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "location",
          "type",
          "message"
        ],
        "title": "DocumentFieldErrorResponse",
        "type": "object"
      }
    }
  }
}
