{
  "description": "Marks the managed search index for deletion and returns it with status deleting. The backing table is dropped asynchronously; poll the index until it returns 404.",
  "operationId": "delete_index_v1_context_search_indexes__index_name__delete",
  "parameters": [
    {
      "in": "path",
      "name": "index_name",
      "required": true,
      "schema": {
        "title": "Index Name",
        "type": "string"
      }
    }
  ],
  "responses": {
    "202": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeleteManagedIndexResponse"
          }
        }
      },
      "description": "Index marked for deletion"
    },
    "404": {
      "description": "Index not found"
    },
    "409": {
      "description": "Index is still provisioning"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "summary": "Delete a managed index",
  "tags": [
    "beta.context.search_indexes"
  ],
  "components": {
    "schemas": {
      "DeleteManagedIndexResponse": {
        "additionalProperties": false,
        "description": "Wire representation returned when an index is deleted (id, name, status).",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ManagedIndexStatus"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "title": "DeleteManagedIndexResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ManagedIndexStatus": {
        "description": "Lifecycle of an index. Derived, not stored -- see ``managed_index_from_row``.",
        "enum": [
          "provisioning",
          "ready",
          "failed",
          "deleting"
        ],
        "title": "ManagedIndexStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
