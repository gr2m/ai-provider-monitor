{
  "description": "Submits a virtual try-on task against the v2 model. Identical request shape to /vto-v1, with reference and output resolution supported up to 4MP. Person and garment images are mapped to the underlying input image slots; prompts steer attribute transfer.",
  "operationId": "generate_flux_tools_vto_v2_v1_flux_tools_vto_v2_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/Flux2KleinTryonInputs"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AsyncResponse"
              },
              {
                "$ref": "#/components/schemas/AsyncWebhookResponse"
              }
            ],
            "title": "Response Generate Flux Tools Vto V2 V1 Flux Tools Vto V2 Post"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "security": [
    {
      "APIKeyHeader": []
    }
  ],
  "summary": "Virtual try-on (v2)",
  "tags": [
    "Models"
  ],
  "components": {
    "schemas": {
      "Flux2KleinTryonInputs": {
        "description": "Input model for FLUX.2 Klein VTO endpoint.\n\nExposes only person/garment image fields for cleaner API ergonomics.",
        "properties": {
          "garment": {
            "description": "Image of one more garments (maps internally to input_image_2).",
            "title": "Garment",
            "type": "string"
          },
          "output_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OutputFormat"
              },
              {
                "type": "null"
              }
            ],
            "default": "jpeg"
          },
          "person": {
            "description": "Person image (maps internally to input_image).",
            "title": "Person",
            "type": "string"
          },
          "prompt": {
            "description": "Text prompt for VTO generation.",
            "example": "TRY-ON: The person of image 1 wearing the garments of image 2.",
            "title": "Prompt",
            "type": "string"
          },
          "safety_tolerance": {
            "default": 2,
            "description": "Tolerance level for input and output moderation. Between 0 and 5 for public use.",
            "maximum": 5,
            "minimum": 0,
            "title": "Safety Tolerance",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional seed for reproducibility.",
            "example": 42,
            "title": "Seed"
          },
          "webhook_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional secret for webhook signature verification",
            "title": "Webhook Secret"
          },
          "webhook_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL to receive webhook notifications",
            "title": "Webhook Url"
          }
        },
        "required": [
          "prompt",
          "person",
          "garment"
        ],
        "title": "Flux2KleinTryonInputs",
        "type": "object"
      },
      "AsyncResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cost in credits for this request",
            "title": "Cost"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input megapixels (2 decimal places)",
            "title": "Input Mp"
          },
          "output_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output megapixels (2 decimal places)",
            "title": "Output Mp"
          },
          "polling_url": {
            "title": "Polling Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "polling_url"
        ],
        "title": "AsyncResponse",
        "type": "object"
      },
      "AsyncWebhookResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
