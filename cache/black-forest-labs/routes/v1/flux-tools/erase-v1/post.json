{
  "description": "Submits an erase task using an input image and a mask identifying the object or region to remove.",
  "operationId": "generate_flux_tools_erase_v1_v1_flux_tools_erase_v1_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/Flux2EraseInputs"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AsyncResponse"
              },
              {
                "$ref": "#/components/schemas/AsyncWebhookResponse"
              }
            ],
            "title": "Response Generate Flux Tools Erase V1 V1 Flux Tools Erase V1 Post"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "security": [
    {
      "APIKeyHeader": []
    }
  ],
  "summary": "Erase an object from an image",
  "tags": [
    "Models"
  ],
  "components": {
    "schemas": {
      "Flux2EraseInputs": {
        "description": "Input model for public FLUX.2 erase.",
        "properties": {
          "dilate_pixels": {
            "default": 10,
            "description": "Number of pixels to dilate the mask by before removal. Dilation helps cover object edges. Maximum is 25 pixels.",
            "maximum": 25,
            "minimum": 0,
            "title": "Dilate Pixels",
            "type": "integer"
          },
          "image": {
            "description": "Base64-encoded input image or HTTP(S) image URL.",
            "title": "Image",
            "type": "string"
          },
          "mask": {
            "description": "Base64-encoded black/white mask or HTTP(S) image URL. White pixels indicate the object to remove; black pixels are preserved. Must have the same dimensions as the input image.",
            "title": "Mask",
            "type": "string"
          },
          "output_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OutputFormat"
              },
              {
                "type": "null"
              }
            ],
            "default": "png"
          },
          "safety_tolerance": {
            "default": 2,
            "description": "Tolerance level for input and output moderation. Between 0 and 5, 0 being most strict, 5 being least strict.",
            "example": 2,
            "maximum": 5,
            "minimum": 0,
            "title": "Safety Tolerance",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional seed for reproducibility.",
            "example": 42,
            "title": "Seed"
          },
          "webhook_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional secret for webhook signature verification",
            "title": "Webhook Secret"
          },
          "webhook_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URL to receive webhook notifications",
            "title": "Webhook Url"
          }
        },
        "required": [
          "image",
          "mask"
        ],
        "title": "Flux2EraseInputs",
        "type": "object"
      },
      "AsyncResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cost in credits for this request",
            "title": "Cost"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input megapixels (2 decimal places)",
            "title": "Input Mp"
          },
          "output_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output megapixels (2 decimal places)",
            "title": "Output Mp"
          },
          "polling_url": {
            "title": "Polling Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "polling_url"
        ],
        "title": "AsyncResponse",
        "type": "object"
      },
      "AsyncWebhookResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cost in credits for this request",
            "title": "Cost"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input megapixels (2 decimal places)",
            "title": "Input Mp"
          },
          "output_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output megapixels (2 decimal places)",
            "title": "Output Mp"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "webhook_url": {
            "title": "Webhook Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "webhook_url"
        ],
        "title": "AsyncWebhookResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OutputFormat": {
        "enum": [
          "jpeg",
          "png",
          "webp"
        ],
        "title": "OutputFormat",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
