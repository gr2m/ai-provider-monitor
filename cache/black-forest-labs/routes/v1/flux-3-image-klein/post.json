{
  "description": "Submits a text-to-image or image editing task with FLUX 3 Image Klein.",
  "operationId": "flux_3_image_klein_v1_flux_3_image_klein_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/Flux3ImageKleinInputs"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AsyncResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "security": [
    {
      "APIKeyHeader": []
    }
  ],
  "summary": "Generate an image with FLUX 3 Image Klein.",
  "tags": [
    "Models"
  ],
  "components": {
    "schemas": {
      "Flux3ImageKleinInputs": {
        "additionalProperties": false,
        "description": "FLUX 3 Image Klein: text-to-image, or editing with up to 10 reference images.",
        "properties": {
          "aspect_ratio": {
            "anyOf": [
              {
                "enum": [
                  "21:9",
                  "2:1",
                  "16:9",
                  "3:2",
                  "7:5",
                  "4:3",
                  "5:4",
                  "1:1",
                  "4:5",
                  "3:4",
                  "5:7",
                  "2:3",
                  "9:16",
                  "1:2",
                  "9:21"
                ],
                "type": "string"
              },
              {
                "const": "auto",
                "type": "string"
              }
            ],
            "default": "auto",
            "description": "Output aspect ratio, as in flux-3-image. `auto` (default): for edits, the first reference's exact aspect; for text-to-image, a ratio picked from the prompt (prompt rewrite, else ratio keywords, else 16:9) at the requested tier. Ignored when width and height are set.",
            "title": "Aspect Ratio"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact output height in pixels, [64, 6256]; width x height at most 16822272 pixels (16.8 MP, the largest 4k bin).",
            "title": "Height"
          },
          "images": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional reference image(s), each an http(s) URL or base64, one to 10 total. The first is the image being edited and sets the default output size.",
            "title": "Images"
          },
          "output_format": {
            "default": "jpeg",
            "description": "Output image format: `jpeg` (default) or `png`.",
            "enum": [
              "jpeg",
              "png"
            ],
            "title": "Output Format",
            "type": "string"
          },
          "prompt": {
            "description": "Free-form prompt describing the image.",
            "title": "Prompt",
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "enum": [
                  "768sq",
                  "1k",
                  "1.5k",
                  "2k",
                  "4k"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Equal-area size tier, as in flux-3-image: `768sq`, `1k`, `1.5k`, `2k` or `4k`. Omitted: `1k` for text-to-image; for edits the first reference's own size, or its nearest tier when aspect_ratio is set. Ignored when width and height are set.",
            "title": "Resolution"
          },
          "safety_tolerance": {
            "default": 2,
            "description": "Harm moderation tolerance from 0 to 7, with 0 the strictest. The route and organization determine the approved maximum and per-category ceilings. Unapproved levels return 422 with approved levels.",
            "maximum": 7,
            "minimum": 0,
            "title": "Safety Tolerance",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for reproducibility; random when omitted.",
            "title": "Seed"
          },
          "steps": {
            "anyOf": [
              {
                "maximum": 16,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Denoising steps (default 16).",
            "title": "Steps"
          },
          "user": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[^\\x00]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque identifier for the end user supplied by the calling platform.",
            "title": "User"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact output width in pixels, [64, 6256]; set together with height. Overrides resolution and aspect_ratio.",
            "title": "Width"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "Flux3ImageKleinInputs",
        "type": "object"
      },
      "AsyncResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cost in credits for this request",
            "title": "Cost"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input megapixels (2 decimal places)",
            "title": "Input Mp"
          },
          "output_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output megapixels (2 decimal places)",
            "title": "Output Mp"
          },
          "polling_url": {
            "title": "Polling Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "polling_url"
        ],
        "title": "AsyncResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
