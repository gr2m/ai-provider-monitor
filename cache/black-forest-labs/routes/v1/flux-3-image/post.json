{
  "description": "Submits an image generation task with FLUX 3.",
  "operationId": "flux_3_image_v1_flux_3_image_post",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/Flux3ImageInputs"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AsyncResponse"
          }
        }
      },
      "description": "Successful Response"
    },
    "422": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/HTTPValidationError"
          }
        }
      },
      "description": "Validation Error"
    }
  },
  "security": [
    {
      "APIKeyHeader": []
    }
  ],
  "summary": "Generate an image with FLUX 3.",
  "tags": [
    "Models"
  ],
  "components": {
    "schemas": {
      "Flux3ImageInputs": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "anyOf": [
              {
                "enum": [
                  "21:9",
                  "2:1",
                  "16:9",
                  "3:2",
                  "7:5",
                  "4:3",
                  "5:4",
                  "1:1",
                  "4:5",
                  "3:4",
                  "5:7",
                  "2:3",
                  "9:16",
                  "1:2",
                  "9:21"
                ],
                "type": "string"
              },
              {
                "const": "auto",
                "type": "string"
              }
            ],
            "default": "auto",
            "description": "Output aspect ratio. Under `auto` a ratio the prompt asks for wins, otherwise the output keeps the first reference image's framing; without references the prompt decides, else 1:1.",
            "title": "Aspect Ratio"
          },
          "grounding": {
            "default": true,
            "description": "When true (default) the prompt may be grounded in external research: web search and image search. When false, both are off.",
            "title": "Grounding",
            "type": "boolean"
          },
          "images": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional reference image(s) the prompt edits or draws from; each is an http(s) URL or base64, one to 10 total.",
            "title": "Images"
          },
          "prompt": {
            "description": "Free-form prompt describing the image.",
            "title": "Prompt",
            "type": "string"
          },
          "resolution": {
            "default": "1k",
            "description": "Image resolution class, an equal-pixel-area tier: `768sq`, `1k`, `1.5k`, `2k`, or `4k`. Exact dimensions vary with the aspect ratio.",
            "enum": [
              "768sq",
              "1k",
              "1.5k",
              "2k",
              "4k"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "safety_tolerance": {
            "default": 2,
            "description": "Tolerance level for input and output harm moderation. Between 0 and 4, with 0 the strictest.",
            "maximum": 4,
            "minimum": 0,
            "title": "Safety Tolerance",
            "type": "integer"
          },
          "version": {
            "const": "latest",
            "default": "latest",
            "description": "Endpoint version. `latest` (default) serves the current release; dated pinnable release tags are added here as they are published.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "Flux3ImageInputs",
        "type": "object"
      },
      "AsyncResponse": {
        "properties": {
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cost in credits for this request",
            "title": "Cost"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input megapixels (2 decimal places)",
            "title": "Input Mp"
          },
          "output_mp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output megapixels (2 decimal places)",
            "title": "Output Mp"
          },
          "polling_url": {
            "title": "Polling Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "polling_url"
        ],
        "title": "AsyncResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  }
}
