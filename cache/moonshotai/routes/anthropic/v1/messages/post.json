{
  "description": "Call Kimi models with an Anthropic Messages API compatible format, supporting streaming, tool use, image input, thinking, and structured output.",
  "parameters": [
    {
      "description": "A client-generated random nonce (a UUID v4 is recommended). Sending it enables Request Signature: the Kimi API returns `Msh-Request-Timestamp` and `Msh-Request-Signature` in the response headers, which can later be used to prove that the request was handled by the Kimi API. Exactly one non-empty header value is allowed; if the value is invalid, the request proceeds normally but the headers above are not returned. See [Verify Request Signature](/api/signatures-verify).",
      "in": "header",
      "name": "X-Msh-Request-Nonce",
      "required": false,
      "schema": {
        "example": "7d929748-0ae6-41c2-ab5d-a186498ad721",
        "minLength": 1,
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/MessagesRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MessagesResponse"
          }
        },
        "text/event-stream": {
          "schema": {
            "$ref": "#/components/schemas/MessagesStreamEvent"
          }
        }
      },
      "description": "Message response",
      "headers": {
        "Msh-Request-Signature": {
          "description": "Signature token prefixed with `reqsigv1_`, issued by the Kimi API over the nonce, timestamp, and the request's `model`; verify it with `POST /v1/signatures/verify`. Only returned when the request carries a valid `X-Msh-Request-Nonce`.",
          "schema": {
            "example": "reqsigv1_<opaque-token>",
            "type": "string"
          }
        },
        "Msh-Request-Timestamp": {
          "description": "Unix timestamp in milliseconds at which the Kimi API accepted this request. Only returned when the request carries a valid `X-Msh-Request-Nonce`.",
          "schema": {
            "example": 1786338000123,
            "format": "int64",
            "type": "integer"
          }
        }
      }
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MessagesErrorResponse"
          }
        }
      },
      "description": "Bad request - Invalid parameters"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/MessagesErrorResponse"
          }
        }
      },
      "description": "Server error"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Messages API",
  "tags": [
    "Messages"
  ],
  "components": {
    "schemas": {
      "MessagesRequest": {
        "properties": {
          "max_tokens": {
            "description": "Maximum number of tokens to generate, required. If the limit is reached before the model finishes, `stop_reason` is `max_tokens`.",
            "minimum": 1,
            "type": "integer"
          },
          "messages": {
            "description": "The conversation messages. If the last message is from the assistant, the model continues from that content (Partial Mode).",
            "items": {
              "$ref": "#/components/schemas/MessagesMessageParam"
            },
            "type": "array"
          },
          "metadata": {
            "properties": {
              "user_id": {
                "description": "A stable identifier for the end user or session, used to improve cache hit rate and for abuse detection. Use a hashed value; do not send personally identifiable information. For coding agents, pass the session id and keep it constant for the whole session.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "model": {
            "default": "kimi-k3",
            "description": "Model ID",
            "enum": [
              "kimi-k3"
            ],
            "type": "string"
          },
          "output_config": {
            "description": "Output configuration: reasoning effort and structured output",
            "properties": {
              "effort": {
                "default": "max",
                "description": "Reasoning effort: low, high, or max; default max. Changing the level breaks prefix-cache hits, so decide it before the session starts.",
                "enum": [
                  "low",
                  "high",
                  "max"
                ],
                "type": "string"
              },
              "format": {
                "description": "Structured output. When set, the model outputs JSON that strictly follows the given JSON Schema.",
                "properties": {
                  "schema": {
                    "additionalProperties": true,
                    "description": "The JSON Schema the output must follow",
                    "type": "object"
                  },
                  "type": {
                    "enum": [
                      "json_schema"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "schema"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "stop_sequences": {
            "description": "Stop sequences. Generation stops on an exact match; the matched sequence itself is not output. Up to 5 entries, each at most 32 bytes.",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "stream": {
            "default": false,
            "description": "Whether to stream the response as Server-Sent Events, default false",
            "type": "boolean"
          },
          "system": {
            "description": "System prompt, either a string or an array of text blocks",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/MessagesTextBlockParam"
                },
                "type": "array"
              }
            ]
          },
          "tool_choice": {
            "$ref": "#/components/schemas/MessagesToolChoice"
          },
          "tools": {
            "description": "List of tools the model may call",
            "items": {
              "$ref": "#/components/schemas/MessagesTool"
            },
            "type": "array"
          }
        },
        "required": [
          "model",
          "messages",
          "max_tokens"
        ],
        "title": "kimi-k3",
        "type": "object"
      },
      "MessagesResponse": {
        "properties": {
          "content": {
            "description": "Content blocks, ordered thinking → text → tool_use",
            "items": {
              "oneOf": [
                {
                  "properties": {
                    "signature": {
                      "type": "string"
                    },
                    "thinking": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "thinking"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "thinking"
                  ],
                  "title": "thinking",
                  "type": "object"
                },
                {
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "text"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
