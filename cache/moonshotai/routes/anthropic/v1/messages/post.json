                  "title": "text",
                  "type": "object"
                },
                {
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "input": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "tool_use"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "name",
                    "input"
                  ],
                  "title": "tool_use",
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "id": {
            "description": "Unique identifier of the response",
            "type": "string"
          },
          "model": {
            "description": "The model specified in the request",
            "type": "string"
          },
          "role": {
            "enum": [
              "assistant"
            ],
            "type": "string"
          },
          "stop_reason": {
            "description": "Stop reason. `end_turn`: finished naturally (including a `stop_sequences` match); `max_tokens`: reached the max_tokens limit; `tool_use`: the model issued a tool call; `refusal`: content safety review was triggered.",
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use",
              "refusal",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "stop_sequence": {
            "description": "The stop sequence that was matched",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "message"
            ],
            "example": "message",
            "type": "string"
          },
          "usage": {
            "description": "Token usage",
            "properties": {
              "cache_creation_input_tokens": {
                "description": "Input tokens written to cache",
                "type": "integer"
              },
              "cache_read_input_tokens": {
                "description": "Input tokens served from cache",
                "type": "integer"
              },
              "input_tokens": {
                "description": "Input tokens (excluding cache hits)",
                "type": "integer"
              },
              "output_tokens": {
                "description": "Output tokens (including reasoning tokens)",
                "type": "integer"
              },
              "output_tokens_details": {
                "properties": {
                  "thinking_tokens": {
                    "description": "The portion of output tokens used for reasoning",
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "MessagesStreamEvent": {
