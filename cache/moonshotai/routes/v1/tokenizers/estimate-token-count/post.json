{
  "description": "Estimates the number of tokens that would be used for a given set of messages and model. The input structure is almost identical to that of chat completion.",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/EstimateTokenRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/EstimateTokenResponse"
          }
        }
      },
      "description": "Token count estimation"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Bad request - Invalid parameters"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Server error"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Estimate Token Count",
  "tags": [
    "Utilities"
  ],
  "components": {
    "schemas": {
      "EstimateTokenRequest": {
        "properties": {
          "messages": {
            "description": "A list of messages in the conversation so far. Each element has the format {\"role\": \"user\", \"content\": \"Hello\"}. role supports system, user, assistant, or tool. content must not be empty",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array"
          },
          "model": {
            "default": "kimi-k3",
            "description": "Model ID",
            "enum": [
              "kimi-k3",
              "kimi-k2.7-code",
              "kimi-k2.7-code-highspeed",
              "kimi-k2.6",
              "kimi-k2.5",
              "moonshot-v1-8k",
              "moonshot-v1-32k",
              "moonshot-v1-128k",
              "moonshot-v1-auto",
              "moonshot-v1-8k-vision-preview",
              "moonshot-v1-32k-vision-preview",
              "moonshot-v1-128k-vision-preview"
            ],
            "type": "string"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "type": "object"
      },
      "EstimateTokenResponse": {
        "properties": {
          "data": {
            "properties": {
              "total_tokens": {
                "description": "Estimated total number of tokens",
                "example": 80,
                "type": "integer"
              }
            },
            "required": [
              "total_tokens"
            ],
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Message": {
        "properties": {
          "content": {
            "description": "The content of the message. Can be a plain text string, or an array of objects with text/image_url/video_url types (for multimodal input)",
            "example": "Hello",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "oneOf": [
                    {
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "text"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "title": "text",
                      "type": "object"
                    },
                    {
                      "properties": {
                        "image_url": {
                          "oneOf": [
                            {
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ],
                              "type": "object"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "type": {
                          "enum": [
                            "image_url"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "title": "image_url",
                      "type": "object"
                    },
                    {
                      "properties": {
                        "type": {
                          "enum": [
                            "video_url"
                          ],
                          "type": "string"
                        },
                        "video_url": {
                          "oneOf": [
                            {
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ],
                              "type": "object"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "video_url"
                      ],
                      "title": "video_url",
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              }
            ]
          },
          "name": {
            "default": null,
            "description": "Optional name for the message sender",
            "type": "string"
          },
          "partial": {
            "default": false,
            "description": "Enable Partial Mode by setting this to true in the last assistant message",
            "type": "boolean"
          },
          "role": {
            "description": "The role of the message sender. Supports system, user, assistant, tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "example": "user",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "type": "object"
      }
    }
  }
}
