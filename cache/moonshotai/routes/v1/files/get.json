{
  "description": "Lists all files uploaded by the current user.",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/FileListResponse"
          }
        }
      },
      "description": "List of uploaded files"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Server error"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "List Files",
  "tags": [
    "Files"
  ],
  "components": {
    "schemas": {
      "FileListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/FileObject"
            },
            "type": "array"
          },
          "object": {
            "example": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FileObject": {
        "properties": {
          "bytes": {
            "description": "File size in bytes",
            "type": "integer"
          },
          "created_at": {
            "description": "Unix timestamp when the file was created",
            "type": "integer"
          },
          "filename": {
            "description": "Original file name",
            "type": "string"
          },
          "id": {
            "description": "Unique file identifier",
            "type": "string"
          },
          "object": {
            "description": "Object type",
            "example": "file",
            "type": "string"
          },
          "purpose": {
            "description": "Purpose used when uploading the file. file-extract: extract content from text-based files (such as pdf, doc, txt); images are not supported; image: upload images for vision understanding; video: upload videos for video understanding; batch: upload JSONL files for batch processing",
            "enum": [
              "file-extract",
              "image",
              "video",
              "batch"
            ],
            "type": "string"
          },
          "status": {
            "description": "Processing status of the file",
            "example": "ready",
            "type": "string"
          },
          "status_details": {
            "description": "Additional status details when processing fails or returns warnings",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "bytes",
          "created_at",
          "filename",
          "purpose",
          "status"
        ],
        "type": "object"
      }
    }
  }
}
