{
  "description": "Fetch the content of a URL and get the page title and body text in Markdown (text and images concatenated in order). Only http and https URLs are supported. You are charged once per successful call that extracts content; failed or empty-content calls are free. See [WebSearch Pricing](/pricing/tools).",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ToolsFetchRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ToolsFetchResponse"
          }
        }
      },
      "description": "Fetch result",
      "headers": {
        "X-Msh-Chat-Id": {
          "description": "Session ID, always `toolgw-{X-Msh-Track-Id}`; provide both IDs when troubleshooting.",
          "schema": {
            "type": "string"
          }
        },
        "X-Msh-Track-Id": {
          "description": "Request ID. If the client sends this header, its value is reused; otherwise the server generates one. Provide this ID when troubleshooting.",
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Bad request - Invalid parameters or malformed URL"
    },
    "401": {
      "description": "Unauthorized - Invalid or missing API key (status code only, no error body)"
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Forbidden - account inactive or suspended (no error body), or the URL was blocked by security risk control (returns a security_risk error)"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "No extractable content found for the URL (markdown_not_found)"
    },
    "408": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Client canceled the request"
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many requests - rate or concurrency limit exceeded, or rate-limit service temporarily unavailable",
      "headers": {
        "X-RateLimit-Limit": {
          "description": "The rate limit that was hit.",
          "schema": {
            "type": "string"
          }
        },
        "X-RateLimit-Remaining": {
          "description": "Remaining quota in the current window.",
          "schema": {
            "type": "string"
          }
        },
        "X-RateLimit-Reset": {
          "description": "When the rate-limit window resets (Unix timestamp in seconds; returned when a per-second rate limit is hit).",
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Internal server error"
    },
    "502": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Service temporarily unavailable; retry later"
    },
    "504": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Request timed out"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "URL Fetch",
  "tags": [
    "Tools"
  ],
  "components": {
    "schemas": {
      "ToolsFetchRequest": {
        "properties": {
          "url": {
            "description": "URL of the page to fetch. Only http and https are supported.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "ToolsFetchResponse": {
        "properties": {
          "markdown": {
            "description": "Fetched content in Markdown. Text and images are concatenated in page order, with images rendered as `![imageN](url)` placeholders.",
            "type": "string"
          },
          "title": {
            "description": "Page title.",
            "type": "string"
          },
          "url": {
            "description": "The fetched URL.",
            "type": "string"
          }
        },
        "required": [
          "url",
          "markdown",
          "title"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
