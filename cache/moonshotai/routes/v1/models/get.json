{
  "description": "List all currently available models.",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "data": {
                "items": {
                  "properties": {
                    "context_length": {
                      "description": "Maximum context length (tokens)",
                      "type": "integer"
                    },
                    "created": {
                      "description": "Creation timestamp",
                      "type": "integer"
                    },
                    "id": {
                      "description": "Model ID",
                      "example": "kimi-k3",
                      "type": "string"
                    },
                    "object": {
                      "example": "model",
                      "type": "string"
                    },
                    "owned_by": {
                      "example": "moonshot",
                      "type": "string"
                    },
                    "supports_image_in": {
                      "description": "Whether the model supports image input",
                      "type": "boolean"
                    },
                    "supports_reasoning": {
                      "description": "Whether the model supports deep thinking",
                      "type": "boolean"
                    },
                    "supports_video_in": {
                      "description": "Whether the model supports video input",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "object": {
                "example": "list",
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "description": "Model list"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "List Models",
  "tags": [
    "Models"
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
