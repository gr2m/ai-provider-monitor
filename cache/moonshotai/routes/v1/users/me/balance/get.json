{
  "description": "REST API to check your available, voucher, and cash balances on Kimi OpenPlatform.",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BalanceResponse"
          }
        }
      },
      "description": "Balance information"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Server error"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "Check Balance",
  "tags": [
    "Billing"
  ],
  "components": {
    "schemas": {
      "BalanceResponse": {
        "properties": {
          "code": {
            "description": "Response code. 0 indicates success.",
            "type": "integer"
          },
          "data": {
            "properties": {
              "available_balance": {
                "description": "The available balance (unit: USD), including cash balance and voucher balance. When it is less than or equal to 0, the user cannot call the inference API",
                "example": 49.58894,
                "format": "float",
                "type": "number"
              },
              "cash_balance": {
                "description": "The cash balance (unit: USD), which can be negative, indicating that the user owes money. When it is negative, available_balance is equal to the value of voucher_balance",
                "example": 3.00001,
                "format": "float",
                "type": "number"
              },
              "voucher_balance": {
                "description": "The voucher balance (unit: USD), which cannot be negative",
                "example": 46.58893,
                "format": "float",
                "type": "number"
              }
            },
            "required": [
              "available_balance",
              "voucher_balance",
              "cash_balance"
            ],
            "type": "object"
          },
          "scode": {
            "description": "Status code",
            "example": "0x0",
            "type": "string"
          },
          "status": {
            "description": "Request status",
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "data",
          "scode",
          "status"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
