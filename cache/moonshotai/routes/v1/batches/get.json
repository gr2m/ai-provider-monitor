{
  "description": "List batch tasks for your organization.",
  "parameters": [
    {
      "description": "Pagination cursor, pass the ID of the last batch from the previous page",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of results per page, default 20",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BatchListResponse"
          }
        }
      },
      "description": "List of batch tasks"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Unauthorized - Invalid or missing API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Server error"
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "summary": "List Batches",
  "tags": [
    "Batch"
  ],
  "components": {
    "schemas": {
      "BatchListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/BatchObject"
            },
            "type": "array"
          },
          "has_more": {
            "description": "Whether there are more results",
            "type": "boolean"
          },
          "object": {
            "example": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "message": {
                "description": "Error message describing what went wrong",
                "type": "string"
              },
              "type": {
                "description": "Error type",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "BatchObject": {
        "properties": {
          "cancelled_at": {
            "description": "Cancellation completion timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "cancelling_at": {
            "description": "Cancellation request timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "completed_at": {
            "description": "Completion timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "completion_window": {
            "description": "Processing time window",
            "type": "string"
          },
          "created_at": {
            "description": "Creation timestamp (Unix)",
            "type": "integer"
          },
          "endpoint": {
            "description": "Request endpoint",
            "type": "string"
          },
          "error_file_id": {
            "description": "Error file ID for failed results",
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "description": "Expiration timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "failed_at": {
            "description": "Validation failure timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "finalizing_at": {
            "description": "Result preparation start timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "Unique identifier for the batch task",
            "type": "string"
          },
          "in_progress_at": {
            "description": "Execution start timestamp (Unix)",
            "type": [
              "integer",
              "null"
            ]
          },
          "input_file_id": {
            "description": "Input file ID",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Custom metadata",
            "type": [
              "object",
              "null"
            ]
          },
          "object": {
            "description": "Object type, always batch",
            "example": "batch",
            "type": "string"
          },
          "output_file_id": {
            "description": "Output file ID for successful results",
            "type": [
              "string",
              "null"
            ]
          },
          "request_counts": {
            "$ref": "#/components/schemas/BatchRequestCounts"
          },
          "status": {
            "description": "Current status: validating, failed, in_progress, finalizing, completed, expired, cancelling, cancelled",
            "enum": [
              "validating",
              "failed",
              "in_progress",
              "finalizing",
              "completed",
              "expired",
              "cancelling",
              "cancelled"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "endpoint",
          "input_file_id",
          "completion_window",
          "status",
          "created_at",
          "request_counts"
        ],
        "type": "object"
      },
      "BatchRequestCounts": {
        "properties": {
          "completed": {
            "description": "Number of completed requests",
            "type": "integer"
          },
          "failed": {
            "description": "Number of failed requests",
            "type": "integer"
          },
          "total": {
            "description": "Total number of requests",
            "type": "integer"
          }
        },
        "required": [
          "completed",
          "failed",
          "total"
        ],
        "type": "object"
      }
    }
  }
}
