{
  "description": "List saved characters, props, environments, styles, and scenes in the authenticated account. Returns their @mention handles and defining reference images. Uses limit and offset pagination; omit types to include every entity type.",
  "operationId": "listAssetEntities",
  "parameters": [
    {
      "description": "Maximum number of entities to return",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 50,
        "description": "Maximum number of entities to return",
        "example": 50,
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "Number of entities to skip",
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
        "default": 0,
        "description": "Number of entities to skip",
        "example": 0,
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    {
      "description": "Entity types to include, comma-separated. Omit to list all types.",
      "in": "query",
      "name": "types",
      "required": false,
      "schema": {
        "description": "Entity types to include, comma-separated. Omit to list all types.",
        "example": [
          "prop",
          "environment"
        ],
        "items": {
          "description": "Smart entity type",
          "enum": [
            "character",
            "prop",
            "environment",
            "style",
            "scene"
          ],
          "example": "character",
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "entities": [
              {
                "cover_image_url": "https://fal.media/files/skiff.png",
                "created_at": "2026-09-12T10:00:00.000Z",
                "description": "A weathered wooden boat with blue trim",
                "handle": "skiff",
                "id": "d7tatpsregjaga2cf3d0",
                "is_favorited": false,
                "name": "Skiff",
                "reference_images": [
                  "https://fal.media/files/skiff.png"
                ],
                "type": "prop",
                "updated_at": "2026-09-12T10:00:00.000Z"
              }
            ]
          },
          "schema": {
            "properties": {
              "entities": {
                "description": "Saved smart entities",
                "items": {
                  "properties": {
                    "cover_image_url": {
                      "description": "Entity cover image URL",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "created_at": {
                      "description": "Creation time in UTC",
                      "format": "date-time",
                      "type": "string"
                    },
                    "description": {
                      "description": "Entity visual description",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "handle": {
                      "description": "Resolved @mention handle, without the leading @",
                      "type": "string"
                    },
                    "id": {
                      "description": "Smart entity ID",
                      "type": "string"
                    },
                    "is_favorited": {
                      "description": "Whether the entity is favorited",
                      "type": "boolean"
                    },
                    "name": {
                      "description": "Entity display name",
                      "maxLength": 255,
                      "minLength": 1,
                      "type": "string"
                    },
                    "reference_images": {
                      "description": "Defining reference image URLs",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "type": {
                      "description": "Smart entity type",
                      "enum": [
                        "character",
                        "prop",
                        "environment",
                        "style",
                        "scene"
                      ],
                      "example": "character",
                      "type": "string"
                    },
                    "updated_at": {
                      "description": "Last update time in UTC",
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "name",
                    "handle",
                    "description",
                    "cover_image_url",
                    "reference_images",
                    "is_favorited",
                    "created_at",
                    "updated_at"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "entities"
            ],
            "type": "object"
          }
        }
      },
      "description": "Entities"
