{
  "description": "Get a saved entity's type, @mention handle, visual description, and defining reference images. Only entities belonging to the authenticated account are accessible.",
  "operationId": "getAssetEntity",
  "parameters": [
    {
      "description": "Smart entity ID",
      "in": "path",
      "name": "entity_id",
      "required": true,
      "schema": {
        "description": "Smart entity ID",
        "minLength": 1,
        "type": "string"
      }
    }
  ],
