{
  "description": "Browse and semantically search fal Assets across all media, uploads, favorites, collections, tags, and character references.",
  "operationId": "listAssets",
  "parameters": [
    {
      "description": "Maximum number of items to return. Actual maximum depends on query type and expansion parameters.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "description": "Maximum number of items to return. Actual maximum depends on query type and expansion parameters.",
        "example": 50,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "Pagination cursor from previous response. Encodes the page number.",
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "description": "Pagination cursor from previous response. Encodes the page number.",
        "example": "Mg==",
        "type": "string"
      }
    },
    {
      "description": "Text query for hybrid semantic search",
      "in": "query",
      "name": "q",
      "required": false,
      "schema": {
        "description": "Text query for hybrid semantic search",
        "example": "cinematic portrait",
        "type": "string"
      }
    },
    {
      "description": "fal-hosted image URL to use for semantic image search",
      "in": "query",
      "name": "search_image_url",
      "required": false,
      "schema": {
        "description": "fal-hosted image URL to use for semantic image search",
        "example": "https://v3b.fal.media/files/b/0a9b4900/PDbTGyzqRh1aijW2WQiY9_opengraph-1%20%281%29.png",
        "format": "uri",
        "type": "string"
      }
    },
    {
      "description": "fal-hosted video URL to use for semantic video search",
      "in": "query",
      "name": "search_video_url",
      "required": false,
      "schema": {
        "description": "fal-hosted video URL to use for semantic video search",
        "example": "https://fal.media/files/example.mp4",
        "format": "uri",
        "type": "string"
      }
    },
    {
      "description": "Filter by one or more media types",
      "in": "query",
      "name": "media_type",
      "required": false,
      "schema": {
        "default": [],
        "description": "Filter by one or more media types",
        "example": [
          "image",
          "video"
        ],
        "items": {
          "description": "Asset media type",
          "enum": [
            "image",
            "video",
            "audio",
            "3d"
          ],
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    {
      "description": "Filter by one or more indexed sources",
      "in": "query",
      "name": "source",
      "required": false,
      "schema": {
        "default": [],
        "description": "Filter by one or more indexed sources",
        "example": [
          "upload",
          "response"
        ],
        "items": {
          "description": "Indexed asset source",
          "enum": [
            "upload",
            "response"
          ],
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    {
      "description": "Asset library section to browse",
      "in": "query",
      "name": "section",
      "required": false,
      "schema": {
        "default": "all-media",
        "description": "Asset library section to browse",
        "enum": [
          "all-media",
          "uploads",
          "favorites",
          "generated"
        ],
        "example": "all-media",
        "type": "string"
      }
    },
    {
      "description": "Collection scope to browse",
      "in": "query",
      "name": "collection_id",
      "required": false,
      "schema": {
        "description": "Collection scope to browse",
        "example": "d8b6elcregj72v34jr8g",
        "type": "string"
      }
    },
    {
      "description": "Character identifiers to use as @mention semantic filters",
      "in": "query",
      "name": "character_identifier",
      "required": false,
      "schema": {
        "default": [],
        "description": "Character identifiers to use as @mention semantic filters",
        "example": [
          "alice"
        ],
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    {
      "description": "Tag IDs to filter by",
      "in": "query",
      "name": "tag_id",
      "required": false,
      "schema": {
        "default": [],
        "description": "Tag IDs to filter by",
        "example": [
          "d9k7q2m4n6p8r1s3t5uv"
        ],
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    {
      "description": "Whether tag filters match any tag or all tags",
      "in": "query",
      "name": "tag_mode",
      "required": false,
      "schema": {
        "default": "any",
        "description": "Whether tag filters match any tag or all tags",
        "enum": [
          "any",
          "all"
        ],
        "example": "any",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "assets": [
              {
                "asset_id": "d8b6elcregj72v34jr8g",
                "collection_ids": [
                  "d8b6elcregj72v34jr8g"
                ],
                "content_type": "image/png",
                "created_at": "2026-05-23T20:00:00.000Z",
                "endpoint": "fal-ai/flux/dev",
                "height": 1024,
                "is_favorited": false,
                "prompt": "cinematic portrait of a character",
                "request_id": "019e6d0a-e5be-7b82-b329-35ae64296902",
                "similarity": 0.92,
                "source": "upload",
                "tags": [
                  {
                    "created_at": "2026-05-23T20:00:00.000Z",
                    "id": "d9k7q2m4n6p8r1s3t5uv",
                    "name": "moodboard"
                  }
                ],
                "title": "Cinematic portrait",
                "type": "image",
                "url": "https://v3b.fal.media/files/b/0a9b4900/PDbTGyzqRh1aijW2WQiY9_opengraph-1%20%281%29.png",
                "vector_id": "b1a2b4a5-cb89-51dc-a108-6dbfd8e742fc",
                "width": 1024
              }
            ],
            "has_more": false,
            "next_cursor": null,
            "scope_truncated": false,
            "total_count": 1
          },
          "schema": {
            "description": "Paginated asset browse response",
            "properties": {
              "assets": {
                "description": "Asset results",
                "items": {
                  "description": "Asset item",
                  "properties": {
                    "asset_id": {
                      "description": "Asset ID (canonical catalog identity)",
                      "example": "d8b6elcregj72v34jr8g",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "collection_ids": {
                      "description": "Collections containing this asset",
                      "example": [
                        "d8b6elcregj72v34jr8g"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "content_type": {
                      "description": "Media content type",
                      "example": "image/png",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "created_at": {
                      "description": "Asset creation time",
                      "example": "2026-05-23T20:00:00.000Z",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "endpoint": {
                      "description": "Model endpoint that produced the asset",
                      "example": "fal-ai/flux/dev",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "height": {
                      "description": "Height in pixels",
                      "example": 1024,
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "is_favorited": {
                      "description": "Whether the asset is favorited",
                      "example": false,
                      "type": "boolean"
                    },
                    "prompt": {
                      "description": "Saved prompt or description",
                      "example": "cinematic portrait",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "request_id": {
                      "description": "Request ID",
                      "example": "019e6d0a-e5be-7b82-b329-35ae64296902",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "similarity": {
                      "description": "Semantic similarity score when applicable",
                      "example": 0.92,
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "source": {
                      "description": "Asset source",
                      "example": "upload",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tags": {
                      "description": "Assigned tags",
                      "items": {
                        "description": "Asset tag",
                        "properties": {
                          "created_at": {
                            "description": "Tag creation time",
                            "example": "2026-05-23T20:00:00.000Z",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "id": {
                            "description": "Tag ID",
                            "example": "d9k7q2m4n6p8r1s3t5uv",
                            "type": "string"
                          },
                          "name": {
                            "description": "Tag name",
                            "example": "moodboard",
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "created_at"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "title": {
                      "description": "Display title",
                      "example": "Portrait",
                      "type": "string"
                    },
                    "type": {
                      "description": "Asset media type",
                      "enum": [
                        "image",
                        "video",
                        "audio",
                        "3d"
                      ],
                      "type": "string"
                    },
                    "url": {
                      "description": "Media URL",
                      "example": "https://v3b.fal.media/files/b/0a9b4900/PDbTGyzqRh1aijW2WQiY9_opengraph-1%20%281%29.png",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "vector_id": {
                      "description": "Vector ID. Prefer asset_id for addressing",
                      "example": "b1a2b4a5-cb89-51dc-a108-6dbfd8e742fc",
                      "type": "string"
                    },
                    "width": {
                      "description": "Width in pixels",
                      "example": 1024,
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "asset_id",
                    "vector_id",
                    "request_id",
                    "url",
                    "type",
                    "title",
                    "endpoint",
                    "created_at",
                    "source",
                    "prompt",
                    "width",
                    "height",
                    "content_type",
                    "is_favorited",
                    "collection_ids",
                    "tags",
                    "similarity"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "has_more": {
                "description": "Whether more results are available",
                "type": "boolean"
              },
              "next_cursor": {
                "description": "Cursor for the next page",
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_truncated": {
                "description": "True when the requested scope (favorites, tags, or collection membership) exceeded the maximum number of assets a single search can cover, so results were drawn from a partial slice of it and some matches are missing. Narrow the scope for complete results. `total_count` remains accurate for the results that were returned.",
                "type": "boolean"
              },
              "total_count": {
                "description": "Exact total when available; null when unavailable",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "assets",
              "next_cursor",
              "has_more",
              "total_count",
              "scope_truncated"
            ],
            "type": "object"
          }
        }
      },
      "description": "Successfully browsed assets"
    },
