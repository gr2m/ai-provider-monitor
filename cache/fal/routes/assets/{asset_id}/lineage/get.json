                            "properties": {
                              "entity_id": {
                                "description": "Smart entity ID",
                                "example": "43ce3411-1a25-4d14-875e-3562d341b090",
                                "type": "string"
                              },
                              "entity_type": {
                                "description": "Smart entity type",
                                "enum": [
                                  "character"
                                ],
                                "example": "character",
                                "type": "string"
                              },
                              "handle": {
