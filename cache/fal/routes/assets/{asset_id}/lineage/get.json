                    "example": "asset:0f343b0931126a20f133d67c2b018a3b",
                    "type": "string"
                  },
                  "nodes": {
                    "description": "Lineage graph nodes",
                    "items": {
                      "description": "A node in the lineage graph",
                      "oneOf": [
                        {
                          "description": "An asset in the user's library",
                          "properties": {
                            "asset_id": {
