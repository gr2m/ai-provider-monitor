                                "content_ref",
                                "mask",
                                "control"
                              ],
                              "type": "string"
                            },
                            {
                              "type": "null"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Input role for input_to / referenced_entity edges; null for generated_by"
                        },
                        "to": {
                          "description": "Target node ID",
                          "example": "request:019e6d0a-e5be-7b82-b329-35ae64296902",
                          "type": "string"
                        }
