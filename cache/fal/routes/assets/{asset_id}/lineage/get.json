                              "example": "0f343b0931126a20f133d67c2b018a3b",
                              "type": "string"
                            },
                            "request_id": {
                              "description": "Request that generated this asset",
                              "example": "019e6d0a-e5be-7b82-b329-35ae64296902",
                              "type": "string"
                            },
                            "tombstone": {
                              "description": "Whether the asset has been deleted or has expired",
                              "example": false,
                              "type": "boolean"
                            },
                            "type": {
                              "description": "Asset media type",
                              "enum": [
                                "image",
                                "video",
                                "audio",
                                "text",
                                "3d"
                              ],
                              "type": "string"
