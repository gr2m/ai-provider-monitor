{
  "description": "Get the derivation lineage of an asset by asset ID: the inputs it was generated from, the generation requests along the way, and any referenced characters, traversed recursively up to `depth` levels. Deleted or expired ancestors stay in the graph flagged as tombstones; inputs that were never captured appear as external inputs.",
  "operationId": "getAssetLineage",
  "parameters": [
    {
      "description": "Asset ID",
      "in": "path",
      "name": "asset_id",
      "required": true,
      "schema": {
        "description": "Asset ID",
        "example": "d8b6elcregj72v34jr8g",
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "description": "Maximum traversal depth (levels of derivation edges)",
      "in": "query",
      "name": "depth",
      "required": false,
      "schema": {
        "default": 5,
        "description": "Maximum traversal depth (levels of derivation edges)",
        "example": 5,
        "maximum": 5,
        "minimum": 1,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "lineage": {
              "edges": [
                {
                  "from": "external:9e107d9d372bb6826bd81d3542a419d6",
                  "kind": "input_to",
                  "role": "source",
                  "to": "request:019e6d0a-e5be-7b82-b329-35ae64296902"
                },
                {
                  "from": "request:019e6d0a-e5be-7b82-b329-35ae64296902",
                  "kind": "generated_by",
                  "role": null,
                  "to": "asset:0f343b0931126a20f133d67c2b018a3b"
                },
                {
                  "from": "entity:43ce3411-1a25-4d14-875e-3562d341b090",
                  "kind": "referenced_entity",
                  "role": "content_ref",
                  "to": "request:019e6d0a-e5be-7b82-b329-35ae64296902"
                }
              ],
              "focus": "asset:0f343b0931126a20f133d67c2b018a3b",
              "nodes": [
                {
                  "asset_id": "d8b6elcregj72v34jr8g",
                  "id": "asset:0f343b0931126a20f133d67c2b018a3b",
                  "kind": "asset",
                  "output_key": "0f343b0931126a20f133d67c2b018a3b",
                  "request_id": "019e6d0a-e5be-7b82-b329-35ae64296902",
                  "tombstone": false,
                  "type": "image",
                  "url": "https://v3b.fal.media/files/b/0a9b4900/portrait.png"
                },
                {
                  "created_at": "2026-05-23T20:00:00.000Z",
                  "endpoint": "fal-ai/flux/dev",
                  "id": "request:019e6d0a-e5be-7b82-b329-35ae64296902",
                  "kind": "request",
                  "prompt": "cinematic portrait of a character",
                  "request_id": "019e6d0a-e5be-7b82-b329-35ae64296902"
                },
                {
                  "id": "external:9e107d9d372bb6826bd81d3542a419d6",
                  "kind": "external_input",
                  "output_key": "9e107d9d372bb6826bd81d3542a419d6",
                  "url": "https://fal.media/files/source.png"
                },
                {
                  "entity_id": "43ce3411-1a25-4d14-875e-3562d341b090",
                  "entity_type": "character",
                  "handle": "alice",
                  "id": "entity:43ce3411-1a25-4d14-875e-3562d341b090",
                  "kind": "entity",
                  "name": "Alice",
                  "tombstone": false
                }
              ]
            }
          },
