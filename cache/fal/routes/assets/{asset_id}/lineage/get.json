                  "edges": {
                    "description": "Lineage graph edges",
                    "items": {
                      "description": "A directed edge in the lineage graph",
                      "properties": {
                        "entities": {
                          "description": "input_to edges only: smart entities this input is the reference image of and that the request referenced",
