    "content": {
      "application/json": {
        "example": {
          "request_id": "019e6d0a-e5be-7b82-b329-35ae64296902"
        },
        "schema": {
          "properties": {
            "asset_id": {
              "description": "Asset ID (canonical catalog identity)",
              "minLength": 1,
              "type": "string"
            },
            "request_id": {
              "description": "Request ID to save as an asset before mutating",
              "minLength": 1,
              "type": "string"
            },
            "vector_id": {
              "description": "Vector ID to save as an asset before mutating. Prefer asset_id",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "required": true
  },
