      "in": "path",
      "name": "tag_id",
      "required": true,
      "schema": {
        "description": "Tag ID",
        "example": "d9k7q2m4n6p8r1s3t5uv",
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "description": "Optional idempotency key for safe request retries",
      "in": "header",
      "name": "Idempotency-Key",
      "required": false,
      "schema": {
        "description": "Optional idempotency key for safe request retries",
