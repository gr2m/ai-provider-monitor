          "schema": {
            "additionalProperties": false,
            "properties": {
              "runner_id": {
                "description": "ID of the runner whose graceful stop was requested",
                "example": "f1e2d3c4-b5a6-7890-dcba-0987654321fe",
                "type": "string"
              }
            },
            "required": [
              "runner_id"
            ],
            "type": "object"
          }
        }
      },
      "description": "Graceful stop requested successfully"
