{
  "description": "Gracefully stops a serverless runner owned by the authenticated account.\nThe runner stops accepting new requests and finishes in-flight work before shutting down.\n\nSet `replace_first=true` to start a replacement before stopping this runner.\nThis option applies to deployed application runners, not standalone `fal run` runners.\n\nA successful response acknowledges the stop request; the runner may still be draining.\nStopping a runner does not change the application's scaling configuration, so autoscaling may start new runners.\n\n**Required permissions:** `serverless:runners:terminate`. Key presets that include them: `COMPUTE`, `FULL`. See [key permissions](https://fal.ai/docs/documentation/model-apis/authentication/key-based#permissions).",
  "operationId": "serverlessStopRunner",
  "parameters": [
    {
      "description": "ID of the serverless runner to stop",
      "in": "path",
      "name": "runner_id",
      "required": true,
      "schema": {
        "description": "ID of the serverless runner to stop",
        "example": "f1e2d3c4-b5a6-7890-dcba-0987654321fe",
        "minLength": 1,
        "type": "string"
      }
    },
    {
      "description": "Whether to start a replacement runner before stopping this one. Defaults to false.",
      "in": "query",
      "name": "replace_first",
      "required": false,
      "schema": {
        "default": "false",
        "description": "Whether to start a replacement runner before stopping this one. Defaults to false.",
        "enum": [
          "true",
          "false"
        ],
        "example": "false",
        "type": "string"
      }
    }
  ],
  "responses": {
