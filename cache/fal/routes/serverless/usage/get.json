          "example": {
            "has_more": false,
            "next_cursor": null,
            "time_series": [
              {
                "bucket": "2025-01-15T00:00:00-05:00",
                "results": [
                  {
                    "app": "my-app-prod",
                    "cost": 1.188,
                    "cost_discount": 0,
                    "cost_subtotal": 1.188,
                    "cost_total": 1.188,
                    "currency": "USD",
                    "environment": null,
                    "is_surge": false,
                    "machine_type": "GPU-H100",
                    "percent_discount": null,
                    "quantity": 1200,
                    "unit": "second",
                    "unit_price": 0.00099
                  }
                ]
              }
            ]
          },
          "schema": {
            "description": "Response containing serverless usage data with pagination support",
            "properties": {
              "has_more": {
                "description": "Boolean indicating if more results are available (convenience field derived from next_cursor)",
                "type": "boolean"
              },
              "next_cursor": {
                "description": "Cursor for the next page of results, null if no more pages",
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "description": "Aggregate statistics (when expand includes 'summary')",
                "items": {
                  "description": "Aggregate usage statistics for the entire date range",
                  "properties": {
                    "app": {
                      "description": "Deployed serverless app name (the billing owner prefix is stripped, e.g. 'autohdr-raw-to-jpg-dev'). May include an environment/version suffix. Null for line items without an app attribution.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "cost": {
                      "deprecated": true,
                      "description": "Deprecated: use cost_total. Same value as cost_total.",
                      "minimum": 0,
                      "type": "number"
                    },
                    "cost_discount": {
                      "description": "Discount applied to this line item (cost_subtotal − cost_total)",
                      "minimum": 0,
                      "type": "number"
                    },
                    "cost_subtotal": {
                      "description": "Cost before discounts (quantity × unit_price)",
                      "minimum": 0,
                      "type": "number"
                    },
                    "cost_total": {
                      "description": "Amount charged after discounts (cost_subtotal − cost_discount)",
                      "minimum": 0,
                      "type": "number"
                    },
                    "currency": {
                      "description": "Three-letter currency code (ISO 4217, e.g., 'USD')",
                      "maxLength": 3,
                      "minLength": 3,
                      "type": "string"
                    },
                    "environment": {
                      "description": "Deployment environment of the app (e.g., 'production') when present on the billing line item, null otherwise.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "is_surge": {
                      "description": "Whether this usage was billed at surge pricing. Surge and non-surge usage of the same machine type appear as separate rows.",
                      "type": "boolean"
                    },
                    "machine_type": {
                      "description": "Machine type the usage ran on (e.g., 'GPU-H100', 'L')",
                      "type": "string"
                    },
                    "percent_discount": {
                      "description": "Percentage discount applied to this line item (e.g., 20 = 20% discount). Null when no percentage discount applies. Usage billed at different discount rates appears as separate rows, like unit_price.",
                      "maximum": 100,
                      "minimum": 0,
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "quantity": {
                      "description": "Quantity of usage in the specified billing unit",
                      "minimum": 0,
                      "type": "number"
                    },
                    "unit": {
                      "description": "The billing unit — always 'second' (machine-seconds)",
                      "type": "string"
                    },
                    "unit_price": {
                      "description": "Per-second price for this machine type before percentage discounts, including any customer-specific machine pricing",
                      "minimum": 0,
                      "type": "number"
                    }
