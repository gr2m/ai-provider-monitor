                          "environment",
                          "machine_type",
                          "unit",
                          "quantity",
                          "unit_price",
                          "percent_discount",
                          "cost_subtotal",
                          "cost_discount",
                          "cost_total",
                          "cost",
                          "currency",
                          "is_surge"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "bucket",
                    "results"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "next_cursor",
              "has_more"
            ],
            "type": "object"
          }
