{
  "description": "Lists the serverless applications owned by the authenticated account, with\nthe configuration needed for follow-up calls.\n\nEach application includes its canonical `endpoint_id` ('<owner>/<name>'),\nwhich is the identifier accepted by the analytics, requests, logs, and\nqueue endpoints — use this endpoint to discover identifiers instead of\nasking users to paste them.\n\nAdd `expand=endpoints` to also include each app's registered route-level\nendpoint ids (e.g. '<owner>/<name>/turbo'). Multi-route apps record their\nrequests/analytics data under these route-level ids.\n\n**Authentication:** Required via API key. Only applications owned by the\nauthenticated account are returned.",
  "operationId": "serverlessListApps",
  "parameters": [
    {
      "description": "Environment to list apps from. Defaults to the main environment.",
      "in": "query",
      "name": "environment",
      "required": false,
      "schema": {
        "description": "Environment to list apps from. Defaults to the main environment.",
        "example": "main",
        "type": "string"
      }
    },
    {
      "description": "Case-insensitive substring match on the app name",
      "in": "query",
      "name": "search",
      "required": false,
      "schema": {
        "description": "Case-insensitive substring match on the app name",
        "example": "image",
        "type": "string"
      }
    },
    {
      "description": "Fields to expand in the response. Use endpoints to include each app's registered route-level endpoint ids.",
      "explode": true,
      "in": "query",
      "name": "expand",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "Fields to expand in the response. Use endpoints to include each app's registered route-level endpoint ids.",
        "example": [
          "endpoints"
        ]
      },
      "style": "form"
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "apps": [
              {
                "auth_mode": "private",
                "endpoint_id": "user_123/my-app",
                "environment": "main",
                "keep_alive": 300,
                "machine_type": "GPU-H100",
                "max_concurrency": 2,
                "min_concurrency": 0,
                "name": "my-app",
                "owner": "user_123",
                "request_timeout": 600,
                "startup_timeout": 300,
                "updated_at": "2026-07-01T12:00:00Z",
                "valid_regions": [
                  "us"
                ]
              }
            ]
          },
          "schema": {
            "additionalProperties": false,
            "description": "The caller's serverless applications",
            "properties": {
              "apps": {
                "description": "Serverless applications owned by the authenticated account",
                "items": {
                  "additionalProperties": false,
                  "description": "A serverless application owned by the caller",
                  "properties": {
                    "auth_mode": {
                      "description": "Endpoint authentication mode",
                      "enum": [
                        "private",
                        "public",
                        "shared"
                      ],
                      "example": "private",
                      "type": "string"
                    },
                    "endpoint_id": {
                      "description": "Canonical endpoint identifier ('<owner>/<name>') accepted by the analytics, requests, logs, and queue endpoints",
                      "example": "user_123/my-app",
                      "type": "string"
                    },
                    "endpoints": {
                      "description": "Registered route-level endpoint ids for this app (only present when expand=endpoints). Multi-route apps record traffic under these ids, not the bare endpoint_id.",
                      "example": [
                        "user_123/my-app",
                        "user_123/my-app/turbo"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "environment": {
                      "description": "Environment the app is deployed in",
                      "example": "main",
                      "type": "string"
                    },
                    "keep_alive": {
                      "description": "Seconds a runner stays warm after its last request",
                      "example": 300,
                      "type": "number"
                    },
                    "machine_type": {
                      "description": "Machine type the app runs on",
                      "example": "GPU-H100",
                      "type": "string"
                    },
                    "max_concurrency": {
                      "description": "Maximum number of concurrent runners",
                      "example": 2,
                      "type": "number"
                    },
                    "min_concurrency": {
                      "description": "Minimum number of runners kept alive",
                      "example": 0,
                      "type": "number"
                    },
                    "name": {
                      "description": "Application name (alias)",
                      "example": "my-app",
                      "type": "string"
                    },
                    "owner": {
                      "description": "Nickname of the app owner",
                      "example": "user_123",
                      "type": "string"
                    },
                    "request_timeout": {
                      "description": "Request timeout in seconds",
                      "example": 600,
                      "type": "number"
                    },
                    "startup_timeout": {
                      "description": "Runner startup timeout in seconds",
                      "example": 300,
                      "type": "number"
                    },
                    "updated_at": {
                      "description": "Last update timestamp (UTC ISO8601)",
                      "example": "2026-07-01T12:00:00Z",
                      "type": "string"
                    },
                    "valid_regions": {
                      "description": "Regions the app may run in",
                      "example": [
                        "us"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "endpoint_id",
                    "name",
                    "owner",
                    "environment",
                    "machine_type",
                    "auth_mode",
                    "keep_alive",
                    "min_concurrency",
                    "max_concurrency",
                    "request_timeout",
                    "startup_timeout",
                    "valid_regions",
                    "updated_at"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "apps"
            ],
            "type": "object"
          }
        }
      },
      "description": "Successfully retrieved the caller's applications"
    },
    "400": {
      "content": {
        "application/json": {
          "example": {
            "error": {
              "message": "Invalid request parameters",
              "type": "validation_error"
            }
          },
          "schema": {
            "description": "Standard error response format",
            "properties": {
              "error": {
                "description": "Error details",
                "properties": {
                  "docs_url": {
                    "description": "Link to relevant documentation",
                    "format": "uri",
                    "type": "string"
                  },
                  "message": {
                    "description": "Human-readable error message",
                    "type": "string"
                  },
                  "request_id": {
                    "description": "Unique request identifier for debugging",
                    "type": "string"
                  },
                  "type": {
                    "description": "The category of error that occurred",
                    "enum": [
                      "authorization_error",
