{
  "description": "\nReplaces the account-level storage lifecycle settings applied to newly\nuploaded fal CDN files. Omitted or null fields are cleared (reset to the\nsystem default), so always send the full desired configuration. Sending an\nempty JSON object `{}` clears all settings. To change a single setting,\nfirst GET the current settings and PUT the full object back with only that\nfield changed.\n\nA request whose body is not valid JSON (including a zero-length body) or\nwhose Content-Type is not `application/json` is rejected with a 400\n`validation_error` and the stored settings are unchanged.\n\nACL rules referencing users that do not exist are dropped. The response\nreflects the settings actually saved, so verify it contains the rules you sent.\n\nThese are the same settings that the per-request\n`X-Fal-Object-Lifecycle-Preference` header overrides on individual requests.\n\n**Authentication:** Required. The API key must have the `account:settings:write` permission.\n    ",
  "operationId": "updateStorageSettings",
  "requestBody": {
    "content": {
      "application/json": {
        "example": {
          "expiration_duration_seconds": 86400,
          "initial_acl": {
            "default": "forbid",
            "rules": [
              {
                "decision": "allow",
                "user": "my-teammate"
              }
            ]
          }
        },
        "schema": {
          "additionalProperties": false,
          "description": "Account-level storage lifecycle settings",
          "properties": {
            "expiration_duration_seconds": {
              "description": "Seconds after which newly uploaded files automatically expire and are deleted. Null disables auto-expiration.",
              "example": 86400,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "initial_acl": {
              "additionalProperties": false,
              "description": "Default ACL applied to newly uploaded files. Null uses the system default (public).",
              "properties": {
                "default": {
                  "description": "Fallback decision when no user-specific rule matches",
                  "enum": [
                    "allow",
                    "forbid",
                    "hide"
                  ],
                  "example": "allow",
                  "type": "string"
                },
                "rules": {
                  "default": [],
                  "description": "User-specific overrides to the default decision",
                  "items": {
                    "additionalProperties": false,
                    "description": "A per-user access control rule",
                    "properties": {
                      "decision": {
                        "description": "Access decision applied to this user",
                        "enum": [
                          "allow",
                          "forbid",
                          "hide"
                        ],
                        "example": "allow",
                        "type": "string"
                      },
                      "user": {
                        "description": "User nickname or user ID the rule applies to",
                        "example": "some-user",
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "user",
                      "decision"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "default"
              ],
              "type": [
                "object",
                "null"
              ]
            }
          },
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "expiration_duration_seconds": 86400,
            "initial_acl": {
              "default": "forbid",
              "rules": [
                {
                  "decision": "allow",
                  "user": "my-teammate"
                }
              ]
            }
          },
          "schema": {
            "description": "Account-level storage lifecycle settings",
            "properties": {
              "expiration_duration_seconds": {
                "description": "Seconds after which newly uploaded files automatically expire, or null if auto-expiration is disabled",
                "example": 86400,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "initial_acl": {
                "description": "Default ACL applied to newly uploaded files, or null if the system default (public) is used",
                "properties": {
                  "default": {
                    "description": "Fallback decision when no user-specific rule matches",
                    "enum": [
                      "allow",
                      "forbid",
                      "hide"
                    ],
                    "example": "allow",
                    "type": "string"
                  },
                  "rules": {
                    "description": "User-specific overrides to the default decision. Users are returned as nicknames where possible.",
                    "items": {
                      "additionalProperties": false,
                      "description": "A per-user access control rule",
                      "properties": {
                        "decision": {
                          "description": "Access decision applied to this user",
                          "enum": [
                            "allow",
                            "forbid",
                            "hide"
                          ],
                          "example": "allow",
                          "type": "string"
                        },
                        "user": {
                          "description": "User nickname or user ID the rule applies to",
                          "example": "some-user",
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "decision"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "default",
                  "rules"
                ],
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "expiration_duration_seconds",
              "initial_acl"
            ],
            "type": "object"
          }
        }
      },
      "description": "Storage settings after the update"
    },
