{
  "description": "\nReturns the account-level storage lifecycle settings applied to newly uploaded\nfal CDN files:\n\n- `expiration_duration_seconds`: how long files live before being\n  automatically deleted (null disables auto-expiration).\n- `initial_acl`: the default ACL applied to new uploads (null means the\n  system default, which is public).\n\nBoth fields are null when the account has never saved settings.\n\n**Authentication:** Required. The API key must have the `account:settings:read` permission.\n    ",
  "operationId": "getStorageSettings",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "expiration_duration_seconds": 86400,
            "initial_acl": {
              "default": "forbid",
              "rules": [
                {
                  "decision": "allow",
                  "user": "my-teammate"
                }
              ]
            }
          },
          "schema": {
            "description": "Account-level storage lifecycle settings",
            "properties": {
              "expiration_duration_seconds": {
                "description": "Seconds after which newly uploaded files automatically expire, or null if auto-expiration is disabled",
                "example": 86400,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "initial_acl": {
                "description": "Default ACL applied to newly uploaded files, or null if the system default (public) is used",
                "properties": {
                  "default": {
                    "description": "Fallback decision when no user-specific rule matches",
                    "enum": [
                      "allow",
                      "forbid",
                      "hide"
                    ],
                    "example": "allow",
                    "type": "string"
                  },
                  "rules": {
                    "description": "User-specific overrides to the default decision. Users are returned as nicknames where possible.",
                    "items": {
                      "additionalProperties": false,
                      "description": "A per-user access control rule",
                      "properties": {
                        "decision": {
                          "description": "Access decision applied to this user",
                          "enum": [
                            "allow",
                            "forbid",
                            "hide"
                          ],
                          "example": "allow",
                          "type": "string"
                        },
                        "user": {
                          "description": "User nickname or user ID the rule applies to",
                          "example": "some-user",
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "decision"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "default",
                  "rules"
                ],
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "expiration_duration_seconds",
              "initial_acl"
            ],
            "type": "object"
          }
        }
      },
      "description": "Current storage settings"
    },
    "401": {
