{
  "description": "\nReturns the Access Control List currently applied to a fal CDN file.\n\nThe ACL consists of a default decision (`allow`, `forbid`, or `hide`) plus\noptional per-user rules that override the default. Rule users are returned as\nnicknames where possible.\n\n**Authentication:** Required. The API key must have the `assets:read` permission.\n    ",
  "operationId": "getStorageFileAcl",
  "parameters": [
    {
      "description": "Full URL of the fal CDN file, as returned by the upload APIs (https://v3.fal.media/files/b/<id>/<filename>). Must not contain query parameters.",
      "in": "query",
      "name": "url",
      "required": true,
      "schema": {
        "description": "Full URL of the fal CDN file, as returned by the upload APIs (https://v3.fal.media/files/b/<id>/<filename>). Must not contain query parameters.",
        "example": "https://v3.fal.media/files/b/0a1b2c3d/output.png",
        "format": "uri",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "default": "forbid",
            "rules": [
              {
                "decision": "allow",
                "user": "my-teammate"
              }
            ]
          },
          "schema": {
            "description": "Access Control List currently applied to the file",
            "properties": {
              "default": {
                "description": "Fallback decision when no user-specific rule matches",
                "enum": [
                  "allow",
                  "forbid",
                  "hide"
                ],
                "example": "allow",
                "type": "string"
              },
              "rules": {
                "description": "User-specific overrides to the default decision. Users are returned as nicknames where possible.",
                "items": {
                  "additionalProperties": false,
                  "description": "A per-user access control rule",
                  "properties": {
                    "decision": {
                      "description": "Access decision applied to this user",
                      "enum": [
                        "allow",
                        "forbid",
                        "hide"
                      ],
                      "example": "allow",
                      "type": "string"
                    },
                    "user": {
                      "description": "User nickname or user ID the rule applies to",
                      "example": "some-user",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "user",
                    "decision"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "default",
              "rules"
            ],
            "type": "object"
          }
        }
      },
      "description": "Current ACL of the file"
    },
    "400": {
      "content": {
        "application/json": {
          "example": {
            "error": {
              "message": "Invalid request parameters",
              "type": "validation_error"
