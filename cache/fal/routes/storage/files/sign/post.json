{
  "description": "\nCreates a signed URL that grants temporary access to a fal CDN file,\nregardless of its ACL. Useful for sharing access-restricted files.\n\nThe signature is valid for `expiration_seconds` (up to 7 days).\n\n**Authentication:** Required. The API key must have the `assets:read` permission.\n    ",
  "operationId": "signStorageFileUrl",
  "parameters": [
    {
      "description": "Full URL of the fal CDN file, as returned by the upload APIs (https://v3.fal.media/files/b/<id>/<filename>). Must not contain query parameters.",
      "in": "query",
      "name": "url",
      "required": true,
      "schema": {
        "description": "Full URL of the fal CDN file, as returned by the upload APIs (https://v3.fal.media/files/b/<id>/<filename>). Must not contain query parameters.",
        "example": "https://v3.fal.media/files/b/0a1b2c3d/output.png",
        "format": "uri",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "example": {
          "expiration_seconds": 3600
        },
        "schema": {
          "additionalProperties": false,
          "description": "Signing options for the file URL",
          "properties": {
            "expiration_seconds": {
              "description": "How long the signed URL stays valid, in seconds (max 7 days)",
              "example": 3600,
              "maximum": 604800,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "expiration_seconds"
          ],
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "signed_url": "https://v3.fal.media/files/b/0a1b2c3d/output.png?identity=..."
          },
          "schema": {
            "description": "Signed URL response",
            "properties": {
              "signed_url": {
                "description": "URL with an embedded signature granting temporary access",
                "example": "https://v3.fal.media/files/b/0a1b2c3d/output.png?identity=...",
                "type": "string"
              }
            },
            "required": [
              "signed_url"
            ],
            "type": "object"
          }
        }
      },
      "description": "Signed URL granting temporary access"
    },
    "400": {
