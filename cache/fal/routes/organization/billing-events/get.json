                    "request_id",
                    "endpoint_id",
                    "timestamp",
                    "output_units",
                    "unit_price",
                    "percent_discount",
                    "cost_subtotal",
                    "cost_discount",
                    "cost_total",
                    "cost_estimate_nano_usd"
