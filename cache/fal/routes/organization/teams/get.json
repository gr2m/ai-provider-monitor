{
  "description": "\nReturns the list of teams in your organization with their details.\n\n> **Availability:** This endpoint is available to enterprise customers with organizations enabled. Contact your account team or support@fal.ai to request access.\n\nMust be called with an admin API key on the organization's root team.\n\n**Key Features:**\n- List all teams within the organization\n- Identify the organization's root team via `is_org_root`\n- View team usernames and display names\n\nSee [fal.ai docs](https://fal.ai/docs/documentation) for more details.\n    ",
  "operationId": "getOrganizationTeams",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "teams": [
              {
                "created_at": "2024-01-15T10:30:00Z",
                "is_org_root": true,
                "name": "Acme Corporation",
                "username": "acme-corp"
              },
              {
                "created_at": "2024-03-01T14:00:00Z",
                "is_org_root": false,
                "name": "ML Research Team",
                "username": "acme-ml-team"
              }
            ]
          },
          "schema": {
            "description": "Response containing organization team details",
            "properties": {
              "teams": {
                "description": "List of teams in the organization",
                "items": {
                  "description": "Organization team details",
                  "properties": {
                    "created_at": {
                      "description": "Team creation timestamp in ISO8601 format",
                      "example": "2024-01-15T10:30:00Z",
                      "type": "string"
                    },
                    "is_org_root": {
                      "description": "True if this is the root organization team; false for sub-teams",
                      "example": true,
                      "type": "boolean"
                    },
                    "name": {
                      "description": "Human-readable display name of the team",
                      "example": "Acme Corporation",
                      "type": "string"
                    },
                    "username": {
                      "description": "Team username/identifier (unique within the organization)",
                      "example": "acme-corp",
                      "type": "string"
                    }
                  },
                  "required": [
                    "username",
                    "name",
                    "is_org_root",
                    "created_at"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "teams"
            ],
            "type": "object"
          }
        }
      },
      "description": "Organization teams retrieved successfully"
    },
