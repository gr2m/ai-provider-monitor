{
  "description": "Returns a list of all API keys belonging to the authenticated user's workspace.\n\n**Key Features:**\n- View all API keys with their aliases and creation dates\n- See how each key is permissioned via `mode`, `preset` and `permissions`\n- Optionally expand to include creator information\n- Paginated results for workspaces with many keys\n\n**Key Modes:**\n- `preset`: created from a named permission preset, reported in `preset`\n- `custom`: created with an explicit list of permissions\n- `legacy`: predates granular permissions and carries a coarse scope\n\n**Expansion Options:**\n- `expand=creator_info`: Include creator_nickname and creator_email for each key\n\n**Common Use Cases:**\n- Audit existing API keys\n- Find keys by alias\n- Monitor key creation activity\n- Build key management interfaces\n\n**Required permissions:** `auth:keys:read`. Key presets that include them: `BILLING`, `FULL`. See [key permissions](https://fal.ai/docs/documentation/model-apis/authentication/key-based#permissions).",
  "operationId": "listApiKeys",
  "parameters": [
    {
      "description": "Maximum number of items to return. Actual maximum depends on query type and expansion parameters.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "description": "Maximum number of items to return. Actual maximum depends on query type and expansion parameters.",
        "example": 50,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "Pagination cursor from previous response. Encodes the page number.",
      "in": "query",
      "name": "cursor",
      "required": false,
      "schema": {
        "description": "Pagination cursor from previous response. Encodes the page number.",
        "example": "Mg==",
        "type": "string"
      }
    },
    {
      "description": "Fields to expand in the response. Available: creator_info (includes creator_nickname and creator_email)",
      "explode": true,
      "in": "query",
      "name": "expand",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "Fields to expand in the response. Available: creator_info (includes creator_nickname and creator_email)",
        "example": [
          "creator_info"
        ]
      },
      "style": "form"
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "example": {
            "has_more": false,
            "keys": [
              {
                "alias": "Production Key",
                "created_at": "2025-01-15T12:00:00Z",
                "expires_at": null,
                "key_id": "abc123def456",
                "mode": "preset",
                "permissions": [
                  "account:settings:read",
                  "assets:read",
                  "assets:write",
                  "auth:tokens:create",
                  "models:list",
                  "models:metrics:read",
                  "models:requests:cancel",
                  "models:requests:read",
                  "models:requests:share",
                  "models:requests:submit",
                  "serverless:metrics:read",
                  "serverless:requests:read",
                  "workflows:read",
                  "workflows:submit"
                ],
                "preset": "API"
              },
              {
                "alias": "Inference Key",
                "created_at": "2025-01-10T09:30:00Z",
                "expires_at": null,
                "key_id": "xyz789ghi012",
                "mode": "custom",
                "permissions": [
                  "models:list",
                  "models:requests:read",
                  "models:requests:submit"
                ]
              }
            ],
            "next_cursor": null
          },
          "schema": {
            "description": "Response containing a list of API keys with pagination support",
            "properties": {
              "has_more": {
                "description": "Boolean indicating if more results are available (convenience field derived from next_cursor)",
                "type": "boolean"
              },
              "keys": {
                "description": "Array of API keys belonging to the authenticated user",
                "items": {
                  "description": "API key information",
                  "properties": {
                    "alias": {
                      "description": "User-provided friendly name for the key",
                      "example": "Production Key",
                      "type": "string"
                    },
                    "created_at": {
                      "description": "ISO8601 timestamp when the key was created",
                      "example": "2025-01-15T12:00:00Z",
                      "type": "string"
                    },
                    "creator_email": {
                      "description": "Email of the user who created this key (when expanded)",
                      "example": "developer@example.com",
                      "type": "string"
                    },
                    "creator_nickname": {
                      "description": "Nickname of the user who created this key (when expanded)",
                      "example": "developer",
                      "type": "string"
                    },
                    "description": {
                      "description": "User-provided description of what the key is for",
                      "example": "CI deploy key for the main environment",
                      "type": "string"
                    },
                    "expires_at": {
                      "description": "ISO8601 timestamp when the key expires, or null if it doesn't",
                      "example": "2025-07-15T12:00:00Z",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "key_id": {
                      "description": "Unique identifier for the API key",
                      "example": "abc123def456",
                      "type": "string"
                    },
                    "mode": {
                      "description": "How the key's permissions are expressed: a named preset, a custom permission list, or a legacy scope.",
                      "enum": [
                        "legacy",
                        "preset",
                        "custom"
                      ],
                      "example": "preset",
                      "type": "string"
                    },
                    "permissions": {
                      "description": "Resolved permissions, present for preset and custom keys",
                      "example": [
                        "models:requests:read",
                        "models:requests:write"
                      ],
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "type": "array"
                    },
                    "preset": {
                      "description": "Preset the key was created from, present when mode is preset",
                      "enum": [
                        "FULL",
                        "AGENT",
                        "API",
                        "DEPLOY",
                        "READONLY",
                        "BILLING",
                        "COMPUTE",
                        "SERVERLESS"
                      ],
                      "example": "API",
                      "type": "string"
                    },
                    "scope": {
                      "deprecated": true,
                      "description": "Coarse scope of a legacy API key. Deprecated: superseded by mode, preset and permissions, and omitted for keys that carry granular permissions.",
                      "enum": [
                        "API",
                        "ADMIN"
                      ],
                      "example": "API",
                      "type": "string"
                    }
                  },
                  "required": [
                    "key_id",
                    "alias",
                    "created_at",
                    "mode",
                    "expires_at"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "next_cursor": {
                "description": "Cursor for the next page of results, null if no more pages",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "next_cursor",
              "has_more",
              "keys"
            ],
            "type": "object"
          }
        }
      },
      "description": "Successfully retrieved API keys"
    },
