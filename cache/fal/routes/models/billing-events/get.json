                    "request_id",
                    "endpoint_id",
                    "timestamp",
                    "output_units",
                    "unit_price",
                    "percent_discount",
                    "cost_subtotal",
                    "cost_discount",
                    "cost_total",
                    "cost_estimate_nano_usd"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "has_more": {
                "description": "Boolean indicating if more results are available (convenience field derived from next_cursor)",
                "type": "boolean"
              },
              "next_cursor": {
                "description": "Cursor for the next page of results, null if no more pages",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "next_cursor",
              "has_more",
              "billing_events"
            ],
            "type": "object"
