{
  "description": "\nEstimates what requests would cost before you run them.\n\n**Request-based estimates** (`items`): send each request's endpoint and\ninput, and get back what it would cost if it succeeds. Each endpoint's own\nestimate reads the input to predict what the request uses (images, seconds,\ncharacters, ...), and the same pricing that bills the request prices it.\nAmounts are decimal strings in USD **before percentage discounts**; your\naccount's discount is applied at billing. An estimate is advisory, not a price\nlock, and estimating is never billed.\n\n- Up to 20 items per call, one request each\n- Items are priced on their own: one that can't be priced reports why in its\n  `error` and never fails the others\n- `status` is `partial` when something can't be predicted from the input\n  (see `warnings`); `rated_amount` then sums only what can\n- Endpoints without request-based pricing yet return `pricing_not_configured`\n  or `estimate_not_registered`\n\n**Deprecated:** `estimate_type` with `historical_api_price` (calls ×\nhistorical cost per call) or `unit_price` (units × one unit price). They keep\nworking for now; use `items` instead.\n\n**Authentication:** Required. Users must provide a valid API key.\n\nSee [fal.ai pricing](https://fal.ai/pricing) for more details.\n    \n\n**Required permissions:** none. Any authenticated caller can use this API.",
  "operationId": "estimatePricing",
  "requestBody": {
    "content": {
      "application/json": {
        "examples": {
          "historical": {
            "summary": "Historical API price estimate (deprecated)",
            "value": {
              "endpoints": {
                "fal-ai/flux/dev": {
                  "call_quantity": 100
                },
                "fal-ai/flux/schnell": {
                  "call_quantity": 50
                }
              },
              "estimate_type": "historical_api_price"
            }
          },
          "items": {
            "summary": "Request-based estimate",
            "value": {
              "items": [
                {
                  "endpoint_id": "xai/tts/v1",
                  "input": {
                    "text": "Hello from fal"
                  }
                }
              ]
            }
          },
          "unit_price": {
            "summary": "Unit price estimate (deprecated)",
            "value": {
              "endpoints": {
                "fal-ai/flux-pro": {
                  "unit_quantity": 25
                },
                "fal-ai/flux/dev": {
                  "unit_quantity": 50
                }
              },
              "estimate_type": "unit_price"
            }
          }
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": false,
              "description": "Request-based estimate: prices each request from its input, as its endpoint would bill it.",
              "properties": {
                "items": {
                  "description": "The requests to price, 1 to 20. Each is priced on its own: one that can't be priced never fails the others.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "endpoint_id": {
                        "description": "The endpoint as you would call it, e.g. 'xai/tts/v1'. Aliases are priced under the name called.",
                        "minLength": 1,
                        "type": "string"
                      },
                      "input": {
                        "additionalProperties": {},
                        "description": "The request body you would send to the endpoint. The endpoint's own estimate reads it to predict what the request uses.",
                        "type": "object"
                      }
                    },
                    "required": [
                      "endpoint_id",
                      "input"
                    ],
                    "type": "object"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "items"
              ],
              "type": "object"
            },
            {
              "description": "Historical API price estimate: Calculates cost based on historical pricing per API call. Useful for estimating costs based on actual usage patterns.",
              "properties": {
                "endpoints": {
                  "additionalProperties": {
                    "properties": {
                      "call_quantity": {
                        "description": "Number of API calls to estimate (regardless of units per call)",
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "call_quantity"
                    ],
                    "type": "object"
                  },
                  "description": "Map of endpoint IDs to call quantities",
                  "type": "object"
                },
                "estimate_type": {
                  "description": "Estimate type: historical API pricing based on past usage patterns",
                  "enum": [
                    "historical_api_price"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "estimate_type",
                "endpoints"
              ],
              "type": "object"
            },
            {
              "description": "Unit price estimate: Calculates cost based on unit price × billing units. Useful for estimating costs when you know the expected output quantity.",
              "properties": {
                "endpoints": {
                  "additionalProperties": {
                    "properties": {
                      "unit_quantity": {
                        "description": "Number of billing units expected (e.g., number of images, videos, etc.)",
                        "minimum": 0.000001,
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit_quantity"
                    ],
                    "type": "object"
                  },
                  "description": "Map of endpoint IDs to unit quantities",
                  "type": "object"
                },
                "estimate_type": {
                  "description": "Estimate type: unit price calculation based on billing units",
                  "enum": [
                    "unit_price"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "estimate_type",
                "endpoints"
              ],
              "type": "object"
            }
          ],
          "example": {
            "items": [
              {
                "endpoint_id": "xai/tts/v1",
                "input": {
                  "text": "Hello from fal"
                }
              }
            ]
          }
        }
      }
    }
  },
