{
  "description": "Returns Prometheus-compatible metrics for an active compute cluster owned by the authenticated caller. Requires compute access and compute:instances:read permission. Use the compute_cluster query parameter to select the cluster by label.\n\n**Required permissions:** `compute:instances:read`. Key presets that include them: `COMPUTE`, `READONLY`, `FULL`. See [key permissions](https://fal.ai/docs/documentation/model-apis/authentication/key-based#permissions).",
  "operationId": "getComputeMetrics",
  "parameters": [
    {
      "description": "The label of the compute cluster owned by the caller",
      "in": "query",
      "name": "compute_cluster",
      "required": true,
      "schema": {
        "description": "The label of the compute cluster owned by the caller",
        "example": "my-cluster",
        "minLength": 1,
        "type": "string"
      }
    }
  ],
