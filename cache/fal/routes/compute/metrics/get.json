          "example": "# HELP DCGM_FI_DEV_GPU_UTIL Compute cluster telemetry\n# TYPE DCGM_FI_DEV_GPU_UTIL untyped\nDCGM_FI_DEV_GPU_UTIL{compute_cluster=\"cluster-id\",gpu=\"0\",job=\"compute-dcgm-exporter\"} 42.0\n",
          "schema": {
            "description": "Prometheus-compatible compute metrics in text format",
            "type": "string"
          }
        }
      },
      "description": "Prometheus-compatible compute metrics retrieved successfully"
    },
