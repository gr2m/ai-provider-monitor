              },
              {
                "$ref": "#/components/schemas/BetaOverloadedError"
              }
            ],
            "title": "Error"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id",
          "type"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "BetaJwksDiscovery": {
        "additionalProperties": false,
        "description": "JWKS via the issuer's OIDC discovery document.",
        "properties": {
          "ca_cert_pem": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional custom CA (PEM) for TLS verification of the JWKS fetch.",
            "title": "Ca Cert Pem"
          },
          "discovery_base": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the discovery URL differs from `issuer_url`.",
            "title": "Discovery Base"
          },
          "type": {
            "const": "discovery",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "JwksDiscovery",
        "type": "object"
      },
      "BetaJwksExplicitUrl": {
        "additionalProperties": false,
        "description": "JWKS fetched from a fixed endpoint.",
        "properties": {
          "ca_cert_pem": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional custom CA (PEM) for TLS verification of the JWKS fetch.",
            "title": "Ca Cert Pem"
          },
          "type": {
            "const": "explicit_url",
            "title": "Type",
            "type": "string"
          },
          "url": {
            "description": "JWKS endpoint.",
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ],
        "title": "JwksExplicitUrl",
        "type": "object"
      },
      "BetaJwksInline": {
        "additionalProperties": false,
        "description": "JWKS supplied directly; no network fetch.",
        "properties": {
          "keys": {
            "description": "Inline JWK objects.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "minItems": 1,
            "title": "Keys",
            "type": "array"
          },
          "type": {
            "const": "inline",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "keys",
          "type"
        ],
        "title": "JwksInline",
        "type": "object"
      },
      "BetaIssuerPollStatus": {
        "description": "Status of automatic JWKS polling for a federation issuer.\n\nAnthropic periodically fetches the issuer's signing keys in the\nbackground. These fields summarize the most recent fetches so the\nhealth of the JWKS endpoint can be monitored.",
        "properties": {
          "consecutive_failures": {
            "description": "Consecutive fetch failures since the last success.",
            "title": "Consecutive Failures",
            "type": "integer"
          },
          "last_fetched_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the last successful fetch completed.",
            "title": "Last Fetched At"
          },
          "next_poll_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the next fetch is scheduled. Null if paused.",
            "title": "Next Poll At"
          }
        },
        "required": [
          "consecutive_failures",
          "last_fetched_at",
          "next_poll_at"
        ],
        "title": "IssuerPollStatus",
        "type": "object"
      },
