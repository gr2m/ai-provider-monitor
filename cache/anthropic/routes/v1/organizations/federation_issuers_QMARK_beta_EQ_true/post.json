{
  "description": "**Requires an OAuth access token with the `org:admin` scope**, from `ant auth login --scope org:admin` or a workload identity federation rule; Admin API keys are not accepted. See [Manage WIF with the Admin API](/docs/en/manage-claude/wif-admin-api).\n\nRegister an OIDC issuer that Anthropic will trust for workload identity\nfederation in your organization.\n\nThe `jwks` field controls how the issuer's signing keys are obtained and\ntakes one of three shapes selected by `type`: `discovery` (resolve keys\nthrough OIDC discovery), `explicit_url` (fetch keys from a fixed JWKS\nURL), or `inline` (provide a static key set). When `jwks.type` is\n`discovery` and no `discovery_base` is set, the issuer URL must be\npublicly reachable over HTTPS so Anthropic can fetch the discovery\ndocument; for `explicit_url` and `inline` modes the issuer URL is only\nmatched as the JWT's `iss` claim and is not fetched.",
  "operationId": "beta_create_federation_issuer_v1_organizations_federation_issuers_post",
  "parameters": [
    {
      "description": "Optional header to specify the beta version(s) you want to use.\n\nTo use multiple betas, use a comma separated list like `beta1,beta2` or specify the header multiple times for each beta.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "Optional header to specify the beta version(s) you want to use.\n\nTo use multiple betas, use a comma separated list like `beta1,beta2` or specify the header multiple times for each beta.",
        "items": {
          "type": "string"
        },
        "title": "Anthropic-Beta",
        "type": "string"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "title": "Anthropic-Version",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/BetaFederationIssuerCreateParams"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaFederationIssuer"
          }
        }
      },
      "description": "Successful Response"
    },
    "4XX": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaErrorResponse"
          }
        }
      },
      "description": "Error response.\n\nSee our [errors documentation](https://platform.claude.com/docs/en/api/errors) for more details."
    }
  },
  "summary": "Create Federation Issuer",
  "components": {
    "schemas": {
      "BetaFederationIssuerCreateParams": {
        "additionalProperties": false,
        "properties": {
          "check_jti": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the jwt-bearer exchange enforces JTI single-use (replay protection) for tokens from this issuer. Defaults to true. Applies only to assertions carrying a `jti` claim; tokens without one are accepted without single-use enforcement.",
            "title": "Check Jti"
          },
          "issuer_url": {
            "description": "The `iss` claim value to match against.",
            "minLength": 1,
            "title": "Issuer Url",
            "type": "string"
          },
          "jwks": {
            "description": "How signing keys are obtained. Defaults to OIDC discovery.",
            "discriminator": {
              "mapping": {
                "discovery": "#/components/schemas/BetaJwksDiscovery",
                "explicit_url": "#/components/schemas/BetaJwksExplicitUrl",
                "inline": "#/components/schemas/BetaJwksInline"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaJwksDiscovery"
              },
              {
                "$ref": "#/components/schemas/BetaJwksExplicitUrl"
              },
              {
                "$ref": "#/components/schemas/BetaJwksInline"
              }
            ],
            "title": "Jwks"
          },
          "max_jwt_lifetime_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 176400,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum allowed iat→exp spread for assertions from this issuer (1-176400 seconds, i.e. up to 49h). Defaults to 3600 (1h). Assertions must carry both `iat` and `exp`; a missing `iat` is rejected.",
            "title": "Max Jwt Lifetime Seconds"
          },
          "name": {
            "description": "Slug identifier (lowercase, digits, hyphens). Unique within the organization; a duplicate name returns 409.",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "issuer_url",
          "name"
        ],
        "title": "FederationIssuerCreateParams",
        "type": "object"
      },
      "BetaFederationIssuer": {
        "description": "Registered external OIDC identity provider.\n\nRecords an external IdP the organization trusts for the RFC 7523\njwt-bearer grant. The `issuer_url` must match the JWT `iss` claim exactly.",
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If set, all rules referencing this issuer reject token exchange.",
            "title": "Archived At"
          },
          "archived_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that archived this issuer.",
            "title": "Archived By Actor Id"
          },
          "check_jti": {
            "description": "Whether the jwt-bearer exchange enforces JTI single-use (replay protection) for tokens from this issuer. Applies only to assertions carrying a `jti` claim; tokens without one are accepted without single-use enforcement.",
            "title": "Check Jti",
            "type": "boolean"
          },
          "created_at": {
            "description": "When this issuer was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that created this issuer.",
            "title": "Created By Actor Id"
          },
          "id": {
            "description": "Tagged ID of the federation issuer.",
            "examples": [
              "fdis_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "Id",
            "type": "string"
          },
          "issuer_url": {
            "description": "The `iss` claim value. Incoming JWTs must match exactly.",
            "examples": [
              "https://token.actions.githubusercontent.com"
            ],
            "title": "Issuer Url",
            "type": "string"
          },
          "jwks": {
            "description": "How signing keys are obtained for signature verification.",
            "discriminator": {
              "mapping": {
                "discovery": "#/components/schemas/BetaJwksDiscovery",
                "explicit_url": "#/components/schemas/BetaJwksExplicitUrl",
                "inline": "#/components/schemas/BetaJwksInline"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaJwksDiscovery"
              },
              {
                "$ref": "#/components/schemas/BetaJwksExplicitUrl"
              },
              {
                "$ref": "#/components/schemas/BetaJwksInline"
              }
            ],
            "title": "Jwks"
          },
          "jwks_polling_disabled_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If set, Anthropic's JWKS poller has paused polling for this issuer after repeated fetch failures. Re-enable by sending `jwks_polling_disabled: false` via the issuer update endpoint (POST) once the upstream JWKS endpoint is fixed. An OAuth caller cannot send this when the issuer backs a rule with any scope other than `workspace:developer` or `workspace:inference`; use a Console session.",
            "title": "Jwks Polling Disabled At"
          },
          "max_jwt_lifetime_seconds": {
            "description": "Maximum allowed iat→exp spread for assertions from this issuer (1-176400 seconds, i.e. up to 49h). Assertions must carry both `iat` and `exp`; a missing `iat` is rejected.",
            "title": "Max Jwt Lifetime Seconds",
            "type": "integer"
          },
          "name": {
            "description": "Admin-chosen slug identifier.",
            "examples": [
              "github-actions"
            ],
            "title": "Name",
            "type": "string"
          },
          "poll_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaIssuerPollStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Live state of Anthropic's JWKS polling for this issuer. Populated on both single-issuer retrieval and list responses, including archived issuers. Typically null for inline-key issuers (no polling), or when poll status is temporarily unavailable or polling has not started yet."
          },
          "type": {
            "const": "federation_issuer",
            "default": "federation_issuer",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "When this issuer was last updated.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that last updated this issuer.",
            "title": "Updated By Actor Id"
          }
        },
        "required": [
          "archived_at",
          "archived_by_actor_id",
          "check_jti",
          "created_at",
          "created_by_actor_id",
          "id",
          "issuer_url",
          "jwks",
          "jwks_polling_disabled_at",
          "max_jwt_lifetime_seconds",
          "name",
          "poll_status",
          "type",
          "updated_at",
          "updated_by_actor_id"
        ],
        "title": "FederationIssuer",
        "type": "object"
      },
