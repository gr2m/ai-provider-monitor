  "summary": "Create Invite",
  "components": {
    "schemas": {
      "BetaCreateInviteParams": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Email of the User.",
            "examples": [
              "user@emaildomain.com"
            ],
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "rbac_group_ids": {
            "description": "RBAC group IDs to assign to the User when the Invite is accepted. A non-empty array is accepted only for a Claude Enterprise organization with RBAC groups, and requires the key to carry the `write:rbac_groups` scope.",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Rbac Group Ids",
            "type": "array"
          },
          "role": {
            "description": "Role for the invited User.\n\nThe accepted values depend on the organization type. Console and API organizations accept `user`, `developer`, `billing`, and `claude_code_user`; `admin` cannot be assigned through the API. Claude Enterprise organizations accept `user` and `managed`; inviting with the `managed` role requires the `write:rbac_groups` scope in addition to `write:members`.",
            "enum": [
              "billing",
              "claude_code_user",
              "developer",
              "managed",
              "user"
            ],
            "examples": [
              "user",
              "developer",
              "billing",
              "claude_code_user"
            ],
            "title": "NoAdminRoleSchema",
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "title": "CreateInviteParams",
        "type": "object"
      },
      "BetaInviteSchema": {
        "properties": {
          "accepted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339 datetime string indicating when the Invite was accepted, or null.",
            "title": "Accepted At"
          },
          "email": {
            "description": "Email of the User being invited.",
            "examples": [
              "user@emaildomain.com"
            ],
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339 datetime string indicating when the Invite expires.",
            "examples": [
              "2024-11-20T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "description": "ID of the Invite.",
            "examples": [
              "invite_015gWxCN9Hfg2QhZwTK7Mdeu"
            ],
            "title": "Id",
            "type": "string"
          },
          "invited_at": {
            "description": "RFC 3339 datetime string indicating when the Invite was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Invited At",
            "type": "string"
          },
          "rbac_group_ids": {
            "description": "RBAC group IDs recorded on the Invite (Claude Enterprise organizations), to be assigned to the User when the Invite is accepted. `[]` when none.",
            "items": {
              "type": "string"
            },
            "title": "Rbac Group Ids",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/BetaOrganizationRoleSchema",
            "description": "Organization role of the User.",
            "examples": [
              "user",
              "developer",
              "billing",
              "admin",
              "claude_code_user"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/BetaInviteStatusSchema",
            "description": "Status of the Invite.",
            "examples": [
              "pending"
            ]
          },
          "type": {
            "const": "invite",
            "default": "invite",
            "description": "Object type.\n\nFor Invites, this is always `\"invite\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "accepted_at",
          "email",
          "expires_at",
          "id",
          "invited_at",
          "rbac_group_ids",
          "role",
          "status",
          "type"
        ],
        "title": "InviteSchema",
        "type": "object"
      },
      "BetaAlreadyMemberErrorDetails": {
        "description": "The email address already belongs to a user in the organization. The message names the user.",
        "properties": {
          "error_code": {
            "const": "already_member",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "AlreadyMemberErrorDetails",
        "type": "object"
      },
      "BetaCannotInviteEmailsWithUnverifiedDomainsErrorDetails": {
        "description": "The email address's domain is not one of the verified domains of the organization's parent organization.",
        "properties": {
          "error_code": {
            "const": "cannot_invite_emails_with_unverified_domains",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "CannotInviteEmailsWithUnverifiedDomainsErrorDetails",
        "type": "object"
      },
      "BetaEmailDomainNotAllowedErrorDetails": {
        "description": "The organization restricts invites to an allowed list of email domains, and the list is empty or does not include the email address's domain.",
        "properties": {
          "error_code": {
            "const": "email_domain_not_allowed",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "EmailDomainNotAllowedErrorDetails",
        "type": "object"
      },
      "BetaInviteAlreadyExistsErrorDetails": {
        "description": "A pending invite already exists for the email address. The message names the invite.",
        "properties": {
          "error_code": {
            "const": "invite_already_exists",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "InviteAlreadyExistsErrorDetails",
        "type": "object"
      },
      "BetaOrgMemberLimitExceededErrorDetails": {
        "description": "The organization has reached the member limit that Anthropic set for it. Pending invites count toward the limit.",
        "properties": {
          "error_code": {
            "const": "org_member_limit_exceeded",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "OrgMemberLimitExceededErrorDetails",
        "type": "object"
      },
      "BetaRbacGroupGrantsOwnerAccessErrorDetails": {
        "description": "A role attached to an RBAC Group in the request grants owner access, so this API does not add members to that group (directly or through an invite), remove its members, or delete it. Make the change in the organization's admin settings in Claude.",
        "properties": {
          "error_code": {
            "const": "rbac_group_grants_owner_access",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "RbacGroupGrantsOwnerAccessErrorDetails",
        "type": "object"
      },
      "BetaRbacGroupOwnerAccessUnconfirmedErrorDetails": {
        "description": "The API could not finish checking whether an RBAC Group in the request grants owner access, so it made no change. Retrying the same request will not help. Make the change in the organization's admin settings in Claude.",
        "properties": {
          "error_code": {
            "const": "rbac_group_owner_access_unconfirmed",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "RbacGroupOwnerAccessUnconfirmedErrorDetails",
        "type": "object"
      },
