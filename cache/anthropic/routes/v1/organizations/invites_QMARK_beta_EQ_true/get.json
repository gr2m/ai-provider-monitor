      "BetaInviteSchema": {
        "properties": {
          "accepted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339 datetime string indicating when the Invite was accepted, or null.",
            "title": "Accepted At"
          },
          "email": {
            "description": "Email of the User being invited.",
            "examples": [
              "user@emaildomain.com"
            ],
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "description": "RFC 3339 datetime string indicating when the Invite expires.",
            "examples": [
              "2024-11-20T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "description": "ID of the Invite.",
            "examples": [
              "invite_015gWxCN9Hfg2QhZwTK7Mdeu"
            ],
            "title": "Id",
            "type": "string"
          },
          "invited_at": {
            "description": "RFC 3339 datetime string indicating when the Invite was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Invited At",
            "type": "string"
          },
          "rbac_group_ids": {
            "description": "RBAC group IDs recorded on the Invite (Claude Enterprise organizations), to be assigned to the User when the Invite is accepted. `[]` when none.",
            "items": {
              "type": "string"
            },
            "title": "Rbac Group Ids",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/BetaOrganizationRoleSchema",
            "description": "Organization role of the User.",
            "examples": [
              "user",
              "developer",
              "billing",
              "admin",
              "claude_code_user"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/BetaInviteStatusSchema",
            "description": "Status of the Invite.",
            "examples": [
              "pending"
            ]
          },
          "type": {
            "const": "invite",
            "default": "invite",
            "description": "Object type.\n\nFor Invites, this is always `\"invite\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "accepted_at",
          "email",
          "expires_at",
          "id",
          "invited_at",
          "rbac_group_ids",
          "role",
          "status",
          "type"
        ],
