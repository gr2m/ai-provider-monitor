{
  "description": "List the organization's invites.",
  "operationId": "beta_list_invites_v1_organizations_invites_get",
  "parameters": [
    {
      "description": "ID of the object to use as a cursor for pagination. When provided, returns the page of results immediately before this object.",
      "in": "query",
      "name": "before_id",
      "required": false,
      "schema": {
        "description": "ID of the object to use as a cursor for pagination. When provided, returns the page of results immediately before this object.",
        "title": "Before Id",
        "type": "string"
      }
    },
    {
      "description": "ID of the object to use as a cursor for pagination. When provided, returns the page of results immediately after this object.",
      "in": "query",
      "name": "after_id",
      "required": false,
      "schema": {
        "description": "ID of the object to use as a cursor for pagination. When provided, returns the page of results immediately after this object.",
        "title": "After Id",
        "type": "string"
      }
    },
    {
      "description": "Number of items to return per page.\n\nDefaults to `20`. Ranges from `1` to `1000`.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "description": "Number of items to return per page.\n\nDefaults to `20`. Ranges from `1` to `1000`.",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "description": "Filter by Invite status. Repeatable; values are OR'ed together. Omit to return `pending`, `accepted`, and `expired` Invites alike.",
      "in": "query",
      "name": "statuses[]",
      "required": false,
      "schema": {
        "description": "Filter by Invite status. Repeatable; values are OR'ed together. Omit to return `pending`, `accepted`, and `expired` Invites alike.",
        "items": {
          "enum": [
            "accepted",
            "expired",
            "pending"
          ],
          "type": "string"
        },
        "title": "Statuses[]",
        "type": "array"
      }
    },
    {
      "description": "Filter by the email address the Invite was sent to. Matches the same way as the Users list's `email` filter (normalized, case-insensitive).",
      "in": "query",
      "name": "email",
      "required": false,
      "schema": {
        "description": "Filter by the email address the Invite was sent to. Matches the same way as the Users list's `email` filter (normalized, case-insensitive).",
        "format": "email",
        "title": "Email",
        "type": "string"
      }
    },
    {
      "description": "Filter to items whose `role` equals one of the supplied values. Repeatable; values are OR'ed together.\n\nAccepted values depend on the organization type: Console and API organizations accept `user`, `developer`, `billing`, `admin`, and `claude_code_user`; Claude Enterprise organizations accept `user`, `owner`, `primary_owner`, `membership_admin`, and `managed`.",
      "in": "query",
      "name": "roles[]",
      "required": false,
      "schema": {
        "description": "Filter to items whose `role` equals one of the supplied values. Repeatable; values are OR'ed together.\n\nAccepted values depend on the organization type: Console and API organizations accept `user`, `developer`, `billing`, `admin`, and `claude_code_user`; Claude Enterprise organizations accept `user`, `owner`, `primary_owner`, `membership_admin`, and `managed`.",
        "items": {
          "type": "string"
        },
        "title": "Roles[]",
        "type": "array"
      }
    },
    {
      "description": "Your unique Admin API key for authentication. \n\nThis key is required in the header of all Admin API requests, to authenticate your account and access Anthropic's services. Get your Admin API key through the [Console](https://console.anthropic.com/settings/admin-keys).",
      "in": "header",
      "name": "x-api-key",
      "required": false,
      "schema": {
        "description": "Your unique Admin API key for authentication. \n\nThis key is required in the header of all Admin API requests, to authenticate your account and access Anthropic's services. Get your Admin API key through the [Console](https://console.anthropic.com/settings/admin-keys).",
        "title": "X-Api-Key",
        "type": "string"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
