      "BetaClaudeCodeRbacGroupManagedSettingsSummary": {
        "properties": {
          "created_at": {
            "description": "When the settings document this group uses was first stored, in RFC 3339 format. This can be earlier than when the group got its settings, and it changes if the group gets a different document.",
