            "title": "Created At",
            "type": "string"
          },
          "rbac_group_id": {
            "description": "The RBAC Group's ID, prefixed `rbac_group_`.",
            "examples": [
              "rbac_group_012rppKaSVsmTo6NqRDXQXNF"
            ],
            "title": "Rbac Group Id",
            "type": "string"
          },
          "rbac_group_status": {
            "$ref": "#/components/schemas/BetaClaudeCodeRbacGroupStatus",
            "description": "Whether the group is still one of the organization's RBAC Groups. Its `type` is `active` if it is, `deleted` if it is not, and `unknown` if that cannot be checked right now. A deleted group's settings stay in `rbac_group_order` but match no member."
          },
          "type": {
            "const": "claude_code_rbac_group_managed_settings_summary",
            "default": "claude_code_rbac_group_managed_settings_summary",
            "description": "Always `claude_code_rbac_group_managed_settings_summary`.",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "When this group's settings or its position in the order last changed, in RFC 3339 format. Its position changes whenever the number of groups ahead of it changes.",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "rbac_group_id",
          "rbac_group_status",
          "type",
          "updated_at"
