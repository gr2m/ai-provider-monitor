        "properties": {
          "mode": {
            "$ref": "#/components/schemas/BetaClaudeCodeManagedSettingsMode",
            "description": "How the organization serves managed settings. In `organization` mode every member receives the organization settings, which are set in claude.ai. In `rbac_groups` mode each member receives the settings of the first RBAC Group in `rbac_group_order` that they belong to. A member in none of them receives the default settings, or no settings if no default is set."
