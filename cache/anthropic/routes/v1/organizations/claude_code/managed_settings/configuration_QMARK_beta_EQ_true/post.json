            ],
            "description": "When the mode last changed, in RFC 3339 format, or `null` if it never has.",
            "title": "Mode Updated At"
          },
          "rbac_group_order": {
            "description": "The ID of every RBAC Group with settings, deleted groups included, highest precedence first.",
            "examples": [
              [
                "rbac_group_012rppKaSVsmTo6NqRDXQXNF"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Rbac Group Order",
            "type": "array"
          },
          "rbac_group_order_version": {
            "description": "An opaque version of `rbac_group_order`, which changes whenever the order does. Send it back with a new order.",
            "title": "Rbac Group Order Version",
            "type": "string"
          },
          "type": {
            "const": "claude_code_managed_settings_configuration",
            "default": "claude_code_managed_settings_configuration",
