{
  "description": "Update your organization's Compliance Settings.\n\nSetting `state` to `enabled` turns on the Compliance API and begins\ncapturing organization activity events. Setting it to `disabled` turns\nboth off. `state` reflects whether the Compliance API is enabled.\n\nA request that sets `state` to its current value succeeds and leaves the\nresource unchanged. A `disabled` request stays in effect until a later\n`enabled` request or the organization's next provisioning action that\nenables Access Transparency: enabling Access Transparency also enables\nthe Compliance API, which serves its activity events, so such\nprovisioning (including re-runs) re-enables the Compliance API even\nafter a `disabled` request. Automated provisioning never disables\ncompliance settings.",
  "operationId": "beta_update_compliance_settings_v1_organizations_compliance_settings_post",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "title": "Anthropic-Version",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/BetaComplianceSettingsUpdateParams"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaComplianceSettings"
          }
        }
      },
      "description": "Successful Response"
    },
    "4XX": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaErrorResponse"
          }
        }
      },
      "description": "Error response.\n\nSee our [errors documentation](https://platform.claude.com/docs/en/api/errors) for more details."
    }
  },
