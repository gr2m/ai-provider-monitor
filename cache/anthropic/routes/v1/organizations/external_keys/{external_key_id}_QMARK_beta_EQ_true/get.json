  "summary": "Get External Key",
  "components": {
    "schemas": {
      "BetaExternalKey": {
        "description": "CMEK external key config belonging to the caller's organization.\n\nConfigs are organization-scoped. Workspaces attach to a config; once any\nworkspace references it, the provider fields become effectively immutable\n(existing encrypted data needs the config for decrypt).",
        "properties": {
          "attachment": {
            "description": "Whether any workspace uses this config to encrypt its data — counting live and archived workspaces (an archived workspace's data remains encrypted under the config), excluding deleted ones. Only an attached config is used by the encryption path; an `unattached` config is inert and can be deleted.",
            "discriminator": {
              "mapping": {
                "attached": "#/components/schemas/BetaAttachedAttachment",
                "unattached": "#/components/schemas/BetaUnattachedAttachment"
              },
              "propertyName": "type"
            },
            "examples": [
              {
                "type": "attached"
              }
            ],
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaAttachedAttachment"
              },
              {
                "$ref": "#/components/schemas/BetaUnattachedAttachment"
              }
            ],
            "title": "Attachment"
          },
          "created_at": {
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-friendly display name. Null if none was set.",
            "examples": [
              "prod-us-key"
            ],
            "title": "Display Name"
          },
          "geo": {
            "description": "Data residency geo. Selects which regional validator handles this key's encrypt/decrypt roundtrips.",
            "examples": [
              "us"
            ],
            "title": "Geo",
            "type": "string"
          },
          "id": {
            "description": "Identifier of the external key config. A tagged ID prefixed `ekey_`, or — for organizations on the Claude Platform on AWS — the AWS KMS key ARN.",
            "examples": [
              "ekey_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "Id",
            "type": "string"
          },
          "provider_config": {
            "description": "KMS provider identity and auth coordinates.",
            "discriminator": {
              "mapping": {
                "aws": "#/components/schemas/BetaAwsExternalKeyConfig",
                "azure": "#/components/schemas/BetaAzureExternalKeyConfig",
                "gcp": "#/components/schemas/BetaGcpExternalKeyConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaAwsExternalKeyConfig"
              },
              {
                "$ref": "#/components/schemas/BetaGcpExternalKeyConfig"
              },
              {
                "$ref": "#/components/schemas/BetaAzureExternalKeyConfig"
              }
            ],
            "title": "Provider Config"
          },
          "type": {
            "const": "external_key",
            "default": "external_key",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "attachment",
          "created_at",
          "display_name",
          "geo",
          "id",
          "provider_config",
          "type",
          "updated_at"
        ],
        "title": "ExternalKey",
        "type": "object"
      },
