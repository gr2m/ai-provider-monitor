      "BetaAwsExternalKeyConfig": {
        "additionalProperties": false,
        "properties": {
          "kms_arn": {
            "description": "Full ARN of the AWS KMS key. On Claude Platform on AWS the key must be a single-Region key in your organization's own AWS account; cross-account keys, multi-Region keys, and alias ARNs are rejected.",
            "examples": [
              "arn:aws:kms:us-east-1:111122223333:key/abcd1234-5678-90ab-cdef-000011112222"
            ],
            "maxLength": 2048,
            "title": "Kms Arn",
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AWS region. Derived from `kms_arn` if omitted.",
            "examples": [
              "us-east-1"
            ],
            "title": "Region"
          },
          "role_arn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "IAM role ARN. Deprecated — Anthropic reaches the KMS key through its own intermediate role (or, on Claude Platform on AWS, with credentials AWS issues for the Workspace); this field is ignored.",
            "examples": [
              "arn:aws:iam::111122223333:role/anthropic-cmek"
            ],
            "title": "Role Arn"
          },
          "type": {
            "const": "aws",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "kms_arn",
          "type"
        ],
        "title": "AwsExternalKeyConfig",
        "type": "object"
      },
      "BetaGcpExternalKeyConfig": {
        "additionalProperties": false,
        "properties": {
          "key_name": {
            "description": "Full resource name of the Cloud KMS key.",
            "examples": [
              "projects/my-proj/locations/us/keyRings/my-ring/cryptoKeys/my-key"
            ],
            "title": "Key Name",
            "type": "string"
          },
          "type": {
            "const": "gcp",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "key_name",
          "type"
        ],
        "title": "GcpExternalKeyConfig",
        "type": "object"
      },
      "BetaAzureExternalKeyConfig": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Azure AD application (client) ID. Omit to use Anthropic's multitenant app. Provide only if using a single-tenant app registration in the customer's directory.",
            "title": "Client Id"
          },
          "key_name": {
            "description": "Name of the key within the vault.",
            "title": "Key Name",
            "type": "string"
          },
          "tenant_id": {
            "description": "Azure AD tenant ID.",
            "title": "Tenant Id",
            "type": "string"
          },
          "type": {
            "const": "azure",
            "title": "Type",
            "type": "string"
          },
          "vault_uri": {
            "description": "Key Vault data-plane URI — `https://{vault-name}.vault.azure.net` or `https://{hsm-name}.managedhsm.azure.net`.",
            "examples": [
              "https://my-vault.vault.azure.net/"
            ],
            "title": "Vault Uri",
            "type": "string"
          }
        },
        "required": [
          "key_name",
          "tenant_id",
          "type",
