            "default": null,
            "title": "Request Id"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id",
          "type"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
