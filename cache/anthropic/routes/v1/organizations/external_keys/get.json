      "ExternalKey": {
        "description": "CMEK external key config belonging to the caller's organization.\n\nConfigs are organization-scoped. Workspaces attach to a config; once any\nworkspace references it, the provider fields become effectively immutable\n(existing encrypted data needs the config for decrypt).",
        "properties": {
          "attachment": {
            "description": "Whether any workspace uses this config to encrypt its data — counting live and archived workspaces (an archived workspace's data remains encrypted under the config), excluding deleted ones. Only an attached config is used by the encryption path; an `unattached` config is inert and can be deleted.",
            "discriminator": {
              "mapping": {
                "attached": "#/components/schemas/AttachedAttachment",
                "unattached": "#/components/schemas/UnattachedAttachment"
              },
              "propertyName": "type"
            },
            "examples": [
              {
                "type": "attached"
              }
            ],
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttachedAttachment"
              },
              {
                "$ref": "#/components/schemas/UnattachedAttachment"
              }
            ],
            "title": "Attachment"
          },
          "created_at": {
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-friendly display name. Null if none was set.",
            "examples": [
              "prod-us-key"
            ],
            "title": "Display Name"
          },
          "geo": {
            "description": "Data residency geo. Selects the region that handles this key's encrypt/decrypt roundtrips.",
            "examples": [
              "us"
            ],
            "title": "Geo",
            "type": "string"
          },
          "id": {
            "description": "Identifier of the external key config: a tagged ID prefixed `ekey_`, or, on Claude Platform on AWS, an AWS KMS key's ARN.",
            "examples": [
              "ekey_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "Id",
            "type": "string"
          },
          "provider_config": {
            "description": "KMS provider identity and auth coordinates.",
            "discriminator": {
              "mapping": {
                "aws": "#/components/schemas/AwsExternalKeyConfig",
                "azure": "#/components/schemas/AzureExternalKeyConfig",
                "gcp": "#/components/schemas/GcpExternalKeyConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/AwsExternalKeyConfig"
              },
              {
                "$ref": "#/components/schemas/GcpExternalKeyConfig"
              },
              {
                "$ref": "#/components/schemas/AzureExternalKeyConfig"
              }
            ],
            "title": "Provider Config"
          },
          "type": {
            "const": "external_key",
            "default": "external_key",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "user_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ID of the user profile the key is bound to, or null if the key is not bound to one. A key bound to a user profile can only be attached to a Workspace that has the same user profile. A key that isn't bound can be attached to a Workspace whatever its user profile.",
            "examples": [
              "uprof_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "User Profile Id"
          }
        },
        "required": [
          "attachment",
          "created_at",
          "display_name",
          "geo",
          "id",
          "provider_config",
          "type",
          "updated_at",
          "user_profile_id"
        ],
        "title": "ExternalKey",
        "type": "object"
      },
