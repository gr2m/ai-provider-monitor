            ],
            "title": "Marketplace Id",
            "type": "string"
          },
          "name": {
            "description": "Lowercase identifier, unique within its plugin marketplace. Fixed for an organization-owned Plugin's lifetime; a member-owned Plugin's changes when its owner renames it in claude.ai, while its `id` stays the same.",
            "examples": [
              "code-review-helper"
            ],
            "title": "Name",
            "type": "string"
          },
          "organization_installation_preference": {
            "anyOf": [
              {
                "enum": [
                  "auto_install",
                  "available",
                  "not_available",
                  "required"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Organization-owned Plugin: the organization-wide installation setting every member gets unless an RBAC Group they belong to holds its own — the Plugin's own setting, or its plugin marketplace's default. Null for a member-owned Plugin, which has shares instead. One of `required`, `auto_install`, `available`, `not_available`; a value this API does not yet name is returned as stored.",
            "examples": [
              "available"
            ],
            "title": "Organization Installation Preference"
          },
          "organization_installation_preference_inherited": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Organization-owned Plugin: true while it has no organization-wide setting of its own and `organization_installation_preference` is its plugin marketplace's default. Null for a member-owned Plugin.",
            "title": "Organization Installation Preference Inherited"
          },
          "owner": {
            "description": "Who owns the Plugin: the organization, or the member whose personal plugin marketplace it lives in.",
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/BetaPluginOwnerOrganization",
                "user": "#/components/schemas/BetaPluginOwnerUser"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaPluginOwnerOrganization"
              },
              {
                "$ref": "#/components/schemas/BetaPluginOwnerUser"
              }
            ],
            "title": "Owner"
          },
          "reach": {
            "anyOf": [
              {
                "enum": [
                  "contained",
                  "privileged",
                  "remote"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "How far the served version reaches, or `null` if it is not classified.\n\n`remote` means it declares an MCP server or a CLI. `privileged` means it declares no MCP server or CLI, but declares a hook, monitor, language server, or settings, or has a skill, command, or other Markdown file whose frontmatter pre-approves tools (`allowed-tools` with any value other than an empty one or one that names only `AskUserQuestion`, `TodoWrite`, and `ToolSearch`). Otherwise it is `contained`.\n\nIf the frontmatter of a skill, command, or other Markdown file that could change the value could not be read, or was past a size limit, the version is `null` or `privileged` (or `remote`, if it declares an MCP server or a CLI), not `contained`. The value is normally worked out when a version is stored, under the rules of that time, so an older version can be `null`, or `contained` where the same files stored today would be `privileged` or `null`.",
            "title": "Reach"
          },
          "served_version_id": {
            "description": "The version claude.ai serves to members.",
            "examples": [
              "pluginver_01K9wPcHd4Rm2Tx8Vq6Ln3Sb"
            ],
            "title": "Served Version Id",
            "type": "string"
          },
          "served_version_pinned": {
            "description": "True once the served version has been pinned, through Update Plugin or in claude.ai. While false, a new version normally becomes the served version when it is stored. While the newest version is not the served version, as when a version saved in claude.ai is waiting for its content scan, `served_version_id` differs from `latest_version_id`.",
            "title": "Served Version Pinned",
            "type": "boolean"
          },
          "type": {
            "const": "plugin",
            "default": "plugin",
            "description": "Always `plugin`.",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "RFC 3339. Moves on a served-version change (including pinning an unpinned Plugin to the version it already serves) and, normally, on a new version. A version saved in claude.ai that waits for its content scan moves it when it becomes the served version, and not necessarily when it is stored. A change to the Plugin's installation settings or shares does not move it.",
            "examples": [
              "2026-03-14T09:26:53.589793Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
