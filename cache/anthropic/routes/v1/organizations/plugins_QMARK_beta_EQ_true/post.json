      "BetaPluginContentScan": {
        "properties": {
          "assessment": {
            "anyOf": [
              {
                "enum": [
                  "fail",
                  "pass",
                  "unknown",
                  "warn"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The scan's verdict; set only when `status` is `completed`. A `warn` can mean a `fail` that was allowed in claude.ai.",
            "examples": [
              "warn"
            ],
            "title": "Assessment"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The primary mechanism behind a `warn` or `fail`, such as `credential-exposure` or `guardrail-tampering`; a mechanism this API does not yet name reads as `other`. Null on a `pass`, whenever `assessment` is null, and when no mechanism is reported for the verdict.",
            "examples": [
              "credential-exposure"
            ],
            "title": "Reason"
          },
          "status": {
            "description": "`processing` while a scan runs, `completed` when it ran to completion, `errored` when it could not run. Once a scan of the version has completed, `content_scan` describes the newest completed scan, even while a later scan runs. While the scan outcome cannot be read, `status` is `errored` instead.",
            "enum": [
              "completed",
              "errored",
              "processing"
            ],
            "examples": [
              "completed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "assessment",
          "reason",
          "status"
        ],
        "title": "PluginContentScan",
        "type": "object"
      },
