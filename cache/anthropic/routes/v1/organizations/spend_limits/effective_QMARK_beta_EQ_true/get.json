{
  "description": "List each member's effective spend limit and period-to-date spend.\n\nReturns one row per (member, period) the member resolves a spend limit\nfor, with the `source` scope the spend limit was inherited from.\nPaginates by member, so a member's periods never split across pages.\nSupported for Claude Enterprise organizations only, not for Claude Console\norganizations.",
  "operationId": "beta_list_effective_spend_limits_v1_organizations_spend_limits_effective_get",
  "parameters": [
    {
      "description": "Restrict the report to these members, by tagged user ID (`user_...`). At most 100 entries.",
      "in": "query",
      "name": "user_ids[]",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Restrict the report to these members, by tagged user ID (`user_...`). At most 100 entries.",
        "title": "User Ids[]"
      }
    },
    {
      "description": "Restrict the report to these limit periods. Omit to return one row per period each member resolves a spend limit for.",
      "in": "query",
      "name": "period[]",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/components/schemas/BetaSpendLimitPeriod"
            },
            "maxItems": 3,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Restrict the report to these limit periods. Omit to return one row per period each member resolves a spend limit for.",
        "title": "Period[]"
      }
    },
    {
      "description": "Maximum number of members per page. A member's period rows never split across pages, so a page may carry more rows than this. Defaults to `20`.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "description": "Maximum number of members per page. A member's period rows never split across pages, so a page may carry more rows than this. Defaults to `20`.",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "description": "Opaque cursor from a previous response's `next_page` field.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Opaque cursor from a previous response's `next_page` field.",
        "title": "Page"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "title": "Anthropic-Version",
        "type": "string"
      }
    }
  ],
