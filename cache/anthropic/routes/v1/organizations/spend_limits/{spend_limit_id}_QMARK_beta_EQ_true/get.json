  "summary": "Get Spend Limit",
  "components": {
    "schemas": {
      "BetaSpendLimit": {
        "description": "A configured spend limit: a cap on metered spend for one scope and period.",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Limit amount as a non-negative integer decimal string in the minor unit of `currency` (cents for USD): \"50000\" is $500.00. `null` means no numeric cap is configured at this scope — see the effective report for whether a limit applies.",
            "examples": [
              "50000"
            ],
            "title": "Amount"
          },
          "created_at": {
            "description": "RFC 3339 datetime at which the spend limit was created.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "description": "ISO 4217 code of the organization's billing currency; the unit for `amount`.",
            "examples": [
              "USD"
            ],
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "description": "Unique tagged ID of the spend limit (`spl_...`).",
            "title": "Id",
            "type": "string"
          },
          "is_enabled": {
            "description": "Read-only. `false` when extra usage is switched off for this organization (`organization` limit); `amount` is kept and applies again when it's switched back on. Always `true` for other limits.",
            "title": "Is Enabled",
            "type": "boolean"
          },
          "period": {
            "$ref": "#/components/schemas/BetaSpendLimitPeriod",
            "description": "Length of the window the limit resets over. `amount` caps spend within each period.",
            "examples": [
              "monthly"
            ]
          },
          "scope": {
            "description": "What the limit applies to. A tagged union on `type`; each variant carries the identifier for its scope.",
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/BetaOrganizationScope",
                "organization_service": "#/components/schemas/BetaOrgServiceScope",
                "rbac_group": "#/components/schemas/BetaRbacGroupScope",
                "seat_tier": "#/components/schemas/BetaSeatTierScope",
                "usage_tier": "#/components/schemas/BetaUsageTierScope",
                "user": "#/components/schemas/BetaUserScope",
                "workspace": "#/components/schemas/BetaWorkspaceScope"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaUserScope"
              },
              {
                "$ref": "#/components/schemas/BetaSeatTierScope"
              },
              {
                "$ref": "#/components/schemas/BetaRbacGroupScope"
              },
              {
                "$ref": "#/components/schemas/BetaOrgServiceScope"
              },
              {
                "$ref": "#/components/schemas/BetaOrganizationScope"
              },
              {
                "$ref": "#/components/schemas/BetaWorkspaceScope"
              },
              {
                "$ref": "#/components/schemas/BetaUsageTierScope"
              }
            ],
            "title": "Scope"
          },
          "type": {
            "const": "spend_limit",
            "default": "spend_limit",
            "description": "Object type. Always `spend_limit`.",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "RFC 3339 datetime at which the spend limit was last modified.",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "created_at",
          "currency",
          "id",
          "is_enabled",
          "period",
          "scope",
          "type",
          "updated_at"
        ],
        "title": "SpendLimit",
        "type": "object"
      },
      "BetaErrorResponse": {
        "properties": {
          "error": {
            "discriminator": {
              "mapping": {
                "api_error": "#/components/schemas/BetaAPIError",
