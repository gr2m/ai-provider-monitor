    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaErrorResponse"
          }
        }
      },
      "description": "Unavailable - The service is currently unavailable"
    },
    "504": {
      "content": {
        "application/json": {
          "schema": {
