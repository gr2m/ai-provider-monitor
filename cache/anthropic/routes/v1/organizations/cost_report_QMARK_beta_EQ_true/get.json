      "BetaGetCostReportResponse": {
        "properties": {
          "data": {
            "description": "List of time buckets for this page, oldest first: one per `bucket_width` interval, including intervals with no costs (their `results` list is empty). A page holds at most `limit` buckets.",
            "items": {
              "$ref": "#/components/schemas/BetaCostReportTimeBucket"
            },
            "title": "Data",
            "type": "array"
          },
          "has_more": {
            "description": "Indicates if there are more results.",
            "title": "Has More",
            "type": "boolean"
          },
          "next_page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque cursor for the next page, or `null` when `has_more` is false. Pass it as the `page` parameter in the next request.",
            "examples": [
              "page_MjAyNS0wNS0xNFQwMDowMDowMFo=",
              null
            ],
            "title": "Next Page"
          }
        },
        "required": [
          "data",
          "has_more",
          "next_page"
        ],
        "title": "GetCostReportResponse",
        "type": "object"
      },
