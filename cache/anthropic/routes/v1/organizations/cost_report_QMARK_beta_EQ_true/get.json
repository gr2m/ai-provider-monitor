{
  "description": "[Legacy] Get a report of your organization's Claude API costs in USD, aggregated into daily buckets.\n\nThis endpoint is part of the legacy Usage and Cost API. For new integrations, use [`GET /v1/organizations/analytics/cost`](/docs/en/api/beta/organization/analytics/cost/list) in the Usage and Cost Analytics API instead. To move an existing integration, see [Migrate from the Usage and Cost API](/docs/en/manage-claude/usage-cost-analytics-api#migrate-from-usage-cost-api).",
  "operationId": "beta_get_cost_report_v1_organizations_cost_report_get",
  "parameters": [
    {
      "description": "Maximum number of time buckets to return in the response.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 7,
        "description": "Maximum number of time buckets to return in the response.",
        "examples": [
          7
        ],
        "maximum": 31,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "description": "Optionally set to the `next_page` token from the previous response.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optionally set to the `next_page` token from the previous response.",
        "examples": [
          "page_MjAyNS0wNS0xNFQwMDowMDowMFo=",
          null
        ],
        "title": "Page"
      }
    },
    {
      "description": "Time buckets that start on or after this RFC 3339 timestamp will be returned.\nEach time bucket will be snapped to the start of the minute/hour/day in UTC.",
      "in": "query",
      "name": "starting_at",
      "required": true,
      "schema": {
        "description": "Time buckets that start on or after this RFC 3339 timestamp will be returned.\nEach time bucket will be snapped to the start of the minute/hour/day in UTC.",
        "examples": [
          "2024-10-30T23:58:27.427722Z"
        ],
        "format": "date-time",
        "title": "Starting At",
        "type": "string"
      }
    },
    {
      "description": "Time buckets that end before this RFC 3339 timestamp will be returned.",
      "in": "query",
      "name": "ending_at",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Time buckets that end before this RFC 3339 timestamp will be returned.",
        "examples": [
          "2024-10-30T23:58:27.427722Z"
        ],
        "title": "Ending At"
      }
    },
    {
      "description": "Group by any subset of the available options.",
      "in": "query",
      "name": "group_by[]",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/components/schemas/BetaCostReportGroupBy"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Group by any subset of the available options.",
        "examples": [
          "workspace_id",
          "description"
        ],
        "title": "Group By[]"
      }
    },
    {
      "description": "Time granularity of the response data.",
      "in": "query",
      "name": "bucket_width",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaCostReportTimeBucketWidth",
        "default": "1d",
        "description": "Time granularity of the response data.",
        "examples": [
          "1d"
        ]
      }
    },
    {
      "description": "Optional header to specify the beta version(s) you want to use.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "Optional header to specify the beta version(s) you want to use.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "title": "Anthropic-Beta",
        "type": "array"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "title": "Anthropic-Version",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaGetCostReportResponse"
          }
