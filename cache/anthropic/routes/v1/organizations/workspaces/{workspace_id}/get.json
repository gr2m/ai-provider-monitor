  "summary": "Get Workspace",
  "components": {
    "schemas": {
      "Workspace": {
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339 datetime string indicating when the Workspace was archived, or `null` if the Workspace is not archived.",
            "examples": [
              "2024-11-01T23:59:27.427722Z"
            ],
            "title": "Archived At"
          },
          "compartment_id": {
            "description": "Identifier for this Workspace's encryption compartment. When you configure a\ncustomer-managed encryption key (CMEK) on AWS, reference this value in your\nKMS key-policy condition so the key is scoped to this compartment. On GCP and\nAzure, Anthropic enforces the compartment binding automatically; you do not\nneed to reference this value in your key configuration. See the CMEK\nintegration guide for the required key configuration; unless your organization\nis on Claude Platform on AWS, it includes a separate value used during key\nvalidation. On Claude Platform on AWS there is no separate validation value:\nthe key is validated against this Workspace's own value when it is attached, so\nif your key policy uses the compartment condition, add this value to it before\nattaching the key.",
            "examples": [
              "f8a7b6c5-4d3e-4f1a-8b9c-0d1e2f3a4b5c"
            ],
            "title": "Compartment Id",
            "type": "string"
          },
          "created_at": {
            "description": "RFC 3339 datetime string indicating when the Workspace was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "data_residency": {
            "$ref": "#/components/schemas/DataResidency",
            "description": "Data residency configuration."
          },
          "display_color": {
            "description": "Hex color code representing the Workspace in the Anthropic Console.",
            "examples": [
              "#6C5BB9"
            ],
            "title": "Display Color",
            "type": "string"
          },
          "external_key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ID of the customer-managed encryption key (CMEK) configuration to use for this\nWorkspace. Setting this field requires CMEK to be enabled for your\norganization. When set, data stored for this Workspace is encrypted with the\nreferenced key. Create key configurations with the External Keys API. On\nClaude Platform on AWS the value is the AWS KMS key ARN, and the key must be a\nsingle-Region key in the same AWS account and Region as the Workspace. On that\nplatform the key is validated against this Workspace when it is attached, so a\nkey-policy problem is reported as an error on this request. This field is write-once:\nonce a key is attached to a Workspace it cannot be detached or replaced. To\nrotate key material, rotate the underlying key on your cloud KMS; the\n`external_key_id` stays the same.",
            "examples": [
              "ekey_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "External Key Id"
          },
          "id": {
            "description": "ID of the Workspace.",
            "examples": [
              "wrkspc_01JwQvzr7rXLA5AGx3HKfFUJ"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Name of the Workspace.",
            "examples": [
              "Workspace Name"
            ],
            "title": "Name",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-defined tags as string key-value pairs. Keys may not begin with `anthropic`.",
            "examples": [
              {
                "env": "prod",
                "team": "platform"
              }
            ],
            "title": "Tags",
            "type": "object"
          },
          "type": {
            "const": "workspace",
            "default": "workspace",
            "description": "Object type.\n\nFor Workspaces, this is always `\"workspace\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "archived_at",
          "compartment_id",
          "created_at",
          "data_residency",
          "display_color",
          "external_key_id",
          "id",
          "name",
          "tags",
          "type"
        ],
        "title": "Workspace",
        "type": "object"
      },
