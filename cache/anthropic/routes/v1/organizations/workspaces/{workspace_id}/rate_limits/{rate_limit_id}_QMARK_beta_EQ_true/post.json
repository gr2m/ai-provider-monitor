{
  "description": "Set or clear rate-limit overrides for one rate-limit group in a workspace.\n\nOnly the limiter types named in `limits` change: an integer `value` sets\nthat type's override and `null` clears it. Types not named keep their\ncurrent value. A value above the organization's own limit is stored, but\nthe organization limit still applies, so the lower of the two is\nenforced.\n\nReturns the targeted group's entry with this request applied, in the shape\n`GET /v1/organizations/workspaces/{workspace_id}/rate_limits` returns.\nChanges take effect within about an hour.",
  "operationId": "beta_update_workspace_rate_limits_v1_organizations_workspaces__workspace_id__rate_limits__rate_limit_id__post",
  "parameters": [
    {
      "description": "The `id` of the organization's rate-limit entry to set overrides for.",
      "in": "path",
      "name": "rate_limit_id",
      "required": true,
      "schema": {
        "description": "The `id` of the organization's rate-limit entry to set overrides for.",
        "title": "Rate Limit Id",
        "type": "string"
      }
    },
    {
      "description": "The ID of the workspace.",
      "in": "path",
      "name": "workspace_id",
      "required": true,
      "schema": {
        "description": "The ID of the workspace.",
        "title": "Workspace Id",
        "type": "string"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
