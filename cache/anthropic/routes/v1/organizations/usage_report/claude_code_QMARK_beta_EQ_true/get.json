      },
      "BetaGatewayTimeoutError": {
        "properties": {
          "message": {
            "default": "Request timeout",
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "timeout_error",
            "default": "timeout_error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message",
