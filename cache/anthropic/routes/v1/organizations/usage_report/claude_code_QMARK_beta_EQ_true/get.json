          },
          "type": {
            "const": "overloaded_error",
            "default": "overloaded_error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message",
          "type"
        ],
        "title": "OverloadedError",
        "type": "object"
      },
      "BetaClaudeCodeUserActor": {
        "properties": {
          "email_address": {
            "description": "Email address of the user who performed Claude Code actions.",
            "examples": [
              "user@emaildomain.com"
            ],
            "title": "Email Address",
            "type": "string"
          },
          "type": {
            "const": "user_actor",
            "description": "Actor type. Always `\"user_actor\"` for a user.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "email_address",
          "type"
        ],
        "title": "ClaudeCodeUserActor",
        "type": "object"
      },
      "BetaClaudeCodeApiActor": {
        "properties": {
          "api_key_name": {
            "description": "Name of the API key used to perform Claude Code actions.",
            "examples": [
              "Developer Key"
            ],
            "title": "Api Key Name",
            "type": "string"
          },
          "type": {
            "const": "api_actor",
            "description": "Actor type. Always `\"api_actor\"` for an API key.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "api_key_name",
          "type"
        ],
        "title": "ClaudeCodeApiActor",
        "type": "object"
      },
      "BetaCoreMetrics": {
        "properties": {
          "commits_by_claude_code": {
            "description": "Number of git commits created through Claude Code's commit functionality.",
            "title": "Commits By Claude Code",
            "type": "integer"
          },
          "lines_of_code": {
            "$ref": "#/components/schemas/BetaLinesOfCode",
            "description": "Statistics on code changes made through Claude Code."
          },
          "num_sessions": {
            "description": "Number of distinct Claude Code sessions initiated by this actor.",
            "title": "Num Sessions",
            "type": "integer"
          },
          "pull_requests_by_claude_code": {
            "description": "Number of pull requests created through Claude Code's PR functionality.",
            "title": "Pull Requests By Claude Code",
            "type": "integer"
          }
        },
        "required": [
          "commits_by_claude_code",
          "lines_of_code",
          "num_sessions",
          "pull_requests_by_claude_code"
        ],
        "title": "CoreMetrics",
        "type": "object"
      },
      "BetaCustomerType": {
        "enum": [
          "api",
          "subscription"
        ],
        "title": "CustomerType",
        "type": "string"
      },
      "BetaModelBreakdown": {
        "properties": {
          "estimated_cost": {
            "$ref": "#/components/schemas/BetaEstimatedCost",
            "description": "Estimated cost for using this model"
          },
          "model": {
            "description": "Name of the AI model used for Claude Code interactions.",
            "examples": [
              "claude-opus-5"
            ],
            "title": "Model",
            "type": "string"
          },
          "tokens": {
            "$ref": "#/components/schemas/BetaTokenUsage",
            "description": "Token usage breakdown for this model"
          }
        },
        "required": [
          "estimated_cost",
          "model",
          "tokens"
        ],
        "title": "ModelBreakdown",
        "type": "object"
      },
      "BetaSubscriptionType": {
        "enum": [
          "enterprise",
          "team"
        ],
        "title": "SubscriptionType",
        "type": "string"
      },
      "BetaApprovalMetrics": {
        "properties": {
          "accepted": {
            "description": "Number of tool action proposals that the user accepted.",
            "title": "Accepted",
            "type": "integer"
          },
          "rejected": {
            "description": "Number of tool action proposals that the user rejected.",
            "title": "Rejected",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "rejected"
        ],
        "title": "ApprovalMetrics",
        "type": "object"
      },
      "BetaLinesOfCode": {
        "properties": {
          "added": {
            "description": "Total number of lines of code added across all files by Claude Code.",
            "title": "Added",
            "type": "integer"
          },
          "removed": {
            "description": "Total number of lines of code removed across all files by Claude Code.",
            "title": "Removed",
            "type": "integer"
          }
        },
        "required": [
          "added",
          "removed"
        ],
        "title": "LinesOfCode",
        "type": "object"
      },
      "BetaEstimatedCost": {
        "properties": {
          "amount": {
            "description": "Estimated cost amount in minor currency units (e.g., cents for USD).",
            "examples": [
              150
            ],
            "title": "Amount",
            "type": "integer"
          },
          "currency": {
            "description": "Currency code for the estimated cost (e.g., 'USD').",
            "examples": [
              "USD"
            ],
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "EstimatedCost",
        "type": "object"
      },
      "BetaTokenUsage": {
        "properties": {
          "cache_creation": {
            "description": "Number of cache creation tokens consumed by this model.",
            "title": "Cache Creation",
            "type": "integer"
          },
          "cache_read": {
            "description": "Number of cache read tokens consumed by this model.",
            "title": "Cache Read",
            "type": "integer"
          },
          "input": {
            "description": "Number of input tokens consumed by this model.",
            "title": "Input",
            "type": "integer"
          },
          "output": {
            "description": "Number of output tokens generated by this model.",
            "title": "Output",
            "type": "integer"
          }
        },
        "required": [
          "cache_creation",
          "cache_read",
          "input",
          "output"
        ],
        "title": "TokenUsage",
        "type": "object"
      }
    }
  }
}
