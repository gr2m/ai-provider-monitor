{
  "description": "Get one Slack channel and its settings. By default `settings` holds what the channel itself stores: a setting that is null there is not set on the channel and is inherited. With `include_inherited=true`, `settings` holds what applies in the channel once the settings levels above it are taken into account, and the request fails with 503 rather than resolve against a settings level that could not be read. Either way `sources` names the settings level each value comes from, so a caller tells the channel's own value from an inherited one by its source, not by whether it is null.",
  "operationId": "BetaGetSlackChannel",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "type": "string"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `experimental-claude-tag-2026-10-21` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `experimental-claude-tag-2026-10-21` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "The channel's identifier, starting with `slch_`.",
      "example": "slch_01SvpyRQK3nN6eH9uhRA7n1q",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "When `true`, `settings` holds what applies in the channel once the settings levels above it are taken into account, and every member of `sources` names the level a value comes from. When `false` or left out, `settings` holds what the channel itself stores.",
      "in": "query",
      "name": "include_inherited",
      "required": false,
      "schema": {
        "type": "boolean"
      }
    }
  ],
