      "BetaClaudeTagSettings": {
        "additionalProperties": false,
        "description": "Claude Tag settings. Without `include_inherited`, a setting that is null is not set on the settings level and is inherited. With it, `enabled` and `guest_policy` are never null, `instructions`, `model` and `environment_id` are null when no settings level sets them, and `reply_mode` is null unless the channel itself stores one.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether Claude is on. The nearest settings level that sets it decides."
          },
          "environment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The environment Claude's sessions run in, starting with `env_`, or the identifier of a self-hosted runner pool, starting with `ccpool_`. The nearest settings level that sets it decides."
          },
          "guest_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagGuestPolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "What Claude does in a channel while a Slack guest is in it. The nearest settings level that sets it decides."
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Instructions for Claude. Instructions add up: the text of every settings level that sets it is joined, broadest first."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model Claude uses: a model identifier or the name of a model line. The nearest settings level that sets it decides. When none does, Claude uses the product's default model."
          },
          "reply_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagReplyMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "How Claude takes part in the channel. Only a channel stores one, and no settings level passes one on, so it is always null on a workspace. Null on a channel means the channel stores none yet: Claude then follows the reply mode chosen in Slack, if one was, else `automatic`. A stored reply mode can be changed but never cleared."
          }
        },
        "required": [
          "enabled",
          "instructions",
          "model",
          "environment_id",
          "guest_policy",
          "reply_mode"
        ],
        "type": "object"
      },
      "BetaClaudeTagSlackChannelIdentifiers": {
        "additionalProperties": false,
        "description": "The identifiers Slack shows for a channel. They are Slack's own, not identifiers of this API.",
        "properties": {
          "channel_id": {
            "description": "Slack's identifier for the channel, starting with `C` or `G`, such as `C0456EFGH`.",
            "maxLength": 32,
            "minLength": 2,
            "type": "string"
          },
          "workspace_id": {
            "description": "Slack's identifier for the workspace the channel is in, starting with `T`, such as `T0123ABCD`.",
            "maxLength": 32,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "channel_id"
        ],
        "type": "object"
      },
      "BetaClaudeTagSettingSources": {
        "additionalProperties": false,
        "description": "For each setting, the settings level its value in `settings` comes from. Without `include_inherited`, a setting the channel or workspace stores has a source that names the channel or workspace itself, and one it does not store has null, or an empty list for `instructions`. With `include_inherited=true` no member is null: a value that no settings level sets has the source `default`.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The settings level `enabled` comes from."
          },
          "environment_id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The settings level `environment_id` comes from."
          },
          "guest_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The settings level `guest_policy` comes from."
          },
          "instructions": {
            "description": "Every settings level that contributes text to `instructions`, broadest first, in the order their text is joined. Empty when none does.",
            "items": {
              "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
            },
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The settings level `model` comes from."
          },
          "reply_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The settings level `reply_mode` comes from: the channel when it stores one. With `include_inherited=true` and no stored mode it is `default`."
          }
        },
        "required": [
          "enabled",
          "instructions",
          "model",
          "environment_id",
          "guest_policy",
          "reply_mode"
        ],
        "type": "object"
      },
