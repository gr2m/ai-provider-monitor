      },
      "BetaClaudeTagSlackChannel": {
        "additionalProperties": false,
        "description": "A Slack channel set up for Claude Tag, with the settings it stores or, with `include_inherited`, the settings that apply in it.",
        "properties": {
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time the channel was set up, by whichever route. It does not change for as long as `id` does not."
          },
          "id": {
            "description": "The channel's identifier. Starts with `slch_`. It does not change for as long as the channel is set up, with one exception: a channel that is not configured can get a new one. A channel that is removed and set up again also has a new one. The old one keeps returning 404; look the channel up by its Slack identifiers for the new one.",
            "type": "string"
          },
          "settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettings"
              }
            ],
            "description": "What the channel itself stores or, with `include_inherited`, what applies in it. `sources` says which."
          },
          "slack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSlackChannelIdentifiers"
              }
            ],
            "description": "Slack's own identifiers for the channel."
          },
          "sources": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSources"
              }
            ],
            "description": "For each setting, the settings level its value in `settings` comes from."
          },
          "type": {
            "const": "slack_channel",
            "type": "string"
          },
          "updated_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time Claude Tag's record of the channel last changed. It moves on every change to a setting, and can also move when something no response holds changes, so a later value says to read the channel again, not that a setting changed. Attaching or detaching a Bundle does not by itself move it."
          }
        },
        "required": [
          "type",
          "id",
          "slack",
          "settings",
          "sources",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
