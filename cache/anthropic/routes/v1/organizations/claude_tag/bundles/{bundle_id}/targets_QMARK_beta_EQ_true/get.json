          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "The Bundle's identifier, starting with `capp_`.",
      "example": "capp_011CZkZjLP1cWxj5EtMmdgbq",
      "in": "path",
      "name": "bundle_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of items to return per page, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "format": "int32",
        "type": "integer"
      }
    },
    {
      "description": "Opaque cursor from a previous response's `next_page`.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
