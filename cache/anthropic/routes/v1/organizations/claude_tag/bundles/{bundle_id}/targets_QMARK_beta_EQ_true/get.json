      "BetaClaudeTagListBundleTargetsResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "description": "Bundle Targets on this page, newest first.",
            "items": {
              "$ref": "#/components/schemas/BetaClaudeTagBundleTarget"
            },
            "type": "array"
          },
          "next_page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor for the next page. Null on the last page."
          }
        },
        "required": [
          "data",
          "next_page"
        ],
        "type": "object"
      },
      "BetaClaudeTagErrorResponse": {
        "properties": {
          "error": {
            "discriminator": {
              "mapping": {
                "conflict_error": "#/components/schemas/BetaClaudeTagSettingsConflictError",
                "invalid_request_error": "#/components/schemas/BetaClaudeTagSetUpSettingsRefusedError",
                "not_found_error": "#/components/schemas/BetaClaudeTagEnvironmentNotFoundError",
                "permission_error": "#/components/schemas/BetaClaudeTagCodedPermissionError"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagCodedPermissionError"
              },
              {
                "$ref": "#/components/schemas/BetaClaudeTagSetUpSettingsRefusedError"
              },
              {
                "$ref": "#/components/schemas/BetaClaudeTagEnvironmentNotFoundError"
              },
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingsConflictError"
              }
            ],
            "type": "object"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "type": {
            "const": "error",
            "description": "Always \"error\" for error responses",
            "type": "string"
          }
        },
        "required": [
          "type",
          "error"
        ],
        "type": "object"
      },
      "BetaClaudeTagBundleTarget": {
        "description": "One Bundle attached to one Slack channel or one Slack workspace. More types of target can be added.",
        "discriminator": {
          "mapping": {
            "slack_channel": "#/components/schemas/BetaClaudeTagSlackChannelBundleTarget",
            "slack_workspace": "#/components/schemas/BetaClaudeTagSlackWorkspaceBundleTarget"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/BetaClaudeTagSlackChannelBundleTarget"
          },
          {
            "$ref": "#/components/schemas/BetaClaudeTagSlackWorkspaceBundleTarget"
          }
        ]
      },
      "BetaClaudeTagCodedPermissionError": {
        "additionalProperties": false,
        "description": "Returned with status 403. `details.error_code` names the cause.",
        "properties": {
          "details": {
            "$ref": "#/components/schemas/BetaClaudeTagCodedPermissionError_Details"
          },
          "message": {
            "description": "A human-readable explanation of the refusal.",
            "type": "string"
          },
          "type": {
            "const": "permission_error",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaClaudeTagSetUpSettingsRefusedError": {
        "additionalProperties": false,
        "description": "Returned with status 400 when the request set the channel up and `settings` was then refused. The channel stays set up with every setting unset.",
        "properties": {
          "details": {
            "$ref": "#/components/schemas/BetaClaudeTagSetUpSettingsRefusedError_Details"
          },
          "message": {
            "description": "A human-readable explanation of what in `settings` was refused.",
            "type": "string"
          },
          "type": {
            "const": "invalid_request_error",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaClaudeTagEnvironmentNotFoundError": {
        "additionalProperties": false,
        "description": "Returned with status 404 when `settings.environment_id` names no Environment within the organization's reach. It says nothing about the `id` in the path.",
        "properties": {
          "details": {
            "$ref": "#/components/schemas/BetaClaudeTagEnvironmentNotFoundError_Details"
          },
          "message": {
            "description": "A human-readable explanation of the refusal.",
            "type": "string"
          },
          "type": {
            "const": "not_found_error",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaClaudeTagSettingsConflictError": {
        "additionalProperties": false,
        "description": "Returned with status 409 when something else changed the resource while this request ran, or it was removed. Nothing of this request's settings was stored. Read the resource again, then send the change again if it is still needed.",
        "properties": {
          "details": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingsConflictError_Details"
              }
            ],
            "description": "Set only when the request had set a channel up before the conflict."
          },
          "message": {
            "description": "A human-readable explanation of the conflict.",
            "type": "string"
          },
          "type": {
            "const": "conflict_error",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "BetaClaudeTagSlackChannelBundleTarget": {
        "additionalProperties": false,
        "description": "One Bundle attached to one Slack channel. The Bundle can be used in that channel only.",
        "properties": {
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time the Bundle was attached."
          },
          "id": {
            "description": "The Bundle Target's identifier. Starts with `btgt_`. No two Bundle Targets have the same one, and the same Bundle and target always give the same one, also after a detach and a new attach. It is opaque.",
            "type": "string"
          },
          "slack_channel_id": {
            "description": "The identifier of the Slack channel the Bundle is attached to, starting with `slch_`. It is the channel object's `id`, not Slack's `channel_id`.",
            "type": "string"
          },
          "type": {
            "const": "slack_channel",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "slack_channel_id",
          "created_at"
        ],
        "type": "object"
      },
      "BetaClaudeTagSlackWorkspaceBundleTarget": {
        "additionalProperties": false,
        "description": "One Bundle attached to one Slack workspace. The Bundle can be used in the workspace and in every channel in it.",
        "properties": {
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time the Bundle was attached."
          },
          "id": {
            "description": "The Bundle Target's identifier. Starts with `btgt_`. No two Bundle Targets have the same one, and the same Bundle and target always give the same one, also after a detach and a new attach. It is opaque.",
            "type": "string"
          },
          "slack_workspace_id": {
            "description": "The identifier of the Slack workspace the Bundle is attached to, starting with `slws_`.",
            "type": "string"
          },
          "type": {
            "const": "slack_workspace",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "slack_workspace_id",
          "created_at"
        ],
        "type": "object"
      },
      "BetaClaudeTagCodedPermissionError_Details": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "A stable code that names the cause.",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "type": "object"
      },
      "BetaClaudeTagSetUpSettingsRefusedError_Details": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "A stable code that names the cause.",
            "type": "string"
          },
          "slack_channel_id": {
            "description": "The identifier of the channel the request set up, starting with `slch_`.",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "slack_channel_id"
        ],
        "type": "object"
      },
      "BetaClaudeTagEnvironmentNotFoundError_Details": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "A stable code that names the cause.",
            "type": "string"
          },
          "slack_channel_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "On a setup request that set the channel up before the refusal: the channel's identifier, starting with `slch_`. The channel stays set up with every setting unset."
          }
        },
        "required": [
          "error_code"
        ],
        "type": "object"
      },
      "BetaClaudeTagSettingsConflictError_Details": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "A stable code that names the cause.",
            "type": "string"
          },
          "slack_channel_id": {
            "description": "The identifier of the channel the request set up, starting with `slch_`.",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "slack_channel_id"
        ],
        "type": "object"
      },
      "BetaTimestamp": {
        "description": "A timestamp in RFC 3339 format",
        "format": "date-time",
        "type": "string"
      }
    }
  }
}
