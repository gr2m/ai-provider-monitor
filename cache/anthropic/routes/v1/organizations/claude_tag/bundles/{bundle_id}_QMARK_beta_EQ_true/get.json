{
  "description": "Get one Bundle. What the Bundle grants (connectors, repositories and credentials) is never returned.",
  "operationId": "BetaGetBundle",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "type": "string"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `experimental-claude-tag-2026-10-21` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `experimental-claude-tag-2026-10-21` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "The Bundle's identifier, starting with `capp_`.",
      "example": "capp_011CZkZjLP1cWxj5EtMmdgbq",
      "in": "path",
      "name": "bundle_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagBundle"
          }
        }
      },
      "description": "Successful response (OK)"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Custom error status"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Unauthenticated - The request does not have valid authentication credentials"
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Custom error status"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Custom error status"
    },
    "408": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Deadline exceeded - The deadline expired before the operation could complete"
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Custom error status"
    },
    "412": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Failed precondition - Operation was rejected because the system is not in required state"
    },
    "413": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Out of range - Operation was attempted past the valid range"
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Resource exhausted - Some resource has been exhausted (rate limiting)"
    },
    "431": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Request header fields too large - Request metadata was too large"
    },
    "499": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Cancelled - The operation was cancelled by the client"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
      "description": "Internal - Internal server error"
    },
    "501": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BetaClaudeTagErrorResponse"
          }
        }
      },
