      "BetaClaudeTagUpdateSlackWorkspaceRequestBody": {
        "additionalProperties": false,
        "properties": {
          "settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingsUpdate"
              }
            ],
            "description": "The settings to change."
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "BetaClaudeTagSlackWorkspace": {
        "additionalProperties": false,
        "description": "A Slack workspace the organization has connected, itself or through its Slack Enterprise Grid, with the settings it stores or, with `include_inherited`, the settings that apply in it.",
        "properties": {
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time the workspace was set up, by whichever route. It does not change for as long as `id` does not."
          },
          "id": {
            "description": "The workspace's identifier. Starts with `slws_`. It does not change for as long as the workspace is set up. A workspace that is removed and set up again has a new one, and the old one keeps returning 404; look the workspace up by its Slack identifier for the new one.",
            "type": "string"
          },
          "settings": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettings"
              }
            ],
            "description": "What the workspace itself stores or, with `include_inherited`, what applies in it. `sources` says which."
          },
          "slack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSlackWorkspaceIdentifiers"
              }
            ],
            "description": "Slack's own identifier for the workspace."
          },
          "sources": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagSettingSources"
              }
            ],
            "description": "For each setting, the settings level its value in `settings` comes from."
          },
          "type": {
            "const": "slack_workspace",
            "type": "string"
          },
          "updated_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "Time Claude Tag's record of the workspace last changed. It moves on every change to a setting, and can also move when something no response holds changes, so a later value says to read the workspace again, not that a setting changed. Attaching or detaching a Bundle does not by itself move it."
          }
        },
        "required": [
          "type",
          "id",
          "slack",
          "settings",
          "sources",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
