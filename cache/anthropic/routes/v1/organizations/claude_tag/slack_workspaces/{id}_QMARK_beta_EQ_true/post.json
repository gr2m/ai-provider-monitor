      "BetaClaudeTagSettingsUpdate": {
        "additionalProperties": false,
        "description": "The settings to change. A setting left out is unchanged. A setting sent as null is cleared, so it is inherited.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether Claude is on. `true` on a channel turns Claude on in it even when its workspace stores `false`. Null clears it."
          },
          "environment_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The environment Claude's sessions run in: the identifier of an active environment of the organization, starting with `env_`. Null clears it."
          },
          "guest_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagGuestPolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "What Claude does in a channel while a Slack guest is in it. Null clears it."
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Instructions for Claude, up to 8,192 characters after leading and trailing white space is trimmed. Null or blank text clears them."
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model Claude uses: the identifier of a model, or the name of a model line, that the organization is entitled to for Claude Tag. Null clears it."
          }
        },
        "type": "object"
      },
      "BetaTimestamp": {
        "description": "A timestamp in RFC 3339 format",
        "format": "date-time",
        "type": "string"
      },
      "BetaClaudeTagSettings": {
        "additionalProperties": false,
        "description": "Claude Tag settings. Without `include_inherited`, a setting that is null is not set on the settings level and is inherited. With it, `enabled` and `guest_policy` are never null, and `instructions`, `model` and `environment_id` are null when no settings level sets them.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether Claude is on. The nearest settings level that sets it decides."
          },
          "environment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The environment Claude's sessions run in, starting with `env_`, or the identifier of a self-hosted runner pool, starting with `ccpool_`. The nearest settings level that sets it decides."
          },
          "guest_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaClaudeTagGuestPolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "What Claude does in a channel while a Slack guest is in it. The nearest settings level that sets it decides."
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Instructions for Claude. Instructions add up: the text of every settings level that sets it is joined, broadest first."
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model Claude uses: a model identifier or the name of a model line. The nearest settings level that sets it decides. When none does, Claude uses the product's default model."
          }
        },
        "required": [
          "enabled",
          "instructions",
          "model",
          "environment_id",
          "guest_policy"
        ],
        "type": "object"
      },
      "BetaClaudeTagSlackWorkspaceIdentifiers": {
        "additionalProperties": false,
        "description": "The identifier Slack shows for a workspace. It is Slack's own, not an identifier of this API.",
        "properties": {
          "workspace_id": {
            "description": "Slack's identifier for the workspace, starting with `T`, such as `T0123ABCD`.",
            "type": "string"
          }
        },
        "required": [
          "workspace_id"
        ],
        "type": "object"
      },
      "BetaClaudeTagSettingSources": {
        "additionalProperties": false,
        "description": "For each setting, the settings level its value in `settings` comes from. Without `include_inherited`, a setting the channel or workspace stores has a source that names the channel or workspace itself, and one it does not store has null, or an empty list for `instructions`. With `include_inherited=true` no member is null: a value that no settings level sets has the source `default`.",
        "properties": {
          "enabled": {
