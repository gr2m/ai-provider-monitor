{
  "description": "Check whether a plugin marketplace held in a public GitHub repository would\nsynchronize into claude.ai, without connecting or storing it.\n\nTo check a `.zip` of the marketplace directory instead, use Validate Plugin Marketplace Archive.\n\nThe report says whether `marketplace.json` is well-formed, which plugins a\nsynchronization would skip and why, and which plugins would synchronize only in\npart, with some files left out. A repository that is missing, private, or has no such branch or commit is reported, not refused: the response is a report with `valid: false`. Plugin sources outside the marketplace\nare fetched anonymously from GitHub, so a private one is reported as not found or as\nneeding a GitHub sign-in; a source on any other host is not fetched here, and the\nreport notes that it will be checked when the marketplace actually synchronizes.\n\nNothing is recorded on the Compliance API activity feed.\n\nFor a worked example, see [Validate marketplace content](/docs/en/manage-claude/plugins-api#validate-marketplace-content)\nin the Plugins API guide.\n\n**Accepted credentials:** an Admin API key with the `read:plugins` or `write:plugins` scope; `read:org_audit` and `read:compliance_org_data` do not grant it.\n\nEvery request must include the beta header `anthropic-beta: ce-plugins-2026-09-01`. A request without it returns `404`, exactly as if the endpoint did not exist. The Plugins API is in beta and is available to Claude Enterprise organizations only. It is not available to Claude Platform (Claude Console) organizations, or to organizations with HIPAA readiness enabled.",
  "operationId": "beta_validate_plugin_marketplace_repository_v1_organizations_plugin_marketplaces_validate_repository_post",
  "parameters": [
    {
      "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "title": "Anthropic-Beta",
        "type": "array"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "additionalProperties": false,
          "description": "The repository to validate: its URL, and optionally the branch or commit\nto read. `repository_url` is required and any other field is refused; a\n`repository_url` or `ref` that fails the checks listed on its field is a 400,\nand a repository, branch, or commit that cannot be read is reported in the\nresponse, not refused.",
          "properties": {
            "ref": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The branch to validate the tip of, or the full 40-character SHA of the commit to validate. When omitted, the branch a synchronization would read (usually the repository's default branch); if that is not the default branch, the report's `ref` says which branch was read. An empty string, a value longer than 255 characters, or one that contains `..` or a character other than ASCII letters, digits, `.`, `_`, `-`, `+`, and `/`, is a 400. Any other value that is not a 40-character SHA is read as a branch name; if the repository has no such branch, the response is a report with `valid: false`, not a 400.",
              "examples": [
                "main"
              ]
            },
            "repository_url": {
              "description": "The `https://` URL of a public repository on github.com that holds the marketplace. A URL longer than 2,048 characters, on any other host or scheme, with a port other than 443 or 80, with credentials in it, or that does not name exactly `owner/repo` (a trailing `.git` or `/` is accepted) is a 400. A private or missing repository is reported in the response, not refused.",
              "examples": [
                "https://github.com/example-org/example-marketplace"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "repository_url"
          ],
          "type": "object"
        }
      }
    },
    "required": true
  },
