      "BetaPluginMarketplaceValidationReport": {
        "description": "The outcome of validating plugin marketplace content: a report, not a\nstored object, so nothing in it can be retrieved afterwards.",
        "properties": {
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The full SHA of the commit that was validated: for a repository, the commit that was read; for an uploaded archive, the commit recorded in the archive's comment (as a Git host's download writes it; not verified), else null.",
            "examples": [
              "9fceb02d0ae598e95dc970b74767f19372d61af8"
            ],
            "title": "Commit Sha"
          },
          "manifest_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when nothing could be validated: the repository or archive could not be read, or marketplace.json is missing, malformed or over a limit. Null otherwise.",
            "title": "Manifest Error"
          },
          "manifest_error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A stable identifier for `manifest_error`; null when that is.",
            "examples": [
              "marketplace_sync_manifest_not_found"
            ],
            "title": "Manifest Error Code"
          },
          "plugin_errors": {
            "description": "One entry per plugin a synchronization would skip entirely, keyed by the plugin's name in marketplace.json.",
            "items": {
              "$ref": "#/components/schemas/BetaPluginMarketplaceValidationPluginError"
            },
            "title": "Plugin Errors",
            "type": "array"
          },
          "plugin_warnings": {
            "description": "One entry per plugin that would synchronize with some of its contents left out, keyed by the plugin's name in marketplace.json.",
            "items": {
              "$ref": "#/components/schemas/BetaPluginMarketplaceValidationPluginWarnings"
            },
            "title": "Plugin Warnings",
            "type": "array"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "For a repository, the branch that was read by name: the one requested, or else the branch a synchronization of this repository is set to read. Null when no branch is named or set and the repository's default branch was read, for a request by commit SHA, and for an uploaded archive.",
            "examples": [
              "main"
            ],
            "title": "Ref"
          },
          "total_plugin_count": {
            "description": "How many plugins marketplace.json declares; 0 when it could not be read.",
            "title": "Total Plugin Count",
            "type": "integer"
          },
          "type": {
            "const": "plugin_marketplace_validation_report",
            "default": "plugin_marketplace_validation_report",
            "description": "Always `plugin_marketplace_validation_report`.",
            "title": "Type",
            "type": "string"
          },
          "valid": {
            "description": "True when marketplace.json is well-formed and no plugin would be skipped; warnings never make it false.",
            "examples": [
              false
            ],
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
