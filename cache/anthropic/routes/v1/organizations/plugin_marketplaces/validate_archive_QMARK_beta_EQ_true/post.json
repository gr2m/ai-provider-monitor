      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "title": "Anthropic-Beta",
        "type": "array"
      }
    }
  ],
  "requestBody": {
    "content": {
      "multipart/form-data": {
        "schema": {
          "properties": {
            "archive": {
              "description": "A .zip of the marketplace directory (its contents at the root, or wrapped in one folder as a Git host's download produces), sent as a file part with a filename; DEFLATE- or STORE-compressed, at most 32 MB. A part sent without a filename, a second archive part, or any other form field is a 400; a larger archive is a 413.",
              "format": "binary",
              "type": "string"
            }
          },
          "required": [
            "archive"
          ],
          "type": "object"
        }
      }
    },
    "required": true
  },
