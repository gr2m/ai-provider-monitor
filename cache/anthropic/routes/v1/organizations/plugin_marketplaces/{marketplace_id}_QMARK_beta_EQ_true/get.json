      "BetaPluginMarketplace": {
        "properties": {
          "created_at": {
            "description": "RFC 3339.",
            "examples": [
              "2026-03-14T09:26:53.589793Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "default_installation_preference": {
            "anyOf": [
              {
                "enum": [
                  "auto_install",
                  "available",
                  "not_available",
                  "required"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Organization plugin marketplace: the organization-wide setting every Plugin in it with no setting of its own gets. Null for a member's personal plugin marketplace. One of `required`, `auto_install`, `available`, `not_available`; a value this API does not yet name is returned as stored.",
            "examples": [
              "available"
            ],
            "title": "Default Installation Preference"
          },
          "id": {
            "description": "The plugin marketplace's ID, prefixed `marketplace_`.",
            "examples": [
              "marketplace_01HxQ3v9KpZ2mTn8RwLc4Ys7"
            ],
            "title": "Id",
            "type": "string"
          },
          "last_sync_ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339. When the most recent synchronization attempt to finish did so, whatever its outcome; for a repository plugin marketplace no synchronization has run on yet, when it was created. Null for a plugin marketplace that is not synchronized from a repository.",
            "examples": [
              "2026-03-14T09:26:53.589793Z"
            ],
            "title": "Last Sync Ended At"
          },
          "last_sync_read_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The commit the last synchronization attempt that reached the repository read, whether or not its content was then accepted (see `sync_status`); an attempt that ends `failed_auth` or `failed_transient` leaves it unchanged. Null until an attempt has first read the repository, and for a plugin marketplace that is not synchronized from a repository.",
            "examples": [
              "9fceb02d0ae598e95dc970b74767f19372d61af8"
            ],
            "title": "Last Sync Read Sha"
          },
          "name": {
            "description": "Fixed for the plugin marketplace's lifetime.",
            "examples": [
              "engineering-tools"
            ],
            "title": "Name",
            "type": "string"
          },
          "owner": {
            "description": "The organization, or the member whose personal plugin marketplace it is.",
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/BetaPluginOwnerOrganization",
                "user": "#/components/schemas/BetaPluginOwnerUser"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaPluginOwnerOrganization"
              },
              {
                "$ref": "#/components/schemas/BetaPluginOwnerUser"
              }
            ],
            "title": "Owner"
          },
          "source": {
            "description": "Where the plugin marketplace's Plugins come from: `manual` when they are uploaded; `github`, `gitlab` or `public_git` when they are synchronized from the Git repository the owner connected, into which nothing can be uploaded; `directory` is Anthropic's own catalog, which this API does not list. A value this API does not yet name is returned as stored.",
            "enum": [
              "directory",
              "github",
              "gitlab",
              "manual",
              "public_git"
            ],
            "examples": [
              "github"
            ],
            "title": "Source",
            "type": "string"
          },
          "sync_status": {
            "anyOf": [
              {
                "enum": [
                  "failed_auth",
                  "failed_content",
                  "failed_limits",
                  "failed_transient",
                  "in_progress",
                  "success"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Outcome of the plugin marketplace's most recent synchronization: one of `success`, `in_progress`, `failed_content`, `failed_transient`, `failed_auth`, `failed_limits`; a value this API does not yet name is returned as stored. Null until a synchronization is first attempted — so always for a `manual` plugin marketplace.",
            "examples": [
              "success"
            ],
            "title": "Sync Status"
          },
          "type": {
            "const": "plugin_marketplace",
            "default": "plugin_marketplace",
            "description": "Always `plugin_marketplace`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "default_installation_preference",
          "id",
          "last_sync_ended_at",
          "last_sync_read_sha",
          "name",
          "owner",
          "source",
          "sync_status",
          "type"
        ],
        "title": "PluginMarketplace",
        "type": "object"
      },
