      "name": "scope_type[]",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "organization",
                "organization_service",
                "rbac_group",
                "seat_tier",
                "usage_tier",
                "user",
                "workspace"
              ],
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "description": "Return only limits with these scope types. Omit for all. A scope type that doesn't apply to the organization gets a 400 error.",
        "title": "Scope Type[]"
      }
    },
    {
      "description": "Maximum number of limits per page. Defaults to `20`.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "description": "Maximum number of limits per page. Defaults to `20`.",
        "maximum": 1000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "description": "Opaque cursor from a previous response's `next_page` field.",
