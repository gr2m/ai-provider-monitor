{
  "description": "List Messages API rate limits for your organization.\n\nEach entry corresponds to one rate-limit group (either a model family\nor an API-surface category such as the Message Batches API or the web\nsearch tool) and contains the set of limiter values that apply to it.\n\nWhen `limit` is omitted, every matching entry is returned in a single\npage; when `limit` truncates the result, follow `next_page` to fetch\nthe remaining entries.",
  "operationId": "beta_get_org_rate_limits_v1_organizations_rate_limits_get",
  "parameters": [
    {
      "description": "Filter to the single entry containing this model. Accepts full model names and aliases. Returns 404 if the model is not found or has no rate limits for this organization.",
      "in": "query",
      "name": "model",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter to the single entry containing this model. Accepts full model names and aliases. Returns 404 if the model is not found or has no rate limits for this organization.",
        "title": "Model"
      }
    },
    {
      "description": "Filter by group type.",
      "in": "query",
      "name": "group_type",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "enum": [
              "batch",
              "files",
              "model_group",
              "skills",
              "token_count",
              "web_search"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by group type.",
        "title": "Group Type"
      }
    },
    {
      "description": "Maximum number of items to return per page. Ranges from `1` to `1000`.\n\nWhen omitted, every remaining entry is returned in a single page and `next_page` is `null`.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Maximum number of items to return per page. Ranges from `1` to `1000`.\n\nWhen omitted, every remaining entry is returned in a single page and `next_page` is `null`.",
        "title": "Limit"
      }
    },
    {
      "description": "Opaque cursor from a previous response's `next_page`.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Opaque cursor from a previous response's `next_page`.",
        "title": "Page"
      }
    },
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "title": "Anthropic-Version",
        "type": "string"
      }
    }
  ],
