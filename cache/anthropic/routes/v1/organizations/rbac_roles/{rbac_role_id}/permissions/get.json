      "RbacRolePermission": {
        "properties": {
          "action": {
            "description": "Action the permission grants on the resource.\n\nThe vocabulary follows the resource: an `organization` grant carries a\nproduct-feature entitlement (for example `chat`), an admin-panel\npermission entitlement (`permission_*`), or a blanket capability-access\nmode — `capability_access_all` grants every product-feature entitlement\nexcept `inference_hooks_inspection`, which a role holds only through its\nown row, and `capability_access_all_ga` grants the subset of those for\nstable features as it stands at permission-check time; neither mode grants\nmodel-access entitlements. A consumer enumerating a role's per-feature grants should\ntreat a blanket row as granting every product-feature entitlement it\ncovers, or it will under-report the role's effective access. A `connector_tool` grant carries\na tool-access action (`use` or `always_allow`); a `connector_scope` grant\ncarries the scope action `grant` (the role may receive the named OAuth\nscope when tokens are minted for the connector); `connector` and\n`all_connectors` grants carry a tool-access action, the scope action, or\nan authentication-method action (`interactive` or `managed`).",
            "examples": [
              "use"
            ],
            "title": "Action",
            "type": "string"
          },
          "resource": {
            "description": "What the permission applies to.\n\nA tagged union: `type` names the kind of resource and determines which\nidentifier fields are present.",
            "discriminator": {
              "mapping": {
                "all_connectors": "#/components/schemas/AllConnectorsPermissionResource",
                "connector": "#/components/schemas/ConnectorPermissionResource",
                "connector_scope": "#/components/schemas/ConnectorScopePermissionResource",
                "connector_tool": "#/components/schemas/ConnectorToolPermissionResource",
                "organization": "#/components/schemas/OrganizationPermissionResource"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/OrganizationPermissionResource"
              },
              {
                "$ref": "#/components/schemas/ConnectorToolPermissionResource"
              },
              {
                "$ref": "#/components/schemas/ConnectorScopePermissionResource"
              },
              {
                "$ref": "#/components/schemas/ConnectorPermissionResource"
              },
              {
                "$ref": "#/components/schemas/AllConnectorsPermissionResource"
              }
            ],
            "title": "Resource"
          },
          "type": {
            "const": "rbac_role_permission",
            "default": "rbac_role_permission",
            "description": "Object type.\n\nFor RBAC Role Permissions, this is always `\"rbac_role_permission\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "action",
          "resource",
          "type"
        ],
        "title": "RbacRolePermission",
        "type": "object"
