  "summary": "Update Service Account",
  "components": {
    "schemas": {
      "ServiceAccountUpdateParams": {
        "additionalProperties": false,
        "description": "Partial update. `name` is immutable.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Replaces the description. Omit to leave unchanged; send `null` to clear (the field is stored as an empty string).",
            "title": "Description"
          },
          "organization_role": {
            "anyOf": [
              {
                "enum": [
                  "admin",
                  "developer"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Replaces the org-level role. Omit or send `null` to leave unchanged.",
            "title": "Organization Role"
          }
        },
        "title": "ServiceAccountUpdateParams",
        "type": "object"
      },
      "ServiceAccount": {
        "description": "Named non-human identity within the caller's organization.\n\nA service account is a pure identity: name + org. Authorization lives on\nwhatever references it (federation rules).",
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If set, this service account is archived.",
            "title": "Archived At"
          },
          "archived_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that archived this service account.",
            "title": "Archived By Actor Id"
          },
          "created_at": {
            "description": "When this service account was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that created this service account.",
            "title": "Created By Actor Id"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional free-text description.",
            "title": "Description"
          },
          "id": {
            "description": "Tagged ID of the service account.",
            "examples": [
              "svac_01SDCCSbTxrXDpWc1phhtcfK"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Admin-chosen slug identifier.",
            "examples": [
              "ci-deploy-bot"
            ],
            "title": "Name",
            "type": "string"
          },
          "organization_role": {
            "description": "Org-level role. A federation rule may only be created or retargeted to grant `org:admin` scope when this is `admin`. A rule granting `org:admin` whose target is later demoted to `developer` is rejected at token exchange. Rules granting `org:admin` are managed in the Console.",
            "enum": [
              "admin",
              "developer"
            ],
            "title": "Organization Role",
            "type": "string"
          },
          "type": {
            "const": "service_account",
            "default": "service_account",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "When this service account was last updated.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tagged ID (`user_`/`svac_`) of the actor that last updated this service account.",
            "title": "Updated By Actor Id"
          }
        },
        "required": [
          "archived_at",
          "archived_by_actor_id",
          "created_at",
          "created_by_actor_id",
          "description",
          "id",
          "name",
          "organization_role",
          "type",
          "updated_at",
          "updated_by_actor_id"
        ],
        "title": "ServiceAccount",
        "type": "object"
      },
