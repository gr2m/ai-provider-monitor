          "created_at": {
            "description": "When this service account was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by_actor_id": {
            "anyOf": [
              {
                "type": "string"
              },
