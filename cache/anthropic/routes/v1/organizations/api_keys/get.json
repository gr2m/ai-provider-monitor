          },
          "partial_key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Partially redacted hint for the API key.",
            "examples": [
              "sk-ant-api03-R2D...igAA"
            ],
            "title": "Partial Key Hint"
          },
          "principal": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "service_account_actor": "#/components/schemas/ApiKeyServiceAccountActor",
                    "user_actor": "#/components/schemas/ApiKeyUserActor"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ApiKeyUserActor"
                  },
                  {
                    "$ref": "#/components/schemas/ApiKeyServiceAccountActor"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The principal the API key acts as (a User or a Service Account), or `null` if the API key is not bound to a principal.",
            "examples": [
              {
                "type": "user_actor",
                "user_id": "user_01WxYzAbCdEfGhJkMnPqRsTu"
              }
            ],
            "title": "Principal"
          },
          "scope": {
            "description": "Where the API key belongs: its Workspace (`{\"type\": \"workspace\", \"workspace_id\": \"wrkspc_...\"}`, with the Workspace's real ID even when it is the organization's default Workspace), or the organization (`{\"type\": \"organization\"}`) for a principal-bound API key that has no Workspace.",
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/ApiKeyOrganizationScope",
                "workspace": "#/components/schemas/ApiKeyWorkspaceScope"
              },
              "propertyName": "type"
            },
            "examples": [
              {
                "type": "workspace",
                "workspace_id": "wrkspc_01JwQvzr7rXLA5AGx3HKfFUJ"
              }
            ],
            "oneOf": [
              {
                "$ref": "#/components/schemas/ApiKeyOrganizationScope"
              },
              {
                "$ref": "#/components/schemas/ApiKeyWorkspaceScope"
              }
            ],
            "title": "Scope"
          },
          "status": {
            "description": "Status of the API key.",
            "enum": [
              "active",
              "archived",
              "expired",
              "inactive"
            ],
            "examples": [
              "active"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "const": "api_key",
            "default": "api_key",
            "description": "Object type.\n\nFor API Keys, this is always `\"api_key\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "created_by",
          "expires_at",
          "id",
          "name",
          "partial_key_hint",
          "principal",
          "scope",
