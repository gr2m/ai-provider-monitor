  "summary": "Update API Key",
  "components": {
    "schemas": {
      "BetaApiKeyUpdateParams": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Name of the API key.",
            "title": "Name"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "archived",
                  "inactive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Status of the API key.",
            "title": "Status"
          }
        },
        "title": "ApiKeyUpdateParams",
        "type": "object"
      },
      "BetaApiKey": {
        "properties": {
          "created_at": {
            "description": "RFC 3339 datetime string indicating when the API Key was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaCreatedBy"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ID and type of the actor that created the API key, or `null` when the\ncreator is not recorded (legacy, workload-identity-federated, or\nsystem-created keys).",
            "examples": [
              {
                "id": "user_01WxYzAbCdEfGhJkMnPqRsTu",
                "type": "user"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RFC 3339 datetime string indicating when the API Key expires, or `null` if it never expires.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "title": "Expires At"
          },
          "id": {
            "description": "ID of the API key.",
            "examples": [
              "apikey_01Rj2N8SVvo6BePZj99NhmiT"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Name of the API key.",
            "examples": [
              "Developer Key"
            ],
            "title": "Name",
            "type": "string"
          },
          "partial_key_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Partially redacted hint for the API key.",
            "examples": [
              "sk-ant-api03-R2D...igAA"
            ],
            "title": "Partial Key Hint"
          },
          "principal": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "service_account_actor": "#/components/schemas/BetaApiKeyServiceAccountActor",
                    "user_actor": "#/components/schemas/BetaApiKeyUserActor"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/BetaApiKeyUserActor"
                  },
                  {
                    "$ref": "#/components/schemas/BetaApiKeyServiceAccountActor"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The principal the API key acts as (a User or a Service Account), or `null` if the API key is not bound to a principal.",
            "examples": [
              {
                "type": "user_actor",
                "user_id": "user_01WxYzAbCdEfGhJkMnPqRsTu"
              }
            ],
            "title": "Principal"
          },
          "scope": {
            "description": "Where the API key belongs: its Workspace (`{\"type\": \"workspace\", \"workspace_id\": \"wrkspc_...\"}`, with the Workspace's real ID even when it is the organization's default Workspace), or the organization (`{\"type\": \"organization\"}`) for a principal-bound API key that has no Workspace.",
            "discriminator": {
              "mapping": {
                "organization": "#/components/schemas/BetaApiKeyOrganizationScope",
                "workspace": "#/components/schemas/BetaApiKeyWorkspaceScope"
              },
              "propertyName": "type"
            },
            "examples": [
              {
                "type": "workspace",
                "workspace_id": "wrkspc_01JwQvzr7rXLA5AGx3HKfFUJ"
              }
            ],
            "oneOf": [
              {
                "$ref": "#/components/schemas/BetaApiKeyOrganizationScope"
              },
              {
                "$ref": "#/components/schemas/BetaApiKeyWorkspaceScope"
              }
            ],
            "title": "Scope"
          },
          "status": {
            "description": "Status of the API key.",
            "enum": [
              "active",
              "archived",
              "expired",
              "inactive"
            ],
            "examples": [
              "active"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "const": "api_key",
            "default": "api_key",
            "description": "Object type.\n\nFor API Keys, this is always `\"api_key\"`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "created_by",
          "expires_at",
          "id",
          "name",
          "partial_key_hint",
          "principal",
          "scope",
          "status",
          "type"
        ],
        "title": "ApiKey",
        "type": "object"
      },
      "BetaOrgApiKeyLimitExceededErrorDetails": {
        "description": "The organization has reached its limit of active API keys.",
        "properties": {
          "error_code": {
            "const": "org_api_key_limit_exceeded",
            "title": "Error Code",
            "type": "string"
          }
        },
        "required": [
          "error_code"
        ],
        "title": "OrgApiKeyLimitExceededErrorDetails",
        "type": "object"
      },
      "BetaWorkspaceApiKeyLimitExceededErrorDetails": {
        "description": "The workspace has reached its limit of active API keys.",
