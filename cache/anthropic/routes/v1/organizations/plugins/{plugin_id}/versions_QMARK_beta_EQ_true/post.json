            "type": "string"
          },
          "manifest_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The manifest's `version`, normalized for display: one leading `v` or `V` is dropped, and the result is returned only if it is 1 to 64 characters, starts with a digit, and uses only ASCII letters, digits, `.`, `+`, and `-`; otherwise `null`. For example, `\"v1.4.0\"` is returned as `\"1.4.0\"`, and `\"latest\"` as `null`. For a synchronized plugin, the `version` of its `marketplace.json` entry can take the place of the manifest's `version`. It is also `null` for a version stored before claude.ai began recording this field (August 2026).",
            "examples": [
              "1.2.0"
            ],
            "title": "Manifest Version"
          },
          "plugin_id": {
            "description": "The Plugin's ID.",
