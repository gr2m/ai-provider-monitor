{
  "description": "List an organization-owned Plugin's installation settings, which say which\nmembers it is for, most recently created first.\n\nThe list holds the Plugin's own organization-wide setting (absent while the Plugin\ninherits its marketplace's default) and each RBAC Group's own setting. A\nmember-owned Plugin has shares instead, so this path returns 404 for one.\n\n**Accepted credentials:** an Admin API key with the `read:plugins` or `read:org_audit` scope, or a Compliance Access Key with the `read:compliance_org_data` scope.\n\nEvery request must include the beta header `anthropic-beta: ce-plugins-2026-09-01`. A request without it returns `404`, exactly as if the endpoint did not exist. The Plugins API is in beta and is available to Claude Enterprise organizations only. It is not available to Claude Platform (Claude Console) organizations, or to organizations with HIPAA readiness enabled.",
  "operationId": "beta_list_plugin_installation_settings_v1_organizations_plugins__plugin_id__installation_settings_get",
  "parameters": [
    {
      "description": "ID of the Plugin (prefixed `plugin_`).",
      "in": "path",
      "name": "plugin_id",
      "required": true,
      "schema": {
        "description": "ID of the Plugin (prefixed `plugin_`).",
        "title": "Plugin Id",
        "type": "string"
      }
    },
    {
      "description": "Number of items to return per page.\n\nDefaults to `20`. Ranges from `1` to `100`.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "description": "Number of items to return per page.\n\nDefaults to `20`. Ranges from `1` to `100`.",
        "maximum": 100,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      }
    },
    {
      "description": "Optionally set to the `next_page` token from the previous response.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "maxLength": 2048,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optionally set to the `next_page` token from the previous response.",
        "title": "Page"
      }
    },
    {
      "description": "Only settings for this kind of target: `organization` (the organization-wide setting) or `rbac_group` (an RBAC Group's).",
      "in": "query",
      "name": "target_type",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "enum": [
              "organization",
              "rbac_group"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only settings for this kind of target: `organization` (the organization-wide setting) or `rbac_group` (an RBAC Group's).",
        "title": "Target Type"
      }
    },
    {
      "description": "For a `read:org_audit` or `read:compliance_org_data` key created for all of a parent organization's linked organizations: a child organization of that parent to read instead of the organization the key was created in, given as the organization's UUID or its `org_`-prefixed ID. A value that is neither returns a 400; an organization that is not a child of the key's parent, or where the Plugins API is not available, returns a 404. Any other key may pass only its own organization's ID here; another organization returns a 404.",
      "in": "query",
      "name": "organization_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "For a `read:org_audit` or `read:compliance_org_data` key created for all of a parent organization's linked organizations: a child organization of that parent to read instead of the organization the key was created in, given as the organization's UUID or its `org_`-prefixed ID. A value that is neither returns a 400; an organization that is not a child of the key's parent, or where the Plugins API is not available, returns a 404. Any other key may pass only its own organization's ID here; another organization returns a 404.",
        "title": "Organization Id"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
