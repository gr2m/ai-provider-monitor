            ],
            "title": "Plugin Id",
            "type": "string"
          },
          "target": {
            "description": "Whose setting this is: `organization` (the Plugin's own organization-wide setting) or `rbac_group` (one RBAC Group's own setting); `organization_member` does not occur here.",
