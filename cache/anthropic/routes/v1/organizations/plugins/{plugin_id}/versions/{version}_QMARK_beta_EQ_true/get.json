{
  "description": "Retrieve one version of a Plugin by its ID, or the Plugin's newest version.\n\n**Accepted credentials:** an Admin API key with the `read:plugins` or `read:org_audit` scope, or a Compliance Access Key with the `read:compliance_org_data` scope.\n\nEvery request must include the beta header `anthropic-beta: ce-plugins-2026-09-01`. A request without it returns `404`, exactly as if the endpoint did not exist. The Plugins API is in beta and is available to Claude Enterprise organizations only. It is not available to Claude Platform (Claude Console) organizations, or to organizations with HIPAA readiness enabled.",
  "operationId": "beta_get_plugin_version_v1_organizations_plugins__plugin_id__versions__version__get",
  "parameters": [
    {
      "description": "ID of the Plugin (prefixed `plugin_`).",
      "in": "path",
      "name": "plugin_id",
      "required": true,
      "schema": {
        "description": "ID of the Plugin (prefixed `plugin_`).",
        "title": "Plugin Id",
        "type": "string"
      }
    },
    {
      "description": "ID of the Plugin Version (prefixed `pluginver_`), or `latest` for the newest one.",
      "in": "path",
      "name": "version",
      "required": true,
      "schema": {
        "description": "ID of the Plugin Version (prefixed `pluginver_`), or `latest` for the newest one.",
        "title": "Version",
        "type": "string"
      }
    },
    {
      "description": "For a `read:org_audit` or `read:compliance_org_data` key created for all of a parent organization's linked organizations: a child organization of that parent to read instead of the organization the key was created in, given as the organization's UUID or its `org_`-prefixed ID. A value that is neither returns a 400; an organization that is not a child of the key's parent, or where the Plugins API is not available, returns a 404. Any other key may pass only its own organization's ID here; another organization returns a 404.",
      "in": "query",
      "name": "organization_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "For a `read:org_audit` or `read:compliance_org_data` key created for all of a parent organization's linked organizations: a child organization of that parent to read instead of the organization the key was created in, given as the organization's UUID or its `org_`-prefixed ID. A value that is neither returns a 400; an organization that is not a child of the key's parent, or where the Plugins API is not available, returns a 404. Any other key may pass only its own organization's ID here; another organization returns a 404.",
        "title": "Organization Id"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `ce-plugins-2026-09-01` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "title": "Anthropic-Beta",
        "type": "array"
      }
    }
  ],
