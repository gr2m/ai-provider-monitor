{
  "description": "List Anthropic's notices to the organizations that the API key can reach, newest first by default. A notice is returned only if the API key can read every case in its `case_ids`.\n\nTo poll, store the largest `created_at` you have read, and send it as the at-or-after filter on `created_at`. Read every page, match results by `id`, and store the new largest value after the last page.\n\nAn Admin API key with the `read:compliance_review_cases` scope can call this endpoint.",
  "operationId": "BetaListReviewNotices",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "type": "string"
      }
    },
    {
      "description": "Optional header to specify the beta version(s) you want to use.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "Optional header to specify the beta version(s) you want to use.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "Return only notices whose `case_ids` include this case (`rvc_...`). A case that the API key can't read returns an empty list.",
      "in": "query",
      "name": "case_id",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Return notices whose `created_at` is at or after this time. Notices slightly older than this time are also returned, so that a poll misses no notice.",
      "in": "query",
      "name": "created_at[gte]",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaTimestamp"
      }
    },
    {
      "description": "Return only notices whose `created_at` is after this time.",
      "in": "query",
      "name": "created_at[gt]",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaTimestamp"
      }
    },
    {
      "description": "Return only notices whose `created_at` is at or before this time.",
      "in": "query",
      "name": "created_at[lte]",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaTimestamp"
      }
    },
    {
      "description": "Return only notices whose `created_at` is before this time.",
      "in": "query",
      "name": "created_at[lt]",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaTimestamp"
      }
    },
    {
      "description": "Number of notices to return per page, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "format": "int32",
        "type": "integer"
      }
    },
    {
      "description": "Opaque cursor from a previous response's `next_page`. Leave it out to get the first page. A cursor works only with the filters and sort order of the request that returned it.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Sort direction, by `created_at` and then by `id`. Defaults to `desc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaComplianceReviewOrder"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
