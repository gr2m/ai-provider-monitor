      "BetaComplianceReviewNotice": {
        "additionalProperties": false,
        "description": "A message from Anthropic to an organization about its review cases or about the organization as a whole, such as a request to respond by a date, a warning, or a question. A notice doesn't change after Anthropic sends it.",
        "properties": {
          "case_ids": {
            "description": "The IDs of the cases that the notice is about (`rvc_...`). Empty when the notice is about the whole organization.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When Anthropic sent the notice."
          },
          "id": {
            "description": "The unique ID of the notice (`rvn_...`).",
            "type": "string"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaComplianceReviewNoticeKind"
              }
            ],
            "description": "What kind of notice this is."
          },
          "message": {
            "description": "The text of the notice.",
            "type": "string"
          },
          "organization_id": {
            "description": "The UUID of the organization that the notice is for.",
            "type": "string"
          },
          "respond_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              },
              {
                "type": "null"
              }
            ],
            "description": "The time by which Anthropic asks for an answer. Null when there is no deadline. Missing it changes nothing on a case, and the time to respond to a case can end before it."
          },
          "type": {
            "const": "compliance_review_notice",
            "description": "The object type, always `compliance_review_notice`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "organization_id",
          "case_ids",
          "kind",
          "created_at",
          "message",
          "respond_by"
        ],
        "type": "object"
      },
