  "summary": "Create Skill",
  "components": {
    "schemas": {
      "Body_create_skill_v1_skills_post": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-readable, single-line label for the Skill. Maximum 255 characters.\nAlways set: derived from the SKILL.md frontmatter `name` when omitted at\ncreation. Not unique.",
            "title": "Display Name"
          },
          "files": {
            "description": "Files to upload for the skill.\n\nAll files must be in the same top-level directory and must include a SKILL.md file at the root of that directory.",
            "items": {
              "format": "binary",
              "type": "string"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "Body_create_skill_v1_skills_post",
        "type": "object"
      },
      "Skill": {
        "properties": {
          "created_at": {
            "description": "ISO 8601 timestamp of when the skill was created.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "description": "Human-readable, single-line label for the Skill. Maximum 255 characters.\nAlways set: derived from the SKILL.md frontmatter `name` when omitted at\ncreation. Not unique.",
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill.\n\nThe format and length of IDs may change over time.",
            "examples": [
              "skill_01JAbcdefghijklmnopqrstuvw"
            ],
            "title": "Id",
            "type": "string"
          },
          "latest_version_id": {
            "description": "ID of the newest Skill Version — what `latest` references resolve to. Always set: a Skill holds at least one version.",
            "title": "Latest Version Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SkillSource",
            "description": "Where the Skill comes from.\n\nPossible values:\n* `\"custom\"`: authored by the platform user; private to their workspace\n* `\"anthropic\"`: published by Anthropic; shared and read-only\n* `\"anthropic_example\"`: Anthropic-published sample Skill\n* `\"plugin\"`: resolved from an installed plugin"
          },
          "type": {
            "const": "skill",
            "default": "skill",
            "description": "Object type.\n\nFor Skills, this is always `\"skill\"`.",
            "title": "Type",
            "type": "string"
          },
          "updated_at": {
            "description": "ISO 8601 timestamp of when the skill was last updated.",
            "examples": [
              "2024-10-30T23:58:27.427722Z"
            ],
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "display_name",
          "id",
          "latest_version_id",
          "source",
          "type",
          "updated_at"
        ],
        "title": "Skill",
        "type": "object"
      },
      "ClaudeCodeKeyCreatorNotMemberErrorDetails": {
