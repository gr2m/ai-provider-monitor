        "type": "object"
      },
      "BetaUserProfileAccessType": {
        "description": "How the platform uses the API on behalf of the entity this profile represents. `application`: the platform sells a product that uses the API behind the scenes, and the profile represents an individual end-user of that product. `passthrough`: the platform resells raw inference, and the profile identifies the resold-to company.",
        "enum": [
          "application",
          "passthrough"
        ],
        "type": "string"
      },
      "BetaUserProfileExternalUserDetailsParams": {
        "additionalProperties": false,
        "properties": {
          "account_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileExternalUserAccountStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "The status of the entity's account on the platform: `active`, `suspended` or `blocked`."
          },
          "country": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The country of the entity (not of the platform), as the platform determines it: an ISO 3166-1 alpha-2 code in upper case, for example `US`. Only the form, two uppercase ASCII letters, is checked."
          },
          "email_hash": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A hash of the entity's email address, computed by the platform. Anthropic treats it as an opaque string and does not prescribe the hash function. 1 to 255 characters."
          },
          "entity_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileExternalUserEntityType"
              },
              {
                "type": "null"
              }
            ],
            "description": "What kind of entity the profile represents: `individual`, `business`, `non_profit` or `government`."
          },
          "name_hash": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A hash of the entity's name, computed by the platform. Anthropic treats it as an opaque string and does not prescribe the hash function. 1 to 255 characters."
          },
          "onboarded_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When the entity opened its account with the platform, in RFC 3339 format: for an `application` profile, when the end-user signed up; for a `passthrough` profile, when the company became the platform's customer. Must be a complete timestamp no more than 1 minute in the future."
          },
          "reference_id": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The platform's own reference for the entity, for example the key of the end-user's row in the platform's database. Not interpreted by Anthropic and not enforced unique. 1 to 255 characters."
          }
        },
        "type": "object"
      },
      "BetaTimestamp": {
        "description": "A timestamp in RFC 3339 format",
        "format": "date-time",
        "type": "string"
      },
      "BetaUserProfileExternalUserDetails": {
        "additionalProperties": false,
        "description": "Details about the entity this profile represents, as the platform states them. Anthropic does not verify them. Every field is present, `null` until the platform supplies a value.",
        "properties": {
          "account_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileExternalUserAccountStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "The status of the entity's account on the platform: `active`, `suspended` or `blocked`. `null` until the platform supplies one."
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The country the platform associates with the entity, as an ISO 3166-1 alpha-2 code. `null` until the platform supplies one."
          },
          "email_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The platform-computed hash of the entity's email address. `null` until the platform supplies one."
          },
