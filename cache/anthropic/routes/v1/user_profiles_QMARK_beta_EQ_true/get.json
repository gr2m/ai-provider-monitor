                "$ref": "#/components/schemas/BetaUserProfileExternalUserEntityType"
              },
              {
                "type": "null"
              }
            ],
            "description": "What kind of entity the profile represents: `individual`, `business`, `non_profit` or `government`. `null` until the platform supplies one."
          },
          "name_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
