      "BetaUserProfileListOrder": {
        "description": "The direction that a list of user profiles is sorted in.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "BetaUserProfileListOrderBy": {
        "description": "Sort field for listing user profiles: `created_at` (default) or `name` (case-insensitive; profiles without a name sort last).",
        "enum": [
          "created_at",
          "name"
        ],
        "type": "string"
      },
      "BetaListUserProfilesResponse": {
        "additionalProperties": false,
        "description": "A page of user profiles, sorted by the request's `order_by` and `order`.",
        "example": {
          "data": [
            {
              "access_type": "application",
              "created_at": "2026-03-15T10:00:00Z",
              "external_id": "user_12345",
              "external_user_details": {
                "account_status": "active",
                "country": "US",
                "email_hash": null,
                "entity_type": "business",
                "name_hash": null,
                "onboarded_at": "2024-11-02T08:15:00Z",
                "reference_id": "user_12345"
              },
              "external_user_onboarded_at": "2024-11-02T08:15:00Z",
              "id": "uprof_011CZkZCu8hGbp5mYRQgUmz9",
              "metadata": {},
              "name": "Example User",
              "trust_grants": {
                "cyber": {
                  "status": "active"
                }
              },
              "type": "user_profile",
              "updated_at": "2026-03-15T10:00:00Z"
            }
          ],
          "next_page": "page_MjAyNS0wNS0xNFQwMDowMDowMFo="
        },
        "properties": {
          "data": {
            "description": "User profiles on this page.",
            "examples": [
              [
                {
                  "access_type": "application",
                  "created_at": "2026-03-15T10:00:00Z",
                  "external_id": "user_12345",
                  "external_user_details": {
                    "account_status": "active",
                    "country": "US",
                    "email_hash": null,
                    "entity_type": "business",
                    "name_hash": null,
                    "onboarded_at": "2024-11-02T08:15:00Z",
                    "reference_id": "user_12345"
                  },
                  "external_user_onboarded_at": "2024-11-02T08:15:00Z",
                  "id": "uprof_011CZkZCu8hGbp5mYRQgUmz9",
                  "metadata": {},
                  "name": "Example User",
                  "trust_grants": {
                    "cyber": {
                      "status": "active"
                    }
                  },
                  "type": "user_profile",
                  "updated_at": "2026-03-15T10:00:00Z"
