        "additionalProperties": false,
        "description": "Details about the entity this profile represents, as the platform states them. Anthropic does not verify them. Every field is present, `null` until the platform supplies a value.",
        "properties": {
          "account_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileExternalUserAccountStatus"
