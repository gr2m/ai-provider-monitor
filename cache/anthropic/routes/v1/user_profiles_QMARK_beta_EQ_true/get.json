      "BetaUserProfile": {
        "additionalProperties": false,
        "description": "A record of an entity that the platform serves through the API, such as an end-user of the platform's product or a company that the platform resells Claude access to.\n\nA Messages, Message Batches or token counting request can send a profile's `id` in the `anthropic-user-profile-id` header to attribute the request to that entity.",
        "example": {
          "access_type": "application",
          "created_at": "2026-03-15T10:00:00Z",
          "external_id": "user_12345",
          "external_user_details": {
            "account_status": "active",
            "country": "US",
            "email_hash": null,
            "entity_type": "business",
            "name_hash": null,
            "onboarded_at": "2024-11-02T08:15:00Z",
            "reference_id": "user_12345"
          },
          "external_user_onboarded_at": "2024-11-02T08:15:00Z",
          "id": "uprof_011CZkZCu8hGbp5mYRQgUmz9",
          "metadata": {},
          "name": "Example User",
          "trust_grants": {
            "cyber": {
              "status": "active"
            }
          },
          "type": "user_profile",
          "updated_at": "2026-03-15T10:00:00Z"
        },
        "properties": {
          "access_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileAccessType"
              }
            ],
            "description": "How the platform uses the API for this entity: `application` (default) or `passthrough`. Absent under the legacy `user-profiles-2026-03-24` beta header.",
            "examples": [
              "application"
            ]
          },
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When this user profile was created, in RFC 3339 format.",
            "examples": [
              "2026-03-15T10:00:00Z"
            ]
          },
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Platform's own identifier for this user. Not enforced unique. Legacy field, present only under the `user-profiles-2026-03-24` and `user-profiles-2026-08-18` beta headers; without one of them, the value is `external_user_details.reference_id`.",
            "examples": [
              "user_12345"
            ]
          },
          "external_user_details": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaUserProfileExternalUserDetails"
              }
            ],
            "description": "Details about the entity this profile represents, as the platform states them; not verified by Anthropic. Every field is present, `null` until the platform supplies a value. Absent under the legacy `user-profiles-2026-03-24` and `user-profiles-2026-08-18` beta headers, which serve `reference_id` as the top-level `external_id` and, under `user-profiles-2026-08-18`, `onboarded_at` as `external_user_onboarded_at`.",
            "examples": [
              {
                "account_status": "active",
                "country": "US",
                "email_hash": null,
                "entity_type": "business",
                "name_hash": null,
                "onboarded_at": "2024-11-02T08:15:00Z",
                "reference_id": "user_12345"
              }
            ]
          },
          "external_user_onboarded_at": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the entity this profile represents opened its account with the platform, as stated by the platform, in RFC 3339 format (UTC). `null` until the platform supplies one. Legacy field, present only under the `user-profiles-2026-08-18` beta header; without a legacy header, the value is `external_user_details.onboarded_at`.",
            "examples": [
              "2024-11-02T08:15:00Z"
            ]
          },
          "id": {
            "description": "Unique identifier for this user profile, prefixed `uprof_`.",
            "examples": [
              "uprof_011CZkZCu8hGbp5mYRQgUmz9"
            ],
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Arbitrary key-value metadata. Maximum 16 pairs, keys up to 64 chars, values up to 512 chars.",
            "examples": [
              {}
            ],
            "type": "object"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Real-world name of the entity this profile represents (company or individual). For a company the platform resells Claude access to (`access_type` `passthrough`) this is that company's name. `null` until the platform supplies one.",
            "examples": [
              "Example User"
            ]
          },
          "trust_grants": {
            "additionalProperties": {
              "$ref": "#/components/schemas/BetaUserProfileTrustGrant"
            },
            "description": "Trust grants for this profile, keyed by grant name. Key omitted when no grant is active or in flight.",
            "examples": [
              {
                "cyber": {
                  "status": "active"
                }
              }
            ],
            "type": "object"
          },
          "type": {
            "const": "user_profile",
            "description": "Object type. Always `user_profile`.",
            "examples": [
              "user_profile"
            ],
            "type": "string"
          },
          "updated_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When this user profile was last modified, in RFC 3339 format. It normally also updates shortly after Anthropic gives the profile an approval or withdraws one. Other changes to the statuses that Anthropic reports do not always update it, so read the status itself rather than watching this timestamp.",
            "examples": [
              "2026-03-15T10:00:00Z"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "trust_grants",
          "created_at",
          "metadata",
          "updated_at"
        ],
        "type": "object"
      },
