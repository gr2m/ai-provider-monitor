      "BetaManagedAgentsMemory": {
        "additionalProperties": false,
        "description": "A text document at a path inside a memory store.\n\n`content` is `null` when the response uses `view=basic`. `content_size_bytes` and `content_sha256` are always set, so you can detect changes without fetching the content. To retrieve, update, or delete a memory, pass its ID, which stays the same when its path changes.\n\nSee the [memory guide](https://platform.claude.com/docs/en/managed-agents/memory#view-and-edit-memories) to learn more about working with memories.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The memory's UTF-8 text content, or `null` when the response uses `view=basic`.\n\nThe maximum size is 100 kB (102,400 bytes)."
          },
          "content_sha256": {
            "description": "Lowercase hex SHA-256 digest of the UTF-8 `content` bytes (64 characters). The server applies no normalization, so clients can compute the same hash locally for staleness checks and as the value for a `content_sha256` precondition on update. Always populated, regardless of `view`.",
            "type": "string"
          },
          "content_size_bytes": {
            "description": "The size of the memory's `content` in UTF-8 bytes. It is set regardless of `view`.",
            "format": "int32",
            "type": "integer"
          },
          "created_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When this memory was created, in RFC 3339 format."
          },
          "id": {
            "description": "The unique ID of the memory (`mem_...`). It stays the same when the memory's path changes.\n\nTo retrieve, update, or delete the memory, pass this ID.",
            "type": "string"
          },
          "memory_store_id": {
            "description": "ID of the memory store this memory belongs to (a `memstore_...` value).",
            "type": "string"
          },
          "memory_version_id": {
            "description": "The ID of the memory version that holds the memory's current content (`memver_...`).\n\nMemory versions don't have a flag that marks the latest one. Compare their IDs with this field instead.\n\nSee the [memory guide](https://platform.claude.com/docs/en/managed-agents/memory#audit-memory-changes) to learn more about memory versions.",
            "type": "string"
          },
          "path": {
            "description": "Hierarchical path of the memory within the store, e.g. `/projects/foo/notes.md`. Always starts with `/`. Paths are case-sensitive and unique within a store. Maximum 1,024 bytes.",
            "type": "string"
          },
          "type": {
            "const": "memory",
            "type": "string"
          },
          "updated_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BetaTimestamp"
              }
            ],
            "description": "When the memory was last changed, in RFC 3339.\n\nTo find out who made the change, look at `created_by` on the memory version that `memory_version_id` references."
          }
        },
        "required": [
          "type",
          "id",
          "memory_store_id",
          "path",
          "content_size_bytes",
          "content_sha256",
          "memory_version_id",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "BetaManagedAgentsMemoryPrefix": {
        "additionalProperties": false,
        "description": "A directory marker that [List Memories](https://platform.claude.com/docs/en/api/beta/memory_stores/memories/list) returns instead of the memories below the requested `depth`.\n\nIt stands for one or more memories whose paths start with `path`. It isn't a stored object and doesn't have an ID. Each marker counts toward the page `limit`.",
