{
  "operationId": "BetaListMemories",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "type": "string"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `agent-memory-2026-07-22` or `managed-agents-2026-04-01` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `agent-memory-2026-07-22` or `managed-agents-2026-04-01` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "The ID of the memory store to list memories from (`memstore_...`).",
      "in": "path",
      "name": "memory_store_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Return only memories whose path starts with this prefix, such as `/notes/`. This value appears in request URLs. Do not include secrets or personally identifiable information.\n\nOmit it to list the whole store. The prefix must end with `/` and matches whole segments, so `/notes/` matches `/notes/todo.md` but not `/notes-archive/todo.md`.",
      "in": "query",
      "name": "path_prefix",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "How far below `path_prefix` to list. Defaults to `0`, which lists every memory below the prefix.\n\nPass `1` to list only the direct children. Deeper memories are then grouped into `memory_prefix` items.",
      "in": "query",
      "name": "depth",
      "required": false,
      "schema": {
        "format": "int32",
        "type": "integer"
      }
    },
    {
      "description": "The maximum number of items to return per page, from 1 to 100. Defaults to 20.\n\nWith `view=full`, a page holds at most 20 items. `memory` and `memory_prefix` items both count toward the limit.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "format": "int32",
        "type": "integer"
      }
    },
    {
      "description": "The `next_page` value from a previous response, to get the next page. Omit it to get the first page.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Whether each memory in the response includes `content`. Defaults to `basic`, which sets it to `null`.\n\nWith `full`, a page holds at most 20 items.",
      "in": "query",
      "name": "view",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/BetaManagedAgentsMemoryView"
      }
    },
    {
      "description": "Optional header to select the Workspace for this request. The value is a Workspace ID (for example, `wrkspc_011CZkZaBF1tNoB5wlCeusgy`).\n\nOnly needed for credentials that can act on more than one Workspace. A credential that belongs to a specific Workspace may omit it; if sent, it must match that Workspace.",
      "example": "wrkspc_011CZkZaBF1tNoB5wlCeusgy",
      "in": "header",
      "name": "anthropic-workspace-id",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
