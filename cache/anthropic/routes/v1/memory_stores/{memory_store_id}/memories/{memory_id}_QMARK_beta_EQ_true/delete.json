{
  "operationId": "BetaDeleteMemory",
  "parameters": [
    {
      "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
      "in": "header",
      "name": "anthropic-version",
      "required": false,
      "schema": {
        "description": "The version of the Claude API you want to use.\n\nRead more about versioning and our version history [here](https://platform.claude.com/docs/en/api/versioning).",
        "type": "string"
      }
    },
    {
      "description": "This endpoint is in beta: requests must send `agent-memory-2026-07-22` or `managed-agents-2026-04-01` in this header.",
      "in": "header",
      "name": "anthropic-beta",
      "required": false,
      "schema": {
        "description": "This endpoint is in beta: requests must send `agent-memory-2026-07-22` or `managed-agents-2026-04-01` in this header.",
        "items": {
          "$ref": "#/components/schemas/AnthropicBeta"
        },
        "type": "array"
      }
    },
    {
      "description": "The ID of the memory store that holds the memory (`memstore_...`).",
      "in": "path",
      "name": "memory_store_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "The ID of the memory to delete (`mem_...`).",
      "in": "path",
      "name": "memory_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Delete the memory only if its current `content_sha256` equals this value, given as 64 lowercase hexadecimal characters. Omit it to delete unconditionally.\n\nIf the hashes differ, the request fails with HTTP status 409 and nothing is deleted.",
      "in": "query",
      "name": "expected_content_sha256",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Optional header to select the Workspace for this request. The value is a Workspace ID (for example, `wrkspc_011CZkZaBF1tNoB5wlCeusgy`).\n\nOnly needed for credentials that can act on more than one Workspace. A credential that belongs to a specific Workspace may omit it; if sent, it must match that Workspace.",
      "example": "wrkspc_011CZkZaBF1tNoB5wlCeusgy",
      "in": "header",
      "name": "anthropic-workspace-id",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
