          "low",
          "max",
          "medium",
          "supported",
          "xhigh"
        ],
        "title": "EffortCapability",
        "type": "object"
      },
      "ServerToolsCapability": {
        "description": "Web search and code execution tool support, with one entry per tool.",
        "properties": {
          "code_execution": {
            "$ref": "#/components/schemas/CapabilitySupport",
            "description": "Whether the model supports the code execution tool: true when the model supports at least one version of the tool, not necessarily every version."
          },
          "supported": {
            "description": "Whether this capability is supported by the model.",
            "title": "Supported",
            "type": "boolean"
          },
