{
  "description": "Get the messages in a stored chat completion. Only Chat Completions that\nhave been created with the `store` parameter set to `true` will be\nreturned.\n",
  "operationId": "getChatCompletionMessages",
  "parameters": [
    {
      "description": "The ID of the chat completion to retrieve messages from.",
      "in": "path",
      "name": "completion_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Identifier for the last message from the previous pagination request.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of messages to retrieve.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    },
    {
      "description": "Sort order for messages by timestamp. Use `asc` for ascending order or `desc` for descending order. Defaults to `asc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "asc",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ChatCompletionMessageList"
          }
        }
      },
      "description": "A list of messages"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Invalid message pagination parameters."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "No stored chat completion was found with the specified ID."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "An internal error prevented the request from being completed."
    }
  },
  "summary": "Get chat messages",
  "tags": [
    "Chat"
  ],
  "components": {
    "schemas": {
      "ChatCompletionMessageList": {
        "description": "An object representing a list of chat completion messages.\n",
        "properties": {
          "data": {
            "description": "An array of chat completion message objects.\n",
            "items": {
              "properties": {
                "content": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "content_parts": {
                  "anyOf": [
                    {
                      "items": {
                        "properties": {
                          "file": {
                            "anyOf": [
                              {
                                "properties": {
                                  "file_data": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "file_id": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "filename": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "image_url": {
                            "anyOf": [
                              {
                                "properties": {
                                  "detail": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "url": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "url"
                                ],
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "input_audio": {
                            "anyOf": [
                              {
                                "properties": {
                                  "data": {
                                    "type": "string"
                                  },
                                  "format": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "data",
                                  "format"
                                ],
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "text": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "type": {
                            "enum": [
                              "text",
                              "image_url",
                              "input_audio",
                              "file"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "id": {
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "role": {
                  "enum": [
                    "user",
                    "assistant",
                    "tool",
                    "system",
                    "function",
                    "developer"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role",
                "content",
                "content_parts"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "first_id": {
            "description": "The identifier of the first chat message in the data array.",
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "description": "Indicates whether there are more chat messages available.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The identifier of the last chat message in the data array.",
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "list",
            "description": "The type of this object. It is always set to \"list\".\n",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "title": "ChatCompletionMessageList",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
