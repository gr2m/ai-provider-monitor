{
  "description": "List checkpoints for a fine-tuning job.\n",
  "operationId": "listFineTuningJobCheckpoints",
  "parameters": [
    {
      "description": "The ID of the fine-tuning job to get checkpoints for.\n",
      "in": "path",
      "name": "fine_tuning_job_id",
      "required": true,
      "schema": {
        "example": "ft-AF1WoRqd3aJAHsqc9NY7iL8F",
        "type": "string"
      }
    },
    {
      "description": "Identifier for the last checkpoint ID from the previous pagination request.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of checkpoints to retrieve.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 10,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListFineTuningJobCheckpointsResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The query parameters are invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The fine-tuning job was not found or is not accessible."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request rate limit has been exceeded."
    }
  },
  "summary": "List fine-tuning checkpoints",
  "tags": [
    "Fine-tuning"
  ],
  "components": {
    "schemas": {
      "ListFineTuningJobCheckpointsResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/FineTuningJobCheckpoint"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "const": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FineTuningJobCheckpoint": {
        "description": "The `fine_tuning.job.checkpoint` object represents a model checkpoint for a fine-tuning job that is ready to use.\n",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the checkpoint was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "fine_tuned_model_checkpoint": {
            "description": "The name of the fine-tuned checkpoint model that is created.",
            "type": "string"
          },
          "fine_tuning_job_id": {
            "description": "The name of the fine-tuning job that this checkpoint was created from.",
            "type": "string"
          },
          "id": {
            "description": "The checkpoint identifier, which can be referenced in the API endpoints.",
            "type": "string"
          },
          "metrics": {
            "description": "Metrics at the step number during the fine-tuning job.",
            "properties": {
              "full_valid_loss": {
                "type": "number"
              },
              "full_valid_mean_token_accuracy": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "train_loss": {
                "type": "number"
              },
              "train_mean_token_accuracy": {
                "type": "number"
              },
              "valid_loss": {
                "type": "number"
              },
              "valid_mean_token_accuracy": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "object": {
            "const": "fine_tuning.job.checkpoint",
            "description": "The object type, which is always \"fine_tuning.job.checkpoint\".",
            "type": "string"
          },
          "step_number": {
            "description": "The step number that the checkpoint was created at.",
            "type": "integer"
          }
        },
        "required": [
          "created_at",
          "fine_tuning_job_id",
          "fine_tuned_model_checkpoint",
          "id",
          "metrics",
          "object",
          "step_number"
        ],
        "title": "FineTuningJobCheckpoint",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
