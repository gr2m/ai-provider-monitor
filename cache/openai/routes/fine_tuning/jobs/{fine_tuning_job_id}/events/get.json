{
  "description": "Get status updates for a fine-tuning job.\n",
  "operationId": "listFineTuningEvents",
  "parameters": [
    {
      "description": "The ID of the fine-tuning job to get events for.\n",
      "in": "path",
      "name": "fine_tuning_job_id",
      "required": true,
      "schema": {
        "example": "ft-AF1WoRqd3aJAHsqc9NY7iL8F",
        "type": "string"
      }
    },
    {
      "description": "Identifier for the last event from the previous pagination request.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of events to retrieve.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListFineTuningJobEventsResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The query parameters are invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The fine-tuning job was not found or is not accessible."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request rate limit has been exceeded."
    }
  },
  "summary": "List fine-tuning events",
  "tags": [
    "Fine-tuning"
  ],
  "components": {
    "schemas": {
      "ListFineTuningJobEventsResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/FineTuningJobEvent"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FineTuningJobEvent": {
        "description": "Fine-tuning job event object",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the fine-tuning job was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "data": {
            "description": "The data associated with the event.",
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "The object identifier.",
            "type": "string"
          },
          "level": {
            "description": "The log level of the event.",
            "enum": [
              "info",
              "warn",
              "error"
            ],
            "type": "string"
          },
          "message": {
            "description": "The message of the event.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always \"fine_tuning.job.event\".",
            "enum": [
              "fine_tuning.job.event"
            ],
            "type": "string"
          },
          "type": {
            "description": "The type of event.",
            "enum": [
              "message",
              "metrics"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "level",
          "message"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
