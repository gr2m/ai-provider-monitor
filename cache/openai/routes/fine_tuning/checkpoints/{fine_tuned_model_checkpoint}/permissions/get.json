{
  "description": "**NOTE:** This endpoint requires an [admin API key](https://developers.openai.com/api/reference/resources/admin/subresources/organization/subresources/admin_api_keys).\n\nOrganization owners can use this endpoint to view all permissions for a fine-tuned model checkpoint.\n",
  "operationId": "listFineTuningCheckpointPermissions",
  "parameters": [
    {
      "description": "The ID of the fine-tuned model checkpoint to get permissions for.\n",
      "in": "path",
      "name": "fine_tuned_model_checkpoint",
      "required": true,
      "schema": {
        "example": "ft-AF1WoRqd3aJAHsqc9NY7iL8F",
        "type": "string"
      }
    },
    {
      "description": "The ID of the project to get permissions for.",
      "in": "query",
      "name": "project_id",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Identifier for the last permission ID from the previous pagination request.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Number of permissions to retrieve.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 10,
        "type": "integer"
      }
    },
    {
      "description": "The order in which to retrieve permissions.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "descending",
        "enum": [
          "ascending",
          "descending"
        ],
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListFineTuningCheckpointPermissionResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The query parameters are invalid."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request rate limit has been exceeded."
    }
  },
  "summary": "List checkpoint permissions",
  "tags": [
    "Fine-tuning"
  ],
  "components": {
    "schemas": {
      "ListFineTuningCheckpointPermissionResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/FineTuningCheckpointPermission"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FineTuningCheckpointPermission": {
        "description": "The `checkpoint.permission` object represents a permission for a fine-tuned model checkpoint.\n",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the permission was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The permission identifier, which can be referenced in the API endpoints.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always \"checkpoint.permission\".",
            "enum": [
              "checkpoint.permission"
            ],
            "type": "string"
          },
          "project_id": {
            "description": "The project identifier that the permission is for.",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "object",
          "project_id"
        ],
        "title": "FineTuningCheckpointPermission",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
