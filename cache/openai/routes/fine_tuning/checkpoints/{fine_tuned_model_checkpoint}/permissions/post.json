{
  "description": "**NOTE:** Calling this endpoint requires an [admin API key](https://developers.openai.com/api/reference/resources/admin/subresources/organization/subresources/admin_api_keys).\n\nThis enables organization owners to share fine-tuned models with other projects in their organization.\n",
  "operationId": "createFineTuningCheckpointPermission",
  "parameters": [
    {
      "description": "The ID of the fine-tuned model checkpoint to create a permission for.\n",
      "in": "path",
      "name": "fine_tuned_model_checkpoint",
      "required": true,
      "schema": {
        "example": "ft:gpt-4o-mini-2024-07-18:org:weather:B7R9VjQd",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateFineTuningCheckpointPermissionRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListFineTuningCheckpointPermissionResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request is invalid or checkpoint permissions cannot be changed for the requested projects or job state."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The checkpoint or its fine-tuning job was not found, or the checkpoint cannot be shared."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request rate limit has been exceeded."
    }
  },
  "summary": "Create checkpoint permissions",
  "tags": [
    "Fine-tuning"
  ],
  "components": {
    "schemas": {
      "CreateFineTuningCheckpointPermissionRequest": {
        "additionalProperties": false,
        "properties": {
          "project_ids": {
            "description": "The project identifiers to grant access to.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "project_ids"
        ],
        "type": "object"
      },
      "ListFineTuningCheckpointPermissionResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/FineTuningCheckpointPermission"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FineTuningCheckpointPermission": {
        "description": "The `checkpoint.permission` object represents a permission for a fine-tuned model checkpoint.\n",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the permission was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The permission identifier, which can be referenced in the API endpoints.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always \"checkpoint.permission\".",
            "enum": [
              "checkpoint.permission"
            ],
            "type": "string"
          },
          "project_id": {
            "description": "The project identifier that the permission is for.",
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "object",
          "project_id"
        ],
        "title": "FineTuningCheckpointPermission",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
