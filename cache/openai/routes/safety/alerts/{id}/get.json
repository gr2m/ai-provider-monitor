{
  "description": "Get a safety alert belonging to the authenticated API project.",
  "operationId": "Getprojectsafetyalert",
  "parameters": [
    {
      "description": "Project safety alert ID",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "Project safety alert ID",
        "maxLength": 38,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SafetyAlertResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The safety alert ID is too long."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The safety alert was not found or is not accessible to the caller."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The safety alert lookup is temporarily unavailable."
    }
  },
  "summary": "Get project safety alert",
  "components": {
    "schemas": {
      "SafetyAlertResource": {
        "properties": {
          "created_at": {
            "format": "unixtime",
            "type": "integer"
          },
          "detailed_explanation": {
            "anyOf": [
              {
                "description": "A generated explanation, temporarily available for eligible zero data retention alerts. Omitted when unavailable.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_type": {
            "$ref": "#/components/schemas/SafetyAlertErrorType"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "default": "safety.alert",
            "enum": [
              "safety.alert"
            ],
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "description": "A customer-safe description derived from error_type, or null for zero data retention requests.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          },
          "request_paused": {
            "description": "Whether block registration succeeded for this request. This does not confirm that response execution stopped.",
            "type": "boolean"
          },
          "response_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "request_id",
          "response_id",
          "model",
          "request_paused",
          "error_type",
          "reason"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "SafetyAlertErrorType": {
        "enum": [
          "potentially_unintended_data_transfer",
          "potentially_unintended_data_access",
          "potentially_unintended_destructive_activity",
          "other"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
