{
  "description": "End an active Realtime API call, whether it was initiated over SIP or\nWebRTC.",
  "operationId": "hangup-realtime-call",
  "parameters": [
    {
      "description": "The identifier for the call. For SIP calls, use the value provided in the\n[`realtime.call.incoming`](https://developers.openai.com/api/reference/resources/webhooks#realtime.call.incoming)\nwebhook. For WebRTC sessions, reuse the call ID returned in the `Location`\nheader when creating the call with\n[`POST /v1/realtime/calls`](https://developers.openai.com/api/reference/resources/realtime/subresources/calls/methods/create).",
      "in": "path",
      "name": "call_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "description": "Call hangup initiated successfully."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The session or call was not found or is unavailable for this operation."
    }
  },
  "summary": "Hang up call",
  "tags": [
    "Realtime"
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
