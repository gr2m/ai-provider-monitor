{
  "description": "Returns information about a specific file.",
  "operationId": "retrieveFile",
  "parameters": [
    {
      "description": "The ID of the file to use for this request.",
      "in": "path",
      "name": "file_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/OpenAIFile"
          }
        }
      },
      "description": "OK"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The file was not found."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many file requests. Reduce the request rate and try again later."
    }
  },
  "summary": "Retrieve file",
  "tags": [
    "Files"
  ],
  "components": {
    "schemas": {
      "OpenAIFile": {
        "description": "The `File` object represents a document that has been uploaded to OpenAI.",
        "properties": {
          "bytes": {
            "description": "The size of the file, in bytes. In a completed file upload response, this can\nbe null when the file size is not yet available.\n",
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the file was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "expires_at": {
            "description": "The Unix timestamp (in seconds) for when the file will expire. In a\ncompleted file upload response, this can be null when no expiry is set.\n",
            "format": "unixtime",
            "type": "integer"
          },
          "filename": {
            "description": "The name of the file.",
            "type": "string"
          },
          "id": {
            "description": "The file identifier, which can be referenced in the API endpoints.",
            "type": "string"
          },
          "object": {
            "const": "file",
            "description": "The object type, which is always `file`.",
            "type": "string"
          },
          "purpose": {
            "description": "The intended purpose of the file. Supported values are `assistants`, `assistants_output`, `batch`, `batch_output`, `fine-tune`, `fine-tune-results`, `vision`, and `user_data`.",
            "enum": [
              "assistants",
              "assistants_output",
              "batch",
              "batch_output",
              "fine-tune",
              "fine-tune-results",
              "vision",
              "user_data"
            ],
            "type": "string"
          },
          "status": {
            "deprecated": true,
            "description": "Deprecated. The current status of the file, which can be either `uploaded`, `processed`, or `error`.",
            "enum": [
              "uploaded",
              "processed",
              "error"
            ],
            "type": "string"
          },
          "status_details": {
            "deprecated": true,
            "description": "Deprecated. For details on why a fine-tuning training file failed validation, see the `error` field on `fine_tuning.job`. Completed file upload responses can return null when these details are unset.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "bytes",
          "created_at",
          "filename",
          "purpose",
          "status"
        ],
        "title": "OpenAIFile"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
