{
  "description": "Modifies a vector store.",
  "operationId": "modifyVectorStore",
  "parameters": [
    {
      "description": "The ID of the vector store to modify.",
      "in": "path",
      "name": "vector_store_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UpdateVectorStoreRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VectorStoreObject"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The vector store input is invalid, the store has expired, or the store cannot be modified."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The caller is not authorized to update the vector store."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The vector store was not found."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "summary": "Modify vector store",
  "tags": [
    "Vector stores"
  ],
  "components": {
    "schemas": {
      "UpdateVectorStoreRequest": {
        "additionalProperties": false,
        "properties": {
          "expires_after": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VectorStoreExpirationAfter"
              },
              {
                "nullable": true
              }
            ]
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "name": {
            "description": "The name of the vector store.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "VectorStoreObject": {
        "description": "A vector store is a collection of processed files can be used by the `file_search` tool.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the vector store was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "expires_after": {
            "$ref": "#/components/schemas/VectorStoreExpirationAfter"
          },
          "expires_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) for when the vector store will expire.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "file_counts": {
            "properties": {
              "cancelled": {
                "description": "The number of files that were cancelled.",
                "type": "integer"
              },
              "completed": {
                "description": "The number of files that have been successfully processed.",
                "type": "integer"
              },
              "failed": {
                "description": "The number of files that have failed to process.",
                "type": "integer"
              },
              "in_progress": {
                "description": "The number of files that are currently being processed.",
                "type": "integer"
              },
              "total": {
                "description": "The total number of files.",
                "type": "integer"
              }
            },
            "required": [
              "in_progress",
              "completed",
              "failed",
              "cancelled",
              "total"
            ],
            "type": "object"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints.",
            "type": "string"
          },
          "last_active_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) for when the vector store was last active.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "name": {
            "description": "The name of the vector store.",
            "type": "string"
          },
          "object": {
            "const": "vector_store",
            "description": "The object type, which is always `vector_store`.",
            "type": "string"
          },
          "status": {
            "description": "The status of the vector store, which can be either `expired`, `in_progress`, or `completed`. A status of `completed` indicates that the vector store is ready for use.",
            "enum": [
              "expired",
              "in_progress",
              "completed"
            ],
            "type": "string"
          },
          "usage_bytes": {
            "description": "The total number of bytes used by the files in the vector store.",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "object",
          "usage_bytes",
          "created_at",
          "status",
          "last_active_at",
          "name",
          "file_counts",
          "metadata"
        ],
        "title": "Vector store",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "VectorStoreExpirationAfter": {
        "description": "The expiration policy for a vector store.",
        "properties": {
          "anchor": {
            "const": "last_active_at",
            "description": "Anchor timestamp after which the expiration policy applies. Supported anchors: `last_active_at`.",
            "type": "string"
          },
          "days": {
            "description": "The number of days after the anchor time that the vector store will expire.",
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "anchor",
          "days"
        ],
        "title": "Vector store expiration policy",
        "type": "object"
      },
      "Metadata": {
        "anyOf": [
          {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Set of 16 key-value pairs that can be attached to an object. This can be\nuseful for storing additional information about the object in a structured\nformat, and querying for objects via API or the dashboard.\n\nKeys are strings with a maximum length of 64 characters. Values are strings\nwith a maximum length of 512 characters.\n",
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
