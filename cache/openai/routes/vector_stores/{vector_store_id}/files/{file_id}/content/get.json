{
  "description": "Retrieve the parsed contents of a vector store file.",
  "operationId": "retrieveVectorStoreFileContent",
  "parameters": [
    {
      "description": "The ID of the vector store.",
      "in": "path",
      "name": "vector_store_id",
      "required": true,
      "schema": {
        "example": "vs_abc123",
        "type": "string"
      }
    },
    {
      "description": "The ID of the file within the vector store.",
      "in": "path",
      "name": "file_id",
      "required": true,
      "schema": {
        "example": "file-abc123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VectorStoreFileContentResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The vector store has expired or the file content is not ready."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The vector store or file was not found."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The vector store file content could not be retrieved."
    }
  },
  "summary": "Retrieve vector store file content",
  "tags": [
    "Vector stores"
  ],
  "components": {
    "schemas": {
      "VectorStoreFileContentResponse": {
        "description": "Represents the parsed content of a vector store file.",
        "properties": {
          "data": {
            "description": "Parsed content of the file.",
            "items": {
              "properties": {
                "text": {
                  "description": "The text content",
                  "type": "string"
                },
                "type": {
                  "description": "The content type (currently only `\"text\"`)",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "description": "Indicates if there are more content pages to fetch.",
            "type": "boolean"
          },
          "next_page": {
            "anyOf": [
              {
                "description": "The token for the next page, if any.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "const": "vector_store.file_content.page",
            "description": "The object type, which is always `vector_store.file_content.page`",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more",
          "next_page"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
