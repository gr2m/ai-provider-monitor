{
  "description": "Cancel an active ChatKit session and return its most recent metadata.\n\nCancelling prevents new requests from using the issued client secret.",
  "operationId": "CancelChatSessionMethod",
  "parameters": [
    {
      "description": "Unique identifier for the ChatKit session to cancel.",
      "in": "path",
      "name": "session_id",
      "required": true,
      "schema": {
        "example": "cksess_123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "examples": {
            "Example": {
              "value": {
                "chatkit_configuration": {
                  "automatic_thread_titling": {
                    "enabled": true
                  },
                  "file_upload": {
                    "enabled": true,
                    "max_file_size": 16,
                    "max_files": 20
                  },
                  "history": {
                    "enabled": true,
                    "recent_threads": 10
                  }
                },
                "client_secret": "",
                "expires_at": 1712349876,
                "id": "cksess_123",
                "max_requests_per_1_minute": 60,
                "object": "chatkit.session",
                "rate_limits": {
                  "max_requests_per_1_minute": 60
                },
                "status": "cancelled",
                "user": "user_789",
                "workflow": {
                  "id": "workflow_alpha",
                  "state_variables": {
                    "message": "hello"
                  },
                  "tracing": {
                    "enabled": true
                  },
                  "version": "2024-10-01T00:00:00.000Z"
                }
              }
            }
          },
          "schema": {
            "$ref": "#/components/schemas/ChatSessionResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request is invalid or the required ChatKit beta header is missing or invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The session was not found or is not accessible."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request rate limit has been exceeded."
    }
  },
  "summary": "Cancel a ChatKit session",
  "components": {
    "schemas": {
      "ChatSessionResource": {
        "description": "Represents a ChatKit session and its resolved configuration.",
        "example": {
          "chatkit_configuration": {
            "automatic_thread_titling": {
              "enabled": true
            },
            "file_upload": {
              "enabled": true,
              "max_file_size": 16,
              "max_files": 20
            },
            "history": {
              "enabled": true,
              "recent_threads": 10
            }
          },
          "client_secret": "ek_token_123",
          "expires_at": 1712349876,
          "id": "cksess_123",
          "max_requests_per_1_minute": 60,
          "object": "chatkit.session",
          "rate_limits": {
            "max_requests_per_1_minute": 60
          },
          "status": "active",
          "user": "user_789",
          "workflow": {
            "id": "workflow_alpha",
            "state_variables": {
              "message": "hello"
            },
            "tracing": {
              "enabled": true
            },
            "version": "2024-10-01T00:00:00.000Z"
          }
        },
        "properties": {
          "chatkit_configuration": {
            "$ref": "#/components/schemas/ChatSessionChatkitConfiguration",
            "description": "Resolved ChatKit feature configuration for the session."
          },
          "client_secret": {
            "description": "Ephemeral client secret that authenticates session requests.",
            "type": "string"
          },
          "expires_at": {
            "description": "Unix timestamp (in seconds) for when the session expires.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "Identifier for the ChatKit session.",
            "type": "string"
          },
          "max_requests_per_1_minute": {
            "description": "Convenience copy of the per-minute request limit.",
            "type": "integer"
          },
          "object": {
            "default": "chatkit.session",
            "description": "Type discriminator that is always `chatkit.session`.",
            "enum": [
              "chatkit.session"
            ],
            "type": "string"
          },
          "rate_limits": {
            "$ref": "#/components/schemas/ChatSessionRateLimits",
            "description": "Resolved rate limit values."
          },
          "status": {
            "$ref": "#/components/schemas/ChatSessionStatus",
            "description": "Current lifecycle state of the session."
          },
          "user": {
            "description": "User identifier associated with the session.",
            "type": "string"
          },
          "workflow": {
            "$ref": "#/components/schemas/ChatkitWorkflow",
            "description": "Workflow metadata for the session."
          }
        },
        "required": [
          "id",
          "object",
          "expires_at",
          "client_secret",
          "workflow",
          "user",
          "rate_limits",
          "max_requests_per_1_minute",
          "status",
          "chatkit_configuration"
        ],
        "title": "The chat session object",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ChatSessionChatkitConfiguration": {
        "description": "ChatKit configuration for the session.",
        "properties": {
          "automatic_thread_titling": {
            "$ref": "#/components/schemas/ChatSessionAutomaticThreadTitling",
            "description": "Automatic thread titling preferences."
          },
          "file_upload": {
            "$ref": "#/components/schemas/ChatSessionFileUpload",
            "description": "Upload settings for the session."
          },
          "history": {
            "$ref": "#/components/schemas/ChatSessionHistory",
            "description": "History retention configuration."
          }
        },
        "required": [
          "automatic_thread_titling",
          "file_upload",
          "history"
        ],
        "title": "ChatKit configuration",
        "type": "object"
      },
      "ChatSessionRateLimits": {
        "description": "Active per-minute request limit for the session.",
        "properties": {
          "max_requests_per_1_minute": {
            "description": "Maximum allowed requests per one-minute window.",
            "type": "integer"
          }
        },
        "required": [
          "max_requests_per_1_minute"
        ],
        "title": "Rate limits",
        "type": "object"
      },
      "ChatSessionStatus": {
        "enum": [
          "active",
          "expired",
          "cancelled"
        ],
        "type": "string"
      },
      "ChatkitWorkflow": {
        "description": "Workflow metadata and state returned for the session.",
        "properties": {
          "id": {
            "description": "Identifier of the workflow backing the session.",
            "type": "string"
          },
          "state_variables": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": "State variable key-value pairs applied when invoking the workflow. Defaults to null when no overrides were provided.",
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "tracing": {
            "$ref": "#/components/schemas/ChatkitWorkflowTracing",
            "description": "Tracing settings applied to the workflow."
          },
          "version": {
            "anyOf": [
              {
                "description": "Specific workflow version used for the session. Defaults to null when using the latest deployment.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "version",
          "state_variables",
          "tracing"
        ],
        "title": "Workflow",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "ChatSessionAutomaticThreadTitling": {
        "description": "Automatic thread title preferences for the session.",
        "properties": {
          "enabled": {
            "description": "Whether automatic thread titling is enabled.",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "Automatic thread titling",
        "type": "object"
      },
      "ChatSessionFileUpload": {
        "description": "Upload permissions and limits applied to the session.",
        "properties": {
          "enabled": {
            "description": "Indicates if uploads are enabled for the session.",
            "type": "boolean"
          },
          "max_file_size": {
            "anyOf": [
              {
                "description": "Maximum upload size in megabytes.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_files": {
            "anyOf": [
              {
                "description": "Maximum number of uploads allowed during the session.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "enabled",
          "max_file_size",
          "max_files"
        ],
        "title": "File upload settings",
        "type": "object"
      },
      "ChatSessionHistory": {
        "description": "History retention preferences returned for the session.",
        "properties": {
          "enabled": {
            "description": "Indicates if chat history is persisted for the session.",
            "type": "boolean"
          },
          "recent_threads": {
            "anyOf": [
              {
                "description": "Number of prior threads surfaced in history views. Defaults to null when all history is retained.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "enabled",
          "recent_threads"
        ],
        "title": "History settings",
        "type": "object"
      },
      "ChatkitWorkflowTracing": {
        "description": "Controls diagnostic tracing during the session.",
        "properties": {
          "enabled": {
            "description": "Indicates whether tracing is enabled.",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "Tracing Configuration",
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
