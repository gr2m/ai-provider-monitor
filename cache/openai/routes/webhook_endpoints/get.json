{
  "description": "Returns webhook endpoints for the authenticated project in newest-first order.",
  "operationId": "ListWebhookEndpoints",
  "parameters": [
    {
      "description": "Maximum number of webhook endpoints to return. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "ID of the last webhook endpoint from the previous page.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "example": "whe_123",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WebhookEndpointListResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The pagination cursor does not identify a webhook endpoint in the authenticated project."
    }
  },
  "summary": "List Webhook Endpoints",
  "components": {
    "schemas": {
      "WebhookEndpointListResource": {
        "properties": {
          "data": {
            "description": "The webhook endpoints in this page.",
            "items": {
              "$ref": "#/components/schemas/WebhookEndpointBody"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "description": "The ID of the first endpoint in this page.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "description": "Whether more webhook endpoints are available.",
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "description": "The ID of the last endpoint in this page.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "const": "list",
            "default": "list",
            "description": "The object type, which is always list.",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "WebhookEndpointBody": {
        "properties": {
          "created_at": {
            "description": "The Unix timestamp when the endpoint was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "event_types": {
            "description": "The event types that trigger deliveries to this endpoint.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "The unique ID of the webhook endpoint.",
            "type": "string"
          },
          "name": {
            "description": "The human-readable name of the endpoint.",
            "type": "string"
          },
          "object": {
            "const": "webhook_endpoint",
            "default": "webhook_endpoint",
            "description": "The object type, which is always webhook_endpoint.",
            "type": "string"
          },
          "signing_secret_hint": {
            "anyOf": [
              {
                "description": "A masked hint for the endpoint's signing secret.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "description": "The Unix timestamp of the last endpoint configuration or signing-secret change. Initialized at creation; tests and unchanged updates do not advance it.",
            "format": "unixtime",
            "type": "integer"
          },
          "url": {
            "description": "The HTTPS URL that receives webhook deliveries.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "name",
          "url",
          "event_types",
          "signing_secret_hint"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
