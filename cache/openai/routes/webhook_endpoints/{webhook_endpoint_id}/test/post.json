{
  "description": "Sends a sample event to a webhook endpoint for the authenticated project.",
  "operationId": "TestWebhookEndpoint",
  "parameters": [
    {
      "description": "The ID of the webhook endpoint to test.",
      "in": "path",
      "name": "webhook_endpoint_id",
      "required": true,
      "schema": {
        "example": "whe_123",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/PublicTestEndpointBody"
        }
      }
    }
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WebhookEndpointTestResultResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The webhook endpoint was not found in the authenticated project."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The sample event could not be sent to the webhook endpoint."
    }
  },
  "summary": "Test Webhook Endpoint",
  "components": {
    "schemas": {
      "PublicTestEndpointBody": {
        "properties": {
          "event_type": {
            "$ref": "#/components/schemas/ProjectEventTypeEnum",
            "description": "The event type to send as a sample delivery."
          }
        },
        "required": [
          "event_type"
        ],
        "type": "object"
      },
      "WebhookEndpointTestResultResource": {
        "properties": {
          "event_type": {
            "description": "The event type sent in the test.",
            "type": "string"
          },
          "object": {
            "const": "webhook_endpoint.test",
            "default": "webhook_endpoint.test",
            "description": "The object type, which is always webhook_endpoint.test.",
            "type": "string"
          },
          "status_code": {
            "description": "The HTTP status code returned by the endpoint.",
            "type": "integer"
          },
          "success": {
            "const": true,
            "default": true,
            "description": "Whether the test request completed. Always true for returned results; use status_code to determine the endpoint response.",
            "type": "boolean"
          },
          "webhook_endpoint_id": {
            "description": "The ID of the webhook endpoint that received the test.",
            "type": "string"
          }
        },
        "required": [
          "object",
          "webhook_endpoint_id",
          "event_type",
          "status_code",
          "success"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProjectEventTypeEnum": {
        "enum": [
          "batch.completed",
          "batch.failed",
          "batch.expired",
          "batch.cancelled",
          "response.completed",
          "response.failed",
          "response.cancelled",
          "response.incomplete",
          "eval.run.succeeded",
          "eval.run.failed",
          "eval.run.canceled",
          "fine_tuning.job.succeeded",
          "fine_tuning.job.failed",
          "fine_tuning.job.cancelled",
          "realtime.call.incoming",
          "video.completed",
          "video.failed",
          "agent.environment.ready",
          "agent.environment.failed",
          "agent.environment.suspended",
          "agent.environment.expired",
          "agent.session.created",
          "agent.session.action_required",
          "agent.session.in_progress",
          "agent.session.idle",
          "agent.session.failed",
          "safety.alert.created"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
