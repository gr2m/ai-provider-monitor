{
  "description": "Updates a webhook endpoint for the authenticated project.",
  "operationId": "UpdateWebhookEndpoint",
  "parameters": [
    {
      "description": "The ID of the webhook endpoint to update.",
      "in": "path",
      "name": "webhook_endpoint_id",
      "required": true,
      "schema": {
        "example": "whe_123",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/PublicUpdateEndpointBody"
        }
      }
    }
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WebhookEndpointBody"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The webhook endpoint parameters are invalid or the requested URL or event types are not permitted."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The webhook endpoint was not found in the authenticated project."
    }
  },
  "summary": "Update Webhook Endpoint",
  "components": {
    "schemas": {
      "PublicUpdateEndpointBody": {
        "properties": {
          "event_types": {
            "description": "The complete set of event types that should trigger deliveries.",
            "items": {
              "$ref": "#/components/schemas/ProjectEventTypeEnum"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "description": "A new human-readable name for the webhook endpoint.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "description": "A new HTTPS URL that receives webhook deliveries.",
            "maxLength": 2048,
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "WebhookEndpointBody": {
        "properties": {
          "created_at": {
            "description": "The Unix timestamp when the endpoint was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "event_types": {
            "description": "The event types that trigger deliveries to this endpoint.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "The unique ID of the webhook endpoint.",
            "type": "string"
          },
          "name": {
            "description": "The human-readable name of the endpoint.",
            "type": "string"
          },
          "object": {
            "default": "webhook_endpoint",
            "description": "The object type, which is always webhook_endpoint.",
            "enum": [
              "webhook_endpoint"
            ],
            "type": "string"
          },
          "signing_secret_hint": {
            "anyOf": [
              {
                "description": "A masked hint for the endpoint's signing secret.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "description": "The Unix timestamp of the last endpoint configuration or signing-secret change. Initialized at creation; tests and unchanged updates do not advance it.",
            "format": "unixtime",
            "type": "integer"
          },
          "url": {
            "description": "The HTTPS URL that receives webhook deliveries.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "name",
          "url",
          "event_types",
          "signing_secret_hint"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProjectEventTypeEnum": {
        "enum": [
          "batch.completed",
          "batch.failed",
          "batch.expired",
          "batch.cancelled",
          "response.completed",
          "response.failed",
          "response.cancelled",
          "response.incomplete",
          "eval.run.succeeded",
          "eval.run.failed",
          "eval.run.canceled",
          "fine_tuning.job.succeeded",
          "fine_tuning.job.failed",
          "fine_tuning.job.cancelled",
          "realtime.call.incoming",
          "video.completed",
          "video.failed",
          "agent.environment.ready",
          "agent.environment.failed",
          "agent.environment.suspended",
          "agent.environment.expired",
          "agent.session.created",
          "agent.session.action_required",
          "agent.session.in_progress",
          "agent.session.idle",
          "agent.session.failed",
          "safety.alert.created"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
