{
  "description": "Create an invite for a user to the organization. The invite must be accepted by the user before they have access to the organization.",
  "operationId": "inviteUser",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/InviteRequest"
        }
      }
    },
    "description": "The invite request payload.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Invite"
          }
        }
      },
      "description": "User invited successfully."
    },
    "201": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Invite"
          }
        }
      },
      "description": "User invited successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The invite request is invalid or the user has already joined or been invited."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Create invite",
  "tags": [
    "Invites"
  ],
  "components": {
    "schemas": {
      "InviteRequest": {
        "properties": {
          "email": {
            "description": "Send an email to this address",
            "type": "string"
          },
          "projects": {
            "description": "An array of projects to which membership is granted at the same time the org invite is accepted. If omitted, the user will be invited to the default project for compatibility with legacy behavior. If empty list is passed, the user will not be invited to any projects, including the default one.",
            "items": {
              "properties": {
                "id": {
                  "description": "Project's public ID",
                  "type": "string"
                },
                "role": {
                  "description": "Project membership role",
                  "enum": [
                    "member",
                    "owner"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "role": {
            "description": "`owner` or `reader`",
            "enum": [
              "reader",
              "owner"
            ],
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "Invite": {
        "description": "Represents an individual `invite` to the organization.",
        "properties": {
          "accepted_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) of when the invite was accepted."
          },
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the invite was sent.",
            "format": "unixtime",
            "type": "integer"
          },
          "email": {
            "description": "The email address of the individual to whom the invite was sent",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) of when the invite expires."
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `organization.invite`",
            "enum": [
              "organization.invite"
            ],
            "type": "string"
          },
          "projects": {
            "description": "The projects that were granted membership upon acceptance of the invite.",
            "items": {
              "properties": {
                "id": {
                  "description": "Project's public ID",
                  "type": "string"
                },
                "role": {
                  "description": "Project membership role",
                  "enum": [
                    "member",
                    "owner"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "role": {
            "description": "`owner` or `reader`",
            "enum": [
              "owner",
              "reader"
            ],
            "type": "string"
          },
          "status": {
            "description": "`accepted`,`expired`, or `pending`",
            "enum": [
              "accepted",
              "expired",
              "pending"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "email",
          "role",
          "status",
          "created_at",
          "projects"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
