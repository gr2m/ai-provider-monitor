{
  "description": "Modifies a project in the organization.",
  "operationId": "modify-project",
  "parameters": [
    {
      "description": "The ID of the project.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ProjectUpdateRequest"
        }
      }
    },
    "description": "The project update request payload.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Project"
          }
        }
      },
      "description": "Project updated successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Error response when updating the default project."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "A requested project, user, service account, or API key was not found."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Modify project",
  "tags": [
    "Projects"
  ],
  "components": {
    "schemas": {
      "ProjectUpdateRequest": {
        "properties": {
          "external_key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "External key ID to associate with the project."
          },
          "geography": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "deprecated": true,
            "description": "Geography for the project.\nDeprecated: use `residency` when creating a project to configure data residency. This field is retained for backward compatibility."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The updated name of the project, this name appears in reports."
          }
        },
        "type": "object"
      },
      "Project": {
        "description": "Represents an individual project.",
        "properties": {
          "archived_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) of when the project was archived or `null`.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the project was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "external_key_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The external key associated with the project."
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the project. This appears in reporting."
          },
          "object": {
            "description": "The object type, which is always `organization.project`",
            "enum": [
              "organization.project"
            ],
            "type": "string"
          },
          "residency": {
            "$ref": "#/components/schemas/PublicProjectResidency",
            "description": "The residency configuration for the project."
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`active` or `archived`"
          }
        },
        "required": [
          "id",
          "object",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PublicProjectResidency": {
        "enum": [
          "GLOBAL",
          "US_STORAGE_PROCESSING",
          "EU_STORAGE_PROCESSING",
          "JP_STORAGE",
          "JP_STORAGE_PROCESSING",
          "KR_STORAGE",
          "CA_STORAGE",
          "SG_STORAGE",
          "IN_STORAGE",
          "IN_STORAGE_PROCESSING",
          "AU_STORAGE",
          "AU_STORAGE_PROCESSING",
          "GB_STORAGE",
          "AE_STORAGE",
          "AE_STORAGE_PROCESSING"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
