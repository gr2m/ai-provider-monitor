{
  "description": "Returns a list of API keys in the project.",
  "operationId": "list-project-api-keys",
  "parameters": [
    {
      "description": "The ID of the project.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 20.\n",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    },
    {
      "description": "A cursor for use in pagination. `after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list.\n",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Filter API keys by whether the owner currently has effective access to the project. Use `active` for owners with access, `inactive` for owners without access, or `any` for all enabled project API keys. If omitted, the endpoint applies its existing membership-based visibility rules, which may exclude some enabled keys.\n",
      "in": "query",
      "name": "owner_project_access",
      "required": false,
      "schema": {
        "enum": [
          "active",
          "inactive",
          "any"
        ],
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectApiKeyListResponse"
          }
        }
      },
      "description": "Project API keys listed successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The listing parameters are invalid or the project is archived."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The project was not found."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "List project API keys",
  "tags": [
    "Projects"
  ],
  "components": {
    "schemas": {
      "ProjectApiKeyListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/ProjectApiKey"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProjectApiKey": {
        "description": "Represents an individual API key in a project.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the API key was created",
            "format": "unixtime",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) when the API key expires, or null if it does not expire."
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) of when the API key was last used."
          },
          "name": {
            "description": "The name of the API key",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `organization.project.api_key`",
            "enum": [
              "organization.project.api_key"
            ],
            "type": "string"
          },
          "owner": {
            "properties": {
              "service_account": {
                "$ref": "#/components/schemas/ProjectApiKeyOwnerServiceAccount"
              },
              "type": {
                "description": "`user` or `service_account`",
                "enum": [
                  "user",
                  "service_account"
                ],
                "type": "string"
              },
              "user": {
                "$ref": "#/components/schemas/ProjectApiKeyOwnerUser"
              }
            },
            "type": "object"
          },
          "owner_project_access": {
            "description": "Whether the API key's owner currently has effective access to the project.",
            "enum": [
              "active",
              "inactive"
            ],
            "type": "string"
          },
          "redacted_value": {
            "description": "The redacted value of the API key",
            "type": "string"
          }
        },
        "required": [
          "object",
          "redacted_value",
          "name",
          "created_at",
          "last_used_at",
          "id",
          "owner_project_access",
          "owner"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "ProjectApiKeyOwnerServiceAccount": {
        "description": "The service account that owns a project API key.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the service account was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "name": {
            "description": "The name of the service account.",
            "type": "string"
          },
          "role": {
            "description": "The service account's project role.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "role"
        ],
        "type": "object"
      },
      "ProjectApiKeyOwnerUser": {
        "description": "The user that owns a project API key.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the user was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "email": {
            "description": "The email address of the user.",
            "type": "string"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "name": {
            "description": "The name of the user.",
            "type": "string"
          },
          "role": {
            "description": "The user's project role.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "created_at",
          "role"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
