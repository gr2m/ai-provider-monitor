{
  "description": "Updates a project rate limit.",
  "operationId": "update-project-rate-limits",
  "parameters": [
    {
      "description": "The ID of the project.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "The ID of the rate limit.",
      "in": "path",
      "name": "rate_limit_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ProjectRateLimitUpdateRequest"
        }
      }
    },
    "description": "The project rate limit update request payload.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectRateLimit"
          }
        }
      },
      "description": "Project rate limit updated successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Error response for various conditions."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "example": {
            "error": {
              "code": "project_not_found",
              "message": "The project proj_abc was not found",
              "param": null,
              "type": "invalid_request_error"
            }
          },
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The project was not found."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Modify project rate limit",
  "tags": [
    "Projects"
  ],
  "components": {
    "schemas": {
      "ProjectRateLimitUpdateRequest": {
        "properties": {
          "batch_1_day_max_input_tokens": {
            "description": "The maximum batch input tokens per day. Only relevant for certain models.",
            "type": "integer"
          },
          "max_audio_megabytes_per_1_minute": {
            "description": "The maximum audio megabytes per minute. Only relevant for certain models.",
            "type": "integer"
          },
          "max_images_per_1_minute": {
            "description": "The maximum images per minute. Only relevant for certain models.",
            "type": "integer"
          },
          "max_requests_per_1_day": {
            "description": "The maximum requests per day. Only relevant for certain models.",
            "type": "integer"
          },
          "max_requests_per_1_minute": {
            "description": "The maximum requests per minute.",
            "type": "integer"
          },
          "max_tokens_per_1_minute": {
            "description": "The maximum tokens per minute.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ProjectRateLimit": {
        "description": "Represents a project rate limit config.",
        "properties": {
          "batch_1_day_max_input_tokens": {
            "description": "The maximum batch input tokens per day. Only present for relevant models.",
            "type": "integer"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints.",
            "type": "string"
          },
          "max_audio_megabytes_per_1_minute": {
            "description": "The maximum audio megabytes per minute. Only present for relevant models.",
            "type": "integer"
          },
          "max_images_per_1_minute": {
            "description": "The maximum images per minute. Only present for relevant models.",
            "type": "integer"
          },
          "max_requests_per_1_day": {
            "description": "The maximum requests per day. Only present for relevant models.",
            "type": "integer"
          },
          "max_requests_per_1_minute": {
            "description": "The maximum requests per minute.",
            "type": "integer"
          },
          "max_tokens_per_1_minute": {
            "description": "The maximum tokens per minute.",
            "type": "integer"
          },
          "model": {
            "description": "The model this rate limit applies to.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `project.rate_limit`",
            "enum": [
              "project.rate_limit"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "model",
          "max_requests_per_1_minute",
          "max_tokens_per_1_minute"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
