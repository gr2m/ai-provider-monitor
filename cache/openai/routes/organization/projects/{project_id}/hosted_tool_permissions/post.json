            "description": "The code interpreter permission update."
          },
          "file_search": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HostedToolPermissionUpdate"
              },
              {
                "type": "null"
              }
            ],
            "description": "The file search permission update."
          },
          "image_generation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HostedToolPermissionUpdate"
              },
              {
                "type": "null"
              }
