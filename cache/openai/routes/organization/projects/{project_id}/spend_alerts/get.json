{
  "description": "Lists project spend alerts.",
  "operationId": "list-project-spend-alerts",
  "parameters": [
    {
      "description": "The ID of the project to inspect.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "A limit on the number of spend alerts to return. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      }
    },
    {
      "description": "Sort order for the returned spend alerts.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "default": "asc",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      }
    },
    {
      "description": "Cursor for pagination. Provide the ID of the last spend alert from the previous response to fetch the next page.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Cursor for pagination. Provide the ID of the first spend alert from the previous response to fetch the previous page.",
      "in": "query",
      "name": "before",
      "required": false,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectSpendAlertListResource"
          }
        }
      },
      "description": "Project spend alerts listed successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The spend alert listing parameters are invalid."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The project or spend alert pagination cursor was not found."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "List project spend alerts",
  "tags": [
    "Spend alerts"
  ],
  "components": {
    "schemas": {
      "ProjectSpendAlertListResource": {
        "description": "Paginated list of project spend alerts.",
        "properties": {
          "data": {
            "description": "Spend alerts returned in the current page.",
            "items": {
              "$ref": "#/components/schemas/ProjectSpendAlert"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ID of the first spend alert in this page."
          },
          "has_more": {
            "description": "Whether more spend alerts are available when paginating.",
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The ID of the last spend alert in this page."
          },
          "object": {
            "description": "Always `list`.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProjectSpendAlert": {
        "description": "Represents a spend alert configured at the project level.",
        "properties": {
          "currency": {
            "description": "The currency for the threshold amount.",
            "enum": [
              "USD"
            ],
            "type": "string"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints.",
            "type": "string"
          },
          "interval": {
            "description": "The time interval for evaluating spend against the threshold.",
            "enum": [
              "month"
            ],
            "type": "string"
          },
          "notification_channel": {
            "$ref": "#/components/schemas/SpendAlertNotificationChannel"
          },
          "object": {
            "description": "The object type, which is always `project.spend_alert`.",
            "enum": [
              "project.spend_alert"
            ],
            "type": "string"
          },
          "threshold_amount": {
            "description": "The alert threshold amount, in cents.",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "object",
          "threshold_amount",
          "currency",
          "interval",
          "notification_channel"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "SpendAlertNotificationChannel": {
        "description": "Email notification settings for a spend alert.",
        "properties": {
          "recipients": {
            "description": "Email addresses that receive the spend alert notification.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "subject_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional subject prefix for alert emails."
          },
          "type": {
            "description": "The notification channel type. Currently only `email` is supported.",
            "enum": [
              "email"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "recipients"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
