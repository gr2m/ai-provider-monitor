{
  "description": "Creates a new service account in the project. By default, this also returns an unredacted API key for the service account.",
  "operationId": "create-project-service-account",
  "parameters": [
    {
      "description": "The ID of the project.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ProjectServiceAccountCreateRequest"
        }
      }
    },
    "description": "The project service account create request payload.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectServiceAccountCreateResponse"
          }
        }
      },
      "description": "Project service account created successfully."
    },
    "201": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectServiceAccountCreateResponse"
          }
        }
      },
      "description": "Project service account created successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Error response when project is archived."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "A requested project, user, service account, or API key was not found."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Create project service account",
  "tags": [
    "Projects"
  ],
  "components": {
    "schemas": {
      "ProjectServiceAccountCreateRequest": {
        "properties": {
          "create_service_account_only": {
            "anyOf": [
              {
                "description": "Create the service account without default roles or an API key.",
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_in_seconds": {
            "anyOf": [
              {
                "maximum": 31536000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of seconds until the initial API key expires. If omitted or null, the key does not expire unless the effective organization or project policy requires an expiration. When a policy sets a maximum lifetime, this value must be provided and must not exceed that limit. A non-null value cannot be used when `create_service_account_only` is true."
          },
          "name": {
            "description": "The name of the service account being created.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ProjectServiceAccountCreateResponse": {
        "properties": {
          "api_key": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectServiceAccountApiKey"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "object": {
            "enum": [
              "organization.project.service_account"
            ],
            "type": "string"
          },
          "role": {
            "description": "Service accounts created with default project membership have role `member`. Accounts created with `create_service_account_only` have role `none`.\n",
            "enum": [
              "member",
              "none"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "role",
          "created_at",
          "api_key"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProjectServiceAccountApiKey": {
        "properties": {
          "created_at": {
            "format": "unixtime",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) when the API key expires, or null if it does not expire."
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `organization.project.service_account.api_key`",
            "enum": [
              "organization.project.service_account.api_key"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "object",
          "value",
          "name",
          "created_at",
          "id"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
