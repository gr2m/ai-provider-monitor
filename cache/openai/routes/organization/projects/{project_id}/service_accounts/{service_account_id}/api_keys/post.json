{
  "description": "Creates an API key for a service account in the project.",
  "operationId": "CreateanAPIkeyforaserviceaccount",
  "parameters": [
    {
      "description": "The ID of the project.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "description": "The ID of the project.",
        "type": "string"
      }
    },
    {
      "description": "The ID of the service account.",
      "in": "path",
      "name": "service_account_id",
      "required": true,
      "schema": {
        "description": "The ID of the service account.",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateProjectServiceAccountApiKeyBody"
        }
      }
    },
    "description": "The service account API key create request payload."
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ServiceAccountApiKeyBody"
          }
        }
      },
      "description": "Service account API key created successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The API key request is invalid or the project is archived."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The project or service account was not found."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Create an API key for a service account",
  "components": {
    "schemas": {
      "CreateProjectServiceAccountApiKeyBody": {
        "description": "The service account API key create request payload.",
        "properties": {
          "expires_in_seconds": {
            "anyOf": [
              {
                "description": "Number of seconds until the API key expires.",
                "maximum": 31536000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "description": "API key name.",
            "type": "string"
          },
          "scopes": {
            "description": "API key scopes.",
            "items": {
              "description": "API key scope.",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [],
        "type": "object"
      },
      "ServiceAccountApiKeyBody": {
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) when the API key was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) when the API key expires, or null if it does not expire.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "description": "The identifier of the API key.",
            "type": "string"
          },
          "name": {
            "description": "The name of the API key.",
            "type": "string"
          },
          "object": {
            "default": "organization.project.service_account.api_key",
            "description": "The object type, which is always `organization.project.service_account.api_key`",
            "enum": [
              "organization.project.service_account.api_key"
            ],
            "type": "string"
          },
          "value": {
            "description": "The unredacted API key value.",
            "type": "string"
          }
        },
        "required": [
          "object",
          "value",
          "name",
          "created_at",
          "id"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
