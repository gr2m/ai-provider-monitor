{
  "description": "Retrieve the configured default and enabled service tiers for a project.",
  "operationId": "Retrieveprojectservicetiersettings",
  "parameters": [
    {
      "description": "The ID of the project",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "description": "The ID of the project",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectServiceTierSettingsResource"
          }
        }
      },
      "description": "Success"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Retrieve project service tier settings",
  "components": {
    "schemas": {
      "ProjectServiceTierSettingsResource": {
        "properties": {
          "default": {
            "$ref": "#/components/schemas/ProjectDefaultServiceTier",
            "description": "Default tier for requests that omit service_tier or use auto."
          },
          "enabled_tiers": {
            "description": "Additional service tiers enabled for this project. \"all\" includes future tiers. An empty array allows only Standard. Organization policy and eligibility still apply.",
            "oneOf": [
              {
                "default": "all",
                "enum": [
                  "all"
                ],
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ProjectOptionalServiceTier"
                },
                "type": "array"
              }
            ]
          },
          "object": {
            "default": "project.service_tier_settings",
            "enum": [
              "project.service_tier_settings"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "default",
          "enabled_tiers"
        ],
        "type": "object"
      },
      "ProjectDefaultServiceTier": {
        "enum": [
          "standard",
          "fast",
          "scale"
        ],
        "type": "string"
      },
      "ProjectOptionalServiceTier": {
        "enum": [
          "flex",
          "fast",
          "ultrafast"
        ],
        "type": "string"
      }
    }
  }
}
