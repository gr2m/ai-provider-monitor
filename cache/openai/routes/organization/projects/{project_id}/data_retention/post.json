{
  "description": "Updates project data retention controls.",
  "operationId": "update-project-data-retention",
  "parameters": [
    {
      "description": "The ID of the project to update.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UpdateProjectDataRetentionBody"
        }
      }
    },
    "description": "The desired project data retention setting.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectDataRetention"
          }
        }
      },
      "description": "Project data retention controls updated successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The requested data retention setting or transition is invalid."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The organization or project was not found."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Update project data retention",
  "tags": [
    "Data retention"
  ],
  "components": {
    "schemas": {
      "UpdateProjectDataRetentionBody": {
        "description": "Parameters for updating project data retention controls.",
        "properties": {
          "retention_type": {
            "description": "The desired project data retention type.",
            "enum": [
              "organization_default",
              "none",
              "zero_data_retention",
              "modified_abuse_monitoring",
              "enhanced_zero_data_retention",
              "enhanced_modified_abuse_monitoring"
            ],
            "type": "string"
          }
        },
        "required": [
          "retention_type"
        ],
        "type": "object"
      },
      "ProjectDataRetention": {
        "description": "Represents a project's data retention control setting.",
        "properties": {
          "object": {
            "description": "The object type, which is always `project.data_retention`.",
            "enum": [
              "project.data_retention"
            ],
            "type": "string"
          },
          "type": {
            "description": "The configured project data retention type.",
            "enum": [
              "organization_default",
              "none",
              "zero_data_retention",
              "modified_abuse_monitoring",
              "enhanced_zero_data_retention",
              "enhanced_modified_abuse_monitoring"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "type"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
