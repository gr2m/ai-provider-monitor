{
  "operationId": "Deleteprojectspendlimit",
  "parameters": [
    {
      "description": "The ID of the project whose hard spend limit is being managed.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "example": "proj_123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectSpendLimitDeletedResource"
          }
        }
      },
      "description": "Hard spend limit deleted successfully."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Delete a project's hard spend limit.",
  "components": {
    "schemas": {
      "ProjectSpendLimitDeletedResource": {
        "description": "Confirmation payload returned after deleting a project hard spend limit.",
        "properties": {
          "deleted": {
            "description": "Whether the hard spend limit was deleted.",
            "type": "boolean"
          },
          "object": {
            "default": "project.spend_limit.deleted",
            "description": "The object type, which is always `project.spend_limit.deleted`.",
            "enum": [
              "project.spend_limit.deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "deleted"
        ],
        "type": "object"
      }
    }
  }
}
