{
  "description": "Create or replace a project's hard spend limit.",
  "operationId": "Updateprojectspendlimit",
  "parameters": [
    {
      "description": "The ID of the project whose hard spend limit is being managed.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "example": "proj_123",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UpdateProjectSpendLimitBody"
        }
      }
    },
    "description": "Parameters for the hard spend limit you want to create or replace.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProjectSpendLimitResource"
          }
        }
      },
      "description": "Hard spend limit created or replaced successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The requested spend limit is invalid or cannot be applied."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The project was not found."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Update project spend limit",
  "components": {
    "schemas": {
      "UpdateProjectSpendLimitBody": {
        "description": "Parameters for the hard spend limit you want to create or replace.",
        "properties": {
          "currency": {
            "description": "The currency for the threshold amount. Currently, only `USD` is supported.",
            "enum": [
              "USD"
            ],
            "type": "string"
          },
          "interval": {
            "description": "The time interval for evaluating spend against the threshold. Currently, only `month` is supported.",
            "enum": [
              "month"
            ],
            "type": "string"
          },
          "threshold_amount": {
            "description": "The hard spend limit amount, in cents.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "threshold_amount",
          "currency",
          "interval"
        ],
        "type": "object"
      },
      "ProjectSpendLimitResource": {
        "description": "Represents a hard spend limit configured at the project level.",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/SpendLimitCurrency",
            "description": "The currency for the threshold amount. Currently, only `USD` is supported."
          },
          "enforcement": {
            "$ref": "#/components/schemas/SpendLimitEnforcement",
            "description": "The current enforcement state of the hard spend limit."
          },
          "interval": {
            "$ref": "#/components/schemas/SpendLimitInterval",
            "description": "The time interval for evaluating spend against the threshold. Currently, only `month` is supported."
          },
          "object": {
            "default": "project.spend_limit",
            "description": "The object type, which is always `project.spend_limit`.",
            "enum": [
              "project.spend_limit"
            ],
            "type": "string"
          },
          "threshold_amount": {
            "description": "The hard spend limit amount, in cents.",
            "type": "integer"
          }
        },
        "required": [
          "object",
          "threshold_amount",
          "currency",
          "interval",
          "enforcement"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "SpendLimitCurrency": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "USD"
            ],
            "type": "string"
          }
        ]
      },
      "SpendLimitEnforcement": {
        "description": "The current enforcement state of a hard spend limit.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SpendLimitEnforcementStatus",
            "description": "Whether the hard spend limit is currently enforcing."
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SpendLimitInterval": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "month"
            ],
            "type": "string"
          }
        ]
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "SpendLimitEnforcementStatus": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "inactive",
              "enforcing"
            ],
            "type": "string"
          }
        ]
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
