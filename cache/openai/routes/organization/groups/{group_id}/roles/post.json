{
  "description": "Assigns an organization role to a group within the organization.",
  "operationId": "assign-group-role",
  "parameters": [
    {
      "description": "The ID of the group that should receive the organization role.",
      "in": "path",
      "name": "group_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/PublicAssignOrganizationGroupRoleBody"
        }
      }
    },
    "description": "Identifies the organization role to assign to the group.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/GroupRoleAssignment"
          }
        }
      },
      "description": "Organization role assigned to the group successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid or the requested operation cannot be performed."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The endpoint is unavailable or a requested resource was not found in this organization or project."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Assign organization role to group",
  "tags": [
    "Group organization role assignments"
  ],
  "components": {
    "schemas": {
      "PublicAssignOrganizationGroupRoleBody": {
        "description": "Request payload for assigning a role to a group or user.",
        "properties": {
          "role_id": {
            "description": "Identifier of the role to assign.",
            "type": "string"
          }
        },
        "required": [
          "role_id"
        ],
        "type": "object"
      },
      "GroupRoleAssignment": {
        "description": "Role assignment linking a group to a role.",
        "properties": {
          "group": {
            "$ref": "#/components/schemas/Group"
          },
          "object": {
            "description": "Always `group.role`.",
            "enum": [
              "group.role"
            ],
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "object",
          "group",
          "role"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Group": {
        "description": "Summary information about a group returned in role assignment responses.",
        "properties": {
          "created_at": {
            "description": "Unix timestamp (in seconds) when the group was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "Identifier for the group.",
            "type": "string"
          },
          "name": {
            "description": "Display name of the group.",
            "type": "string"
          },
          "object": {
            "description": "Always `group`.",
            "enum": [
              "group"
            ],
            "type": "string"
          },
          "scim_managed": {
            "description": "Whether the group is managed through SCIM.",
            "type": "boolean"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "created_at",
          "scim_managed"
        ],
        "type": "object"
      },
      "Role": {
        "description": "Details about a role that can be assigned through the public Roles API.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional description of the role."
          },
          "id": {
            "description": "Identifier for the role.",
            "type": "string"
          },
          "name": {
            "description": "Unique name for the role.",
            "type": "string"
          },
          "object": {
            "description": "Always `role`.",
            "enum": [
              "role"
            ],
            "type": "string"
          },
          "permissions": {
            "description": "Permissions granted by the role.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "predefined_role": {
            "description": "Whether the role is predefined and managed by OpenAI.",
            "type": "boolean"
          },
          "resource_type": {
            "description": "Resource type the role is bound to (for example `api.organization` or `api.project`).",
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "description",
          "permissions",
          "resource_type",
          "predefined_role"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
