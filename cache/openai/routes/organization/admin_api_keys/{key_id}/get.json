{
  "description": "Retrieve a single organization API key",
  "operationId": "admin-api-keys-get",
  "parameters": [
    {
      "in": "path",
      "name": "key_id",
      "required": true,
      "schema": {
        "description": "The ID of the API key.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AdminApiKey"
          }
        }
      },
      "description": "Details of the requested API key."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The API key was not found or is not available to this organization."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Retrieve admin API key",
  "components": {
    "schemas": {
      "AdminApiKey": {
        "description": "Represents an individual Admin API key in an org.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the API key was created",
            "example": 1711471533,
            "format": "unixtime",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) of when the API key expires",
                "example": 1714063533,
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "example": "key_abc",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "description": "The Unix timestamp (in seconds) of when the API key was last used",
                "example": 1711471534,
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the API key",
            "example": "Administration Key"
          },
          "object": {
            "description": "The object type, which is always `organization.admin_api_key`",
            "enum": [
              "organization.admin_api_key"
            ],
            "type": "string"
          },
          "owner": {
            "properties": {
              "created_at": {
                "description": "The Unix timestamp (in seconds) of when the user was created",
                "example": 1711471533,
                "format": "unixtime",
                "type": "integer"
              },
              "id": {
                "description": "The identifier, which can be referenced in API endpoints",
                "example": "sa_456",
                "type": "string"
              },
              "name": {
                "description": "The name of the user",
                "example": "My Service Account",
                "type": "string"
              },
              "object": {
                "description": "The object type, which is always organization.user",
                "example": "organization.user",
                "type": "string"
              },
              "role": {
                "description": "Always `owner`",
                "example": "owner",
                "type": "string"
              },
              "type": {
                "description": "Always `user`",
                "example": "user",
                "type": "string"
              }
            },
            "type": "object"
          },
          "redacted_value": {
            "description": "The redacted value of the API key",
            "example": "sk-admin...def",
            "type": "string"
          }
        },
        "required": [
          "object",
          "redacted_value",
          "created_at",
          "expires_at",
          "id",
          "owner"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
