{
  "description": "Get Decisions API usage details for the organization.",
  "operationId": "OrganizationDecisionsusage",
  "parameters": [
    {
      "description": "Start time (Unix seconds) of the query time range, inclusive.",
      "in": "query",
      "name": "start_time",
      "required": true,
      "schema": {
        "type": "integer"
      }
    },
    {
      "description": "End time (Unix seconds) of the query time range, exclusive.",
      "in": "query",
      "name": "end_time",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Width of each time bucket in response. Currently `1m`, `1h` and `1d` are supported, default to `1d`.",
      "in": "query",
      "name": "bucket_width",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Width of each time bucket in response. Currently `1m`, `1h` and `1d` are supported, default to `1d`.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/DecisionsUsageBucketWidth"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Specifies the number of buckets to return.\n- `bucket_width=1d`: default: 7, max: 31\n- `bucket_width=1h`: default: 24, max: 168\n- `bucket_width=1m`: default: 60, max: 1440",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "A cursor for use in pagination. Corresponding to the `next_page` field from the previous response.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "A cursor for use in pagination. Corresponding to the `next_page` field from the previous response.",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Return only usage for these projects.",
      "in": "query",
      "name": "project_ids",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Return only usage for these projects.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Group the usage data by the specified fields. Support fields include `project_id`, `user_id`, `api_key_id`, `model`, `batch`, `service_tier`, `api_source` or any combination of them. When grouped by `api_source`, results use `agents_api` for attributed Agents API activity and `unlabeled` for all other activity. Without source grouping, `api_source` is null.",
      "in": "query",
      "name": "group_by",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Group the usage data by the specified fields. Support fields include `project_id`, `user_id`, `api_key_id`, `model`, `batch`, `service_tier`, `api_source` or any combination of them. When grouped by `api_source`, results use `agents_api` for attributed Agents API activity and `unlabeled` for all other activity. Without source grouping, `api_source` is null.",
            "oneOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DecisionsUsageGroupBy"
                },
                "type": "array"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Return only usage for these users.",
      "in": "query",
      "name": "user_ids",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Return only usage for these users.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Return only usage for these API keys.",
      "in": "query",
      "name": "api_key_ids",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Return only usage for these API keys.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Return only usage for these models.",
      "in": "query",
      "name": "models",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Return only usage for these models.",
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "If `true`, return batch jobs only. If `false`, return non-batch jobs only. By default, return both.",
      "in": "query",
      "name": "batch",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PublicDecisionsUsageResponseResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DecisionsUsageErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid or the requested operation cannot be performed."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DecisionsUsagePermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Decisions",
  "components": {
    "schemas": {
      "DecisionsUsageBucketWidth": {
        "enum": [
          "1m",
          "1h",
          "1d"
        ],
        "type": "string"
      },
      "DecisionsUsageGroupBy": {
        "enum": [
          "project_id",
          "user_id",
          "api_key_id",
          "model",
          "batch",
          "service_tier",
          "api_source"
        ],
        "type": "string"
      },
      "PublicDecisionsUsageResponseResource": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DecisionsUsageBucket"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "default": "page",
            "enum": [
              "page"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "has_more",
          "next_page",
          "data"
        ],
        "type": "object"
      },
      "DecisionsUsageErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/DecisionsUsageErrorDetails"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "DecisionsUsagePermissionErrorResponse": {
        "properties": {
          "error": {
            "description": "Details about the permission error.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/DecisionsUsageErrorDetails"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "DecisionsUsageBucket": {
        "properties": {
          "end_time": {
            "type": "integer"
          },
          "object": {
            "default": "bucket",
            "enum": [
              "bucket"
            ],
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/DecisionsUsageResult"
            },
            "type": "array"
          },
          "start_time": {
            "type": "integer"
          }
        },
        "required": [
          "object",
          "start_time",
          "end_time",
          "results"
        ],
        "type": "object"
      },
      "DecisionsUsageErrorDetails": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "param",
          "type"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "DecisionsUsageResult": {
        "description": "The aggregated Decisions API usage details of the specific time bucket.",
        "properties": {
          "api_key_id": {
            "anyOf": [
              {
                "description": "When `group_by=api_key_id`, this field provides the API key ID of the grouped usage result.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "api_source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionsUsageApiSource",
                "description": "When grouped by `api_source`, `agents_api` identifies attributed Agents API activity and `unlabeled` includes all records without published source attribution, including historical and unknown origins. Unlabeled does not imply direct API usage. Without source grouping, this field is null."
              },
              {
                "type": "null"
              }
            ]
          },
          "batch": {
            "anyOf": [
              {
                "description": "When `group_by=batch`, this field tells whether the grouped usage result is batch or not.",
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_audio_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of uncached audio input tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cache_write_12h_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of input tokens written to the cache with a 12-hour retention period.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cache_write_30m_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of input tokens written to the cache with a 30-minute retention period.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cache_write_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of input tokens written to the cache across 30-minute and 12-hour retention periods.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cached_audio_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of cached audio input tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cached_image_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of cached image input tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cached_text_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of cached text input tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_cached_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of cached input tokens used across text, audio, and image inputs. For customers subscribed to Scale Tier, this includes Scale Tier tokens.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_image_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of uncached image input tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_text_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of uncached text input tokens used, excluding cache-write tokens.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_tokens": {
            "description": "The aggregated number of input tokens used, including cached and cache-write tokens. This includes text, audio, and image tokens. For customers subscribed to Scale Tier, this includes Scale Tier tokens.",
            "type": "integer"
          },
          "input_uncached_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of uncached input tokens used across text, audio, and image inputs, excluding cache-write tokens.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "description": "When `group_by=model`, this field provides the model name of the grouped usage result.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "num_model_requests": {
            "description": "The count of requests made to the model.",
            "type": "integer"
          },
          "object": {
            "default": "organization.usage.decisions.result",
            "enum": [
              "organization.usage.decisions.result"
            ],
            "type": "string"
          },
          "output_audio_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of audio output tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_image_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of image output tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_text_tokens": {
            "anyOf": [
              {
                "description": "The aggregated number of text output tokens used.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "description": "The aggregated number of output tokens used across text, audio, and image outputs. For customers subscribed to Scale Tier, this includes Scale Tier tokens.",
            "type": "integer"
          },
          "project_id": {
            "anyOf": [
              {
                "description": "When `group_by=project_id`, this field provides the project ID of the grouped usage result.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "service_tier": {
            "anyOf": [
              {
                "description": "When `group_by=service_tier`, this field provides the service tier of the grouped usage result.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_id": {
            "anyOf": [
              {
                "description": "When `group_by=user_id`, this field provides the user ID of the grouped usage result.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "object",
          "input_tokens",
          "output_tokens",
          "num_model_requests"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "DecisionsUsageApiSource": {
        "enum": [
          "agents_api",
          "unlabeled"
        ],
        "type": "string"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
