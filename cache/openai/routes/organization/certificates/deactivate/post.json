{
  "description": "Deactivate certificates at the organization level.\n\nYou can atomically and idempotently deactivate up to 10 certificates at a time.\n",
  "operationId": "deactivateOrganizationCertificates",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/ToggleCertificatesRequest"
        }
      }
    },
    "description": "The certificate deactivation payload.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/OrganizationCertificateDeactivationResponse"
          }
        }
      },
      "description": "Certificates deactivated successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid or the requested operation cannot be performed."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "A certificate was not found in this organization."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The certificate update could not be completed because of a server error."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Deactivate certificates for organization",
  "tags": [
    "Certificates"
  ],
  "components": {
    "schemas": {
      "ToggleCertificatesRequest": {
        "properties": {
          "certificate_ids": {
            "items": {
              "example": "cert_abc",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "certificate_ids"
        ],
        "type": "object"
      },
      "OrganizationCertificateDeactivationResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/OrganizationCertificate"
            },
            "type": "array"
          },
          "object": {
            "description": "The organization certificate deactivation result type.",
            "enum": [
              "organization.certificate.deactivation"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "OrganizationCertificate": {
        "description": "Represents an individual certificate configured at the organization level.",
        "properties": {
          "active": {
            "description": "Whether the certificate is currently active at the organization level.",
            "type": "boolean"
          },
          "certificate_details": {
            "properties": {
              "expires_at": {
                "description": "The Unix timestamp (in seconds) of when the certificate expires.",
                "format": "unixtime",
                "type": "integer"
              },
              "valid_at": {
                "description": "The Unix timestamp (in seconds) of when the certificate becomes valid.",
                "format": "unixtime",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "created_at": {
            "description": "The Unix timestamp (in seconds) of when the certificate was uploaded.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the certificate."
          },
          "object": {
            "description": "The object type, which is always `organization.certificate`.",
            "enum": [
              "organization.certificate"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "created_at",
          "certificate_details",
          "active"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
