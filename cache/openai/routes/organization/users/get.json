{
  "description": "Lists all of the users in the organization.",
  "operationId": "list-users",
  "parameters": [
    {
      "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 20.\n",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    },
    {
      "description": "A cursor for use in pagination. `after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list.\n",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "Filter by the email address of users.",
      "in": "query",
      "name": "emails",
      "required": false,
      "schema": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/UserListResponse"
          }
        }
      },
      "description": "Users listed successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The user listing parameters are invalid."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Too many management requests. Reduce the request rate and try again later."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "List users",
  "tags": [
    "Users"
  ],
  "components": {
    "schemas": {
      "UserListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "User": {
        "description": "Represents an individual `user` within an organization.",
        "properties": {
          "added_at": {
            "description": "The Unix timestamp (in seconds) of when the user was added.",
            "format": "unixtime",
            "type": "integer"
          },
          "api_key_last_used_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) of the user's last API key usage."
          },
          "created": {
            "description": "The Unix timestamp (in seconds) of when the user was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "developer_persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The developer persona metadata for the user."
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The email address of the user"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "is_default": {
            "description": "Whether this is the organization's default user.",
            "type": "boolean"
          },
          "is_scale_tier_authorized_purchaser": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the user is an authorized purchaser for Scale Tier."
          },
          "is_scim_managed": {
            "description": "Whether the user is managed through SCIM.",
            "type": "boolean"
          },
          "is_service_account": {
            "description": "Whether the user is a service account.",
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the user"
          },
          "object": {
            "description": "The object type, which is always `organization.user`",
            "enum": [
              "organization.user"
            ],
            "type": "string"
          },
          "projects": {
            "anyOf": [
              {
                "properties": {
                  "data": {
                    "items": {
                      "properties": {
                        "id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "name": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "role": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "object": {
                    "enum": [
                      "list"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "object",
                  "data"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Projects associated with the user, if included."
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`owner` or `reader`"
          },
          "technical_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The technical level metadata for the user."
          },
          "user": {
            "description": "Nested user details.",
            "properties": {
              "banned": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "banned_at": {
                "anyOf": [
                  {
                    "format": "unixtime",
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "enabled": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "object": {
                "enum": [
                  "user"
                ],
                "type": "string"
              },
              "picture": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "object",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "object",
          "id",
          "added_at"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
