{
  "operationId": "Getorganizationspendlimit",
  "parameters": [],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/OrganizationSpendLimitResource"
          }
        }
      },
      "description": "Hard spend limit retrieved successfully."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Get the organization's hard spend limit.",
  "components": {
    "schemas": {
      "OrganizationSpendLimitResource": {
        "description": "Represents a hard spend limit configured at the organization level.",
        "properties": {
          "currency": {
            "$ref": "#/components/schemas/SpendLimitCurrency",
            "description": "The currency for the threshold amount. Currently, only `USD` is supported."
          },
          "enforcement": {
            "$ref": "#/components/schemas/SpendLimitEnforcement",
            "description": "The current enforcement state of the hard spend limit."
          },
          "interval": {
            "$ref": "#/components/schemas/SpendLimitInterval",
            "description": "The time interval for evaluating spend against the threshold. Currently, only `month` is supported."
          },
          "object": {
            "default": "organization.spend_limit",
            "description": "The object type, which is always `organization.spend_limit`.",
            "enum": [
              "organization.spend_limit"
            ],
            "type": "string"
          },
          "threshold_amount": {
            "description": "The hard spend limit amount, in cents.",
            "type": "integer"
          }
        },
        "required": [
          "object",
          "threshold_amount",
          "currency",
          "interval",
          "enforcement"
        ],
        "type": "object"
      },
      "SpendLimitCurrency": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "USD"
            ],
            "type": "string"
          }
        ]
      },
      "SpendLimitEnforcement": {
        "description": "The current enforcement state of a hard spend limit.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SpendLimitEnforcementStatus",
            "description": "Whether the hard spend limit is currently enforcing."
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "SpendLimitInterval": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "month"
            ],
            "type": "string"
          }
        ]
      },
      "SpendLimitEnforcementStatus": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "inactive",
              "enforcing"
            ],
            "type": "string"
          }
        ]
      }
    }
  }
}
