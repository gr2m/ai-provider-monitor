{
  "description": "Disconnect a customer-managed external storage configuration. Removing the project's last configuration restores organization-default retention if customer-managed retention was active. Repeating a deletion also completes any interrupted retention update. Cloud storage is unchanged.",
  "operationId": "Deleteanexternalstorageconfiguration",
  "parameters": [
    {
      "in": "path",
      "name": "external_storage_id",
      "required": true,
      "schema": {
        "example": "extstorage_123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ExternalStorageDeletedResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The organization is not enabled for external storage."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The organization or external storage was not found."
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Delete an external storage configuration",
  "components": {
    "schemas": {
      "ExternalStorageDeletedResource": {
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "object": {
            "default": "organization.external_storage.deleted",
            "enum": [
              "organization.external_storage.deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "deleted"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
