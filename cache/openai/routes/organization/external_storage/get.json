{
  "description": "List the organization's customer-managed external storage configurations.",
  "operationId": "Listexternalstorageconfigurations",
  "parameters": [
    {
      "in": "query",
      "name": "project_id",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "example": "proj_123",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "description": "Return external storage configurations after this ID.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "description": "Return external storage configurations after this ID.",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ExternalStorageOrder"
      }
    },
    {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
