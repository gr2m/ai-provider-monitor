{
  "description": "Add an external key config for an organization",
  "operationId": "Addanexternalkeyconfigforanorganization",
  "parameters": [],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/V1OrganizationExternalKeysPostRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ExternalKeyResource"
          }
        }
      },
      "description": "Success"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Add an external key config for an organization",
  "components": {
    "schemas": {
      "V1OrganizationExternalKeysPostRequest": {
        "discriminator": {
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/AwsExternalKeyParams"
          },
          {
            "$ref": "#/components/schemas/GcpExternalKeyParams"
          },
          {
            "$ref": "#/components/schemas/AzureExternalKeyParams"
          }
        ]
      },
      "ExternalKeyResource": {
        "properties": {
          "api_project_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "audience": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "external_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key_name": {
            "type": "string"
          },
          "key_version": {
            "type": "string"
          },
          "kms_arn": {
            "type": "string"
          },
          "kms_key_location": {
            "type": "string"
          },
          "kms_key_name": {
            "type": "string"
          },
          "kms_key_ring_name": {
            "type": "string"
          },
          "kms_key_version": {
            "type": "string"
          },
          "kms_project_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExternalKeyPurpose"
          },
          "role_arn": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "vault_uri": {
            "type": "string"
          },
          "workload_identity_pool_id": {
            "type": "string"
          },
          "workload_identity_project_number": {
            "type": "string"
          },
          "workload_identity_provider_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "type",
          "name",
          "api_project_ids",
          "workspace_id",
          "created_at"
        ],
        "type": "object"
      },
      "AwsExternalKeyParams": {
        "properties": {
          "external_id": {
            "description": "The ExternalID that OpenAI will pass in the AssumeRole call for the customer's AWS account. This must be the OpenAI organization ID or an API project ID that belongs to the organization.",
            "type": "string"
          },
          "kms_arn": {
            "description": "The Key Management System ARN for the master key you manage",
            "type": "string"
          },
          "name": {
            "description": "A friendly name to identify this config",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExternalKeyPurpose"
          },
          "role_arn": {
            "description": "The Role ARN that OpenAI will assume to call your KMS",
            "pattern": "^arn:aws:iam::\\d{12}:role/.+$",
            "type": "string"
          },
          "type": {
            "default": "aws",
            "enum": [
              "aws"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "role_arn",
          "kms_arn",
          "external_id"
        ],
        "type": "object"
      },
      "GcpExternalKeyParams": {
        "properties": {
          "audience": {
            "description": "The aud field in the identity token OpenAI will pass in the call to the customer's GCP STS. This must be the OpenAI organization ID or an API project ID that belongs to the organization.",
            "type": "string"
          },
          "kms_key_location": {
            "description": "The region where your Key Management System master key is located",
            "type": "string"
          },
          "kms_key_name": {
            "description": "The name of the Key Management System master key you manage",
            "type": "string"
          },
          "kms_key_ring_name": {
            "description": "The Key Management System key ring for the master key you manage",
            "type": "string"
          },
          "kms_key_version": {
            "description": "An exact CryptoKeyVersion number. Required for PSP decryption; not accepted for EKM.",
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "kms_project_id": {
            "description": "The string GCP project name where your KMS resides",
            "type": "string"
          },
          "name": {
            "description": "A friendly name to identify this config",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExternalKeyPurpose"
          },
          "type": {
            "default": "gcp",
            "enum": [
              "gcp"
            ],
            "type": "string"
          },
          "workload_identity_pool_id": {
            "description": "The pool containing the Workload Identity provider that you registered for OpenAI",
            "type": "string"
          },
          "workload_identity_project_number": {
            "description": "The numeric GCP project number where you registered OpenAI's workload identity",
            "pattern": "^[0-9]{1,19}$",
            "type": "string"
          },
          "workload_identity_provider_id": {
            "description": "The Workload Identity provider that you registered for OpenAI",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "workload_identity_project_number",
          "workload_identity_pool_id",
          "workload_identity_provider_id",
          "kms_project_id",
          "kms_key_ring_name",
          "kms_key_name",
          "kms_key_location",
          "audience"
        ],
        "type": "object"
      },
      "AzureExternalKeyParams": {
        "properties": {
          "key_name": {
            "description": "The name of the Azure Key Vault master key that you manage",
            "maxLength": 127,
            "pattern": "^org-[0-9a-zA-Z-]*--[0-9a-zA-Z-]*$",
            "type": "string"
          },
          "key_version": {
            "description": "An exact Azure Key Vault key version. Required for PSP decryption; not accepted for EKM.",
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "name": {
            "description": "A friendly name to identify this config",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExternalKeyPurpose"
          },
          "tenant_id": {
            "description": "Your Azure tenant UUID",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "type": {
            "default": "azure",
            "enum": [
              "azure"
            ],
            "type": "string"
          },
          "vault_uri": {
            "description": "The URI of the Azure vault containing the master key you manage",
            "pattern": "^https://.+\\.vault\\.azure\\.net/?$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "tenant_id",
          "vault_uri",
          "key_name"
        ],
        "type": "object"
      },
      "ExternalKeyPurpose": {
        "enum": [
          "ekm",
          "psp_decryption"
        ],
        "type": "string"
      }
    }
  }
}
