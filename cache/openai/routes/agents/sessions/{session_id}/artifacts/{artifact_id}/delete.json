{
  "description": "Deletes an immutable session artifact without deleting its live environment file or original Files API object. See [session artifacts](https://developers.openai.com/api/docs/guides/agents-api/environments/files#openai-hosted-artifacts).",
  "operationId": "deleteAgentSessionArtifact",
  "parameters": [
    {
      "description": "The ID of the session that owns the artifact.",
      "in": "path",
      "name": "session_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "The immutable session artifact ID.",
      "in": "path",
      "name": "artifact_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeletedSessionArtifactResource"
          }
        }
      },
      "description": "The deleted session artifact."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested session or event was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current session state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Delete an agent session artifact",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "DeletedSessionArtifactResource": {
        "additionalProperties": false,
        "description": "Confirmation that an immutable session artifact was deleted.",
        "properties": {
          "deleted": {
            "description": "Whether the session artifact was deleted. Always `true`.",
            "type": "boolean"
          },
          "id": {
            "description": "The ID of the deleted session artifact.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "agent.session.artifact.deleted",
            "description": "The object type. Always `agent.session.artifact.deleted`.",
            "enum": [
              "agent.session.artifact.deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "deleted"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
