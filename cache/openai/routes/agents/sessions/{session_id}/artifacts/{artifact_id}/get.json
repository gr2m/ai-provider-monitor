{
  "description": "Retrieves immutable metadata for one durable session artifact. See [session artifacts](https://developers.openai.com/api/docs/guides/agents-api/environments/files#openai-hosted-artifacts).",
  "operationId": "retrieveAgentSessionArtifact",
  "parameters": [
    {
      "description": "The ID of the session that owns the artifact.",
      "in": "path",
      "name": "session_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "The immutable session artifact ID.",
      "in": "path",
      "name": "artifact_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SessionArtifactResource"
          }
        }
      },
      "description": "The requested session artifact."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested session or event was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current session state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Retrieve an agent session artifact",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "SessionArtifactResource": {
        "additionalProperties": false,
        "description": "An immutable file published by a completed hosted session turn.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the artifact was published.",
            "format": "int64",
            "type": "integer"
          },
          "environment_id": {
            "description": "The ID of the environment that produced the artifact.",
            "minLength": 0,
            "type": "string"
          },
          "id": {
            "description": "The immutable artifact ID.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "agent.session.artifact",
            "description": "The object type. Always `agent.session.artifact`.",
            "enum": [
              "agent.session.artifact"
            ],
            "type": "string"
          },
          "path": {
            "description": "The original absolute file path in the execution environment.",
            "minLength": 0,
            "type": "string"
          },
          "session_id": {
            "description": "The ID of the session that owns the artifact.",
            "minLength": 0,
            "type": "string"
          },
          "size_bytes": {
            "description": "The immutable artifact size in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "turn_id": {
            "description": "The ID of the completed turn that published the artifact.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "session_id",
          "environment_id",
          "turn_id",
          "path",
          "size_bytes",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
