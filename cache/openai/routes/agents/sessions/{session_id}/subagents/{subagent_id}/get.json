{
  "description": "Retrieves a subagent belonging to this session. See [subagent workflows](https://developers.openai.com/api/docs/guides/agents-api/multi-agent).",
  "operationId": "retrieveAgentSessionSubagent",
  "parameters": [
    {
      "description": "The ID of the session.",
      "in": "path",
      "name": "session_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "The ID of the subagent in this session.",
      "in": "path",
      "name": "subagent_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SubagentResource"
          }
        }
      },
      "description": "The requested subagent."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested session or event was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current session state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Retrieve a session subagent",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "SubagentResource": {
        "additionalProperties": false,
        "description": "A subagent created within a session.",
        "properties": {
          "closed_at": {
            "description": "The Unix timestamp, in seconds, when the subagent was closed. Null while active, including after resume.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "description": "The ID of the subagent.",
            "minLength": 0,
            "type": "string"
          },
          "instructions": {
            "description": "Initial task content, or null when unavailable. Text may contain placeholders for images or audio when only a preview is available.",
            "items": {
              "$ref": "#/components/schemas/AgentContentResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": [
              "array",
              "null"
            ]
          },
          "name": {
            "description": "The runner-assigned nickname, or null when unavailable.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "$ref": "#/components/schemas/SubagentObjectResource",
            "description": "The object type. Always `agent.session.subagent`."
          },
          "opened_at": {
            "description": "The Unix timestamp, in seconds, when the subagent was first opened. Resuming does not change it.",
            "format": "int64",
            "type": "integer"
          },
          "parent_agent_id": {
            "description": "The ID of the agent that created this subagent.",
            "minLength": 0,
            "type": "string"
          },
          "session_id": {
            "description": "The ID of the session that owns the subagent.",
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SubagentStatusResource",
            "description": "The current status of the subagent."
          }
        },
        "required": [
          "id",
          "object",
          "session_id",
          "name",
          "instructions",
          "parent_agent_id",
          "status",
          "opened_at",
          "closed_at"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AgentContentResource": {
        "description": "A plaintext or encrypted content part exchanged between agents.",
        "discriminator": {
          "mapping": {
            "encrypted_content": "#/components/schemas/EncryptedContentResource",
            "output_text": "#/components/schemas/OutputTextResource"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/OutputTextResource"
          },
          {
            "$ref": "#/components/schemas/EncryptedContentResource"
          }
        ]
      },
      "SubagentObjectResource": {
        "default": "agent.session.subagent",
        "description": "The object type for a subagent.",
        "enum": [
          "agent.session.subagent"
        ],
        "type": "string"
      },
      "SubagentStatusResource": {
        "description": "The current status of a subagent.",
        "enum": [
          "active",
          "closed"
        ],
        "type": "string"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      },
      "OutputTextResource": {
        "additionalProperties": false,
        "description": "A text content part produced by the agent.",
        "properties": {
          "text": {
            "description": "The text produced by the agent.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "output_text",
            "description": "The content type. Always `output_text`.",
            "enum": [
              "output_text"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "type": "object"
      },
      "EncryptedContentResource": {
        "additionalProperties": false,
        "description": "Encrypted content exchanged between agents.",
        "properties": {
          "encrypted_content": {
            "description": "The encrypted content payload.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "encrypted_content",
            "description": "The content type. Always `encrypted_content`.",
            "enum": [
              "encrypted_content"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "encrypted_content"
        ],
        "type": "object"
      }
    }
  }
}
