            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "SessionTurnTraceResource": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "description": "The Unix timestamp in seconds when the root turn was created.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The root turn ID. Use this ID as the pagination anchor.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "agent.session.trace",
            "description": "The object type, which is always `agent.session.trace`.",
            "enum": [
              "agent.session.trace"
