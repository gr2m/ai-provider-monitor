{
  "description": "Lists published root-turn traces as OTLP JSON, ordered by turn creation time and ID. Unpublished traces are skipped. Each page returns data available when read; it does not wait for late traces. Trace reads and the JSON response are limited to 16 MiB per request. If the limit is exceeded, request fewer traces.",
  "operationId": "listAgentSessionTraces",
  "parameters": [
    {
      "description": "The ID of the session.",
      "in": "path",
      "name": "session_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "The maximum number of resources to return, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "format": "int64",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "The order in which resources are returned. Defaults to `desc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ListOrderParam",
        "default": "desc"
      }
    },
    {
      "description": "Return resources after this resource ID in the selected order.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
