            "description": "The session that owns this trace.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "session_id",
          "created_at",
          "otlp"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
