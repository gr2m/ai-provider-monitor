{
  "description": "Lists reusable agents in the current project. See [agent configuration](https://developers.openai.com/api/docs/guides/agents-api/configuration).",
  "operationId": "listAgents",
  "parameters": [
    {
      "description": "The maximum number of resources to return, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "format": "int64",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "The order in which resources are returned. Defaults to `desc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ListOrderParam",
        "default": "desc"
      }
    },
    {
      "description": "Return resources after this resource ID in the selected order.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AgentListResource",
            "description": "A page of reusable agents."
          }
        }
      },
      "description": "A page of agents."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested session or event was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current session state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "List agents",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "ListOrderParam": {
        "description": "The order in which paginated resources are returned.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "AgentListResource": {
        "additionalProperties": false,
        "description": "A page of Agents API resources, with IDs for retrieving additional pages.",
        "properties": {
          "data": {
            "description": "The resources returned in this page, in the requested sort order.",
            "items": {
              "$ref": "#/components/schemas/AgentResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "first_id": {
            "description": "The ID of the first resource in `data`, or `null` if the page is empty.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "description": "Whether there are more resources to retrieve after this page.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The ID of the last resource in `data`, or `null` if the page is empty. Pass this as `after` with the same order and filters.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "list",
            "description": "The object type, which is always `list`.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "AgentResource": {
        "additionalProperties": false,
        "description": "A reusable agent scoped to the caller's project.",
        "properties": {
          "compaction": {
            "$ref": "#/components/schemas/CompactionResource",
            "description": "The effective context compaction settings."
          },
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the agent was created.",
            "format": "int64",
            "type": "integer"
          },
          "experimental": {
            "$ref": "#/components/schemas/ExperimentalConfigResource",
            "description": "The effective experimental settings for the agent."
          },
          "id": {
            "description": "The ID of the reusable agent.",
            "minLength": 0,
            "type": "string"
          },
          "instructions": {
            "description": "Custom instructions appended to the agent's default base instructions.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "additionalProperties": {
              "minLength": 0,
              "type": "string"
            },
            "description": "Custom string key-value pairs attached to the agent.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "model": {
            "description": "The requested model name used for inference.",
            "minLength": 0,
            "type": "string"
          },
          "multi_agent": {
            "$ref": "#/components/schemas/MultiAgentConfigResource",
            "description": "The resolved configuration for creating and coordinating subagents."
          },
          "name": {
            "description": "A human-readable name for the agent, or null if it is unnamed.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "agent",
            "description": "The object type. Always `agent`.",
            "enum": [
              "agent"
            ],
            "type": "string"
          },
          "reasoning": {
            "$ref": "#/components/schemas/ReasoningResource",
            "description": "The resolved reasoning configuration, including the model default for an omitted effort."
          },
          "service_tier": {
            "$ref": "#/components/schemas/ServiceTierResource",
            "description": "The resolved service-tier policy used for model requests."
          },
          "text": {
            "$ref": "#/components/schemas/TextResource",
            "description": "The resolved configuration for text generated by the agent."
          },
          "tools": {
            "description": "Tools available to the agent.",
            "items": {
              "$ref": "#/components/schemas/PersistedAgentToolResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "updated_at": {
            "description": "The Unix timestamp, in seconds, when the agent was last updated.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "updated_at",
          "name",
          "metadata",
          "model",
          "reasoning",
          "text",
          "service_tier",
          "instructions",
          "tools",
          "multi_agent"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      },
      "CompactionResource": {
        "additionalProperties": false,
        "description": "The effective settings for compacting the agent's context.",
        "properties": {
          "async": {
            "description": "Whether context is compacted in the background. Defaults to false.",
            "type": "boolean"
          }
        },
        "required": [
          "async"
        ],
        "type": "object"
      },
      "ExperimentalConfigResource": {
        "additionalProperties": false,
        "description": "The effective experimental settings for an agent.",
        "properties": {
          "time_awareness": {
            "description": "Whether the model receives periodic current-time reminders.",
            "type": "boolean"
          }
        },
        "required": [
          "time_awareness"
        ],
        "type": "object"
      },
      "MultiAgentConfigResource": {
        "additionalProperties": false,
        "description": "The resolved configuration for creating and coordinating subagents.",
        "properties": {
          "enabled": {
            "description": "Whether subagent tools are enabled. Defaults to false.",
            "type": "boolean"
          },
          "max_concurrent_subagents": {
            "description": "Maximum number of subagents that may run concurrently, or null when disabled. Defaults to 6 when enabled.",
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "enabled",
          "max_concurrent_subagents"
        ],
        "type": "object"
      },
      "ReasoningResource": {
        "additionalProperties": false,
        "description": "The reasoning configuration used by an agent.",
        "properties": {
          "effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasoningEffortResource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The requested reasoning effort, or `null` when the model selects its own default."
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasoningSummaryResource"
              },
              {
                "type": "null"
              }
            ],
            "description": "The requested reasoning summary format, or `null` when summaries are disabled."
          }
        },
        "required": [
          "effort",
          "summary"
        ],
        "type": "object"
      },
      "ServiceTierResource": {
        "description": "The service-tier policy configured for an agent.",
        "enum": [
          "auto",
          "default",
          "flex",
          "priority",
          "fast",
          "ultrafast"
        ],
        "type": "string"
      },
      "TextResource": {
        "additionalProperties": false,
        "description": "The text configuration used by an agent.",
        "properties": {
          "format": {
            "$ref": "#/components/schemas/TextFormatResource",
            "description": "The effective output format. Defaults to ordinary text."
          },
          "verbosity": {
            "$ref": "#/components/schemas/VerbosityResource",
            "description": "The amount of text produced by the agent. Defaults to `medium`."
          }
        },
        "required": [
          "format",
          "verbosity"
        ],
        "type": "object"
      },
      "PersistedAgentToolResource": {
        "description": "A credential-free tool available to a reusable agent.",
        "discriminator": {
          "mapping": {
            "automations": "#/components/schemas/PersistedAgentToolResourceAutomations",
            "computer_use": "#/components/schemas/PersistedAgentToolResourceComputerUse",
            "function": "#/components/schemas/PersistedAgentToolResourceFunction",
            "mcp": "#/components/schemas/PersistedAgentToolResourceMcp",
            "programmatic_tool_calling": "#/components/schemas/PersistedAgentToolResourceProgrammaticToolCalling",
            "tool_search": "#/components/schemas/PersistedAgentToolResourceToolSearch",
            "web_search": "#/components/schemas/PersistedAgentToolResourceWebSearch"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceFunction"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceToolSearch"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceProgrammaticToolCalling"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceMcp"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceWebSearch"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceComputerUse"
          },
          {
            "$ref": "#/components/schemas/PersistedAgentToolResourceAutomations"
          }
        ]
      },
      "ReasoningEffortResource": {
        "description": "The amount of reasoning effort used by an agent.",
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "type": "string"
      },
      "ReasoningSummaryResource": {
        "description": "The reasoning summary format requested from an agent.",
        "enum": [
          "concise",
          "detailed",
          "auto"
        ],
        "type": "string"
      },
      "TextFormatResource": {
        "description": "The effective output format for generated text.",
        "discriminator": {
          "mapping": {
            "json_schema": "#/components/schemas/TextFormatResourceJsonSchema",
            "text": "#/components/schemas/TextFormatResourceText"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextFormatResourceText"
          },
          {
            "$ref": "#/components/schemas/TextFormatResourceJsonSchema"
          }
        ]
      },
      "VerbosityResource": {
        "description": "The amount of text produced by an agent.",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "type": "string"
      },
      "PersistedAgentToolResourceFunction": {
        "additionalProperties": false,
        "description": "A function defined by the application.",
        "properties": {
          "async": {
            "description": "Whether the agent continues without waiting for the function result.",
            "type": "boolean"
          },
          "defer_loading": {
            "description": "Whether the function is deferred and discovered through tool search.",
            "type": "boolean"
          },
          "description": {
            "description": "A description of what the function does.",
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "description": "The name of the function.",
            "minLength": 0,
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {},
            "description": "A JSON Schema object describing the function's arguments.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "type": {
            "default": "function",
            "description": "The type of the object. Always `function`.",
            "enum": [
              "function"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "description",
          "parameters",
          "defer_loading"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceToolSearch": {
        "additionalProperties": false,
        "description": "Discovers deferred function tools and loads them into the model context.",
        "properties": {
          "type": {
            "default": "tool_search",
            "description": "The type of the object. Always `tool_search`.",
            "enum": [
              "tool_search"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceProgrammaticToolCalling": {
        "additionalProperties": false,
        "description": "Enables calling tools from model-generated code.",
        "properties": {
          "enabled": {
            "description": "Whether tools can be called from model-generated code.",
            "type": "boolean"
          },
          "type": {
            "default": "programmatic_tool_calling",
            "description": "The type of the object. Always `programmatic_tool_calling`.",
            "enum": [
              "programmatic_tool_calling"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "enabled"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceMcp": {
        "additionalProperties": false,
        "description": "Tools provided by a remote MCP server without stored credentials.",
        "properties": {
          "allowed_tools": {
            "description": "The MCP tools the agent may call, or null when all server tools are allowed.",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": [
              "array",
              "null"
            ]
          },
          "connection_origin": {
            "$ref": "#/components/schemas/McpConnectionOriginResource",
            "description": "Where outbound MCP HTTP connections originate."
          },
          "credential_id": {
            "description": "The vault credential selected for this MCP server, if any.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "request_metadata": {
            "additionalProperties": {},
            "description": "Metadata included with requests to this MCP server.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "required": {
            "description": "Whether this MCP server must initialize before the first turn.",
            "type": "boolean"
          },
          "server_label": {
            "description": "A label used to identify the MCP server in tool calls.",
            "minLength": 0,
            "type": "string"
          },
          "transport": {
            "$ref": "#/components/schemas/PersistedMcpTransportResource",
            "description": "The credential-free transport used to connect to the MCP server."
          },
          "type": {
            "default": "mcp",
            "description": "The type of the object. Always `mcp`.",
            "enum": [
              "mcp"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "server_label",
          "credential_id",
          "transport",
          "request_metadata",
          "allowed_tools",
          "required",
          "connection_origin"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceWebSearch": {
        "additionalProperties": false,
        "description": "Web search.",
        "properties": {
          "allowed_domains": {
            "description": "Allowed search domains, or `null` when the search is unrestricted.",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": [
              "array",
              "null"
            ]
          },
          "context_size": {
            "$ref": "#/components/schemas/WebSearchContextSizeResource",
            "description": "The amount of search context made available to the model. Defaults to `medium`."
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WebSearchLocationResource"
              },
              {
                "type": "null"
              }
            ],
            "description": "Approximate location used to localize search results, if provided."
          },
          "mode": {
            "$ref": "#/components/schemas/WebSearchModeResource",
            "description": "The source used for web search results."
          },
          "type": {
            "default": "web_search",
            "description": "The type of the object. Always `web_search`.",
            "enum": [
              "web_search"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "mode",
          "context_size",
          "allowed_domains",
          "location"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceComputerUse": {
        "additionalProperties": false,
        "description": "Browser use in an OpenAI-hosted session.",
        "properties": {
          "include_screenshots": {
            "description": "Whether computer tool outputs include screenshots.",
            "type": "boolean"
          },
          "type": {
            "default": "computer_use",
            "description": "The type of the object. Always `computer_use`.",
            "enum": [
              "computer_use"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "include_screenshots"
        ],
        "type": "object"
      },
      "PersistedAgentToolResourceAutomations": {
        "additionalProperties": false,
        "description": "Lets the agent manage its own scheduled wakeups.",
        "properties": {
          "type": {
            "default": "automations",
            "description": "The type of the object. Always `automations`.",
            "enum": [
              "automations"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "TextFormatResourceText": {
        "additionalProperties": false,
        "description": "Generates ordinary text without a structured-output constraint.",
        "properties": {
          "type": {
            "default": "text",
            "description": "The type of the object. Always `text`.",
            "enum": [
              "text"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "TextFormatResourceJsonSchema": {
        "additionalProperties": false,
        "description": "Constrains generated text to a JSON Schema.",
        "properties": {
          "schema": {
            "additionalProperties": {},
            "description": "The JSON Schema that generated text must match.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "type": {
            "default": "json_schema",
            "description": "The type of the object. Always `json_schema`.",
            "enum": [
              "json_schema"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "schema"
        ],
        "type": "object"
      },
      "McpConnectionOriginResource": {
        "description": "Where outbound MCP HTTP connections originate.",
        "enum": [
          "service",
          "environment"
        ],
        "type": "string"
      },
      "PersistedMcpTransportResource": {
        "description": "A credential-free transport used to connect to an MCP server.",
        "discriminator": {
          "mapping": {
            "http": "#/components/schemas/PersistedMcpTransportResourceHttp",
            "stdio": "#/components/schemas/PersistedMcpTransportResourceStdio"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/PersistedMcpTransportResourceHttp"
          },
          {
            "$ref": "#/components/schemas/PersistedMcpTransportResourceStdio"
          }
        ]
      },
      "WebSearchContextSizeResource": {
        "description": "The amount of web search context made available to the model.",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "type": "string"
      },
      "WebSearchLocationResource": {
        "additionalProperties": false,
        "description": "Approximate user location used to localize web search results.",
        "properties": {
          "city": {
            "description": "The city name.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "description": "The two-letter ISO country code, such as `US`.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "description": "The region or state name.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "description": "The IANA timezone, such as `America/Los_Angeles`.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "country",
          "region",
          "city",
          "timezone"
        ],
        "type": "object"
      },
      "WebSearchModeResource": {
        "description": "The source used for web search results.",
        "enum": [
          "disabled",
          "cached",
          "live"
        ],
        "type": "string"
      },
      "PersistedMcpTransportResourceHttp": {
