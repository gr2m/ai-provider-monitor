{
  "description": "Lists reusable environment templates without returning confidential values. See [reusing a hosted setup](https://developers.openai.com/api/docs/guides/agents-api/tools#reuse-a-hosted-plugin-setup).",
  "operationId": "listAgentEnvironmentTemplates",
  "parameters": [
    {
      "description": "The maximum number of resources to return, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "format": "int64",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "The order in which resources are returned. Defaults to `desc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ListOrderParam",
        "default": "desc"
      }
    },
    {
      "description": "Return resources after this resource ID in the selected order.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/EnvironmentTemplateListResource",
            "description": "A page of reusable environment templates."
          }
        }
      },
      "description": "A page of environment templates."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required management permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested environment definition was not found."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "List agent environment templates",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "ListOrderParam": {
        "description": "The order in which paginated resources are returned.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "EnvironmentTemplateListResource": {
        "additionalProperties": false,
        "description": "A page of Agents API resources, with IDs for retrieving additional pages.",
        "properties": {
          "data": {
            "description": "The resources returned in this page, in the requested sort order.",
            "items": {
              "$ref": "#/components/schemas/EnvironmentTemplateResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "first_id": {
            "description": "The ID of the first resource in `data`, or `null` if the page is empty.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "description": "Whether there are more resources to retrieve after this page.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The ID of the last resource in `data`, or `null` if the page is empty. Pass this as `after` with the same order and filters.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "list",
            "description": "The object type, which is always `list`.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EnvironmentTemplateResource": {
        "additionalProperties": false,
        "description": "Reusable configuration that provisions a fresh OpenAI-hosted environment for each session.",
        "properties": {
          "capability_directories": {
            "description": "Directories that expose capabilities to the agent.",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the template was created.",
            "format": "int64",
            "type": "integer"
          },
          "desktop": {
            "$ref": "#/components/schemas/DesktopResource",
            "description": "Desktop configuration for each OpenAI-hosted environment."
          },
          "files": {
            "description": "Safe file metadata, excluding contents and session-scoped file IDs.",
            "items": {
              "$ref": "#/components/schemas/HostedTemplateFileResource"
            },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          },
          "id": {
            "description": "The ID of the reusable environment template.",
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "description": "An optional human-readable display name for the template.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "network": {
            "$ref": "#/components/schemas/NetworkPolicyResource",
            "description": "Runtime network access for each OpenAI-hosted environment."
          },
          "object": {
            "default": "agent.environment.template",
            "description": "The object type. Always `agent.environment.template`.",
            "enum": [
              "agent.environment.template"
            ],
            "type": "string"
          },
          "packages": {
            "$ref": "#/components/schemas/EnvironmentPackagesResource",
            "description": "Packages installed in each fresh OpenAI-hosted environment."
          },
          "plugins": {
            "description": "Safe plugin metadata, excluding inline archive contents.",
            "items": {
              "$ref": "#/components/schemas/HostedPluginResource"
            },
            "maxItems": 32,
            "minItems": 0,
            "type": "array"
          },
          "skills": {
            "description": "Safe skill metadata, preserving unresolved version selectors.",
            "items": {
              "$ref": "#/components/schemas/HostedTemplateSkillResource"
            },
            "maxItems": 200,
            "minItems": 0,
            "type": "array"
          },
          "updated_at": {
            "description": "The Unix timestamp, in seconds, when the template was last updated.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "object",
          "created_at",
          "updated_at",
          "packages",
          "network",
          "desktop",
          "capability_directories",
          "skills",
          "plugins",
          "files"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      },
      "DesktopResource": {
        "additionalProperties": false,
        "description": "The effective desktop configuration for an OpenAI-hosted environment.",
        "properties": {
          "enabled": {
            "description": "Whether the environment provisions a desktop and browser proxy.",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "type": "object"
      },
      "HostedTemplateFileResource": {
        "description": "Safe metadata for a file configured by an environment template.",
        "discriminator": {
          "mapping": {
            "file_id": "#/components/schemas/HostedTemplateFileResourceFileId",
            "inline": "#/components/schemas/HostedTemplateFileResourceInline"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/HostedTemplateFileResourceFileId"
          },
          {
            "$ref": "#/components/schemas/HostedTemplateFileResourceInline"
          }
        ]
      },
      "NetworkPolicyResource": {
        "additionalProperties": false,
        "description": "Network access for an OpenAI-hosted environment.",
        "properties": {
          "access": {
            "$ref": "#/components/schemas/NetworkAccessResource",
            "description": "The environment's network access mode."
          },
          "allowed_domains": {
            "description": "Domains the environment may access when network access is restricted.",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "access",
          "allowed_domains"
        ],
        "type": "object"
      },
      "EnvironmentPackagesResource": {
        "additionalProperties": false,
        "description": "Packages installed in an OpenAI-hosted environment.",
        "properties": {
          "npm": {
            "description": "npm packages installed globally in the environment.",
            "items": {
              "maxLength": 1048576,
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 16384,
            "minItems": 0,
            "type": "array"
          },
          "python": {
            "description": "Python packages installed in the environment.",
            "items": {
              "maxLength": 1048576,
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 16384,
            "minItems": 0,
            "type": "array"
          },
          "system": {
            "description": "System packages installed in the environment.",
            "items": {
              "maxLength": 1048576,
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 16384,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "python",
          "system",
          "npm"
        ],
        "type": "object"
      },
      "HostedPluginResource": {
        "description": "A plugin installed in an OpenAI-hosted environment.",
        "discriminator": {
          "mapping": {
            "inline": "#/components/schemas/HostedPluginResourceInline"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/HostedPluginResourceInline"
          }
        ]
      },
      "HostedTemplateSkillResource": {
        "description": "Safe metadata for a skill configured by an environment template.",
        "discriminator": {
          "mapping": {
            "inline": "#/components/schemas/HostedTemplateSkillResourceInline",
            "skill_reference": "#/components/schemas/HostedTemplateSkillResourceSkillReference"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/HostedTemplateSkillResourceSkillReference"
          },
          {
            "$ref": "#/components/schemas/HostedTemplateSkillResourceInline"
          }
        ]
      },
      "HostedTemplateFileResourceFileId": {
        "additionalProperties": false,
        "description": "A project-scoped Files API reference resolved separately for each session.",
        "properties": {
          "file_id": {
            "description": "The ID of the uploaded file.",
            "minLength": 0,
            "type": "string"
          },
          "path": {
            "description": "The file's absolute path inside the environment.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "file_id",
            "description": "The type of the object. Always `file_id`.",
            "enum": [
              "file_id"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "file_id",
          "path"
        ],
        "type": "object"
      },
      "HostedTemplateFileResourceInline": {
        "additionalProperties": false,
        "description": "Metadata for confidential inline file contents.",
        "properties": {
          "path": {
            "description": "The file's absolute path inside the environment.",
            "minLength": 0,
            "type": "string"
          },
          "size_bytes": {
            "description": "The decoded size of the inline file in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "default": "inline",
            "description": "The type of the object. Always `inline`.",
            "enum": [
              "inline"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "path",
          "size_bytes"
        ],
        "type": "object"
      },
      "NetworkAccessResource": {
        "description": "The network access mode for an OpenAI-hosted environment.",
        "enum": [
          "enabled",
          "disabled",
          "restricted"
        ],
        "type": "string"
      },
      "HostedPluginResourceInline": {
        "additionalProperties": false,
        "description": "A plugin installed from an inline ZIP archive.",
        "properties": {
          "description": {
            "description": "The installed plugin description.",
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "description": "The installed plugin name.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "inline",
            "description": "The type of the object. Always `inline`.",
            "enum": [
              "inline"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "description"
        ],
        "type": "object"
      },
      "HostedTemplateSkillResourceSkillReference": {
        "additionalProperties": false,
        "description": "A skill resolved afresh from the Skills API whenever a session starts.",
        "properties": {
          "skill_id": {
            "description": "The referenced skill ID.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "skill_reference",
            "description": "The type of the object. Always `skill_reference`.",
            "enum": [
              "skill_reference"
            ],
            "type": "string"
          },
          "version": {
            "description": "The requested version selector, including `latest`.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "skill_id",
          "version"
        ],
        "type": "object"
      },
      "HostedTemplateSkillResourceInline": {
        "additionalProperties": false,
        "description": "Safe metadata for an inline skill archive.",
        "properties": {
          "description": {
            "description": "The skill description declared in `SKILL.md`.",
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "description": "The skill name declared in `SKILL.md`.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "inline",
            "description": "The type of the object. Always `inline`.",
            "enum": [
              "inline"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "description"
        ],
        "type": "object"
      }
    }
  }
}
