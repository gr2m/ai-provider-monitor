{
  "description": "Creates an OpenAI-hosted environment before creating a session. Requires access to the prewarming beta.",
  "operationId": "createAgentEnvironment",
  "parameters": [
    {
      "description": "Deduplicates creation for 24 hours within the authenticated organization, project, and creator. Retry the same JSON parameters with the same key to retrieve the original environment in its current state. Different parameters or an incomplete hosted creation return 409. Deleted environments are not recreated. After retention expires, the key may create a new environment. Without this header, each request creates a new environment.",
      "in": "header",
      "name": "Idempotency-Key",
      "required": false,
      "schema": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateAgentEnvironmentParams"
        }
      }
    },
    "required": true
  },
  "responses": {
    "201": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PublicEnvironmentResource"
          }
        }
      },
      "description": "The created OpenAI-hosted environment."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested environment or referenced resource was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current environment state."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request exceeded a rate or capacity limit."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Create an agent environment",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "CreateAgentEnvironmentParams": {
        "additionalProperties": false,
        "description": "Parameters for creating an execution environment before its sessions.",
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/CreateEnvironmentParam",
            "description": "The required hosting type and its configuration."
          },
          "vault_ids": {
            "description": "The IDs of up to 10 vaults made available to an OpenAI-hosted environment.",
            "items": {
              "maxLength": 1048576,
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 0,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "environment"
        ],
        "type": "object"
      },
      "PublicEnvironmentResource": {
        "additionalProperties": false,
        "description": "Safe metadata for a first-class execution environment.",
        "properties": {
          "files": {
            "description": "Files installed in the environment, without their contents.",
            "items": {
              "$ref": "#/components/schemas/HostedEnvironmentFileResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "id": {
            "description": "The ID of the environment.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "agent.environment",
            "description": "The object type. Always `agent.environment`.",
            "enum": [
              "agent.environment"
            ],
            "type": "string"
          },
          "plugins": {
            "description": "Plugins installed in the environment, without their archive contents.",
            "items": {
              "$ref": "#/components/schemas/HostedPluginResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "skills": {
            "description": "Skills installed in the environment, without their archive contents.",
            "items": {
              "$ref": "#/components/schemas/HostedSkillResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/EnvironmentStatusResource",
            "description": "The current environment connection status."
          },
          "type": {
            "$ref": "#/components/schemas/EnvironmentTypeResource",
            "description": "Whether the environment is hosted by OpenAI or by the application."
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "status",
          "files",
          "skills",
          "plugins"
        ],
        "type": "object"
      },
