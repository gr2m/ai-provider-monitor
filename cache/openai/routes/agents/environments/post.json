      "CreateEnvironmentParamOpenaiHosted": {
        "additionalProperties": false,
        "description": "Provision an OpenAI-hosted environment from inline configuration or a template.",
        "properties": {
          "capability_directories": {
            "description": "Directories that contain capabilities exposed to the agent. Defaults to an empty list.",
