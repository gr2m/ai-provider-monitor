{
  "description": "Lists live files on a connected execution environment with optional directory filtering and opaque cursor pagination. See [environment files](https://developers.openai.com/api/docs/guides/agents-api/environments/files).",
  "operationId": "listAgentEnvironmentFiles",
  "parameters": [
    {
      "description": "The ID of the environment.",
      "in": "path",
      "name": "environment_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "Restrict the listing to this absolute workspace directory.",
      "in": "query",
      "name": "path",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": [
          "string",
          "null"
        ]
      }
    },
    {
      "description": "The maximum number of files to return, between 1 and 100.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "format": "int64",
        "maximum": 100,
        "minimum": 1,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    {
      "description": "Sort by case-sensitive path components. Defaults to descending.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ListOrderParam"
      }
    },
    {
      "description": "The opaque token from the previous page. Keep the same path, order, and limit.",
      "in": "query",
      "name": "page",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/EnvironmentFileListResource"
          }
        }
      },
      "description": "A page of live environment files."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested session or event was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current session state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "List agent environment files",
  "tags": [
    "Agents"
  ],
  "components": {
    "schemas": {
      "ListOrderParam": {
        "description": "The order in which paginated resources are returned.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "EnvironmentFileListResource": {
        "additionalProperties": false,
        "description": "A paginated list of live execution environment files.",
        "properties": {
          "data": {
            "description": "Files available on the current page.",
            "items": {
              "$ref": "#/components/schemas/EnvironmentFileResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "has_more": {
            "description": "Whether more files follow this page.",
            "type": "boolean"
          },
          "next": {
            "description": "The opaque cursor to use when requesting the next page, if any.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "$ref": "#/components/schemas/EnvironmentFilePageObjectResource",
            "description": "The object type. Always `page`."
          }
        },
        "required": [
          "object",
          "data",
          "next",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EnvironmentFileResource": {
        "additionalProperties": false,
        "description": "A live file in an execution environment.",
        "properties": {
          "environment_id": {
            "description": "The ID of the environment containing this file.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "agent.environment.file",
            "description": "The object type. Always `agent.environment.file`.",
            "enum": [
              "agent.environment.file"
            ],
            "type": "string"
          },
          "path": {
            "description": "The absolute file path inside the environment's workspace.",
            "minLength": 0,
            "type": "string"
          },
          "size_bytes": {
            "description": "The file size in bytes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "object",
          "environment_id",
          "path",
          "size_bytes"
        ],
        "type": "object"
      },
      "EnvironmentFilePageObjectResource": {
        "default": "page",
        "description": "The object type for a page of files in an execution environment.",
        "enum": [
          "page"
        ],
        "type": "string"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
