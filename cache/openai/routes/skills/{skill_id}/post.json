{
  "description": "Update the default version pointer for a skill.",
  "operationId": "UpdateSkillDefaultVersion",
  "parameters": [
    {
      "description": "The identifier of the skill.",
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "example": "skill_123",
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/SetDefaultSkillVersionBody"
        }
      }
    }
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SkillResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The requested version is invalid."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The skill or requested skill version was not found."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "summary": "Update Skill Default Version",
  "tags": [
    "Skills"
  ],
  "components": {
    "schemas": {
      "SetDefaultSkillVersionBody": {
        "description": "Updates the default version pointer for a skill.",
        "properties": {
          "default_version": {
            "description": "The skill version number to set as default.",
            "type": "string"
          }
        },
        "required": [
          "default_version"
        ],
        "title": "Update skill request",
        "type": "object"
      },
      "SkillResource": {
        "properties": {
          "created_at": {
            "description": "Unix timestamp (seconds) for when the skill was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "default_version": {
            "description": "Default version for the skill.",
            "type": "string"
          },
          "description": {
            "description": "Description of the skill.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill.",
            "type": "string"
          },
          "latest_version": {
            "description": "Latest version for the skill.",
            "type": "string"
          },
          "name": {
            "description": "Name of the skill.",
            "type": "string"
          },
          "object": {
            "default": "skill",
            "description": "The object type, which is `skill`.",
            "enum": [
              "skill"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "name",
          "description",
          "created_at",
          "default_version",
          "latest_version"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
