{
  "description": "List skill versions for a skill.",
  "operationId": "ListSkillVersions",
  "parameters": [
    {
      "description": "The identifier of the skill.",
      "in": "path",
      "name": "skill_id",
      "required": true,
      "schema": {
        "example": "skill_123",
        "type": "string"
      }
    },
    {
      "description": "Number of versions to retrieve.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      }
    },
    {
      "description": "Sort order of results by version number.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/OrderEnum"
      }
    },
    {
      "description": "The skill version ID to start after.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "example": "skillver_123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SkillVersionListResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The version specified by `after` does not belong to this skill."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The skill or the version specified by `after` was not found."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "summary": "List Skill Versions",
  "tags": [
    "Skills"
  ],
  "components": {
    "schemas": {
      "OrderEnum": {
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "SkillVersionListResource": {
        "properties": {
          "data": {
            "description": "A list of items",
            "items": {
              "$ref": "#/components/schemas/SkillVersionResource"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "description": "The ID of the first item in the list.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "description": "Whether there are more items available.",
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "description": "The ID of the last item in the list.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "default": "list",
            "description": "The type of object returned, must be `list`.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "SkillVersionResource": {
        "properties": {
          "created_at": {
            "description": "Unix timestamp (seconds) for when the version was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "description": {
            "description": "Description of the skill version.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the skill version.",
            "type": "string"
          },
          "name": {
            "description": "Name of the skill version.",
            "type": "string"
          },
          "object": {
            "default": "skill.version",
            "description": "The object type, which is `skill.version`.",
            "enum": [
              "skill.version"
            ],
            "type": "string"
          },
          "skill_id": {
            "description": "Identifier of the skill for this version.",
            "type": "string"
          },
          "version": {
            "description": "Version number for this skill.",
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "skill_id",
          "version",
          "created_at",
          "name",
          "description"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
