{
  "description": "List your organization's batches.",
  "operationId": "listBatches",
  "parameters": [
    {
      "description": "A cursor for use in pagination. `after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list.\n",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 20.\n",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListBatchesResponse"
          }
        }
      },
      "description": "Batch listed successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Invalid pagination parameters."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "No batch was found with the specified pagination cursor."
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request was rejected because a rate limit was exceeded."
    }
  },
  "summary": "List batches",
  "tags": [
    "Batch"
  ],
  "components": {
    "schemas": {
      "ListBatchesResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Batch"
            },
            "type": "array"
          },
          "first_id": {
            "example": "batch_abc123",
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "example": "batch_abc456",
            "type": "string"
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Batch": {
        "properties": {
          "cancelled_at": {
            "description": "The Unix timestamp (in seconds) for when the batch was cancelled.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "cancelling_at": {
            "description": "The Unix timestamp (in seconds) for when the batch started cancelling.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "completed_at": {
            "description": "The Unix timestamp (in seconds) for when the batch was completed.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "completion_window": {
            "description": "The time frame within which the batch should be processed.",
            "type": "string"
          },
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the batch was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "endpoint": {
            "description": "The OpenAI API endpoint used by the batch.",
            "type": "string"
          },
          "error_file_id": {
            "description": "The ID of the file containing the outputs of requests with errors.",
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/BatchError"
                },
                "type": "array"
              },
              "object": {
                "description": "The object type, which is always `list`.",
                "type": "string"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "expired_at": {
            "description": "The Unix timestamp (in seconds) for when the batch expired.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "expires_at": {
            "description": "The Unix timestamp (in seconds) for when the batch will expire.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "failed_at": {
            "description": "The Unix timestamp (in seconds) for when the batch failed.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "finalizing_at": {
            "description": "The Unix timestamp (in seconds) for when the batch started finalizing.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "in_progress_at": {
            "description": "The Unix timestamp (in seconds) for when the batch started processing.",
            "format": "unixtime",
            "type": [
              "integer",
              "null"
            ]
          },
          "input_file_id": {
            "description": "The ID of the input file for the batch.",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "model": {
            "description": "Model ID used to process the batch, like `gpt-6-astra`. OpenAI\noffers a wide range of models with different capabilities, performance\ncharacteristics, and price points. Refer to the [model\nguide](https://developers.openai.com/api/docs/models) to browse and compare available models.\n",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `batch`.",
            "enum": [
              "batch"
            ],
            "type": "string"
          },
          "output_file_id": {
            "description": "The ID of the file containing the outputs of successfully executed requests.",
            "type": [
              "string",
              "null"
            ]
          },
          "request_counts": {
            "$ref": "#/components/schemas/BatchRequestCounts"
          },
          "status": {
            "description": "The current status of the batch.",
            "enum": [
              "validating",
              "failed",
              "in_progress",
              "finalizing",
              "completed",
              "expired",
              "cancelling",
              "cancelled"
            ],
            "type": "string"
          },
          "usage": {
            "description": "Represents token usage details including input tokens, output tokens, a\nbreakdown of output tokens, and the total tokens used. Only populated on\nbatches created after September 7, 2025.\n",
            "properties": {
              "input_tokens": {
                "description": "The number of input tokens.",
                "type": "integer"
              },
              "input_tokens_details": {
                "description": "A detailed breakdown of the input tokens.",
                "properties": {
                  "cached_tokens": {
                    "description": "The number of tokens that were retrieved from the cache. [More on\nprompt caching](https://developers.openai.com/api/docs/guides/prompt-caching).\n",
                    "type": "integer"
                  }
                },
                "required": [
                  "cached_tokens"
                ],
                "type": "object"
              },
              "output_tokens": {
                "description": "The number of output tokens.",
                "type": "integer"
              },
              "output_tokens_details": {
                "description": "A detailed breakdown of the output tokens.",
                "properties": {
                  "reasoning_tokens": {
                    "description": "The number of reasoning tokens.",
                    "type": "integer"
                  }
                },
                "required": [
                  "reasoning_tokens"
                ],
                "type": "object"
              },
              "total_tokens": {
                "description": "The total number of tokens used.",
                "type": "integer"
              }
            },
            "required": [
              "input_tokens",
              "input_tokens_details",
              "output_tokens",
              "output_tokens_details",
              "total_tokens"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "object",
          "endpoint",
          "input_file_id",
          "completion_window",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "BatchError": {
        "properties": {
          "code": {
            "description": "An error code identifying the error type.",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "description": "The line number of the input file where the error occurred, if applicable.",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "description": "A human-readable message providing more details about the error.",
            "type": "string"
          },
          "param": {
            "anyOf": [
              {
                "description": "The name of the parameter that caused the error, if applicable.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "Metadata": {
        "anyOf": [
          {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Set of 16 key-value pairs that can be attached to an object. This can be\nuseful for storing additional information about the object in a structured\nformat, and querying for objects via API or the dashboard.\n\nKeys are strings with a maximum length of 64 characters. Values are strings\nwith a maximum length of 512 characters.\n",
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "BatchRequestCounts": {
        "description": "The request counts for different statuses within the batch.",
        "properties": {
          "completed": {
            "description": "Number of requests that have been completed successfully.",
            "type": "integer"
          },
          "failed": {
            "description": "Number of requests that have failed.",
            "type": "integer"
          },
          "total": {
            "description": "Total number of requests in the batch.",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "completed",
          "failed"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
