{
  "description": "Returns a list of voice consent recordings.",
  "operationId": "listVoiceConsents",
  "parameters": [
    {
      "description": "A cursor for use in pagination. `after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list.\n",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 20.\n",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VoiceConsentListResource"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Invalid pagination parameters."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The endpoint is unavailable or the pagination cursor was not found."
    }
  },
  "summary": "List voice consents",
  "tags": [
    "Audio"
  ],
  "components": {
    "schemas": {
      "VoiceConsentListResource": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/VoiceConsentResource"
            },
            "type": "array"
          },
          "first_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "last_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "VoiceConsentResource": {
        "additionalProperties": false,
        "description": "A consent recording used to authorize creation of a custom voice.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the consent recording was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The consent recording identifier.",
            "example": "cons_1234",
            "type": "string"
          },
          "language": {
            "description": "The BCP 47 language tag for the consent phrase (for example, `en-US`).",
            "type": "string"
          },
          "name": {
            "description": "The label provided when the consent recording was uploaded.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `audio.voice_consent`.",
            "enum": [
              "audio.voice_consent"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "language",
          "created_at"
        ],
        "title": "Voice consent",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
