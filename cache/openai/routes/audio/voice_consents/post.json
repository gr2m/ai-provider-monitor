{
  "description": "Upload a voice consent recording.",
  "operationId": "createVoiceConsent",
  "requestBody": {
    "content": {
      "multipart/form-data": {
        "schema": {
          "$ref": "#/components/schemas/CreateVoiceConsentRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VoiceConsentResource"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Invalid consent recording or consent phrase."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The endpoint is unavailable to this caller."
    }
  },
  "summary": "Create voice consent",
  "tags": [
    "Audio"
  ],
  "components": {
    "schemas": {
      "CreateVoiceConsentRequest": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "description": "The BCP 47 language tag for the consent phrase (for example, `en-US`).",
            "type": "string"
          },
          "name": {
            "description": "The label to use for this consent recording.",
            "type": "string"
          },
          "recording": {
            "description": "The consent audio recording file. Maximum size is 10 MiB.\n\nSupported MIME types:\n`audio/mpeg`, `audio/wav`, `audio/x-wav`, `audio/ogg`, `audio/aac`, `audio/flac`, `audio/webm`, `audio/mp4`.\n",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "name",
          "recording",
          "language"
        ],
        "type": "object"
      },
      "VoiceConsentResource": {
        "additionalProperties": false,
        "description": "A consent recording used to authorize creation of a custom voice.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp (in seconds) for when the consent recording was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "The consent recording identifier.",
            "example": "cons_1234",
            "type": "string"
          },
          "language": {
            "description": "The BCP 47 language tag for the consent phrase (for example, `en-US`).",
            "type": "string"
          },
          "name": {
            "description": "The label provided when the consent recording was uploaded.",
            "type": "string"
          },
          "object": {
            "description": "The object type, which is always `audio.voice_consent`.",
            "enum": [
              "audio.voice_consent"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "language",
          "created_at"
        ],
        "title": "Voice consent",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
