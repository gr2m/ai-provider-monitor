{
  "description": "List Container files",
  "operationId": "ListContainerFiles",
  "parameters": [
    {
      "in": "path",
      "name": "container_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 20.\n",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "type": "integer"
      }
    },
    {
      "description": "Sort order by the `created_at` timestamp of the objects. `asc` for ascending order and `desc` for descending order.\n",
      "in": "query",
      "name": "order",
      "schema": {
        "default": "desc",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      }
    },
    {
      "description": "A cursor for use in pagination. `after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with obj_foo, your subsequent call can include after=obj_foo in order to fetch the next page of the list.\n",
      "in": "query",
      "name": "after",
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ContainerFileListResource"
          }
        }
      },
      "description": "Success"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The container was not found or has expired, or the file specified by `after` was not found."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "summary": "List container files",
  "components": {
    "schemas": {
      "ContainerFileListResource": {
        "properties": {
          "data": {
            "description": "A list of container files.",
            "items": {
              "$ref": "#/components/schemas/ContainerFileResource"
            },
            "type": "array"
          },
          "first_id": {
            "description": "The ID of the first file in the list.",
            "type": "string"
          },
          "has_more": {
            "description": "Whether there are more files available.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The ID of the last file in the list.",
            "type": "string"
          },
          "object": {
            "description": "The type of object returned, must be 'list'.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ContainerFileResource": {
        "properties": {
          "bytes": {
            "description": "Size of the file in bytes.",
            "type": "integer"
          },
          "container_id": {
            "description": "The container this file belongs to.",
            "type": "string"
          },
          "created_at": {
            "description": "Unix timestamp (in seconds) when the file was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "Unique identifier for the file.",
            "type": "string"
          },
          "object": {
            "description": "The type of this object (`container.file`).",
            "type": "string"
          },
          "path": {
            "description": "Path of the file in the container.",
            "type": "string"
          },
          "source": {
            "description": "Source of the file (e.g., `user`, `assistant`).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "bytes",
          "container_id",
          "path",
          "source"
        ],
        "title": "The container file object",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
