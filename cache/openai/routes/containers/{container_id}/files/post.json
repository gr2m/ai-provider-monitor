{
  "description": "Create a Container File\n\nYou can send either a multipart/form-data request with the raw file content, or a JSON request with a file ID.\n",
  "operationId": "CreateContainerFile",
  "parameters": [
    {
      "in": "path",
      "name": "container_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CreateContainerFileBody"
        }
      },
      "multipart/form-data": {
        "schema": {
          "$ref": "#/components/schemas/CreateContainerFileBody"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ContainerFileResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The file input is invalid, or the container file limit would be exceeded."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The container was not found or has expired."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "summary": "Create container file",
  "components": {
    "schemas": {
      "CreateContainerFileBody": {
        "properties": {
          "file": {
            "description": "The File object (not file name) to be uploaded.\n",
            "format": "binary",
            "type": "string"
          },
          "file_id": {
            "description": "Name of the file to create.",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "ContainerFileResource": {
        "properties": {
          "bytes": {
            "description": "Size of the file in bytes.",
            "type": "integer"
          },
          "container_id": {
            "description": "The container this file belongs to.",
            "type": "string"
          },
          "created_at": {
            "description": "Unix timestamp (in seconds) when the file was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "id": {
            "description": "Unique identifier for the file.",
            "type": "string"
          },
          "object": {
            "description": "The type of this object (`container.file`).",
            "type": "string"
          },
          "path": {
            "description": "Path of the file in the container.",
            "type": "string"
          },
          "source": {
            "description": "Source of the file (e.g., `user`, `assistant`).",
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created_at",
          "bytes",
          "container_id",
          "path",
          "source"
        ],
        "title": "The container file object",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
