{
  "description": "Assigns a project role to a user within a project.",
  "operationId": "assign-project-user-role",
  "parameters": [
    {
      "description": "The ID of the project to update.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "The ID of the user that should receive the project role.",
      "in": "path",
      "name": "user_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/PublicAssignOrganizationGroupRoleBody"
        }
      }
    },
    "description": "Identifies the project role to assign to the user.",
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/UserRoleAssignment"
          }
        }
      },
      "description": "Project role assigned to the user successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid or the requested operation cannot be performed."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The endpoint is unavailable or a requested resource was not found in this organization or project."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Assign project role to user",
  "tags": [
    "Project user role assignments"
  ],
  "components": {
    "schemas": {
      "PublicAssignOrganizationGroupRoleBody": {
        "description": "Request payload for assigning a role to a group or user.",
        "properties": {
          "role_id": {
            "description": "Identifier of the role to assign.",
            "type": "string"
          }
        },
        "required": [
          "role_id"
        ],
        "type": "object"
      },
      "UserRoleAssignment": {
        "description": "Role assignment linking a user to a role.",
        "properties": {
          "object": {
            "description": "Always `user.role`.",
            "enum": [
              "user.role"
            ],
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "object",
          "user",
          "role"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Role": {
        "description": "Details about a role that can be assigned through the public Roles API.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional description of the role."
          },
          "id": {
            "description": "Identifier for the role.",
            "type": "string"
          },
          "name": {
            "description": "Unique name for the role.",
            "type": "string"
          },
          "object": {
            "description": "Always `role`.",
            "enum": [
              "role"
            ],
            "type": "string"
          },
          "permissions": {
            "description": "Permissions granted by the role.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "predefined_role": {
            "description": "Whether the role is predefined and managed by OpenAI.",
            "type": "boolean"
          },
          "resource_type": {
            "description": "Resource type the role is bound to (for example `api.organization` or `api.project`).",
            "type": "string"
          }
        },
        "required": [
          "object",
          "id",
          "name",
          "description",
          "permissions",
          "resource_type",
          "predefined_role"
        ],
        "type": "object"
      },
      "User": {
        "description": "Represents an individual `user` within an organization.",
        "properties": {
          "added_at": {
            "description": "The Unix timestamp (in seconds) of when the user was added.",
            "format": "unixtime",
            "type": "integer"
          },
          "api_key_last_used_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Unix timestamp (in seconds) of the user's last API key usage."
          },
          "created": {
            "description": "The Unix timestamp (in seconds) of when the user was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "developer_persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The developer persona metadata for the user."
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The email address of the user"
          },
          "id": {
            "description": "The identifier, which can be referenced in API endpoints",
            "type": "string"
          },
          "is_default": {
            "description": "Whether this is the organization's default user.",
            "type": "boolean"
          },
          "is_scale_tier_authorized_purchaser": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the user is an authorized purchaser for Scale Tier."
          },
          "is_scim_managed": {
            "description": "Whether the user is managed through SCIM.",
            "type": "boolean"
          },
          "is_service_account": {
            "description": "Whether the user is a service account.",
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the user"
          },
          "object": {
            "description": "The object type, which is always `organization.user`",
            "enum": [
              "organization.user"
            ],
            "type": "string"
          },
          "projects": {
            "anyOf": [
              {
                "properties": {
                  "data": {
                    "items": {
                      "properties": {
                        "id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "name": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "role": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "object": {
                    "enum": [
                      "list"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "object",
                  "data"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Projects associated with the user, if included."
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`owner` or `reader`"
          },
          "technical_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The technical level metadata for the user."
          },
          "user": {
            "description": "Nested user details.",
            "properties": {
              "banned": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "banned_at": {
                "anyOf": [
                  {
                    "format": "unixtime",
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "enabled": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "type": "string"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "object": {
                "enum": [
                  "user"
                ],
                "type": "string"
              },
              "picture": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "object",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "object",
          "id",
          "added_at"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
