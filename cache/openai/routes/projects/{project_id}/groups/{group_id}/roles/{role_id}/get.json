{
  "description": "Retrieves a project role assigned to a group.",
  "operationId": "retrieve-project-group-role",
  "parameters": [
    {
      "description": "The ID of the project to inspect.",
      "in": "path",
      "name": "project_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "The ID of the group to inspect.",
      "in": "path",
      "name": "group_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    },
    {
      "description": "The ID of the project role to retrieve for the group.",
      "in": "path",
      "name": "role_id",
      "required": true,
      "schema": {
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/AssignedRoleDetails"
          }
        }
      },
      "description": "Project role retrieved for the group successfully."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request parameters are invalid or the requested operation cannot be performed."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/PermissionErrorResponse"
          }
        }
      },
      "description": "The caller does not have permission to perform this operation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The endpoint is unavailable or a requested resource was not found in this organization or project."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    }
  },
  "security": [
    {
      "AdminApiKeyAuth": []
    }
  ],
  "summary": "Retrieve project group role",
  "tags": [
    "Project group role assignments"
  ],
  "components": {
    "schemas": {
      "AssignedRoleDetails": {
        "description": "Detailed information about a role assignment entry returned when listing assignments.",
        "properties": {
          "assignment_sources": {
            "anyOf": [
              {
                "items": {
                  "properties": {
                    "principal_id": {
                      "type": "string"
                    },
                    "principal_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "principal_id",
                    "principal_type"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Principals from which the role assignment is inherited, when available."
          },
          "created_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the role was created."
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Identifier of the actor who created the role."
          },
          "created_by_user_obj": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "User details for the actor that created the role, when available."
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Description of the role."
          },
          "id": {
            "description": "Identifier for the role.",
            "type": "string"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Arbitrary metadata stored on the role."
          },
          "name": {
            "description": "Name of the role.",
            "type": "string"
          },
          "permissions": {
            "description": "Permissions associated with the role.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "predefined_role": {
            "description": "Whether the role is predefined by OpenAI.",
            "type": "boolean"
          },
          "resource_type": {
            "description": "Resource type the role applies to.",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the role was last updated."
          }
        },
        "required": [
          "id",
          "name",
          "permissions",
          "resource_type",
          "predefined_role",
          "description",
          "created_at",
          "updated_at",
          "created_by",
          "created_by_user_obj",
          "metadata",
          "assignment_sources"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "PermissionErrorResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "description": "An explanation of the missing API permissions.",
                "type": "string"
              }
            ],
            "description": "Details about the permission error."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
