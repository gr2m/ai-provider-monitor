{
  "description": "Check whether an image or audio file contains known OpenAI provenance signals. [Learn more about content provenance](https://developers.openai.com/api/docs/guides/content-provenance).\n\nIf `not_detected`, it means the tool did not find supported signals in the uploaded file. The content could still have been generated by OpenAI if the metadata was stripped or has evidence of tampering, the watermark was degraded, it comes from a legacy generation model, or it was created before provenance signals were available. Content could also still be AI-generated by another company's model, which the tool currently does not detect.",
  "operationId": "Createcontentprovenancecheck",
  "parameters": [],
  "requestBody": {
    "content": {
      "multipart/form-data": {
        "schema": {
          "$ref": "#/components/schemas/CreateContentProvenanceBody"
        }
      }
    }
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProvenanceResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The file is missing, invalid, unsupported, too large, or rejected by safety checks."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Content provenance checks are unavailable to this caller."
    },
    "429": {
      "$ref": "#/components/responses/TooManyRequests"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The content provenance check could not be completed."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "Content provenance inspection is temporarily unavailable."
    }
  },
  "summary": "Create content provenance check",
  "components": {
    "schemas": {
      "CreateContentProvenanceBody": {
        "properties": {
          "file": {
            "description": "The image or audio file to check for supported OpenAI provenance signals.",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "ProvenanceResource": {
        "properties": {
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the provenance check was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "object": {
            "$ref": "#/components/schemas/ProvenanceCheckObject",
            "description": "The object type. Always `content_provenance_check` for this endpoint."
          },
          "results": {
            "description": "The provenance results that apply to the uploaded file. Image results include C2PA and SynthID; audio results include SynthID.",
            "items": {
              "discriminator": {
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/C2PAProvenanceResult"
                },
                {
                  "$ref": "#/components/schemas/SynthIDProvenanceResult"
                }
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "object",
          "created_at",
          "results"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ProvenanceCheckObject": {
        "enum": [
          "content_provenance_check"
        ],
        "type": "string"
      },
      "C2PAProvenanceResult": {
        "properties": {
          "generated_at": {
            "anyOf": [
              {
                "description": "The UTC RFC 3339 timestamp recorded by the provenance signal for when the asset was generated, when available.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "issuer": {
            "anyOf": [
              {
                "description": "The C2PA manifest issuer, when available.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "description": "The OpenAI model recorded by the provenance signal, when available.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/ProvenanceDetectionResultApi",
            "description": "Whether a supported OpenAI C2PA provenance signal was detected.\nIf `not_detected`, it means the tool did not find supported signals in the uploaded file. The content could still have been generated by OpenAI if the metadata was stripped or has evidence of tampering, the watermark was degraded, it comes from a legacy generation model, or it was created before provenance signals were available. Content could also still be AI-generated by another company's model, which the tool currently does not detect."
          },
          "type": {
            "default": "c2pa",
            "description": "The provenance signal type. Always `c2pa`.",
            "enum": [
              "c2pa"
            ],
            "type": "string"
          },
          "validation_state": {
            "$ref": "#/components/schemas/C2PAValidationStateApi",
            "description": "The validation status of the C2PA manifest in the uploaded image."
          }
        },
        "required": [
          "type",
          "outcome",
          "validation_state",
          "issuer",
          "model",
          "generated_at"
        ],
        "type": "object"
      },
      "SynthIDProvenanceResult": {
        "properties": {
          "generated_at": {
            "anyOf": [
              {
                "description": "The UTC RFC 3339 timestamp recorded by the provenance signal for when the asset was generated, when available.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "description": "The OpenAI model recorded by the provenance signal, when available.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/ProvenanceDetectionResultApi",
            "description": "Whether a supported OpenAI SynthID watermark was detected.\nIf `not_detected`, it means the tool did not find supported signals in the uploaded file. The content could still have been generated by OpenAI if the metadata was stripped or has evidence of tampering, the watermark was degraded, it comes from a legacy generation model, or it was created before provenance signals were available. Content could also still be AI-generated by another company's model, which the tool currently does not detect."
          },
          "type": {
            "default": "synthid",
            "description": "The provenance signal type. Always `synthid`.",
            "enum": [
              "synthid"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "outcome",
          "model",
          "generated_at"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "ProvenanceDetectionResultApi": {
        "enum": [
          "detected",
          "not_detected"
        ],
        "type": "string"
      },
      "C2PAValidationStateApi": {
        "enum": [
          "trusted",
          "valid",
          "invalid",
          "not_present"
        ],
        "type": "string"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "responses": {
      "TooManyRequests": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "The request was rejected because a rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "The minimum number of seconds to wait before retrying. This header is returned when the server has computed a retry delay and may be omitted for 429 responses that require user action.",
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
