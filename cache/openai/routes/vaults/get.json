{
  "description": "Lists vaults using ID-based pagination. See [vaults](https://developers.openai.com/api/docs/guides/agents-api/tools/vaults).",
  "operationId": "listVaults",
  "parameters": [
    {
      "description": "The maximum number of resources to return, between 1 and 100. Defaults to 20.",
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 20,
        "format": "int64",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      }
    },
    {
      "description": "The order in which resources are returned. Defaults to `desc`.",
      "in": "query",
      "name": "order",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/ListOrderParam",
        "default": "desc"
      }
    },
    {
      "description": "Return resources after this resource ID in the selected order.",
      "in": "query",
      "name": "after",
      "required": false,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "Exact string matches supplied as `metadata[key]=value`. All supplied pairs must match. Up to 16 pairs, with keys from 1 to 64 characters and values up to 512 characters. Filtering is eventually consistent; metadata changes may take time to appear.",
      "explode": true,
      "in": "query",
      "name": "metadata",
      "required": false,
      "schema": {
        "additionalProperties": {
          "maxLength": 512,
          "minLength": 0,
          "type": "string"
        },
        "maxProperties": 16,
        "minProperties": 0,
        "propertyNames": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "type": "object"
      },
      "style": "deepObject"
    },
    {
      "description": "Filter by one status or a list, such as `status=active` or `status[]=active&status[]=archived`. Both statuses are included by default.",
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/VaultStatusFilterParam"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VaultListResource",
            "description": "A page of vaults."
          }
        }
      },
      "description": "A page of vaults."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required management permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested vault or credential was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current vault state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "List vaults",
  "tags": [
    "Vaults"
  ],
  "components": {
    "schemas": {
      "ListOrderParam": {
        "description": "The order in which paginated resources are returned.",
        "enum": [
          "asc",
          "desc"
        ],
        "type": "string"
      },
      "VaultStatusFilterParam": {
        "description": "One or more lifecycle statuses to include when listing vaults or credentials.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/VaultStatusParam"
          },
          {
            "items": {
              "$ref": "#/components/schemas/VaultStatusParam"
            },
            "maxItems": 16384,
            "minItems": 0,
            "type": "array"
          }
        ]
      },
      "VaultListResource": {
        "additionalProperties": false,
        "description": "A page of Agents API resources, with IDs for retrieving additional pages.",
        "properties": {
          "data": {
            "description": "The resources returned in this page, in the requested sort order.",
            "items": {
              "$ref": "#/components/schemas/VaultResource"
            },
            "maxItems": 2000,
            "minItems": 0,
            "type": "array"
          },
          "first_id": {
            "description": "The ID of the first resource in `data`, or `null` if the page is empty.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "description": "Whether there are more resources to retrieve after this page.",
            "type": "boolean"
          },
          "last_id": {
            "description": "The ID of the last resource in `data`, or `null` if the page is empty. Pass this as `after` with the same order and filters.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "list",
            "description": "The object type, which is always `list`.",
            "enum": [
              "list"
            ],
            "type": "string"
          }
        },
        "required": [
          "object",
          "data",
          "first_id",
          "last_id",
          "has_more"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "VaultStatusParam": {
        "description": "Whether a vault or credential is active or archived.",
        "enum": [
          "active",
          "archived"
        ],
        "type": "string"
      },
      "VaultResource": {
        "additionalProperties": false,
        "description": "A collection of credentials for MCP servers and OpenAI-hosted environments.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the vault was created.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The ID of the vault.",
            "minLength": 0,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "minLength": 0,
              "type": "string"
            },
            "description": "Key-value pairs associated with the vault, such as an application or team identifier.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "description": "The human-readable name of the vault, if set.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "vault",
            "description": "The object type. Always `vault`.",
            "enum": [
              "vault"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "name",
          "metadata",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
