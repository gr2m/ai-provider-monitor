{
  "description": "Deletes a vault and all its credentials. See [vaults](https://developers.openai.com/api/docs/guides/agents-api/tools/vaults).",
  "operationId": "deleteVault",
  "parameters": [
    {
      "description": "The ID of the vault.",
      "in": "path",
      "name": "vault_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DeletedVaultResource"
          }
        }
      },
      "description": "The deleted vault."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required management permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested vault or credential was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current vault state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Delete a vault",
  "tags": [
    "Vaults"
  ],
  "components": {
    "schemas": {
      "DeletedVaultResource": {
        "additionalProperties": false,
        "description": "Confirmation that a vault was deleted.",
        "properties": {
          "deleted": {
            "description": "Whether the resource was deleted. Always `true`.",
            "type": "boolean"
          },
          "id": {
            "description": "The ID of the deleted vault.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "vault.deleted",
            "description": "The object type. Always `vault.deleted`.",
            "enum": [
              "vault.deleted"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "deleted"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
