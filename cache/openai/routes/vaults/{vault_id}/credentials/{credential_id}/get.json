{
  "description": "Retrieves vault credential metadata without returning secret values. See [vaults](https://developers.openai.com/api/docs/guides/agents-api/tools/vaults).",
  "operationId": "retrieveVaultCredential",
  "parameters": [
    {
      "description": "The ID of the vault.",
      "in": "path",
      "name": "vault_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    },
    {
      "description": "The ID of the vault credential.",
      "in": "path",
      "name": "credential_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VaultCredentialResource"
          }
        }
      },
      "description": "The requested vault credential without secret values."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required management permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested vault or credential was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current vault state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Retrieve a vault credential",
  "tags": [
    "Vaults"
  ],
  "components": {
    "schemas": {
      "VaultCredentialResource": {
        "additionalProperties": false,
        "description": "Metadata for a stored credential. Secret values are never returned.",
        "properties": {
          "auth": {
            "$ref": "#/components/schemas/VaultCredentialAuthResource",
            "description": "The authentication method and non-secret configuration of the credential."
          },
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the credential was created.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The ID of the credential.",
            "minLength": 0,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "minLength": 0,
              "type": "string"
            },
            "description": "Application-defined key-value pairs associated with this credential.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "description": "The human-readable name of the credential.",
            "minLength": 0,
            "type": "string"
          },
          "object": {
            "default": "vault.credential",
            "description": "The object type. Always `vault.credential`.",
            "enum": [
              "vault.credential"
            ],
            "type": "string"
          },
          "updated_at": {
            "description": "The Unix timestamp, in seconds, when the credential was last updated.",
            "format": "int64",
            "type": "integer"
          },
          "vault_id": {
            "description": "The ID of the vault containing this credential.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "vault_id",
          "name",
          "auth",
          "metadata",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "VaultCredentialAuthResource": {
        "description": "The authentication configuration of a vault credential, excluding secrets.",
        "discriminator": {
          "mapping": {
            "environment_variable": "#/components/schemas/VaultCredentialAuthResourceEnvironmentVariable",
            "mcp_oauth": "#/components/schemas/VaultCredentialAuthResourceMcpOauth",
            "static_bearer": "#/components/schemas/VaultCredentialAuthResourceStaticBearer"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/VaultCredentialAuthResourceMcpOauth"
          },
          {
            "$ref": "#/components/schemas/VaultCredentialAuthResourceStaticBearer"
          },
          {
            "$ref": "#/components/schemas/VaultCredentialAuthResourceEnvironmentVariable"
          }
        ]
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      },
      "VaultCredentialAuthResourceMcpOauth": {
        "additionalProperties": false,
        "description": "Public metadata for an OAuth credential; tokens and client secrets are never returned.",
        "properties": {
          "expires_at": {
            "description": "When the OAuth access token expires, as an RFC 3339 timestamp, if known.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "mcp_server_url": {
            "description": "The HTTPS MCP server URL authorized by this credential.",
            "minLength": 0,
            "type": "string"
          },
          "refresh": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/McpOauthRefreshResource"
              },
              {
                "type": "null"
              }
            ],
            "description": "Public refresh metadata without refresh tokens or OAuth client secrets."
          },
          "type": {
            "default": "mcp_oauth",
            "description": "The type of the object. Always `mcp_oauth`.",
            "enum": [
              "mcp_oauth"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "mcp_server_url",
          "expires_at",
          "refresh"
        ],
        "type": "object"
      },
      "VaultCredentialAuthResourceStaticBearer": {
        "additionalProperties": false,
        "description": "Metadata for a bearer-token credential, without automatic OAuth refresh.",
        "properties": {
          "mcp_server_url": {
            "description": "The HTTPS MCP server URL authorized by this credential.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "static_bearer",
            "description": "The type of the object. Always `static_bearer`.",
            "enum": [
              "static_bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "mcp_server_url"
        ],
        "type": "object"
      },
      "VaultCredentialAuthResourceEnvironmentVariable": {
        "additionalProperties": false,
        "description": "Metadata for an HTTP credential used only in OpenAI-hosted environments. Sandbox code receives a placeholder. The proxy substitutes the secret for allowed HTTPS destinations on ports 443 and 8443. The real secret is not available to sandbox code for local computation and is never returned in this resource.",
        "properties": {
          "networking": {
            "$ref": "#/components/schemas/VaultCredentialNetworkingResource",
            "description": "The destinations where the proxy can substitute the secret, subject to the environment network policy."
          },
          "secret_name": {
            "description": "The environment variable name that receives the placeholder in the sandbox.",
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "default": "environment_variable",
            "description": "The type of the object. Always `environment_variable`.",
            "enum": [
              "environment_variable"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "secret_name",
          "networking"
        ],
        "type": "object"
      },
      "McpOauthRefreshResource": {
        "additionalProperties": false,
        "description": "Configuration used to refresh an MCP OAuth access token, excluding secret values.",
        "properties": {
          "client_id": {
            "description": "The OAuth client ID used when requesting a new access token.",
            "minLength": 0,
            "type": "string"
          },
          "resource": {
            "description": "The resource URI sent to the OAuth token endpoint during refresh, if configured.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "description": "Space-separated OAuth scopes requested during refresh, if configured.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "token_endpoint": {
            "description": "The HTTPS OAuth token endpoint used for refresh.",
            "minLength": 0,
            "type": "string"
          },
          "token_endpoint_auth": {
            "$ref": "#/components/schemas/McpOauthTokenEndpointAuthResource",
            "description": "How the OAuth client authenticates to the token endpoint, excluding its client secret."
          }
        },
        "required": [
          "token_endpoint",
          "client_id",
          "resource",
          "scope",
          "token_endpoint_auth"
        ],
        "type": "object"
      },
      "VaultCredentialNetworkingResource": {
        "description": "Destination permissions for an environment-variable credential. These do not grant network access to the environment.",
        "discriminator": {
          "mapping": {
            "limited": "#/components/schemas/VaultCredentialNetworkingResourceLimited",
            "unrestricted": "#/components/schemas/VaultCredentialNetworkingResourceUnrestricted"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/VaultCredentialNetworkingResourceUnrestricted"
          },
          {
            "$ref": "#/components/schemas/VaultCredentialNetworkingResourceLimited"
          }
        ]
      },
      "McpOauthTokenEndpointAuthResource": {
        "description": "The client authentication method used for OAuth token refresh.",
        "discriminator": {
          "mapping": {
            "client_secret_basic": "#/components/schemas/McpOauthTokenEndpointAuthResourceClientSecretBasic",
            "client_secret_post": "#/components/schemas/McpOauthTokenEndpointAuthResourceClientSecretPost",
            "none": "#/components/schemas/McpOauthTokenEndpointAuthResourceNone"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/McpOauthTokenEndpointAuthResourceNone"
          },
          {
            "$ref": "#/components/schemas/McpOauthTokenEndpointAuthResourceClientSecretBasic"
          },
          {
            "$ref": "#/components/schemas/McpOauthTokenEndpointAuthResourceClientSecretPost"
          }
        ]
      },
      "VaultCredentialNetworkingResourceUnrestricted": {
        "additionalProperties": false,
        "description": "Allows substitution for destinations permitted by the environment network policy. Requires `environment.network.access` to be `restricted`, with explicit `allowed_domains`.",
        "properties": {
          "type": {
            "default": "unrestricted",
            "description": "The type of the object. Always `unrestricted`.",
            "enum": [
              "unrestricted"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "VaultCredentialNetworkingResourceLimited": {
        "additionalProperties": false,
        "description": "Allows substitution only for the listed hosts. The environment network policy must also allow these hosts.",
        "properties": {
          "allowed_hosts": {
            "description": "The 1 to 16 distinct allowed hostnames or IPv4 addresses, normalized to lowercase. Entries contain no scheme, path, port, or wildcard. IPv6 addresses are not supported.",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "type": {
            "default": "limited",
            "description": "The type of the object. Always `limited`.",
            "enum": [
              "limited"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "allowed_hosts"
        ],
        "type": "object"
      },
      "McpOauthTokenEndpointAuthResourceNone": {
        "additionalProperties": false,
        "description": "Sends the client ID without a client secret.",
        "properties": {
          "type": {
            "default": "none",
            "description": "The type of the object. Always `none`.",
            "enum": [
              "none"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "McpOauthTokenEndpointAuthResourceClientSecretBasic": {
        "additionalProperties": false,
        "description": "Sends the client ID and secret using HTTP Basic authentication.",
        "properties": {
          "type": {
            "default": "client_secret_basic",
            "description": "The type of the object. Always `client_secret_basic`.",
            "enum": [
              "client_secret_basic"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "McpOauthTokenEndpointAuthResourceClientSecretPost": {
        "additionalProperties": false,
        "description": "Sends the client ID and secret in the token request body.",
        "properties": {
          "type": {
            "default": "client_secret_post",
            "description": "The type of the object. Always `client_secret_post`.",
            "enum": [
              "client_secret_post"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      }
    }
  }
}
