{
  "description": "Updates the name or metadata of an active vault. Omitted fields remain unchanged. See [vaults](https://developers.openai.com/api/docs/guides/agents-api/tools/vaults).",
  "operationId": "updateVault",
  "parameters": [
    {
      "description": "The ID of the vault.",
      "in": "path",
      "name": "vault_id",
      "required": true,
      "schema": {
        "maxLength": 1048576,
        "minLength": 0,
        "type": "string"
      }
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/UpdateVaultParams"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VaultResource"
          }
        }
      },
      "description": "The updated vault."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request was invalid."
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "Authentication or project context was missing."
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The API key lacks the required management permission."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The requested vault or credential was not found."
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The request conflicted with the current vault state."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "An internal error occurred."
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse-2"
          }
        }
      },
      "description": "The service is temporarily unavailable."
    }
  },
  "summary": "Update a vault",
  "tags": [
    "Vaults"
  ],
  "components": {
    "schemas": {
      "UpdateVaultParams": {
        "additionalProperties": false,
        "description": "Fields to replace on an active vault.",
        "properties": {
          "metadata": {
            "additionalProperties": {
              "maxLength": 512,
              "minLength": 0,
              "type": "string"
            },
            "description": "Replaces all metadata. Omit to leave unchanged, or pass {} to clear it. Up to 16 string key-value pairs, with keys up to 64 and values up to 512 characters.",
            "maxProperties": 16,
            "minProperties": 0,
            "propertyNames": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "description": "A replacement name. Omit to leave unchanged, or pass null to clear it. The name is trimmed before storage. It must contain 1 to 256 UTF-8 bytes after trimming.",
            "maxLength": 1048576,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "VaultResource": {
        "additionalProperties": false,
        "description": "A collection of credentials for MCP servers and OpenAI-hosted environments.",
        "properties": {
          "created_at": {
            "description": "The Unix timestamp, in seconds, when the vault was created.",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "description": "The ID of the vault.",
            "minLength": 0,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "minLength": 0,
              "type": "string"
            },
            "description": "Key-value pairs associated with the vault, such as an application or team identifier.",
            "minProperties": 0,
            "propertyNames": {
              "minLength": 0,
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "description": "The human-readable name of the vault, if set.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "default": "vault",
            "description": "The object type. Always `vault`.",
            "enum": [
              "vault"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "name",
          "metadata",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorResponse-2": {
        "additionalProperties": false,
        "description": "An API error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyResource",
            "description": "The error returned by the API."
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorBodyResource": {
        "additionalProperties": false,
        "description": "Details about an API error.",
        "properties": {
          "code": {
            "description": "A machine-readable error code.",
            "minLength": 0,
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "minLength": 0,
            "type": "string"
          },
          "param": {
            "description": "The request parameter that caused the error, or null for a request-wide error.",
            "minLength": 0,
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "description": "The error type.",
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "type",
          "code",
          "message",
          "param"
        ],
        "type": "object"
      }
    }
  }
}
