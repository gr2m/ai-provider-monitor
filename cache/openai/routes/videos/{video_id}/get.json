{
  "deprecated": true,
  "description": "Fetch the latest metadata for a generated video.",
  "operationId": "GetVideo",
  "parameters": [
    {
      "description": "The identifier of the video to retrieve.",
      "in": "path",
      "name": "video_id",
      "required": true,
      "schema": {
        "example": "video_123",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/VideoResource"
          }
        }
      },
      "description": "Success"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request is invalid, or the organization does not support video generation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The video was not found or is not accessible, or the Videos API is unavailable."
    }
  },
  "summary": "Retrieve a video",
  "tags": [
    "Videos"
  ],
  "components": {
    "schemas": {
      "VideoResource": {
        "description": "Structured information describing a generated video job.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "description": "Unix timestamp (seconds) for when the job completed, if finished.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "description": "Unix timestamp (seconds) for when the job was created.",
            "format": "unixtime",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error-2",
                "description": "Error payload that explains why generation failed, if applicable."
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "description": "Unix timestamp (seconds) for when the downloadable assets expire, if set.",
                "format": "unixtime",
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "description": "Unique identifier for the video job.",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/VideoModel",
            "description": "The video generation model that produced the job."
          },
          "object": {
            "default": "video",
            "description": "The object type, which is always `video`.",
            "enum": [
              "video"
            ],
            "type": "string"
          },
          "progress": {
            "description": "Approximate completion percentage for the generation task.",
            "type": "integer"
          },
          "prompt": {
            "anyOf": [
              {
                "description": "The prompt that was used to generate the video.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "remixed_from_video_id": {
            "anyOf": [
              {
                "description": "Identifier of the source video if this video is a remix.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "seconds": {
            "description": "Duration of the generated clip in seconds. For extensions, this is the stitched total duration.",
            "type": "string"
          },
          "size": {
            "$ref": "#/components/schemas/VideoSize",
            "description": "The resolution of the generated video."
          },
          "status": {
            "$ref": "#/components/schemas/VideoStatus",
            "description": "Current lifecycle status of the video job."
          }
        },
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "completed_at",
          "expires_at",
          "prompt",
          "size",
          "seconds",
          "remixed_from_video_id",
          "error"
        ],
        "title": "Video job",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error-2": {
        "description": "An error that occurred while generating the response.",
        "properties": {
          "code": {
            "description": "A machine-readable error code that was returned.",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "description": "The retry header value.",
              "type": "string"
            },
            "description": "The Retry-After and Retry-After-Ms headers returned with the original error, if any.",
            "type": "object"
          },
          "message": {
            "description": "A human-readable description of the error that was returned.",
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "description": "The request parameter associated with the error, or null if none was recorded.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "anyOf": [
              {
                "description": "The original error type, or null if it was not recorded.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Error",
        "type": "object"
      },
      "VideoModel": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "sora-2",
              "sora-2-pro",
              "sora-2-2025-10-06",
              "sora-2-pro-2025-10-06",
              "sora-2-2025-12-08"
            ],
            "type": "string"
          }
        ]
      },
      "VideoSize": {
        "enum": [
          "720x1280",
          "1280x720",
          "1024x1792",
          "1792x1024"
        ],
        "type": "string"
      },
      "VideoStatus": {
        "enum": [
          "queued",
          "in_progress",
          "completed",
          "failed"
        ],
        "type": "string"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
