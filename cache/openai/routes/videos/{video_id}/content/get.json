{
  "deprecated": true,
  "description": "Download the generated video bytes or a derived preview asset.\n\nStreams the rendered video content for the specified video job.",
  "operationId": "RetrieveVideoContent",
  "parameters": [
    {
      "description": "The identifier of the video whose media to download.",
      "in": "path",
      "name": "video_id",
      "required": true,
      "schema": {
        "example": "video_123",
        "type": "string"
      }
    },
    {
      "description": "Which downloadable asset to return. Defaults to the MP4 video.",
      "in": "query",
      "name": "variant",
      "required": false,
      "schema": {
        "$ref": "#/components/schemas/VideoContentVariant"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "type": "string"
          }
        },
        "image/webp": {
          "schema": {
            "format": "binary",
            "type": "string"
          }
        },
        "video/mp4": {
          "example": "<binary MP4 video content>",
          "schema": {
            "format": "binary",
            "type": "string"
          }
        }
      },
      "description": "The video bytes or preview asset that matches the requested variant."
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The request or content variant is invalid, or the organization does not support video generation."
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The video was not found or is not ready, its download is unavailable or expired, or the Videos API is unavailable."
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "description": "The requested video media is unavailable."
    }
  },
  "summary": "Download video content",
  "tags": [
    "Videos"
  ],
  "components": {
    "schemas": {
      "VideoContentVariant": {
        "enum": [
          "video",
          "thumbnail",
          "spritesheet"
        ],
        "type": "string"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "misalignment": {
            "$ref": "#/components/schemas/MisalignmentErrorDetailsResource"
          },
          "param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "MisalignmentErrorDetailsResource": {
        "properties": {
          "detailed_explanation": {
            "description": "The public explanation for this block.",
            "type": "string"
          },
          "error_type": {
            "$ref": "#/components/schemas/_MisalignmentErrorType",
            "description": "An optional classification; clients must accept additional values."
          },
          "review_target": {
            "anyOf": [
              {
                "description": "An opaque target for explicitly continuing this review, or null when unavailable.",
                "maxLength": 96,
                "minLength": 1,
                "not": {
                  "pattern": "[^A-Za-z0-9._~:-]"
                },
                "pattern": "^[A-Za-z0-9._~:-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "steer": {
            "$ref": "#/components/schemas/_MisalignmentSteer",
            "description": "An optional public continuation instruction."
          }
        },
        "required": [],
        "type": "object"
      },
      "_MisalignmentErrorType": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "enum": [
              "potentially_unintended_data_transfer",
              "potentially_unintended_data_access",
              "potentially_unintended_destructive_activity",
              "other"
            ],
            "type": "string"
          }
        ]
      },
      "_MisalignmentSteer": {
        "properties": {
          "message": {
            "description": "The public continuation instruction.",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
