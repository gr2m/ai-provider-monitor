{
  "description": "This endpoint is used to query the result of an asynchronous request.",
  "parameters": [
    {
      "$ref": "#/components/parameters/AcceptLanguage"
    },
    {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "Task id.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AsyncVideoGenerationResponse",
                "title": "Video Generation"
              },
              {
                "$ref": "#/components/schemas/AsyncImageGenerationResponse",
                "title": "Image Generation"
              }
            ]
          }
        }
      },
      "description": "Processing successful"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "description": "The request has failed."
    }
  },
  "components": {
    "parameters": {
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "default": "en-US,en",
          "description": "Config desired response language for HTTP requests.",
          "enum": [
            "en-US,en"
          ],
          "example": "en-US,en",
          "type": "string"
        }
      }
    },
    "schemas": {
      "AsyncVideoGenerationResponse": {
        "properties": {
          "model": {
            "description": "Model name.",
            "type": "string"
          },
          "request_id": {
            "description": "Task number submitted by the user during the client request or generated by the platform.",
            "type": "string"
          },
          "task_status": {
            "description": "Processing status, `PROCESSING` (processing), `SUCCESS` (success), `FAIL` (failure). Note: Processing status needs to be obtained via query.",
            "type": "string"
          },
          "video_result": {
            "description": "Video generation results.",
            "items": {
              "properties": {
                "cover_image_url": {
                  "description": "Video cover URL.",
                  "type": "string"
                },
                "url": {
                  "description": "Video URL.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "AsyncImageGenerationResponse": {
        "properties": {
          "image_result": {
            "description": "Array containing the generated image URLs.",
            "items": {
              "properties": {
                "url": {
                  "description": "Image URL. The temporary link expires after `30` days, please store it promptly.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "model": {
            "description": "Model name.",
            "type": "string"
          },
          "request_id": {
            "description": "Unique ID identifying this request, can be submitted by the user or generated by the platform.",
            "type": "string"
          },
          "task_status": {
            "description": "Processing status, `PROCESSING` (processing), `SUCCESS` (success), `FAIL` (failure). Note: Processing status needs to be obtained via query.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "The request has failed.",
        "properties": {
          "code": {
            "description": "Error code.",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "description": "Error message.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    }
  }
}
