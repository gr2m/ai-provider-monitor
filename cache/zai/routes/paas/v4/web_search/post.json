{
  "description": "The [Web Search](/guides/tools/web-search) is a specialized search engine for large language models. Building upon traditional search engine capabilities like web crawling and ranking, it enhances intent recognition to return results better suited for LLM processing (including webpage titles, URLs, summaries, site names, favicons etc.).",
  "parameters": [
    {
      "$ref": "#/components/parameters/AcceptLanguage"
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/WebSearchRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WebSearchResponse"
          }
        }
      },
      "description": "Processing successful"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "description": "The request has failed."
    }
  },
  "components": {
    "parameters": {
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "default": "en-US,en",
          "description": "Config desired response language for HTTP requests.",
          "enum": [
            "en-US,en"
          ],
          "example": "en-US,en",
          "type": "string"
        }
      }
    },
    "schemas": {
      "WebSearchRequest": {
        "properties": {
          "count": {
            "description": "The number of results to return\nFillable range: `1-50`, maximum `50` results per single search\nDefault is `10`\nSupported search engines: \n`search_pro_jina`.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "request_id": {
            "description": "Passed by the user side, needs to be unique; used to distinguish each request, 6–64 characters. If not provided by the user side, the platform will generate one by default.",
            "maxLength": 64,
            "minLength": 6,
            "type": "string"
          },
          "search_domain_filter": {
            "description": "Used to limit the scope of search results and only return content from specified whitelist domains.\nWhitelist: Directly enter the domain name (e.g., `www.example.com`)\nSupported search engines: \n`search_pro_jina`",
            "type": "string"
          },
          "search_engine": {
            "default": "search-prime",
            "description": "The search engine code to call.\n search-prime: Z.AI Premium Version Search Engine",
            "enum": [
              "search-prime"
            ],
            "example": "search-prime",
            "type": "string"
          },
          "search_query": {
            "description": "The content to be searched.",
            "type": "string"
          },
          "search_recency_filter": {
            "description": "Search for webpages within a specified time range.\nDefault is `noLimit`\nFillable values:\n`oneDay`: within one day\n`oneWeek`: within one week\n`oneMonth`: within one month\n`oneYear`: within one year\n`noLimit`: no limit (default)\nSupported search engines: \n`search_pro_jina`",
            "enum": [
              "oneDay",
              "oneWeek",
              "oneMonth",
              "oneYear",
              "noLimit"
            ],
            "type": "string"
          },
          "user_id": {
            "description": "Unique ID for the end user, 6–128 characters. Avoid using sensitive information.",
            "maxLength": 128,
            "minLength": 6,
            "type": "string"
          }
        },
        "required": [
          "search_engine",
          "search_query"
        ],
        "type": "object"
      },
      "WebSearchResponse": {
        "properties": {
          "created": {
            "description": "Request creation time, Unix timestamp in seconds.",
            "type": "integer"
          },
          "id": {
            "description": "Task ID.",
            "type": "string"
          },
          "search_result": {
            "description": "Search results.",
            "items": {
              "$ref": "#/components/schemas/WebSearchObjectResponse"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "The request has failed.",
        "properties": {
          "code": {
            "description": "Error code.",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "description": "Error message.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "WebSearchObjectResponse": {
        "properties": {
          "content": {
            "description": "Content summary.",
            "type": "string"
          },
          "icon": {
            "description": "Website icon.",
            "type": "string"
          },
          "link": {
            "description": "Result URL.",
            "type": "string"
          },
          "media": {
            "description": "Website name.",
            "type": "string"
          },
          "publish_date": {
            "description": "Website publication date.",
            "type": "string"
          },
          "refer": {
            "description": "Index number.",
            "type": "string"
          },
          "title": {
            "description": "Title.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
