{
  "description": "This endpoint is used to query the agent conversation history.Only support slides_glm_agent",
  "parameters": [
    {
      "$ref": "#/components/parameters/AcceptLanguage"
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/GlmSlideAgentConversationRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/GlmSlideAgentConversationResponse"
          }
        }
      },
      "description": "Processing successful"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "description": "The request has failed."
    }
  },
  "components": {
    "parameters": {
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "default": "en-US,en",
          "description": "Config desired response language for HTTP requests.",
          "enum": [
            "en-US,en"
          ],
          "example": "en-US,en",
          "type": "string"
        }
      }
    },
    "schemas": {
      "GlmSlideAgentConversationRequest": {
        "properties": {
          "agent_id": {
            "description": "Agent ID",
            "type": "string"
          },
          "conversation_id": {
            "description": "Conversation ID",
            "type": "string"
          },
          "custom_variables": {
            "description": "Custom variables",
            "properties": {
              "include_pdf": {
                "description": "Is export the pdf file",
                "type": "boolean"
              },
              "pages": {
                "description": "Slides Pages",
                "items": {
                  "properties": {
                    "height": {
                      "description": "Slide Height, unit: pt",
                      "type": "number"
                    },
                    "position": {
                      "description": "Slide Page Position",
                      "type": "number"
                    },
                    "width": {
                      "description": "Slide Width, unit: pt",
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "GlmSlideAgentConversationResponse": {
        "properties": {
          "agent_id": {
            "description": "Agent ID",
            "type": "string"
          },
          "choices": {
            "description": "Agent output.",
            "items": {
              "properties": {
                "message": {
                  "items": {
                    "properties": {
                      "content": {
                        "description": "Content metadata",
                        "items": {
                          "properties": {
                            "file_url": {
                              "description": "Output file_url content when type is file_url",
                              "type": "string"
                            },
                            "image_url": {
                              "description": "Output image_url content when type is image_url",
                              "type": "string"
                            },
                            "tag_cn": {
                              "description": "CN Tag.",
                              "type": "string"
                            },
                            "tag_en": {
                              "description": "EN Tag.",
                              "type": "string"
                            },
                            "type": {
                              "description": "Response Content type: file_url、image_url",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "role": {
                        "description": "Role: fixed as `assistant`.",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "conversation_id": {
            "description": "Conversation ID",
            "type": "string"
          },
          "error": {
            "properties": {
              "code": {
                "description": "Error code.",
                "type": "string"
              },
              "message": {
                "description": "Error message.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "The request has failed.",
        "properties": {
          "code": {
            "description": "Error code.",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "description": "Error message.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    }
  }
}
