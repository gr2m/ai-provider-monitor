{
  "description": "This endpoint is used to query the result of an asynchronous request.",
  "parameters": [
    {
      "$ref": "#/components/parameters/AcceptLanguage"
    }
  ],
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "$ref": "#/components/schemas/CommonAgentResultRequest"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/CommonAgentResultResponse"
          }
        }
      },
      "description": "Processing successful"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SpecialEffectsVideosAgentError"
          }
        }
      },
      "description": "The request has failed."
    }
  },
  "components": {
    "parameters": {
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "default": "en-US,en",
          "description": "Config desired response language for HTTP requests.",
          "enum": [
            "en-US,en"
          ],
          "example": "en-US,en",
          "type": "string"
        }
      }
    },
    "schemas": {
      "CommonAgentResultRequest": {
        "properties": {
          "agent_id": {
            "description": "Agent ID: `vidu_template_agent`.",
            "type": "string"
          },
          "async_id": {
            "description": "Task ID from async response.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CommonAgentResultResponse": {
        "properties": {
          "agent_id": {
            "description": "Agent ID",
            "type": "string"
          },
          "async_id": {
            "description": "Asynchronous task ID.",
            "type": "string"
          },
          "choices": {
            "description": "Agent output.",
            "items": {
              "properties": {
                "finish_reason": {
                  "description": "Reason for model inference termination. Can be ‘stop’, ‘tool_calls’, ‘length’, ‘sensitive’, or ‘network_error’.",
                  "type": "string"
                },
                "index": {
                  "description": "Result index.",
                  "type": "integer"
                },
                "message": {
                  "items": {
                    "properties": {
                      "content": {
                        "description": "Video file metadata",
                        "items": {
                          "properties": {
                            "type": {
                              "description": "object type: `video_url`.",
                              "type": "string"
                            },
                            "video_url": {
                              "description": "MP4 video URL.",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "role": {
                        "description": "Role: fixed as `assistant`.",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "description": "`pending` (processing), `success` (completed), `failed` (failed).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SpecialEffectsVideosAgentError": {
        "properties": {
          "agent_id": {
            "description": "Agent ID",
            "type": "string"
          },
          "error": {
            "properties": {
              "code": {
                "description": "Error code.",
                "type": "string"
              },
              "message": {
                "description": "Error message.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "status": {
            "description": "Status: `pending` (task created), `failed` (task creation failed).",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
