{
  "description": "Get the current user's balance information.",
  "operationId": "getUserBalance",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/UserBalance"
          }
        }
      },
      "description": "Successful response"
    }
  },
  "summary": "Get User Balance",
  "tags": [
    "User"
  ],
  "components": {
    "schemas": {
      "UserBalance": {
        "properties": {
          "balance_infos": {
            "items": {
              "properties": {
                "currency": {
                  "enum": [
                    "CNY",
                    "USD"
                  ],
                  "type": "string"
                },
                "granted_balance": {
                  "description": "Total not expired granted balance.",
                  "type": "string"
                },
                "topped_up_balance": {
                  "description": "Total topped-up balance.",
                  "type": "string"
                },
                "total_balance": {
                  "description": "Total available balance.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "is_available": {
            "description": "Whether the user's balance is sufficient for API calls.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
