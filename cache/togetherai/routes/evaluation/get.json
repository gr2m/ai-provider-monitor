{
  "operationId": "getAllEvaluationJobs",
  "parameters": [
    {
      "in": "query",
      "name": "status",
      "required": false,
      "schema": {
        "description": "Filter evaluation jobs by status",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
        "default": 10,
        "description": "Limit the number of results",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "items": {
              "$ref": "#/components/schemas/EvaluationJob"
            },
            "type": "array"
          }
        }
      },
      "description": "evaluation jobs retrieved successfully"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Invalid request format"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Error retrieving jobs from manager"
    }
  },
  "summary": "Get all evaluation jobs",
  "tags": [
    "evaluation"
  ],
  "components": {
    "schemas": {
      "EvaluationJob": {
        "properties": {
          "created_at": {
            "description": "When the job was created",
            "example": "2025-07-23T17:10:04.837888Z",
            "format": "date-time",
            "type": "string"
          },
          "owner_id": {
            "description": "ID of the job owner (admin only)",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "description": "The parameters used for this evaluation",
            "type": "object"
          },
          "results": {
            "description": "Results of the evaluation (when completed)",
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/EvaluationClassifyResults"
              },
              {
                "$ref": "#/components/schemas/EvaluationScoreResults"
              },
              {
                "$ref": "#/components/schemas/EvaluationCompareResults"
              },
              {
                "properties": {
                  "error": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ]
          },
          "status": {
            "description": "Current status of the job",
            "enum": [
              "pending",
              "queued",
              "running",
              "completed",
              "error",
              "user_error"
            ],
            "example": "completed",
            "type": "string"
          },
          "status_updates": {
            "description": "History of status updates (admin only)",
            "items": {
              "$ref": "#/components/schemas/EvaluationJobStatusUpdate"
            },
            "type": "array"
          },
          "type": {
            "description": "The type of evaluation",
            "enum": [
              "classify",
              "score",
              "compare"
            ],
            "example": "classify",
            "type": "string"
          },
          "updated_at": {
            "description": "When the job was last updated",
            "example": "2025-07-23T17:10:04.837888Z",
            "format": "date-time",
            "type": "string"
          },
          "workflow_id": {
            "description": "The evaluation job ID",
            "example": "eval-1234aedf",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EvaluationClassifyResults": {
        "properties": {
          "generation_fail_count": {
            "description": "Number of failed generations.",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "invalid_label_count": {
            "description": "Number of invalid labels",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "judge_fail_count": {
            "description": "Number of failed judge generations",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "label_counts": {
            "description": "JSON string representing label counts",
            "example": "{\"yes\": 10, \"no\": 0}",
            "type": "string"
          },
          "pass_percentage": {
            "description": "Pecentage of pass labels.",
            "example": 10,
            "nullable": true,
            "type": "number"
          },
          "result_file_id": {
            "description": "Data File ID",
            "example": "file-1234-aefd",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EvaluationScoreResults": {
        "properties": {
          "aggregated_scores": {
            "properties": {
              "mean_score": {
                "type": "number"
              },
              "pass_percentage": {
                "type": "number"
              },
              "std_score": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "failed_samples": {
            "description": "number of failed samples generated from model",
            "type": "number"
          },
          "generation_fail_count": {
            "description": "Number of failed generations.",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "invalid_score_count": {
            "description": "number of invalid scores generated from model",
            "type": "number"
          },
          "judge_fail_count": {
            "description": "Number of failed judge generations",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "result_file_id": {
            "description": "Data File ID",
            "example": "file-1234-aefd",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EvaluationCompareResults": {
        "properties": {
          "A_wins": {
            "description": "Number of samples where model A was judged the winner",
            "type": "integer"
          },
          "B_wins": {
            "description": "Number of samples where model B was judged the winner",
            "type": "integer"
          },
          "Ties": {
            "description": "Number of samples that resulted in a tie score",
            "type": "integer"
          },
          "generation_fail_count": {
            "description": "Number of generation failures across model A and model B.",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "judge_fail_count": {
            "description": "Number of judge inference failures. In the default two-pass mode (disable_position_bias_correction=false) this is the combined failure count from both the original-order and flipped-order judge passes.\n",
            "example": 0,
            "nullable": true,
            "type": "number"
          },
          "result_file_id": {
            "description": "File ID of the detailed output file. Each row contains the original input fields plus judge outputs. In two-pass mode the file includes both original-order and flipped-order judge fields; in single-pass mode (disable_position_bias_correction=true) only original-order fields are present.\n",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EvaluationJobStatusUpdate": {
        "properties": {
          "message": {
            "description": "Additional message for this update",
            "example": "Job is pending evaluation",
            "type": "string"
          },
          "status": {
            "description": "The status at this update",
            "example": "pending",
            "type": "string"
          },
          "timestamp": {
            "description": "When this update occurred",
            "example": "2025-07-23T17:10:04.837888Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
