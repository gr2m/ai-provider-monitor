{
  "description": "Returns all LoRA adapters bound to the specified dedicated endpoint.",
  "operationId": "listAdapters",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "data": {
                "items": {
                  "properties": {
                    "adapter_name": {
                      "type": "string"
                    },
                    "endpoint_name": {
                      "type": "string"
                    },
                    "model_id": {
                      "description": "Combined endpoint:adapter identifier",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "object": {
                "example": "list",
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "description": "List of bound adapters"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Not Found — endpoint does not exist"
    }
  },
  "summary": "List adapters on an endpoint",
  "tags": [
    "Endpoints"
  ],
  "components": {
    "schemas": {
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
