{
  "description": "Adds a LoRA adapter model to a dedicated endpoint. After this call,\ninference requests to the adapter model name will be routed to the\nspecified endpoint. The endpoint must have LoRA enabled, and the\nadapter's base model must be compatible with the endpoint's model.\nThe endpoint name prefix in model_id must match the resolved endpoint.\n",
  "operationId": "addAdapter",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "properties": {
            "model_id": {
              "description": "Combined identifier in format \"endpoint_name:adapter_model_name\".",
              "example": "username/Meta-Llama-3.1-8B-Instruct-def456:username/my-adapter-abc123",
              "type": "string"
            }
          },
          "required": [
            "model_id"
          ],
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "model_id": {
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "description": "Adapter successfully bound to endpoint"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Bad Request — invalid model_id format, endpoint name mismatch, LoRA not enabled, incompatible base model, or adapter already bound"
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Forbidden — adapter model not found or not owned"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Not Found — endpoint does not exist"
    }
  },
  "summary": "Add a LoRA adapter to an endpoint",
  "tags": [
    "Endpoints"
  ],
  "components": {
    "schemas": {
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
