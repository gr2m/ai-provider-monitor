{
  "description": "Removes the routing rule that binds an adapter to an endpoint.\nThe adapter must be currently bound to this specific endpoint.\n",
  "operationId": "removeAdapter",
  "requestBody": {
    "content": {
      "application/json": {
        "schema": {
          "properties": {
            "model_id": {
              "description": "Combined identifier in format \"endpoint_name:adapter_model_name\".",
              "type": "string"
            }
          },
          "required": [
            "model_id"
          ],
          "type": "object"
        }
      }
    },
    "required": true
  },
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "deleted": {
                "type": "boolean"
              },
              "model_id": {
                "type": "string"
              }
            },
            "type": "object"
          }
        }
      },
      "description": "Adapter successfully unbound"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Bad Request — invalid model_id format, or adapter not bound to this endpoint"
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Forbidden — adapter model not found or not owned"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Not Found — endpoint does not exist"
    }
  },
  "summary": "Remove a LoRA adapter from an endpoint",
  "tags": [
    "Endpoints"
  ],
  "components": {
    "schemas": {
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
