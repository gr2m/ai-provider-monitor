{
  "description": "Returns metadata for a checkpoint: type, base model, LoRA rank, step, and owning session.",
  "operationId": "getCheckpoint",
  "parameters": [
    {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "ID of the checkpoint",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/RL.Checkpoint"
          }
        }
      },
      "description": "Checkpoint metadata"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "An unexpected error response."
    }
  },
  "summary": "Get checkpoint",
  "tags": [
    "RL"
  ],
  "components": {
    "schemas": {
      "RL.Checkpoint": {
        "description": "Metadata for a saved checkpoint",
        "properties": {
          "base_model": {
            "description": "Base model the checkpoint was trained from",
            "example": "Qwen/Qwen3-0.6B",
            "type": "string"
          },
          "created_at": {
            "description": "Timestamp when the checkpoint was created",
            "example": "2026-01-02T00:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the checkpoint",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "lora_rank": {
            "description": "LoRA rank of the session that produced this checkpoint. Absent for full-weight sessions and for checkpoints saved before this field was recorded.",
            "example": 32,
            "type": "integer"
          },
          "session_id": {
            "description": "Training session that produced the checkpoint",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "step": {
            "description": "Training step at time of save",
            "example": "42",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/RL.CheckpointType",
            "description": "Whether this is a training checkpoint or an inference checkpoint",
            "example": "CHECKPOINT_TYPE_TRAINING"
          }
        },
        "required": [
          "id",
          "session_id",
          "base_model",
          "type",
          "step",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "RL.CheckpointType": {
        "description": "Whether a checkpoint is saved for training resume or inference download.",
        "enum": [
          "CHECKPOINT_TYPE_TRAINING",
          "CHECKPOINT_TYPE_INFERENCE"
        ],
        "type": "string"
      }
    }
  }
}
