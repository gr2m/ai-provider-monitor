{
  "description": "Detaches an adapter from a deployment using its row-level etag for optimistic concurrency.",
  "operationId": "DeploymentService_RemoveAdapter",
  "parameters": [
    {
      "in": "path",
      "name": "projectId",
      "required": true,
      "schema": {
        "description": "Project identifier.",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "endpointId",
      "required": true,
      "schema": {
        "description": "Endpoint identifier.",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "deploymentId",
      "required": true,
      "schema": {
        "description": "Deployment identifier.",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "Adapter model identifier.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "etag",
      "required": true,
      "schema": {
        "description": "Adapter etag from a previous add, update, get, or list response. The removal is rejected if the adapter changed after that response.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DE.DeleteResponse"
          }
        }
      },
      "description": "OK"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Default error response"
    }
  },
  "servers": [
    {
      "url": "https://api.together.ai/v2"
    }
  ],
  "summary": "Remove a deployment adapter",
  "tags": [
    "DeploymentService"
  ],
  "components": {
    "schemas": {
      "DE.DeleteResponse": {
        "additionalProperties": false,
        "description": "Empty response returned after a successful delete operation.",
        "properties": {},
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
