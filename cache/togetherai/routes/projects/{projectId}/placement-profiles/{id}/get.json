{
  "description": "Retrieves a reusable placement profile and its ordered region preferences.",
  "operationId": "PlacementProfileService_GetPlacementProfile",
  "parameters": [
    {
      "in": "path",
      "name": "projectId",
      "required": true,
      "schema": {
        "description": "Project identifier.",
        "type": "string"
      }
    },
    {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "Placement profile identifier.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/DE.PlacementProfile"
          }
        }
      },
      "description": "OK"
    },
    "default": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Default error response"
    }
  },
  "servers": [
    {
      "url": "https://api.together.ai/v2"
    }
  ],
  "summary": "Get a placement profile",
  "tags": [
    "PlacementProfileService"
  ],
  "components": {
    "schemas": {
      "DE.PlacementProfile": {
        "description": "Reusable ordered region preferences for scheduling a project's deployments.",
        "properties": {
          "id": {
            "description": "Unique placement profile identifier.",
            "type": "string"
          },
          "name": {
            "description": "Human-readable placement profile name.",
            "type": "string"
          },
          "organizationId": {
            "description": "Organization that owns the placement profile.",
            "type": "string"
          },
          "preferredRegions": {
            "description": "Preferred deployment regions in descending priority order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "projectId": {
            "description": "Project that owns the placement profile.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "projectId",
          "organizationId",
          "name",
          "preferredRegions"
        ],
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
