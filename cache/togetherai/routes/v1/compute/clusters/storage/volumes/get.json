{
  "description": "List all shared volumes.",
  "operationId": "SharedVolumeService_List",
  "parameters": [
    {
      "in": "query",
      "name": "projectId",
      "schema": {
        "description": "Optional UMS project ID to filter volumes by. When set, only volumes\n belonging to this project are returned. The caller must be a member of\n the project; otherwise the result set will be empty.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/GPUClustersSharedVolumes"
          }
        }
      },
      "description": "OK"
    }
  },
  "summary": "List all shared volumes",
  "tags": [
    "SharedVolumeService"
  ],
  "components": {
    "schemas": {
      "GPUClustersSharedVolumes": {
        "properties": {
          "volumes": {
            "items": {
              "$ref": "#/components/schemas/GPUClustersSharedVolume"
            },
            "type": "array"
          }
        },
        "required": [
          "volumes"
        ],
        "type": "object"
      },
      "GPUClustersSharedVolume": {
        "properties": {
          "size_tib": {
            "description": "Size of the volume in TiB.",
            "type": "integer"
          },
          "status": {
            "description": "Current status of the shared volume.",
            "enum": [
              "scheduled",
              "available",
              "bound",
              "provisioning",
              "deleting",
              "failed",
              "access_revoked",
              "unknown"
            ],
            "type": "string"
          },
          "volume_id": {
            "description": "ID of the volume.",
            "type": "string"
          },
          "volume_name": {
            "description": "User provided name of the volume.",
            "type": "string"
          }
        },
        "required": [
          "volume_id",
          "volume_name",
          "size_tib",
          "status"
        ],
        "type": "object"
      }
    }
  }
}
