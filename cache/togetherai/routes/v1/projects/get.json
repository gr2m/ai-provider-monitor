{
  "description": "Retrieve a list of accessible projects.",
  "operationId": "listProjects",
  "parameters": [
    {
      "in": "query",
      "name": "limit",
      "schema": {
        "description": "Maximum number of user projects in the page.",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "after",
      "schema": {
        "description": "Paginate the response utilizing a responses next_cursor field.",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListProjectsResponse"
          }
        }
      },
      "description": "OK"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Invalid request"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Authentication failed"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Not found"
    },
    "429": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Resource exhausted"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Internal server error"
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Service unavailable"
    },
    "504": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Request timed out"
    }
  },
  "summary": "List available projects",
  "tags": [
    "Projects"
  ],
  "components": {
    "schemas": {
      "ListProjectsResponse": {
        "description": "One page of projects available to the authenticated caller.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array"
          },
          "next_cursor": {
            "description": "Opaque cursor for the next page. Empty when this is the last page.",
            "type": "string"
          },
          "object": {
            "const": "list",
            "description": "Object type. Always `list`."
          }
        },
        "required": [
          "object",
          "data",
          "next_cursor"
        ],
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Project": {
        "description": "A project the authenticated caller can access.",
        "properties": {
          "id": {
            "description": "Unique project identifier.",
            "type": "string"
          },
          "name": {
            "description": "Display name of the project.",
            "type": "string"
          },
          "organization_id": {
            "description": "ID of the organization that owns the project.",
            "type": "string"
          },
          "organization_name": {
            "description": "Display name of the organization that owns the project.",
            "type": "string"
          },
          "slug": {
            "description": "Customer-facing project slug.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "organization_id",
          "organization_name"
        ],
        "type": "object"
      }
    }
  }
}
