{
  "description": "Returns identity information for the authenticated caller. Accepts project API keys and user session JWTs. The response `type` indicates which fields are present.\nFor project-scoped credentials, `project.slug` can be used with an endpoint slug as `<project_slug>/<endpoint_slug>` to form the `model` value in dedicated endpoint inference calls.\n",
  "operationId": "whoami",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WhoamiResponse"
          }
        }
      },
      "description": "Caller identity"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Invalid request"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Authentication failed"
    },
    "403": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Authentication failed or permission denied"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Not found"
    },
    "409": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Conflict"
    },
    "413": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Request body too large"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Internal server error"
    },
    "503": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Service unavailable"
    },
    "504": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Request timed out"
    }
  },
  "summary": "Identify the caller",
  "tags": [
    "Account"
  ],
  "components": {
    "schemas": {
      "WhoamiResponse": {
        "description": "The caller. `type` names the variant and which fields are present.",
        "discriminator": {
          "mapping": {
            "org_api_key": "#/components/schemas/WhoamiOrgApiKey",
            "project_api_key": "#/components/schemas/WhoamiProjectApiKey",
            "user_jwt": "#/components/schemas/WhoamiUserJwt",
            "user_org_jwt": "#/components/schemas/WhoamiUserOrgJwt",
            "user_org_project_jwt": "#/components/schemas/WhoamiUserOrgProjectJwt"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/WhoamiProjectApiKey"
          },
          {
            "$ref": "#/components/schemas/WhoamiOrgApiKey"
          },
          {
            "$ref": "#/components/schemas/WhoamiUserJwt"
          },
          {
            "$ref": "#/components/schemas/WhoamiUserOrgJwt"
          },
          {
            "$ref": "#/components/schemas/WhoamiUserOrgProjectJwt"
          }
        ]
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "WhoamiProjectApiKey": {
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/WhoamiApiKey"
          },
          "organization": {
            "$ref": "#/components/schemas/WhoamiOrganization"
          },
          "project": {
            "$ref": "#/components/schemas/WhoamiProject"
          },
          "type": {
            "description": "Always `project_api_key`.",
            "enum": [
              "project_api_key"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "api_key",
          "organization",
          "project"
        ],
        "title": "Project API key",
        "type": "object"
      },
      "WhoamiOrgApiKey": {
        "properties": {
          "api_key": {
            "$ref": "#/components/schemas/WhoamiApiKey"
          },
          "organization": {
            "$ref": "#/components/schemas/WhoamiOrganization"
          },
          "type": {
            "description": "Always `org_api_key`.",
            "enum": [
              "org_api_key"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "api_key",
          "organization"
        ],
        "title": "Organization API key",
        "type": "object"
      },
      "WhoamiUserJwt": {
        "properties": {
          "type": {
            "description": "Always `user_jwt`.",
            "enum": [
              "user_jwt"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/WhoamiUser"
          }
        },
        "required": [
          "type",
          "user"
        ],
        "title": "User JWT",
        "type": "object"
      },
      "WhoamiUserOrgJwt": {
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/WhoamiOrganization"
          },
          "type": {
            "description": "Always `user_org_jwt`.",
            "enum": [
              "user_org_jwt"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/WhoamiUser"
          }
        },
        "required": [
          "type",
          "user",
          "organization"
        ],
        "title": "User organization JWT",
        "type": "object"
      },
      "WhoamiUserOrgProjectJwt": {
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/WhoamiOrganization"
          },
          "project": {
            "$ref": "#/components/schemas/WhoamiProject"
          },
          "type": {
            "description": "Always `user_org_project_jwt`.",
            "enum": [
              "user_org_project_jwt"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/WhoamiUser"
          }
        },
        "required": [
          "type",
          "user",
          "organization",
          "project"
        ],
        "title": "User organization project JWT",
        "type": "object"
      },
      "WhoamiApiKey": {
        "properties": {
          "id": {
            "description": "The authenticated API key identifier.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "WhoamiOrganization": {
        "properties": {
          "id": {
            "description": "Organization identifier.",
            "type": "string"
          },
          "name": {
            "description": "Organization display name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "WhoamiProject": {
        "properties": {
          "id": {
            "description": "Project identifier.",
            "type": "string"
          },
          "name": {
            "description": "Project display name.",
            "type": "string"
          },
          "slug": {
            "description": "DNS-friendly project identifier. Used with an endpoint slug as `<project_slug>/<endpoint_slug>` to form the `model` value in dedicated endpoint inference calls.\n",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "type": "object"
      },
      "WhoamiUser": {
        "properties": {
          "id": {
            "description": "Authenticated user identifier.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    }
  }
}
