{
  "description": "Lists passive health check alerts. Filters combine across axes; empty values skip that axis.",
  "operationId": "HealthCheckService_ListPassiveHealthCheckAlerts",
  "parameters": [
    {
      "in": "query",
      "name": "intent_id",
      "schema": {
        "description": "Remediation intent ID to filter by.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "instance_id",
      "schema": {
        "description": "Instance ID to filter by.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "cluster_id",
      "schema": {
        "description": "Optional instance cluster ID to filter by. Required for non-admin callers.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "page_size",
      "schema": {
        "default": 50,
        "description": "Max number of results to return.",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "page_token",
      "schema": {
        "description": "Opaque pagination token from the previous response.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "status",
      "schema": {
        "description": "Lifecycle filter. Omit to return firing alerts.",
        "enum": [
          "PHC_ALERT_STATUS_FIRING",
          "PHC_ALERT_STATUS_RESOLVED",
          "PHC_ALERT_STATUS_ALL"
        ],
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "severity_filter",
      "schema": {
        "description": "Severity tiers to include. Omit or pass an empty array to include all severities.",
        "items": {
          "enum": [
            "PHC_SEVERITY_INFO",
            "PHC_SEVERITY_WARNING",
            "PHC_SEVERITY_CRITICAL"
          ],
          "type": "string"
        },
        "type": "array"
      }
    },
    {
      "in": "query",
      "name": "order_by",
      "schema": {
        "default": "PHC_ALERT_ORDER_STARTED_AT_DESC",
        "description": "Sort order for returned alerts. Omit for newest alerts first.",
        "enum": [
          "PHC_ALERT_ORDER_STARTED_AT_ASC",
          "PHC_ALERT_ORDER_STARTED_AT_DESC"
        ],
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ListPassiveHealthCheckAlertsResponse"
          }
        }
      },
      "description": "OK"
    }
  },
  "summary": "List passive health check alerts",
  "tags": [
    "HealthCheckService"
  ],
  "components": {
    "schemas": {
      "ListPassiveHealthCheckAlertsResponse": {
        "description": "Response returned when listing passive health check alerts.",
        "properties": {
          "alerts": {
            "description": "Alerts on the current page, ordered by the request sort order.",
            "items": {
              "$ref": "#/components/schemas/PassiveHealthCheckAlert"
            },
            "type": "array"
          },
          "next_page_token": {
            "description": "Opaque token for the next page. Empty means there are no more pages.",
            "type": "string"
          }
        },
        "required": [
          "alerts",
          "next_page_token"
        ],
        "type": "object"
      },
      "PassiveHealthCheckAlert": {
        "description": "Passive health check alert returned by the health check API.",
        "properties": {
          "alert_name": {
            "description": "Alertmanager alert name.",
            "readOnly": true,
            "type": "string"
          },
          "annotation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PHCAnnotation"
              }
            ],
            "description": "Typed annotation content parsed from the legacy annotations bag.",
            "readOnly": true
          },
          "annotations": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Legacy Alertmanager annotations as key-value strings.",
            "readOnly": true,
            "type": "object"
          },
          "cluster_id": {
            "description": "Cluster UUID the alert was raised against.",
            "readOnly": true,
            "type": "string"
          },
          "instance_id": {
            "description": "Resolved instance UUID. Empty until the alert is joined to an instance.",
            "readOnly": true,
            "type": "string"
          },
          "node_remediation_intent_id": {
            "description": "Remediation intent UUID attached to this alert, if any.",
            "readOnly": true,
            "type": "string"
          },
          "passive_health_check_alert_id": {
            "description": "Primary key UUID for the passive health check alert.",
            "readOnly": true,
            "type": "string"
          },
          "resolved_at": {
            "description": "Time when the underlying alert resolved. Empty while the alert is firing.",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "severity": {
            "description": "Canonical severity tier for the alert.",
            "enum": [
              "PHC_SEVERITY_INFO",
              "PHC_SEVERITY_WARNING",
              "PHC_SEVERITY_CRITICAL"
            ],
            "readOnly": true,
            "type": "string"
          },
          "started_at": {
            "description": "Time when the underlying alert first fired.",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "target_vm": {
            "description": "VM name extracted from the Alertmanager labels.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "passive_health_check_alert_id",
          "cluster_id",
          "target_vm",
          "alert_name",
          "severity",
          "annotations",
          "started_at",
          "annotation"
        ],
        "type": "object"
      },
      "PHCAnnotation": {
        "description": "Typed content parsed from passive health check alert annotations.",
        "properties": {
          "description": {
            "description": "Static explanation for the alert.",
            "readOnly": true,
            "type": "string"
          },
          "slurm_node_unavailable": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SlurmNodeUnavailableDetail"
              }
            ],
            "description": "Slurm node details when the alert was caused by unavailable Slurm nodes."
          },
          "summary_line": {
            "description": "Per-firing summary line parsed from the evidence annotation.",
            "readOnly": true,
            "type": "string"
          },
          "title": {
            "description": "Alert title from the Alertmanager summary annotation.",
            "readOnly": true,
            "type": "string"
          },
          "xid": {
            "allOf": [
              {
                "$ref": "#/components/schemas/XidDetail"
              }
            ],
            "description": "Xid-specific details when the alert was caused by NVIDIA Xid errors."
          }
        },
        "required": [
          "title",
          "description",
          "summary_line"
        ],
        "type": "object"
      },
      "SlurmNodeUnavailableDetail": {
        "description": "Details for a Slurm node unavailable passive health check alert.",
        "properties": {
          "reason": {
            "description": "Drain reason reported for the unavailable Slurm node.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "XidDetail": {
        "description": "Details for a DmesgXidError passive health check alert.",
        "properties": {
          "events": {
            "description": "Xid events observed during the alert window.",
            "items": {
              "$ref": "#/components/schemas/XidEvent"
            },
            "readOnly": true,
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "XidEvent": {
        "description": "One NVIDIA Xid code observed during the alert window.",
        "properties": {
          "count": {
            "description": "Number of times this Xid code appeared in the alert window.",
            "readOnly": true,
            "type": "integer"
          },
          "mnemonic": {
            "description": "Driver mnemonic for the Xid code when metadata is available.",
            "readOnly": true,
            "type": "string"
          },
          "xid_code": {
            "description": "NVIDIA Xid code, such as `79`.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "xid_code",
          "mnemonic",
          "count"
        ],
        "type": "object"
      }
    }
  }
}
