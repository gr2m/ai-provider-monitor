{
  "description": "Returns the revision history of the deployment, in descending order. Defaults to the most recent events.\nOnly the 200 most recent events are retained per deployment; paginating past that returns an empty list.",
  "parameters": [
    {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
        "description": "Deployment ID or name.",
        "type": "string"
      }
    },
    {
      "in": "query",
      "name": "limit",
      "schema": {
        "description": "Maximum number of events to return (default 10, max 100).",
        "type": "integer"
      }
    },
    {
      "in": "query",
      "name": "before",
      "schema": {
        "description": "Return only events with event_number strictly less than this value for pagination.",
        "type": "integer"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/RevisionEventListResponse"
          }
        }
      },
      "description": "Revision history"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object"
          }
        }
      },
      "description": "Invalid pagination parameters"
    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object"
          }
        }
      },
      "description": "Deployment not found"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "type": "object"
          }
        }
      },
      "description": "Internal server error"
    }
  },
  "summary": "List revision history events of a deployment",
  "tags": [
    "Deployments"
  ],
  "components": {
    "schemas": {
      "RevisionEventListResponse": {
        "description": "Revision history events for a deployment, newest first.",
        "properties": {
          "data": {
            "description": "Revision events, newest first.",
            "items": {
              "$ref": "#/components/schemas/RevisionEventItem"
            },
            "type": "array"
          },
          "object": {
            "const": "list",
            "description": "The object type, which is always `list`."
          }
        },
        "required": [
          "data",
          "object"
        ],
        "type": "object"
      },
      "RevisionEventItem": {
        "description": "One entry in a deployment's revision history.",
        "properties": {
          "action": {
            "description": "How this revision became active.",
            "enum": [
              "create",
              "update",
              "system",
              "rollback"
            ],
            "type": "string"
          },
          "activated_at": {
            "description": "Time when this revision became active.",
            "format": "date-time",
            "type": "string"
          },
          "event_number": {
            "description": "Monotonic event number in the deployment's revision history.",
            "type": "integer"
          },
          "image": {
            "description": "Container image of the revision activated by this event.",
            "type": "string"
          },
          "object": {
            "const": "revision_event",
            "description": "The object type, which is always `revision_event`."
          },
          "revision_id": {
            "description": "Revision ID activated by this event.",
            "type": "string"
          },
          "revision_number": {
            "description": "Human-readable per-deployment revision counter.",
            "type": "integer"
          }
        },
        "required": [
          "object",
          "event_number",
          "revision_id",
          "revision_number",
          "image",
          "action",
          "activated_at"
        ],
        "type": "object"
      }
    }
  }
}
