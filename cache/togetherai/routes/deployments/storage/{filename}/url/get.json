    },
    "404": {
      "content": {
        "application/json": {
          "schema": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        }
      },
      "description": "File not found"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "additionalProperties": {
