{
  "description": "Create a signed URL for downloading a deployment storage file",
  "parameters": [
    {
      "in": "path",
      "name": "filename",
      "required": true,
      "schema": {
        "description": "Filename",
        "type": "string"
      }
    }
  ],
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SignedURLResponse"
          }
        }
      },
      "description": "Signed URL"
    },
    "400": {
      "content": {
        "application/json": {
          "schema": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
