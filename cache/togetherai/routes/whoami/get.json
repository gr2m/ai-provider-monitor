{
  "description": "Returns identity information about the authenticated API key. Useful for confirming which project and organization a key is scoped to, and for obtaining the project slug used to compose the `model` value (`<project_slug>/<endpoint_slug>`) in dedicated endpoint inference calls.\nRequires a Bearer API key in the `Authorization` header. Cookie, session, and SLS JWT credentials are not accepted.\n",
  "operationId": "whoami",
  "responses": {
    "200": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/WhoamiResponse"
          }
        }
      },
      "description": "API key identity information"
    },
    "401": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Unauthorized — missing or invalid API key"
    },
    "500": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ErrorData"
          }
        }
      },
      "description": "Internal server error"
    }
  },
  "summary": "Get API key identity",
  "tags": [
    "Account"
  ],
  "components": {
    "schemas": {
      "WhoamiResponse": {
        "properties": {
          "api_key_id": {
            "description": "The ID of the API key that authenticated the request.",
            "type": "string"
          },
          "organization_id": {
            "description": "The ID of the organization that owns the project.",
            "type": "string"
          },
          "organization_name": {
            "description": "Human-readable name of the organization.",
            "type": "string"
          },
          "project_id": {
            "description": "The ID of the project the API key is scoped to.",
            "type": "string"
          },
          "project_name": {
            "description": "Human-readable name of the project.",
            "type": "string"
          },
          "project_slug": {
            "description": "DNS-friendly project identifier. Used with an endpoint slug as `<project_slug>/<endpoint_slug>` to form the `model` value in dedicated endpoint inference calls.\n",
            "type": "string"
          },
          "user_id": {
            "description": "The ID of the authenticated user, if available.",
            "type": "string"
          }
        },
        "required": [
          "api_key_id",
          "project_id",
          "project_name",
          "project_slug",
          "organization_id",
          "organization_name"
        ],
        "type": "object"
      },
      "ErrorData": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "message": {
                "nullable": false,
                "type": "string"
              },
              "param": {
                "default": null,
                "nullable": true,
                "type": "string"
              },
              "type": {
                "nullable": false,
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  }
}
